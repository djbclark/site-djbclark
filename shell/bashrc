# Disk usage: dua over the whole boot volume with nothing counted twice.
# -x drops the genuinely separate volumes reached from / (/System/Volumes/VM,
# Preboot, Update, /Volumes/Recovery, external /Volumes mounts, the autofs
# /System/Volumes/Data/home, and Carbon Copy Cloner's read-only snapshot
# mounted under /private/tmp). -x ALONE IS NOT ENOUGH: in an APFS volume group
# the system and data volumes report the SAME device id, so dua descends into
# /System/Volumes/Data and counts /Users, /private, /Applications, /Library,
# /opt and /usr/local a second time -- hence the explicit ignore. Nothing is
# lost by it: every one of those paths is already reachable from / through the
# firmlinks in /usr/share/firmlinks. /Volumes/Macintosh HD needs no flag at
# all -- it is a plain symlink to /, and dua does not follow symlinks.
# Trade-off: excluding /System/Volumes/VM hides swap/sleepimage, so the total
# reads lower than df.
alias du-all='sudo dua i -x -i /System/Volumes/Data -- /'

