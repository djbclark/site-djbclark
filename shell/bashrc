# Agent TUIs: default each tool into its "YOLO" mode, but only add the flag
# when it is not already on the command line. Orca launches agent panes with
# the flag already present, and re-adding it made clap-style CLIs abort on
# the duplicate (2026-08-21). Dedup rather than an ORCA_* env-var guard so a
# command typed by hand inside an Orca terminal pane still gets the flag.
# These are FUNCTIONS, not aliases, on purpose: Orca's generated bash rcfile
# defines its own wrappers AFTER sourcing this file, and bash alias-expands
# function names at parse time -- an alias here turned Orca's codex() wrapper
# into a syntax error at every pane launch (2026-08-21).
__agent_default_flag() {
  # usage: __agent_default_flag <cmd> <flag> [args...]
  local cmd=$1 flag=$2 a
  shift 2
  for a in "$@"; do
    [[ $a == "$flag" ]] && { command "$cmd" "$@"; return; }
  done
  command "$cmd" "$flag" "$@"
}
__opencode_tui() {
  local restore_monitor=0 status
  if [[ $- == *m* ]]; then
    set +m
    restore_monitor=1
  fi
  command opencode "$@"
  status=$?
  (( restore_monitor )) && set -m
  return "$status"
}
agy()          { __agent_default_flag agy          --dangerously-skip-permissions "$@"; }
claude()       { __agent_default_flag claude       --dangerously-skip-permissions "$@"; }
cursor-agent() { __agent_default_flag cursor-agent --yolo                         "$@"; }
opencode() {
  case ${1:-} in
    completion|acp|mcp|debug|providers|auth|agent|upgrade|uninstall|serve|web|models|stats|export|import|github|session|plugin|db)
      command opencode "$@" ;;
    run)
      __agent_default_flag opencode --auto "$@" ;;
    attach|pr)
      __opencode_tui "$@" ;;
    *)
      # OpenCode/OpenTUI can lose the foreground process group under Bash
      # job control, suspending itself and leaving mouse reporting enabled.
      local arg
      for arg in "$@"; do
        [[ $arg == --auto ]] && { __opencode_tui "$@"; return; }
      done
      __opencode_tui --auto "$@" ;;
  esac
}
copilot()      { __agent_default_flag copilot      --allow-all                    "$@"; }
grok()         { __agent_default_flag grok         --always-approve               "$@"; }
# codex: with codex already a function, Orca's rcfile skips its own wrapper
# (its guard wants an executable path from `command -v`), so the launch
# preflight that wrapper would have run is replicated here, gated on Orca's
# own env var.
codex() {
  if [[ -n "${ORCA_CODEX_LAUNCH_PREFLIGHT:-}" && -x "${ORCA_CODEX_LAUNCH_PREFLIGHT}" ]]; then
    "${ORCA_CODEX_LAUNCH_PREFLIGHT}" agent hooks prepare-codex >/dev/null 2>&1 || :
  fi
  __agent_default_flag codex --dangerously-bypass-approvals-and-sandbox "$@"
}

# Hermes: keep the normal local safety flag, but make restart use the
# launchd-aware gateway service operation. This function lives in shell config
# rather than the generated launcher so Hermes upgrades cannot clobber it.
hermes() {
  if [[ "${1:-}" == "restart" ]]; then
    shift
    command hermes gateway restart "$@"
  else
    __agent_default_flag hermes --yolo "$@"
  fi
}

# More agent TUIs in YOLO mode (2026-09-24). Each flag was checked against the
# tool's own --help or README. These tools also take a competing mode option
# (--approval-mode, --permission-mode, --auto-approve ...), so the default is
# skipped when ANY of the listed options is already on the command line, not
# only the exact flag. Same function-not-alias rule as above.
__agent_has_opt() {
  # usage: __agent_has_opt "<opt1> <opt2> ..." [args...]  -> 0 if any arg is one of
  # the opts, or <opt>=value
  local opts=$1 a o
  shift
  for a in "$@"; do
    for o in $opts; do
      [[ $a == "$o" || $a == "$o="* ]] && return 0
    done
  done
  return 1
}
__agent_default_opts() {
  # usage: __agent_default_opts <cmd> "<guard opts>" <default args...> -- [args...]
  local cmd=$1 guard=$2
  shift 2
  local n=0 a
  for a in "$@"; do n=$((n+1)); [[ $a == "--" ]] && break; done
  local defaults=("${@:1:n-1}")
  shift "$n"
  if __agent_has_opt "$guard" "$@"; then command "$cmd" "$@"
  else command "$cmd" "${defaults[@]}" "$@"; fi
}
qwen()  { __agent_default_opts qwen  "--yolo -y --approval-mode"       --yolo -- "$@"; }
crush() { __agent_default_opts crush "--yolo -y"                       --yolo -- "$@"; }
aider() { __agent_default_opts aider "--yes-always --no-yes-always"    --yes-always -- "$@"; }
devin() { __agent_default_opts devin "--permission-mode"               --permission-mode dangerous -- "$@"; }
# cline: --yolo is a ONE-SHOT mode (exits after the turn), so the interactive
# equivalent is --auto-approve true.
cline() { __agent_default_opts cline "--auto-approve --yolo"           --auto-approve true -- "$@"; }
# zcode: --mode takes a value and is global (accepted before any subcommand),
# so prepending works for plain TUI launches, `tui`, and headless -p alike.
zcode() { __agent_default_opts zcode "--mode" --mode yolo -- "$@"; }
# omp: Orca's rcfile REPLACES this with its own omp() (status extension) in
# Orca panes, so this only applies outside Orca. Its subcommands (config,
# install, ...) don't take the flag, so only add it to interactive launches,
# mirroring Orca's __orca_omp_should_skip_extension list.
omp() {
  case "${1:-}" in
    help|--help|-h|--version|-v|__complete|acp|agents|auth-broker|auth-gateway|bench|commit|completions|config|dry-balance|gallery|grep|grievances|install|join|models|plugin|read|say|search|setup|shell|ssh|stats|tiny-models|token|ttsr|update|usage|worktree|q|wt)
      command omp "$@" ;;
    *) __agent_default_opts omp "--auto-approve --approval-mode" --auto-approve -- "$@" ;;
  esac
}

# -- fzf (fuzzy finder) --------------------------------------------------

if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)" 2>/dev/null || true
fi

# Search only under current directory with Spotlight
fzf-spotlight() {
  local query="${1-}"
  shift 2>/dev/null || true
  local cmd='mdfind -onlyin . "kMDItemFSName = *"'
  FZF_DEFAULT_COMMAND="$cmd" fzf --query="$query" "$@"
}

# Search your entire home directory with Spotlight
fzf-home() {
  local query="${1-}"
  shift 2>/dev/null || true
  local cmd='mdfind -onlyin ~ "kMDItemFSName = *"'
  FZF_DEFAULT_COMMAND="$cmd" fzf --query="$query" "$@"
}

alias fzs='fzf-spotlight'
alias fzh='fzf-home'

