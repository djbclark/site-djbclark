# ~/.bashrc -- the single load-bearing shell config on this machine.
#
# Sourced by ALL of:
#   * login shells        -- via ~/.bash_profile, which is now just a stub
#   * interactive shells  -- bash's normal ~/.bashrc behavior
#   * non-interactive     -- Claude Code's Bash tool sets BASH_ENV to this file
#                           (see ~/.claude/settings.json); such shells read
#                           BASH_ENV and nothing else -- no .bash_profile.
#
# ASCII ONLY: keep this file pure 7-bit ASCII, comments included. The fancy
# Unicode that used to live in these comments (box-drawing rules, em dashes,
# bullets, arrows) rendered as <E2><94><80>-style garbage on some terminals
# and made grep/diff/file(1) treat the file as binary (2026-08-21).
# Substitutes: -- for em dash, -> for arrow, * for bullet, --- / === for
# section rules. Enforced by check 1b in ~/.config/bash/selftest.sh.
#
# == THE ONE RULE ==========================================================
# This file has exactly two sections, split by the guard partway down.
#
#   TIER 1 (above the guard) -- PATH, exported env vars, PATH helpers.
#     Runs in every shell, including scripts and agent Bash-tool calls.
#     MUST BE SILENT and MUST NOT change parsing/globbing behavior.
#
#   TIER 2 (below the guard) -- aliases, functions, prompt, completion,
#     fzf, shopt toggles. Interactive shells only.
#
# Deciding which side something goes on is the whole maintenance burden.
# The test is: "would a script or an agent's Bash tool call need this?"
#   yes -> tier 1.   no -> tier 2.   unsure -> tier 2 (the safe default:
#   worst case something is missing and you notice loudly, rather than
#   silently corrupting every non-interactive shell on the machine).
#
# == WHY TIER 1 MUST BE SILENT =============================================
# Claude Code hooks return JSON on stdout, and BASH_ENV sourcing runs before
# the hook script's body -- so anything in tier 1 that prints (a banner, a
# version notice, an nvm/pyenv init, an "update available" line) prepends
# itself to that JSON. The hook then fails SILENTLY: malformed JSON is
# discarded with no error and no log line, and the blame lands on the hook
# rather than on the .bashrc line added weeks earlier.
#
# == DON'T HAND-VERIFY -- RUN THE SELF-TEST =================================
# After ANY edit to this file, ~/.bash_profile, or ~/.bashrc.local:
#
#     ~/.config/bash/selftest.sh
#
# It checks tier-1 silence, PATH ordering invariants (including the herdr
# wrapper precedence that a stray `export PATH=` in .bashrc.local silently
# broke for two weeks), duplicate PATH entries, and nesting stability.
# ~/.claude/hooks/cswap_quota_context.sh also runs it at session start and
# warns on stderr if anything regresses, so a break can't stay invisible.
#
# Then RE-BLESS the tamper-alarm golden(s) for whichever file you edited:
#     cp ~/.bashrc ~/.config/bash/bashrc.expected
#     cp ~/.bash_profile ~/.config/bash/bash_profile.expected
# Until you do, every new interactive shell shows the change and prompts
# [LATER/accept/revert] (the ~/.bashrc alarm) or a red banner (the
# ~/.bash_profile alarm). Accept at that prompt does the same re-bless.
#
# ==========================================================================
# == TIER 1: environment -- every shell, interactive or not. SILENT ONLY. ===
# ==========================================================================

# -- PATH helpers ---------------------------------------------------------
# Both are IDEMPOTENT: a directory already on PATH is left where it is
# rather than moved. First claim wins. This is what makes ordering
# deterministic and makes nested shells (herdr panes spawn login shells
# inside login shells) stop growing PATH without bound.
#
# ALWAYS use these instead of `export PATH="dir:$PATH"`. A raw prepend
# outranks everything added before it, which is how ~/.bashrc.local ended up
# shadowing the herdr self-closure-defense wrapper with the real binary.

__path_prepend() {  # highest priority first; args applied so arg order == final order
  local i d
  for (( i = $#; i > 0; i-- )); do
    d="${!i}"
    [[ -d $d ]] || continue
    case ":$PATH:" in *":$d:"*) continue ;; esac
    PATH="$d${PATH:+:$PATH}"
  done
  return 0
}

__path_append() {
  local d
  for d in "$@"; do
    [[ -d $d ]] || continue
    case ":$PATH:" in *":$d:"*) continue ;; esac
    PATH="${PATH:+$PATH:}$d"
  done
  return 0
}

# Force-to-front variant, for ordering decisions that must hold even when a
# dir arrived on the INHERITED PATH in a losing position. Orca panes inherit
# the daemon's environment, where ~/.local/bin already sits far below
# /opt/homebrew/bin; the idempotent prepend saw it "already present" and
# left it losing, so aiuse resolved to a broken Homebrew copy (2026-08-21).
# Re-prepends unconditionally -- the same pattern as the brew block below --
# and relies on __path_dedup at the end of tier 1 to drop the lower
# duplicate, which is also what keeps nested shells from growing PATH.
__path_prepend_force() {  # highest priority first; arg order == final order
  local i d
  for (( i = $#; i > 0; i-- )); do
    d="${!i}"
    [[ -d $d ]] || continue
    PATH="$d${PATH:+:$PATH}"
  done
  return 0
}

# Drop duplicate PATH entries, keeping the first (highest-priority)
# occurrence. Backstop for things that prepend unconditionally and are not
# ours to change -- `brew shellenv` most notably, plus anything an installer
# appends to ~/.bash_profile. Pure bash, no subshell: this runs on every
# single Bash-tool invocation.
__path_dedup() {
  local IFS=: d out= seen=: reset_glob=
  [[ $- == *f* ]] || { set -f; reset_glob=1; }   # don't glob-expand path entries
  for d in $PATH; do
    # Skip empties and "." -- an empty component and a literal "." both mean
    # "current directory", which makes every cd into an untrusted tree a
    # command-execution risk. bash's built-in default PATH contains ".", so
    # this can arrive by inheritance rather than by anyone choosing it.
    [[ -z $d || $d == "." || $seen == *":$d:"* ]] && continue
    seen+="$d:"
    out="${out:+$out:}$d"
  done
  [[ -n $reset_glob ]] && set +f
  PATH="$out"
  return 0
}

# -- Baseline system PATH -------------------------------------------------
# Must come before `brew shellenv`. macOS assembles the system PATH in
# /etc/profile via path_helper -- but /etc/profile runs for LOGIN shells
# only. A non-login shell started from a minimal environment (launchd, cron,
# `env -i bash`) gets bash's built-in default PATH, which is NOT exported.
# `brew shellenv` is a subprocess and reads PATH from its own environment;
# seeing none, it emits an unconditional assignment that replaces PATH
# wholesale -- silently leaving /usr/bin and /bin off. The `export` below is
# the load-bearing part; the seeding handles a genuinely empty PATH.

case ":${PATH-}:" in
  *:/usr/bin:*) : ;;   # already seeded (login shell, or inherited) -- leave as is
  *)
    if [ -x /usr/libexec/path_helper ]; then
      eval "$(/usr/libexec/path_helper -s)"
    else
      PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    fi
    ;;
esac
export PATH

# -- Homebrew (arm64) -----------------------------------------------------
# Inlined rather than `eval "$(brew shellenv)"`. That call spawns brew (a
# Ruby program) plus a path_helper subprocess on EVERY shell -- ~40ms, which
# tier 1 pays on every single agent Bash-tool call. What it actually does is
# fully static for a fixed prefix, so it is reproduced literally below.
#
# The raw prepend (not __path_prepend) is deliberate and mirrors what
# shellenv itself does: /etc/paths.d/homebrew already puts these dirs in the
# SYSTEM section of PATH, below /usr/bin, and Homebrew must outrank /usr/bin
# for the many names they share (python3, git, curl, openssl, ...). An
# idempotent prepend would see them already present and leave them down
# there. The duplicate this creates is removed by __path_dedup at the end of
# tier 1, which keeps the first (highest-priority) occurrence.
#
# ~/.config/bash/selftest.sh asserts these values still match what
# `brew shellenv` actually emits, so a Homebrew change cannot drift silently.

export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export HOMEBREW_NO_AUTO_UPDATE=1
if [ -d /opt/homebrew/bin ]; then
  PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH:+:$PATH}"
  # Guarded, unlike shellenv's unconditional prepend: shellenv re-prepends on
  # every nested shell, growing INFOPATH one copy per nesting level forever
  # (PATH has __path_dedup to clean that up; INFOPATH has nothing).
  case ":${INFOPATH:-}:" in
    *":/opt/homebrew/share/info:"*) : ;;
    *) export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}" ;;
  esac
  [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
  # Guarded like INFOPATH above. Without /opt/homebrew/share present, GLib
  # apps (e.g. czkawka_gui) can't find their compiled GSettings schemas
  # (org.gtk.Settings.FileChooser etc.) and hard-abort with
  # "No GSettings schemas are installed on the system". Nix's profile.d
  # script sets XDG_DATA_DIRS to its own paths and never includes Homebrew's,
  # so this has to be added explicitly rather than assumed inherited.
  case ":${XDG_DATA_DIRS:-}:" in
    *":/opt/homebrew/share:"*) : ;;
    *) export XDG_DATA_DIRS="/opt/homebrew/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" ;;
  esac
fi

