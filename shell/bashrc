# -- herdr self-closure-defense wrapper -- must resolve FIRST --------------
# The wrapper blocks a herdr pane from closing itself; it only works if it
# shadows the real binary at ~/.local/bin/herdr (the upstream-default
# install location). It lives in its own dedicated dir precisely so an
# installer or updater can never clobber it.
#
# Two deliberate departures from the rules above, both load-bearing:
#
#  1. Raw prepend, not __path_prepend. Idempotence is WRONG here (the
#     __path_prepend_force reasoning): a shell that inherits a PATH where ~/.local/bin
#     already precedes the wrapper dir would see the wrapper "already
#     present" and leave it in the losing position. That is not
#     hypothetical -- it was the live state of every shell on this machine
#     before 2026-08-17, and any process still running from before then
#     passes that PATH to its children now.
#  2. Positioned AFTER the ~/.bashrc.local source, dead last before
#     __path_dedup, so NOTHING in this file or in local overrides can land
#     in front of it. (The original defect was exactly a stray prepend in
#     .bashrc.local; keeping this block below that source line makes the
#     recurrence structurally impossible rather than merely detected.)
#
# __path_dedup below removes the now-duplicate lower entry.
if [ -x "$HOME/.herdr-wrapper/bin/herdr" ]; then
  PATH="$HOME/.herdr-wrapper/bin${PATH:+:$PATH}"
fi

# Final normalization. Keep this LAST in tier 1 -- it cleans up duplicates
# introduced by brew shellenv in nested shells and by anything sourced above.
__path_dedup
export PATH

# ==========================================================================
# == GUARD -- interactive-only below this line ==============================
# ==========================================================================
# Non-interactive shells (scripts, Claude Code's Bash tool via BASH_ENV)
# return here and never see aliases, prompt, or fzf/completion init.

[[ $- == *i* ]] || return

# ==========================================================================
# == TIER 2: interactive shells only =======================================
# ==========================================================================

# -- ~/.bash_profile tamper alarm ------------------------------------------
# Installers append `export PATH=...` to ~/.bash_profile (rustup did), where
# it silently outranks every PATH decision made in tier 1. The selftest
# catches that at Claude session start; this catches it at the very next
# interactive shell, loudly. Zero subprocesses on the happy path: $(<file)
# is a bash builtin read, so the compare costs two small file reads (<1ms).
# The diff/printf work only runs after a real mismatch. After a DELIBERATE
# edit to ~/.bash_profile, re-bless it with:
#     cp ~/.bash_profile ~/.config/bash/bash_profile.expected
if [[ -r ~/.config/bash/bash_profile.expected ]] &&
   [[ ! -r ~/.bash_profile ||
      "$(<~/.bash_profile)" != "$(<~/.config/bash/bash_profile.expected)" ]]; then
  {
    printf '\a\033[1;41;97m %s \033[0m\n' \
      '!!  ~/.bash_profile CHANGED from its blessed state  !!'
    printf '\033[1;31m%s\033[0m\n' \
      '  something (an installer?) edited the deliberately-stub profile.' \
      '  diff vs blessed copy (~/.config/bash/bash_profile.expected):'
    diff ~/.config/bash/bash_profile.expected ~/.bash_profile 2>&1 | sed 's/^/    /'
    printf '\033[1;31m%s\033[0m\n' \
      '  if intentional:  cp ~/.bash_profile ~/.config/bash/bash_profile.expected' \
      '  otherwise: revert it (see the WATCH OUT note in that file).'
  } >&2
fi

# -- ~/.bashrc tamper alarm (self-referential) -----------------------------
# Same blessed-copy idea as above, but interactive: on drift, a HUMAN shell
# gets the selftest verdict for the changed config, a pretty diff, and a
# [LATER/accept/revert] prompt (Enter = LATER; only the full word,
# case-insensitive, is accepted; 120s timeout = LATER).
#
# Two hard constraints shape the gating below:
#   * selftest.sh spawns `bash -i` shells that source this very file; if
#     those ran the full alarm they would run selftest again -> infinite
#     recursion. `env -i` wipes any guard variable, so the human-shell test
#     (tty stdin/stderr and no BASH_EXECUTION_STRING, i.e. not `bash -ic
#     '...'`) is what breaks the loop -- selftest's shells all use -c.
#   * The same test keeps Orca/herdr pane launches and other automation
#     from blocking on a prompt they can never answer. Orca/herdr panes DO
#     allocate a tty, so a bare interactive shell in one would otherwise
#     look human and hold the pane launch at the prompt for up to 120s;
#     ORCA_PANE_KEY / HERDR_PANE_ID identify those panes and demote them to
#     the one-line warning. Resolve drift from a plain terminal (Ghostty,
#     Terminal.app, ssh).
# Happy path stays fork-free: $(<file) is a builtin read (~0.2ms).
# /bin/bash 3.2 also parses this (selftest clean shells): keep it bash3-safe
# (no ${var,,}, no arrays) and pure ASCII.
__bashrc_tamper_alarm() {
  local expected="$HOME/.config/bash/bashrc.expected" current="$HOME/.bashrc"
  [ -r "$expected" ] && [ -r "$current" ] || return 0
  [[ "$(<"$current")" == "$(<"$expected")" ]] && return 0

  if [[ ! -t 0 || ! -t 2 || -n ${BASH_EXECUTION_STRING-} ||
        -n ${ORCA_PANE_KEY-} || -n ${HERDR_PANE_ID-} ]]; then
    printf 'WARNING: ~/.bashrc differs from its blessed copy -- resolve in a plain terminal (not an Orca/herdr pane)\n' >&2
    return 0
  fi

  {
    printf '\a\033[1;41;97m %s \033[0m\n' \
      '!!  ~/.bashrc CHANGED from its blessed state  !!'
    printf '  checking the changed config with ~/.config/bash/selftest.sh ...\n'
    if "$HOME/.config/bash/selftest.sh" >/dev/null 2>&1; then
      printf '  the changed config \033[1;42;97m PASSES \033[0m the self-test\n'
    else
      printf '  the changed config \033[1;41;97m FAILS \033[0m the self-test (run it for details)\n'
    fi
    printf '  diff (blessed -> current):\n'
    if command -v git >/dev/null 2>&1 && command -v delta >/dev/null 2>&1; then
      git --no-pager diff --no-index -- "$expected" "$current" 2>/dev/null \
        | delta --paging=never 2>/dev/null
    elif command -v git >/dev/null 2>&1; then
      git --no-pager diff --no-index --color=always -- "$expected" "$current" \
        | tail -n +5 | sed 's/^/    /'
    else
      diff -u "$expected" "$current" | tail -n +3 | sed 's/^/    /'
    fi
  } >&2

  local ans
  while :; do
    printf '\033[1m  Keep this change? [LATER/accept/revert] (Enter = LATER): \033[0m' >&2
    if ! read -r -t 120 ans; then
      printf '\n  no answer -- LATER (will ask again in the next interactive shell)\n' >&2
      return 0
    fi
    case "$ans" in
      ""|[Ll][Aa][Tt][Ee][Rr])
        printf '  LATER -- will ask again in the next interactive shell\n' >&2
        return 0 ;;
      [Aa][Cc][Cc][Ee][Pp][Tt])
        cp "$current" "$expected" \
          && printf '  accepted -- blessed copy updated\n' >&2 \
          || printf '  ERROR: could not update %s\n' "$expected" >&2
        return 0 ;;
      [Rr][Ee][Vv][Ee][Rr][Tt])
        local qdir="$HOME/.config/bash/quarantine" stamp
        stamp=$(date +%Y%m%d-%H%M%S)
        if mkdir -p "$qdir" \
           && cp "$current" "$qdir/bashrc.rejected.$stamp" \
           && cp "$expected" "$current"; then
          printf '  reverted -- rejected version saved to %s\n' \
            "$qdir/bashrc.rejected.$stamp" >&2
          printf '  NOTE: this shell already sourced the rejected version; run: exec bash\n' >&2
        else
          printf '  ERROR: revert failed -- ~/.bashrc left untouched\n' >&2
        fi
        return 0 ;;
      *)
        printf '  type the full word (later / accept / revert) or press Enter\n' >&2 ;;
    esac
  done
}
__bashrc_tamper_alarm

