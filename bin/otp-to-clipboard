#!/usr/bin/env python3
"""otp-to-clipboard — copy one-time codes from macOS notifications to the clipboard.

Two sources, one extractor. FAST: macOS/otp-to-clipboard/otp-banner-watch reads
banners from Notification Center's accessibility tree (~0.25 s tick) and pipes
each to `--text`. FALLBACK (this daemon): polls the usernoted database, which
lags the banner by ~8 s but also catches notifications that never show a banner
(Focus/DND) and needs Full Disk Access. Both cover notifications from ANY app (incl. iPhone-mirrored SMS, Mail, Slack, web
push), pulls a verification code out of the title/body, and puts it on the
pasteboard marked org.nspasteboard.ConcealedType so clipboard managers and
Tahoe's clipboard history skip it. Prior art: Otifier (closed app),
MessAuto (Messages/Mail only), notifwd (same DB trick).

  otp-to-clipboard             run the watcher (what the LaunchAgent does)
  otp-to-clipboard --selftest  check the extractor against sample texts
  otp-to-clipboard --text [--app NAME]  read one notification's text on stdin (used by the
                               push watcher otp-banner-watch, which reads banners
                               via the Accessibility API the instant they appear)
  otp-to-clipboard --once N    scan the newest N rows, print app + whether a
                               code was found (never the code), copy nothing

DB: ~/Library/Group Containers/group.com.apple.usernoted/db2/db — needs Full
Disk Access for whatever process runs this (grant it to the interpreter the
LaunchAgent uses). Rows: record.data is a binary plist; req.titl/subt/body.
Log: ~/Library/Logs/otp-to-clipboard.log — records app + code length, never
the code. State: ~/.local/state/otp-to-clipboard/last_id.
Env: OTP_POLL (seconds, default 1).
"""
import os, plistlib, re, sqlite3, subprocess, sys, time

DB = os.path.expanduser("~/Library/Group Containers/group.com.apple.usernoted/db2/db")
STATE = os.path.expanduser("~/.local/state/otp-to-clipboard/last_id")
LOG = os.path.expanduser("~/Library/Logs/otp-to-clipboard.log")
POLL = float(os.environ.get("OTP_POLL", "1"))

# --- extraction -----------------------------------------------------------
# Two stages (idea from Otifier): find keyword spans and candidate spans, take
# the best candidate near a keyword. Plus 2FHey's multilingual keywords and
# alphanumeric codes, and Otifier's rejects (masked card tails, money, order
# numbers, repeated digits, "Code review ... PR 4412").
STRONG = re.compile(
    r"verification|verify|one[- ]?time|single[- ]?use|\botp\b|passcode|pass code|\b2fa\b|\bmfa\b|"
    r"security code|auth(?:entication)? code|confirmation code|login code|sign-?in code|"
    r"vérification|verification|c[óo]digo de|codice|bestätigung|verifizierung|sicherheitscode|"
    r"验证码|驗證碼|校验码|动态码|安全码|認証|認証コード|コード|인증|код подтверждения|doğrulama|"
    r"\bpin\b", re.I)
WEAK = re.compile(r"\bcode\b|\bauth\b|\baccess\b|\blogin\b|\blog-in\b|sign-?in|\bcodigo\b|\bcodice\b|\bkod\b|\bcode d", re.I)
NEGATIVE = re.compile(
    r"\border\b|tracking|invoice|receipt|shipping|transaction|\bpayment\b|balance|\bphone\b|appointment|"
    r"\baddress\b|zip code|promo|coupon|discount|\bdelivery\b|reservation", re.I)
# words just before a digit run that make it NOT an OTP
PREFIX_REJECT = re.compile(
    r"(?:\bending(?:\s+in)?|\baccount(?:\s+(?:number|no\.?|#))?|\bcard|\border|\btracking|\binvoice|\bphone|"
    r"\bzip|\bappointment|\bamount|\bPR|\bissue|\bticket|\bcommit|\bline|[\$€£#])[^A-Za-z0-9]{0,5}$", re.I)
VETO = re.compile(r"review|\bPR\b|pull|issue|ticket|request|commit", re.I)
CAND = re.compile(
    r"(?<![A-Za-z0-9.$€£#:/-])(?:"
    r"G-\d{4,8}"                                   # Google
    r"|\d{3}[- ]\d{3,4}"                             # 123-456 / 123 456
    r"|\d{4,8}"                                     # plain
    r"|(?=[A-Z0-9-]*\d)(?=[A-Z0-9-]*[A-Z])[A-Z0-9]{3}-?[A-Z0-9]{3,5}"  # ABC123 / X7Y-9Z2
    r")(?![A-Za-z0-9]|[.,]\d|\s?%|:\d)")
FILLER = re.compile(r"^[\s:：=\-—–,.\"'“”‘’()\[\]【】「」]*(?:(?:is|are|was|es|est|ist|lautet|é|是|为|为：|:)[\s:：]*)?$", re.I)
PROX = 60


def extract(text):
    """Return the most plausible OTP in text, or None."""
    if not text:
        return None
    strong = list(STRONG.finditer(text))
    kws = strong + list(WEAK.finditer(text))
    if not kws:
        return None
    neg = bool(NEGATIVE.search(text)) and not strong
    best = None  # (rank, code)
    for m in CAND.finditer(text):
        code = m.group(0)
        digits = re.sub(r"\D", "", code)
        if digits and len(set(digits)) == 1 and len(digits) == len(code.replace("G-", "")):
            continue                                   # all one digit
        if PREFIX_REJECT.search(text[max(0, m.start() - 25):m.start()]):
            continue
        # distance to nearest keyword, and whether it is directly adjacent
        rank = None
        for k in kws:
            if m.start() >= k.end():
                gap = text[k.end():m.start()]
                if len(gap) > PROX or VETO.search(gap):
                    continue
                adj = len(gap) <= 25 and "\n" not in gap.strip()
                r = (0 if adj else 2, len(gap))
            elif k.start() >= m.end():
                gap = text[m.end():k.start()]
                if len(gap) > PROX or VETO.search(gap):
                    continue
                r = (1 if re.match(r"\s*(?:is|es|est|ist|as|=|:)?\s*(?:your|the|ur|tu|votre|ihr|my|this|su)\b", gap, re.I) else 3, len(gap))
            else:
                r = (0, 0)
            rank = r if rank is None or r < rank else rank
        if rank is None:
            continue
        if code.startswith("G-"):
            rank = (-1, 0)
        elif re.search(r"[A-Z]", code) and not re.search(r"\d", code):
            continue
        elif re.search(r"[A-Z]", code) and rank[0] > 1:
            continue                                   # alphanumeric needs adjacency
        if best is None or rank < best[0]:
            best = (rank, code)
    if best and neg and best[0][0] != 0:
        return None                                    # order/receipt text, code not right after a keyword
    return best[1].strip() if best else None


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(time.strftime("%F %T ") + msg + "\n")
    except OSError:
        pass


def copy(code):
    """Pasteboard write flagged concealed; fall back to clip."""
    js = ("ObjC.import('AppKit');var p=$.NSPasteboard.generalPasteboard;"
          "p.clearContents;var t=$.NSString.alloc.initWithUTF8String(ObjC.unwrap($.NSProcessInfo.processInfo.environment.objectForKey('OTP_CODE')));"
          "p.declareTypesOwner(['public.utf8-plain-text','org.nspasteboard.ConcealedType'],null);"
          "p.setStringForType(t,'public.utf8-plain-text');p.setStringForType($(''),'org.nspasteboard.ConcealedType');")
    env = dict(os.environ, OTP_CODE=code)
    try:
        r = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", js], env=env,
                           capture_output=True, timeout=5)
        if r.returncode == 0:
            return "concealed"
    except subprocess.SubprocessError:
        pass
    try:
        r = subprocess.run([os.path.expanduser("~/ops/site-private/bin/clip"), "-q"],
                           input=code.encode(), capture_output=True, timeout=10)
        return "clip" if r.returncode == 0 else "FAILED"
    except subprocess.SubprocessError:
        return "FAILED"


SEEN = os.path.expanduser("~/.local/state/otp-to-clipboard/last_copied")


def handle(text, source):
    """Extract, dedupe across the DB and banner paths (same code within 30 s: the DB row lands ~6 s after the banner), copy."""
    code = extract(text)
    if not code:
        return
    try:
        prev_code, prev_t = open(SEEN).read().split()
        if prev_code == code and time.time() - float(prev_t) < 30:
            return
    except (OSError, ValueError):
        pass
    how = copy(code)
    os.makedirs(os.path.dirname(SEEN), exist_ok=True)
    open(SEEN, "w").write("%s %f" % (code, time.time()))
    log("copied code (len %d) via %s [%s]" % (len(code), source, how))


def rows(con, after_id, limit=None):
    q = "select r.rec_id, a.identifier, r.data from record r left join app a on a.app_id=r.app_id where r.rec_id>? order by r.rec_id"
    cur = con.execute(q, (after_id,))
    for rec_id, app, data in (cur.fetchmany(limit) if limit else cur):
        try:
            req = plistlib.loads(data).get("req", {})
        except Exception:
            req = {}
        yield rec_id, app or "?", " \n".join(str(req.get(k, "")) for k in ("titl", "subt", "body"))


def connect():
    return sqlite3.connect("file:%s?mode=ro" % DB, uri=True, timeout=5)


def selftest():
    cases = [
        ("Your verification code is 482913", "482913"),
        ("482913 is your Google verification code.", "482913"),
        ("G-482913 is your Google verification code", "G-482913"),
        ("Use code 7391 to sign in to Venmo", "7391"),
        ("Your Amazon OTP is 123456. Do not share it.", "123456"),
        ("Security code: 123-456", "123-456"),
        ("Your Uber code is 4821", "4821"),
        ("Código de verificación: 884102", "884102"),
        ("您的验证码是 552031", "552031"),
        ("Login code\n739 201", "739 201"),
        ("Your order #12345678 shipped", None),
        ("Meet at 10:30 on 2026-10-06", None),
        ("Your balance is $1234.56", None),
        ("Code review requested on PR 4412", None),
        ("Your code is ready", None),
        ("Your code for order 4417 is 882013", "882013"),
        ("Your verification code for order #55123 is 604412", "604412"),
        ("Your order 884412 has shipped. Track with code ABC", None),
        ("Card ending in 43001 was used for $12481.16", None),
        ("Your code is 111111", None),
        ("Your Amazon code is 000000. Security code expires soon", None),
        ("【Alipay】验证码123456，请勿泄露", "123456"),
        ("Dein Bestätigungscode lautet 904412", "904412"),
        ("Votre code de vérification est 330918", "330918"),
        ("Your code is X7Y9Z2", "X7Y9Z2"),
        ("Use ABC-123 as your login code", "ABC-123"),
        ("Verification code: 4821 (valid 10 min). Call 5551234 for help", "4821"),
        ("2FA: 55 21 77", None),
        ("Chase: your one-time code is 774519. Never share it.", "774519"),
        ("Your Apple ID Code is: 847 291. Don't share it with anyone.", "847 291"),
        ("Hi! Your PIN is 4821", "4821"),
        ("You have 3 new messages, verification pending", None),
        ("Delivery code 7781 for your package", "7781"),
        ("Zoom: 123456 is your Zoom verification code", "123456"),
        ("Meeting ID 987654321 passcode 112233", "112233"),
    ]
    bad = 0
    for text, want in cases:
        got = extract(text)
        flag = "ok " if got == want else "BAD"
        bad += got != want
        print(flag, repr(text), "->", got)
    sys.exit(1 if bad else 0)


def main():
    if "--selftest" in sys.argv:
        selftest()
    if "--text" in sys.argv:
        app = sys.argv[sys.argv.index("--app") + 1] if "--app" in sys.argv else "?"
        handle(sys.stdin.read(), "banner:" + app)
        return
    if "--once" in sys.argv:
        con = connect()
        n = int(sys.argv[sys.argv.index("--once") + 1])
        top = con.execute("select max(rec_id) from record").fetchone()[0] or 0
        for rec_id, app, text in rows(con, max(0, top - n)):
            code = extract(text)
            print(rec_id, app, "CODE(len %d)" % len(code) if code else "-")
        return
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    con, warned = None, False
    while con is None:  # no Full Disk Access yet, or the post-login TCC race: keep trying
        try:
            con = connect()
            con.execute("select 1 from record limit 1")
        except sqlite3.Error as e:
            con = None
            if not warned:
                log("cannot read notification DB (%s); needs Full Disk Access for %s" % (e, sys.executable))
                warned = True
            time.sleep(30)
    try:  # resume after a quick restart only; never replay old notifications into the clipboard
        if time.time() - os.path.getmtime(STATE) > 120:
            raise ValueError("stale")
        last = int(open(STATE).read().strip())
    except (OSError, ValueError):
        last = con.execute("select coalesce(max(rec_id),0) from record").fetchone()[0]
    log("started at rec_id %d" % last)
    while True:
        try:
            for rec_id, app, text in rows(con, last):
                last = rec_id
                handle(text, "db:" + app)
            open(STATE, "w").write(str(last))
        except Exception as e:  # never let one bad row or copy kill the watcher
            log("loop error: %s: %s" % (type(e).__name__, e))
            try:
                con.close()
                con = connect()
            except sqlite3.Error:
                pass
        time.sleep(POLL)


if __name__ == "__main__":
    main()
