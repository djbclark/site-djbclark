#!/usr/bin/env bash
# bg-offload — run a build or test command on CI instead of this Mac, and report CI's verdict (bg's helper,
# 2026-10-23; builds and full suites since 2026-11-01).
#
#   bg-offload --probe TOP            exit 0 when TOP has a runnable CI route (bg asks once, up front); on exit
#                                     != 0 prints one line, `bg: offload: <why there is no route>`, on stderr
#   bg-offload TOP -- CMD [ARGS...]   run the repo's CI route on TOP's HEAD (which must already be on the
#                                     remote), wait, print the result; CMD is only used to name the run and to
#                                     check the test paths it names (CI cannot see a path that is missing,
#                                     untracked or outside the repo)
#
# What bg offloads (repos recorded `ci` by load-watch ci):
#   - a build or full suite (not a targeted test run, not a release): at once, before the load gate and without a
#     slot (djbclark, 2026-11-01: "route builds to github ci for public repo linux and macos builds, or forgejo
#     for private repo linux builds"; the 16 GB Mac is memory-starved). No route: bg refuses (exit 3) as before;
#   - a targeted test run: only when bg's load gate has held it past BG_OFFLOAD_AFTER seconds (2026-10-23: a 2 s
#     pytest file sat over an hour in the gate).
# bg never execs the command after an offload, and exits with the verdict below.
#
# Routes (the `load-watch ci` text is free text of many shapes and is never executed; an untracked or ignored script
# in the repo is never used: it is not public code, and what it pushes is what this helper vouches for):
#   (1) a TRACKED, executable scripts/bg-offload-run in the repo top, (2) a tracked scripts/github-ci-run. Both are
#       called as `RUNNER --no-wait REF` from the repo top with GITHUB_CI_REMOTE set to the CI remote, and must push
#       the run and print two lines on stdout, which scripts/github-ci-run already does:
#         overlay <40-hex commit that the CI run builds> for <ref sha> -> <remote> <branch>
#         pushed https://github.com/<owner>/<repo>/tree/<branch>    (ShizukuTendCF prints `branch: https://...`
#                                                                     instead; both are accepted)
#       The OWNER/REPO printed must be the CI remote's own github.com repo (a trailing / is ignored), and this helper
#       polls that repo for the verdict (below). A repo with a faster route than the whole CI workflow may ship its
#       own scripts/bg-offload-run with the same contract.
#   (3) Forgejo: a tracked, executable scripts/forgejo-ci-run opts the repo in; this helper does not run it
#       (adversary F3, 2026-11-01: herdr's pushes whatever HEAD is when it runs, not the commit checked here). It
#       notes the newest Actions run id of the Forgejo repo (forgejo-api GET /repos/O/R/actions/runs; a body that is
#       not a run list is unreadable, r3 F6), pushes the checked commit itself, `git-forgejo push
#       --force-with-lease=refs/heads/ci-run:<value check (b) saw> --no-follow-tags --no-recurse-submodules forgejo
#       <sha>:refs/heads/ci-run` (a lease failure means another session moved ci-run: exit 69, nothing overwritten; r3
#       F3), then polls the run list until every run NEWER than that id, of that commit, on ci-run, has finished (N2:
#       never another branch's run or an older one). When ci-run already holds the commit, a push would start no run:
#       if a run of it on ci-run is still going (another session's push), that run is followed; otherwise ci-run is
#       deleted (with the same lease) and pushed again (N2, r3 F3). The `forgejo` remote must be one url on a Forgejo
#       host the forgejo skill uses (git-forgejo defaults to forgejo.mit.edu and no other host is configured, so the
#       list is just forgejo.mit.edu); git-forgejo and forgejo-api must be tracked and unmodified in their checkout,
#       and jq present; both run with FORGEJO_HOST set to that host and FORGEJO_GIT_USER / FORGEJO_TOKEN_VAR unset
#       (N6). Because sudo-secretspec may drop GIT_CONFIG_PARAMETERS and GIT_GRAFT_FILE on the way to git-forgejo's
#       git (F4, N9), a repo whose config sets push.followTags or submodule.recurse true, or push.recurseSubmodules to
#       anything but `no`, or that has replace refs or a default info/grafts file, is refused. The publish checks below
#       ask the `forgejo` remote, through git-forgejo (its token reaches a private repo). When Forgejo cannot run the
#       build (git-forgejo or the API fails, the push fails, no run of the push appears within BG_OFFLOAD_APPEAR, or no
#       runner takes it within BG_OFFLOAD_APPEAR: every run still waiting/blocked, r3 F4) it prints `bg: FORGEJO
#       UNREACHABLE: <why>` and the line "fix Forgejo (forgejo / forgejo-ci skills); if you cannot, notify djbclark
#       (hermes-ping) and keep doing work that is not blocked", and exits 69. A timeout there names the local secret
#       broker too (git-forgejo and forgejo-api go through sudo-secretspec), and route (3)'s ls-remote gets at least
#       150 s, past git-forgejo's ~121 s of broker retries (r3 F5).
#   (4) generic GitHub: no tracked runner, but the CI remote is a github.com repo whose ci/base branch (asked with
#       `git ls-remote`, then fetched into refs/remotes/<remote>/ci/base when that copy is missing or stale and no
#       local ci/base exists; a fetch publishes nothing, and one that loses a ref lock to a concurrent bg is fine if
#       the ref is right afterwards, else retried once within the same BG_OFFLOAD_FETCH_TIMEOUT) holds
#       .github/workflows/agent-ci.yml or linux-ci.yml with a push trigger on ci/run/**. The repo must be djbclark's,
#       or one gh reports ADMIN on, or the remote must be named explicitly in git config bgoffload.remote (F12: no
#       ci/run branches pushed to other people's repos). The runner is ~/src/djbclark-ade/scripts/github-ci-run (same
#       contract as (2)), which must be tracked and unmodified in that checkout (F5; BG_OFFLOAD_GENERIC_RUNNER
#       replaces it in tests only).
# Order, by the CI remote's GitHub visibility (`gh repo view OWNER/REPO --json isPrivate`; djbclark 2026-11-01, herdr
# included, no exception):
#   public    (1), else (2), else (4); (3) only when the repo has none of those.
#   private   (3) ONLY. GitHub is never used for a private repo, Linux or macOS. No forgejo-ci-run, or a route (3) that
#             fails its checks: no route, reason `private repo has no Forgejo route: <why>`; bg refuses the build
#             (exit 3) with that as its first line and the fix-Forgejo line above.
#   unknown   (gh failed) no route for this run; bg does not guess either way.
#   not on GitHub (the CI remote is not a github.com repo): (3) only.
#   Two known ways a PUBLIC repo lands on Forgejo outside the letter of the ruling (adversary r3 F8, left as is: neither
#   publishes anything new, check (b) still asks forgejo): a transient failure inside route (4) (its ls-remote, ci/base
#   fetch or ADMIN gh call) falls through to (3) for that run; and a github.com remote behind an SSH host alias
#   (`github-work:o/r`) is not recognised as GitHub, so it gets (3) only.
#   gh is always asked about github.com: an inherited GH_HOST/GH_REPO is dropped (r3 F1). A CI remote chosen only by
#   an inherited $GITHUB_CI_REMOTE gets route (4)'s owner/ADMIN check on routes (1) and (2) too (r3 F7).
# This replaces the round-1 guard that read the workflows for macOS labels: a private repo never reaches GitHub, a
# public one may use any runner, so nothing in the workflows decides a route (adversary N1, N4).
# The CI remote of routes (1), (2) and (4): git config bgoffload.remote in the repo, else $GITHUB_CI_REMOTE, else
# origin (a fork whose origin is upstream sets `git config bgoffload.remote <fork remote>`; upstream never has
# djbclark's ci/base, so (4) never pushes there). Its (first) fetch url names the GitHub repo whose visibility is
# asked; check (b) below refuses unless that url is also its one push url. Route (3) always uses `forgejo`.
# A linked git worktree (.git is a file) has no route: github-ci-run sets GIT_DIR=$top/.git. No route, no gh, no
# GNU tool, nothing publishable (see below): this helper says so and exits 69; bg then refuses a build (exit 3) or
# goes on waiting at the gate with a targeted run, as it always did.
# Probe cost (F9, N8): reads of ci/base's workflow blobs never lazy-fetch without a bound (a partial clone's missing
# blobs are fetched first, within BG_OFFLOAD_FETCH_TIMEOUT); a timeout knob of 0 or junk means its default; and a
# --probe's answer is cached in ~/.local/state/bg-offload/probe-cache, a route for BG_OFFLOAD_PROBE_TTL seconds (300;
# 0 = off, the default with BG_OFFLOAD_TESTING=1), "no route" for at most 60 s, keyed on the repo, the CI and forgejo
# remotes and urls, HEAD, the local ci/base copies, the route scripts, the push/submodule config and the hooks in
# effect. An answer that came from a failed ls-remote, fetch or gh call is not cached. The full offload never uses
# the cache.
#
# What may be offloaded (adversary reviews of c7cab20 to 2d037f7, 2026-10-23, and djbclark's ruling that followed:
# bg-offload publishes NOTHING that is not already on the remote; six review rounds, the first three on scanning
# what would be pushed, so there is no scan and no opt-in): all of
#   (a) no tracked file is modified, in the working tree or the index (`git status --porcelain
#       --untracked-files=no`; untracked files never travel and never block, they are listed). A tracked file
#       marked --assume-unchanged or --skip-worktree and edited shows as clean: CI then tests HEAD's copy;
#   (b) the push target is asked, not guessed from local remote-tracking refs (which go stale after a `set-url`, a
#       remote branch deleted by another clone, or a separate pushurl): the remote's fetch url and push url
#       (`git remote get-url [--push] --all $remote`, remote = the CI remote above, the name the runner pushes to)
#       must be the same single url, and `git ls-remote --refs $remote` (60 s, BatchMode, no prompt; any
#       failure refuses; route (3) asks through the forgejo skill's git-forgejo, which supplies the token) lists
#       the refs there. It is asked by NAME, as the runner's `git push $remote` resolves it:
#       the url get-url prints is already rewritten by url.*.insteadOf, and handing that string to ls-remote would
#       rewrite it a second time, to a repository the push never goes to (adversary round 5). Every commit of HEAD
#       must be reachable from one of the advertised refs (`git rev-list --count HEAD --stdin` with those tips
#       excluded is 0);
#   (c) the ref the runner overlays, local refs/heads/ci/base (else refs/remotes/$remote/ci/base), is reachable
#       from those same advertised refs too (it is published content). It may be behind or level with the
#       remote's ci/base, and a stale remote-tracking copy no longer on the remote fails this check.
# The history walked is the real one, for the checks and the runner's push alike: GIT_NO_REPLACE_OBJECTS=1 is
# exported for the whole helper (a `git replace` of a public commit by one with a private parent would hide that
# parent from rev-list while the push sends it), and a graft file (info/grafts or $GIT_GRAFT_FILE, which that
# variable does not turn off) refuses. GIT_NO_LAZY_FETCH=1 is set on the reachability checks only (cat-file of the
# advertised tips, rev-list, log): a partial clone never fetches an advertised tip it lacks; such a tip is just not an
# exclusion. It is NOT passed to the runner (adversary round 6: it made github-ci-run's `cat-file -e ci/base:PATH`
# fail in a blob:none clone, the overlay was skipped without a word and CI's PASS was for HEAD's own workflow).
# Instead, before the runner, every object of HEAD's tree and of the overlaid ci/base tree must be here: missing ones
# (a partial clone) are fetched (a fetch publishes nothing; BG_OFFLOAD_FETCH_TIMEOUT, 300 s), and any still missing
# refuses, so a runner that skips what it cannot read never builds a run without the overlay.
# If any fails: one line per reason (dirty files capped, N unpushed commits, ci/base commits not on the remote, url
# mismatch, ls-remote failure, grafts, objects missing from a partial clone), nothing is pushed or built, exit 69, and
# bg refuses a build (exit 3) or keeps waiting at the gate with a targeted run, as before. The dev flow: commit and
# push, then bg offloads. These checks hold for all four routes, against the remote the route pushes to. The runner is then
# called on HEAD itself with git config forced from the environment (push.followTags=false and
# push.recurseSubmodules=no appended to GIT_CONFIG_PARAMETERS, which git reads after every config file and after
# GIT_CONFIG_COUNT/KEY/VALUE, so neither the user's config nor a caller's environment can make its `git push` carry
# tags or submodule commits), and the only thing it pushes is the CI overlay branch: HEAD's tree, the ci/base overlay
# and .ci-target-sha. "HEAD's tree" holds up to the repo's own filters: github-ci-run checks the tree out and re-adds
# it, so a smudge filter whose clean is not its inverse would publish the smudged text (adversary round 6, P3;
# git-crypt, LFS and nbstripout round-trip). That is the runner's code, tracked in each repo, not this helper's.
# A named test path that does not exist, is untracked or git-ignored, is a directory with no tracked file, or
# resolves outside the repo top also exits 69 (pytest/unittest arguments that look like paths: end in .py,
# contain `/` or `::`, or are directories; a unittest dotted id is not checked).
#
# Budget: the offload has its own budget, not BG_MAX_WAIT: up to BG_OFFLOAD_PUSH_TIMEOUT (900 s) for the runner or
# route (3)'s push, plus BG_OFFLOAD_WAIT (2400 s) for CI, after the hold that triggered it, if any. bg's own ping is
# not sent for it.
#
# The wait is ours, not the runner's (github-ci-run's own wait gives up at 480 s and a full Linux CI run of
# sudo-secretspec takes longer): for routes (1), (2), (4) the runner is started with --no-wait, then this polls `gh
# run list -R OWNER/REPO` (always -R: gh in some checkouts resolves to an upstream remote) for the runs whose head is
# the pushed commit until all are completed, up to BG_OFFLOAD_WAIT seconds (default 2400). Route (3) polls Forgejo's
# run list the same way (above).
#
# Artifacts (2026-11-01; F10): after a GitHub verdict of success, each successful run's artifacts are downloaded with
# `gh run download RUN -R OWNER/REPO` into a temporary directory beside ~/.local/state/bg-offload/artifacts/
# OWNER__REPO/RUN/, then moved there (replacing an earlier download of the same run), bounded by
# BG_OFFLOAD_ARTIFACT_TIMEOUT (600 s), and the path is printed. A failed download (or a run with no artifacts) is a
# warning naming that path; the verdict stays 0. Downloads older than 7 days, and all but the newest 20 per repo, are
# pruned. BG_OFFLOAD_ARTIFACTS=0 skips it. Route (3) has no download.
#
# Exit codes (bg 3 = refused CI-first and 75 = wait budget keep their meaning; neither is used here):
#   0   at least one CI run concluded success and none failed: "CI's workflow passed on this tree". It does NOT
#       mean the test the caller named passed on its own: CI ran the repo's whole workflow
#   1   a CI run concluded failure: the failed-step (GitHub) or job (Forgejo) log tail is printed
#   69  not offloaded (no route: none tracked, a private repo without a usable Forgejo route, visibility unreadable;
#       no gh or GNU tool, a tracked change, an unpushed commit, ci/base commits not on the remote, an unverifiable
#       push target, a named test path CI cannot see, a --no-wait runner that failed: it may have pushed before
#       failing, but no run is followed; or FORGEJO UNREACHABLE: route (3)'s git-forgejo or API failed, its push
#       failed, or no run of its push appeared): bg refuses a build (exit 3), or falls back to waiting at the gate
#       with a targeted run
#   76  CI did not finish within BG_OFFLOAD_WAIT; the run is still going, its URL is printed
#   77  pushed, but no verdict: no GitHub run appeared, gh or the Forgejo API kept failing after a run was seen,
#       every run was skipped/neutral, a run was cancelled/timed out, or the runner's printed repo is not the CI
#       remote's
# Test hooks, honoured ONLY with BG_OFFLOAD_TESTING=1 (an inherited BG_GH or BG_OFFLOAD_RUNNER must not redirect a
# real run): BG_GH (gh binary), BG_OFFLOAD_RUNNER (route, treated as route (2)), BG_OFFLOAD_TOOLS_EXTRA (more
# required tools), BG_OFFLOAD_GIT_FORGEJO (git-forgejo), BG_OFFLOAD_FORGEJO_API (forgejo-api),
# BG_OFFLOAD_GENERIC_RUNNER (route (4)'s runner), BG_OFFLOAD_URL_ALIAS ("LOCAL HTTPS[;LOCAL HTTPS...]": a remote whose
# url is LOCAL, a local path or file:// url, counts as HTTPS for the github.com / Forgejo host checks, so a local
# bare repository can stand in). Knobs: BG_OFFLOAD_POLL (poll seconds, default 20), BG_OFFLOAD_APPEAR (seconds to
# wait for the run to show up, default 240), the timeouts named above, BG_OFFLOAD_PROBE_TTL.
export PATH="/opt/homebrew/bin:$PATH"
export GIT_NO_REPLACE_OBJECTS=1  # header: the real history, for the checks and the runner's push
ade="$HOME/src/djbclark-ade"
git_forgejo_default="$ade/skills/forgejo/scripts/git-forgejo"
fj_api_default="$ade/skills/forgejo/scripts/forgejo-api"
generic_default="$ade/scripts/github-ci-run"
if [ "${BG_OFFLOAD_TESTING:-0}" = 1 ]; then
  gh_bin="${BG_GH:-gh}"; runner_override="${BG_OFFLOAD_RUNNER:-}"
  git_forgejo="${BG_OFFLOAD_GIT_FORGEJO:-$git_forgejo_default}"; fj_api="${BG_OFFLOAD_FORGEJO_API:-$fj_api_default}"
  generic_runner="${BG_OFFLOAD_GENERIC_RUNNER:-$generic_default}"; url_alias="${BG_OFFLOAD_URL_ALIAS:-}"
  probe_ttl_default=0
else
  gh_bin=gh; runner_override=""; git_forgejo="$git_forgejo_default"; fj_api="$fj_api_default"
  generic_runner="$generic_default"; url_alias=""; probe_ttl_default=300
fi
forgejo_hosts="forgejo.mit.edu"  # header, route (3): the hosts the forgejo skill's git-forgejo is set up for
poll="${BG_OFFLOAD_POLL:-20}"
# knob NAME DEFAULT: a positive whole number of seconds; unset, 0 or junk is DEFAULT (gtimeout 0 would be no limit).
knob() {
  local v="${!1:-}"
  case "$v" in ""|*[!0-9]*) echo "$2"; return ;; esac
  v=$((10#$v)); [ "$v" -gt 0 ] && echo "$v" || echo "$2"
}
t_lsremote=$(knob BG_OFFLOAD_LSREMOTE_TIMEOUT 60); t_fetch=$(knob BG_OFFLOAD_FETCH_TIMEOUT 300)
t_push=$(knob BG_OFFLOAD_PUSH_TIMEOUT 900); t_wait=$(knob BG_OFFLOAD_WAIT 2400); t_art=$(knob BG_OFFLOAD_ARTIFACT_TIMEOUT 600)
t_appear=$(knob BG_OFFLOAD_APPEAR 240)
probe_ttl="${BG_OFFLOAD_PROBE_TTL:-$probe_ttl_default}"; case "$probe_ttl" in ""|*[!0-9]*) probe_ttl=0 ;; esac
# Every git that talks to a remote here (ls-remote, fetch) must fail rather than prompt.
[ -n "${GIT_SSH_COMMAND:-}" ] || export GIT_SSH_COMMAND="ssh -o BatchMode=yes"
export GIT_TERMINAL_PROMPT=0
# The forgejo skill's scripts take their host, user and token variable from the environment (adversary N6): an
# inherited FORGEJO_HOST would hand another host's token to the checked host's prompt. Route (3) sets the host itself.
unset FORGEJO_HOST FORGEJO_GIT_USER FORGEJO_TOKEN_VAR
# The same for gh (adversary r3 F1): an inherited GH_HOST would ask another host whether OWNER/REPO is private, and
# poll it, while the push goes to github.com. Every gh call here names OWNER/REPO, on github.com.
unset GH_HOST GH_REPO

say() { echo "bg: $*" >&2; }
# redact: drop user:password@ from urls in a message
redact() { gsed -E 's#//[^/@ ]*@#//#g'; }

# Every tool this helper uses must exist: a missing one must refuse, never be swallowed (a missing GNU grep once made
# the dirty-tree check pass without checking).
need_tools="git gawk gsed gtimeout greadlink gmktemp ghead gtail gwc gdate gtr gfind gsort gsha256sum"
[ "${BG_OFFLOAD_TESTING:-0}" = 1 ] && need_tools="$need_tools ${BG_OFFLOAD_TOOLS_EXTRA:-}"
tools_ok() {
  local t
  for t in $need_tools "$gh_bin"; do
    command -v "$t" >/dev/null 2>&1 || { say "offload: required tool '$t' not found"; return 1; }
  done
}

# url_alias_of URL: the url the host checks read. BG_OFFLOAD_URL_ALIAS (tests only) is "LOCAL HTTPS[;LOCAL HTTPS...]",
# and only a LOCAL that is a local path (/... or file://...) is ever aliased (adversary F12).
url_alias_of() {
  local pair rest="$url_alias"
  while [ -n "$rest" ]; do
    pair=${rest%%;*}
    if [ "$pair" = "$rest" ]; then rest=""; else rest=${rest#*;}; fi
    case "$pair" in
      /*" "*|file://*" "*) [ "$1" = "${pair%% *}" ] && { printf '%s\n' "${pair#* }"; return; } ;;
    esac
  done
  printf '%s\n' "$1"
}
# url_host URL: the lower-cased host of an https://, ssh:// or scp-like (user@host:path) url; empty for anything else
# (http, git://, file, a local path).
url_host() {
  local u="$1" h=""
  case "$u" in
    https://*|ssh://*|git+ssh://*|ssh+git://*) h=${u#*://}; h=${h%%/*}; h=${h##*@}; h=${h%%:*} ;;
    *://*) ;;
    *@*:*) h=${u#*@}; h=${h%%:*} ;;
  esac
  printf '%s\n' "$h" | gtr 'A-Z' 'a-z'
}
# url_repo URL HOST: print OWNER/REPO of an https/ssh/scp url on HOST, or fail.
url_repo() {
  local u p
  u=$(url_alias_of "$1")
  [ "$(url_host "$u")" = "$2" ] || return 1
  case "$u" in *://*) p=${u#*://}; p=${p#*/} ;; *) p=${u#*:} ;; esac
  p=${p%/}; p=${p%.git}
  case "$p" in */*/*|*[!A-Za-z0-9._/-]*|/*|*/|.*) return 1 ;; ?*/?*) printf '%s\n' "$p" ;; *) return 1 ;; esac
}
github_repo() { url_repo "$1" github.com; }
# one_push_url REMOTE: print the remote's push url when it has exactly one, or fail.
one_push_url() {
  local u
  u=$(git -C "$top" remote get-url --push --all -- "$1" 2>/dev/null) || return 1
  [ -n "$u" ] && [ "$(printf '%s\n' "$u" | gwc -l | gtr -d ' ')" = 1 ] && printf '%s\n' "$u"
}

# ci_remote: set $remote (routes (1), (2), (4)): git config bgoffload.remote, else $GITHUB_CI_REMOTE, else origin; and
# $gh_repo, OWNER/REPO when its (first) fetch url is a github.com repo (else empty). Publish check (b) later refuses
# unless that url is also the one push url, so the repo whose visibility is asked is the one pushed to.
ci_remote() {
  local url
  remote=$(git -C "$top" config --get bgoffload.remote 2>/dev/null) || remote=""
  if [ -n "$remote" ]; then remote_src=config
  elif [ -n "${GITHUB_CI_REMOTE:-}" ] && [ "$GITHUB_CI_REMOTE" != origin ]; then remote=$GITHUB_CI_REMOTE; remote_src=env
  else remote=origin; remote_src=origin
  fi
  gh_repo=""
  case "$remote" in ""|-*|*[!A-Za-z0-9._-]*) route_why="odd remote name '$remote'"; return 1 ;; esac
  url=$(git -C "$top" remote get-url -- "$remote" 2>/dev/null) && gh_repo=$(github_repo "$url") || gh_repo=""
  return 0
}

# owner_ok: the CI remote's GitHub repo is djbclark's, or gh reports ADMIN on it, or the remote is named explicitly in
# git config bgoffload.remote (adversary F12: no ci/run branches pushed to other people's repos). Sets route_why.
owner_ok() {
  local perm owner
  owner=$(printf '%s' "${gh_repo%%/*}" | gtr 'A-Z' 'a-z')
  [ "$owner" = djbclark ] || [ "$remote_src" = config ] && return 0
  perm=$(gtimeout 60 "$gh_bin" repo view "$gh_repo" --json viewerPermission --jq .viewerPermission 2>/dev/null) || { perm=""; transient=1; }
  [ "$perm" = ADMIN ] && return 0
  route_why="$gh_repo is not djbclark's and gh does not report ADMIN on it (${perm:-unreadable}); bg pushes ci/run branches only to his repos, or to one named with git config bgoffload.remote"
  return 1
}

# gh_vis REPO: set $vis to public, private or unknown (gh failed: a transient failure, never cached).
gh_vis() {
  local v
  v=$(gtimeout 60 "$gh_bin" repo view "$1" --json isPrivate --jq .isPrivate 2> "$tmp/vis.err") || v=error
  case "$v" in false) vis=public ;; true) vis=private ;; *) vis=unknown; transient=1 ;; esac
}

# find_base_ref: the ref github-ci-run overlays (its own choice: local ci/base, else the remote-tracking copy) in
# $base_ref (empty: none). show-ref exits 0 (exists), 1 (absent) or 128 (unreadable, e.g. its object is missing):
# only 1 means absent; unreadable sets base_bad=1.
find_base_ref() {
  local st
  base_ref=""; base_bad=0
  git -C "$top" show-ref --verify --quiet refs/heads/ci/base; st=$?
  if [ "$st" = 0 ]; then base_ref=refs/heads/ci/base
  elif [ "$st" = 1 ]; then
    git -C "$top" show-ref --verify --quiet "refs/remotes/$remote/ci/base"; st=$?
    if [ "$st" = 0 ]; then base_ref="refs/remotes/$remote/ci/base"; elif [ "$st" != 1 ]; then base_bad=1; fi
  else base_bad=1
  fi
}

# tracked_exec TOP PATH: PATH is an executable file tracked in TOP.
tracked_exec() {
  [ -f "$1/$2" ] && [ -x "$1/$2" ] && git -C "$1" ls-files --error-unmatch -- "$2" >/dev/null 2>&1
}
# tracked_clean FILE: FILE is tracked in its own checkout and unmodified against that checkout's HEAD (adversary F5:
# a helper outside the repo decides what is pushed or how, so it must be committed code, not another session's edit).
tracked_clean() {
  local d="${1%/*}" n="${1##*/}"
  [ -f "$1" ] && git -C "$d" ls-files --error-unmatch -- "$n" >/dev/null 2>&1 \
    && git -C "$d" diff --quiet HEAD -- "$n" 2>/dev/null
}
# helper_ok FILE DEFAULT [MORE...]: FILE is executable; when it is the DEFAULT (not a test hook), it and MORE (files it
# sources) are tracked_clean.
helper_ok() {
  local f="$1" def="$2" m
  shift 2
  [ -f "$f" ] && [ -x "$f" ] || return 1
  [ "$f" = "$def" ] || return 0
  for m in "$f" "$@"; do tracked_clean "$m" || return 1; done
}

# prefetch_workflows TREEISH...: in a partial clone, fetch the blobs under .github/workflows of each TREEISH (bounded;
# a fetch publishes nothing), so the reads after it run with GIT_NO_LAZY_FETCH=1 and never fetch without a bound.
prefetch_workflows() {
  local t
  : > "$tmp/pf"
  for t in "$@"; do
    GIT_NO_LAZY_FETCH=1 git -C "$top" ls-tree -r "$t" -- .github/workflows/ 2>/dev/null \
      | gawk '$2 == "blob" { print $3 }' >> "$tmp/pf"
  done
  [ -s "$tmp/pf" ] || return 0
  GIT_NO_LAZY_FETCH=1 git -C "$top" cat-file --batch-check < "$tmp/pf" 2>/dev/null | gawk '$2 == "missing" { print $1 }' > "$tmp/pf.missing"
  [ -s "$tmp/pf.missing" ] || return 0
  rg_in="$tmp/pf.missing"
  run_group "$t_fetch" "$tmp/pf.out" "$tmp/pf.err" git -C "$top" cat-file --batch-check
  rg_in=""
}
# show_blob SPEC OUT: write SPEC (TREEISH:PATH) to OUT without a lazy fetch; fail when it is unreadable.
show_blob() { GIT_NO_LAZY_FETCH=1 git -C "$top" show "$1" > "$2" 2>/dev/null; }

# forgejo_ok: route (3) (header): the `forgejo` remote exists ($fj_missing=1 if not) on a Forgejo host the skill uses,
# the push and API helpers are committed code, and the repo's config cannot make the push carry anything else.
forgejo_ok() {
  local urls u v st cdir
  remote=forgejo; fj_missing=0; fj_repo=""; fj_host=""
  urls=$(git -C "$top" remote get-url --push --all -- forgejo 2>/dev/null) || urls=""
  if [ -z "$urls" ]; then
    fj_missing=1
    route_why="scripts/forgejo-ci-run needs the remote 'forgejo', which $top does not have"
    return 1
  fi
  [ "$(printf '%s\n' "$urls" | gwc -l | gtr -d ' ')" = 1 ] || { route_why="the remote 'forgejo' has more than one push url"; return 1; }
  u=$(url_alias_of "$urls"); fj_host=$(url_host "$u")
  case " $forgejo_hosts " in *" $fj_host "*) [ -n "$fj_host" ] ;; *) false ;; esac \
    && fj_repo=$(url_repo "$urls" "$fj_host") || {
    route_why="the remote 'forgejo' ($(printf '%s' "$urls" | redact)) is not a repository on a Forgejo host the forgejo skill uses ($forgejo_hosts); not offloading to it"
    return 1
  }
  helper_ok "$git_forgejo" "$git_forgejo_default" \
    || { route_why="route (3) needs the forgejo skill's git-forgejo ($git_forgejo), committed and unmodified in its checkout"; return 1; }
  helper_ok "$fj_api" "$fj_api_default" \
    || { route_why="route (3) needs the forgejo skill's forgejo-api ($fj_api), committed and unmodified in its checkout"; return 1; }
  command -v jq >/dev/null 2>&1 || { route_why="route (3) needs jq to read Forgejo's run list"; return 1; }
  # Defence in depth (adversary F4): sudo-secretspec may drop GIT_CONFIG_PARAMETERS on the way to git-forgejo's git,
  # so the push passes --no-follow-tags --no-recurse-submodules itself, and a repo configured otherwise is refused.
  v=$(git -C "$top" config --type=bool --get push.followTags 2>/dev/null); st=$?
  { [ "$st" = 0 ] && [ "$v" = true ]; } || [ "$st" -gt 1 ] && { route_why="push.followTags is set (or unreadable) in $top; route (3) refuses"; return 1; }
  v=$(git -C "$top" config --type=bool --get submodule.recurse 2>/dev/null); st=$?
  { [ "$st" = 0 ] && [ "$v" = true ]; } || [ "$st" -gt 1 ] && { route_why="submodule.recurse is set (or unreadable) in $top; route (3) refuses"; return 1; }
  v=$(git -C "$top" config --get push.recurseSubmodules 2>/dev/null); st=$?
  { [ "$st" = 0 ] && [ "$v" != no ]; } || [ "$st" -gt 1 ] && { route_why="push.recurseSubmodules is '$v' in $top (not no); route (3) refuses"; return 1; }
  [ -z "$(git -C "$top" for-each-ref --count=1 refs/replace/ 2>/dev/null)" ] \
    || { route_why="$top has replace refs (refs/replace/); route (3) refuses"; return 1; }
  # The graft check below honours an inherited GIT_GRAFT_FILE; git-forgejo's git may run without it (N9), so the
  # default graft file must not exist either.
  cdir=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    && [ ! -e "$cdir/info/grafts" ] && [ ! -L "$cdir/info/grafts" ] \
    || { route_why="$top has (or may have) a graft file ($cdir/info/grafts); route (3) refuses"; return 1; }
  return 0
}

# fj_rc_why RC SECONDS: what a failed git-forgejo/forgejo-api call means. Both go through sudo-secretspec, whose broker
# can stall (git-forgejo retries it for about 2 min), so our own timeout is not "Forgejo is down" (adversary r3 F5).
fj_rc_why() {
  case "$1" in
    124|137) echo "no answer within $2 s: Forgejo, or the local secret broker (sudo-secretspec) that git-forgejo and forgejo-api go through" ;;
    *) echo "rc $1" ;;
  esac
}
# Route (3)'s ls-remote outlasts git-forgejo's broker retries (about 121 s of backoff).
t_fj_lsremote=$(( t_lsremote > 150 ? t_lsremote : 150 ))

# wf_pushes_ci_run FILE: the workflow has a push trigger on ci/run/** (comments ignored).
wf_pushes_ci_run() {
  gawk '{ sub(/(^|[[:space:]])#.*/, "") }
        /(^|[[:space:]{\[,])push[[:space:]]*(:|,|\]|$)/ { p = 1 }
        index($0, "ci/run/**") { b = 1 }
        END { exit !(p && b) }' "$1"
}

# fetch_ci_base SHA: make refs/remotes/$remote/ci/base the remote's ci/base (SHA). A concurrent bg may hold the ref's
# lock (adversary F9): a failed fetch is fine if the ref is at SHA now, else it is retried once, within the same
# BG_OFFLOAD_FETCH_TIMEOUT (N8: the retry does not double the bound).
fetch_ci_base() {
  local n left t0
  t0=$(gdate +%s); left=$t_fetch
  for n in 1 2; do
    run_group "$left" "$tmp/base.fetch" "$tmp/base.fetch.err" \
      git -C "$top" fetch --no-tags --quiet "$remote" "+refs/heads/ci/base:refs/remotes/$remote/ci/base"
    [ "$rc" = 0 ] && return 0
    [ "$(git -C "$top" rev-parse --verify -q "refs/remotes/$remote/ci/base" 2>/dev/null)" = "$1" ] && return 0
    sleep 2
    left=$(( t_fetch - ($(gdate +%s) - t0) ))
    [ "$left" -gt 0 ] || return 1
  done
  return 1
}

# generic_route: route (4) (header). Sets runner or route_why.
generic_route() {
  local sha cur f perm owner
  kind=generic
  if [ -z "$gh_repo" ]; then
    route_why="no tracked scripts/bg-offload-run, scripts/github-ci-run or scripts/forgejo-ci-run, and the CI remote '$remote' is not one github.com repo (set git config bgoffload.remote to a fork's remote)"
    return 1
  fi
  helper_ok "$generic_runner" "$generic_default" \
    || { route_why="the generic GitHub runner $generic_runner is missing, untracked or modified in its checkout"; return 1; }
  owner_ok || return 1
  run_group "$t_lsremote" "$tmp/base.lsr" "$tmp/base.err" git -C "$top" ls-remote --refs "$remote" refs/heads/ci/base
  if [ "$rc" != 0 ]; then
    transient=1
    route_why="could not ask $remote ($gh_repo) for its ci/base (rc $rc): $(ghead -n 1 "$tmp/base.err" | redact)"
    return 1
  fi
  sha=$(gawk '$2 == "refs/heads/ci/base" { print $1; exit }' "$tmp/base.lsr")
  [ -n "$sha" ] || { route_why="no tracked CI route script, and $gh_repo (remote $remote) has no ci/base branch with a ci/run/** workflow"; return 1; }
  if ! git -C "$top" show-ref --verify --quiet refs/heads/ci/base; then
    cur=$(git -C "$top" rev-parse --verify -q "refs/remotes/$remote/ci/base" 2>/dev/null) || cur=""
    if [ "$cur" != "$sha" ] && ! fetch_ci_base "$sha"; then
      transient=1
      route_why="could not fetch ci/base from $remote (rc $rc): $(ghead -n 1 "$tmp/base.fetch.err" | redact)"
      return 1
    fi
  fi
  find_base_ref
  if [ "$base_bad" = 1 ] || [ -z "$base_ref" ]; then
    route_why="could not read ci/base in $top after asking $remote for it"
    return 1
  fi
  prefetch_workflows "$base_ref"
  for f in agent-ci.yml linux-ci.yml; do
    show_blob "$base_ref:.github/workflows/$f" "$tmp/wf" || continue
    if wf_pushes_ci_run "$tmp/wf"; then runner="$generic_runner"; return 0; fi
  done
  route_why="ci/base (${base_ref#refs/}) of $gh_repo has no readable .github/workflows/agent-ci.yml or linux-ci.yml with a push trigger on ci/run/**"
  return 1
}

# try_github: route (1) if tracked, else (2), else (4). The CI remote must already be set (ci_remote). A CI remote that
# only an inherited GITHUB_CI_REMOTE chose gets route (4)'s owner check on (1) and (2) too (adversary r3 F7: a private
# fork's `upstream` would otherwise get ci/run branches pushed to someone else's repo).
try_github() {
  if [ "$have1" = 1 ] || [ "$have2" = 1 ]; then
    [ "$remote_src" != env ] || owner_ok || return 1
  fi
  if [ "$have1" = 1 ]; then kind=custom; runner="$top/scripts/bg-offload-run"; return 0; fi
  if [ "$have2" = 1 ]; then kind=github; runner="${runner_override:-$top/scripts/github-ci-run}"; return 0; fi
  generic_route
}
# try_forgejo: route (3).
try_forgejo() { kind=forgejo; runner="$top/scripts/forgejo-ci-run"; forgejo_ok; }

# route: set $kind (custom, github, forgejo, generic), $runner, $remote (and $gh_repo for GitHub routes), or set
# $route_why and fail. Only a TRACKED script in the repo opts a repo into a route. Order by the CI remote's GitHub
# visibility (header, djbclark 2026-11-01): public -> (1), (2), (4), and (3) only when none of those exists; private ->
# (3) only, never GitHub; unreadable -> no route for this run; not on GitHub at all -> (3) only.
route() {
  local gwhy
  kind=""; runner=""; remote=""; gh_repo=""; route_why=""; fj_missing=0; vis=""
  [ -d "$top/.git" ] || { route_why="$top is not a repo top with its own .git (a linked worktree has no route)"; return 1; }
  have1=0; have2=0; have3=0
  if [ -n "$runner_override" ]; then
    [ -x "$runner_override" ] || { route_why="BG_OFFLOAD_RUNNER $runner_override is not executable"; return 1; }
    have2=1
  else
    tracked_exec "$top" scripts/bg-offload-run && have1=1
    tracked_exec "$top" scripts/github-ci-run && have2=1
  fi
  tracked_exec "$top" scripts/forgejo-ci-run && have3=1
  ci_remote || return 1
  if [ -z "$gh_repo" ]; then
    if [ "$have3" = 1 ]; then try_forgejo; return; fi
    route_why="no tracked scripts/forgejo-ci-run, and the CI remote '$remote' is not one github.com repo (set git config bgoffload.remote to a fork's remote)"
    return 1
  fi
  gh_vis "$gh_repo"
  case "$vis" in
    public)
      try_github && return 0
      [ "$have3" = 1 ] || return 1
      gwhy=$route_why
      try_forgejo && return 0
      route_why="$gwhy (and route (3): $route_why)"
      return 1 ;;
    private)
      # djbclark 2026-11-01: a private repo builds on Forgejo only, never on GitHub, Linux or not.
      if [ "$have3" = 0 ]; then
        route_why="private repo has no Forgejo route: $gh_repo is private and $top has no tracked scripts/forgejo-ci-run (private repos build on Forgejo only, never on GitHub)"
        return 1
      fi
      try_forgejo && return 0
      route_why="private repo has no Forgejo route: $route_why"
      return 1 ;;
    *)
      route_why="could not read whether $gh_repo is public or private (gh repo view: $(ghead -n 1 "$tmp/vis.err")); no CI route for this run (bg does not guess: public repos build on GitHub, private ones on Forgejo only)"
      return 1 ;;
  esac
}

# run_group TIMEOUT OUT ERR CMD...: run CMD bounded, in its own process group and as a background job we wait on, so a
# kill of bg (it reaches us as TERM) kills the whole group (gtimeout, a runner script, its git push), not just the
# top process. The status is left in $rc.
run_group() {
  local t="$1" o="$2" e="$3"
  shift 3
  set -m
  gtimeout "$t" "$@" > "$o" 2> "$e" < "${rg_in:-/dev/null}" &
  rpid=$!
  set +m
  trap 'kill -TERM -- "-$rpid" 2>/dev/null; kill -TERM "$rpid" 2>/dev/null; exit 143' TERM INT HUP
  wait "$rpid"
  rc=$?
  trap - TERM INT HUP
}

base_ref=""; base_bad=0; vis=""; transient=0; have2=0; have3=0; fj_missing=0
# mktmp: the helper's scratch directory, removed on exit. bg may kill us (it runs us as a child): bash runs the EXIT
# trap when a TERM ends it (checked 2026-10-23), so no TERM trap is needed while polling; only run_group traps TERM,
# to kill a runner's process group.
mktmp() {
  tmp=$(gmktemp -d "${TMPDIR:-/tmp}/bg-offload.XXXXXX") || exit 69
  trap 'rm -rf "$tmp"' EXIT
}

# probe_key: what a probe's answer depends on that is cheap to read here (adversary F9): the repo, the CI remote and
# its urls, the forgejo url, HEAD, the local ci/base copies, the route scripts and the hooks in effect. Network answers
# (ls-remote, gh) are behind it for up to BG_OFFLOAD_PROBE_TTL seconds (300; 0 = no cache; tests default to 0); a
# "no route" answer for at most 60 s of that (N8: a route that appears on the remote is not hidden for long).
probe_key() {
  local r s
  r=$(git -C "$top" config --get bgoffload.remote 2>/dev/null) || r=""
  [ -n "$r" ] || r="${GITHUB_CI_REMOTE:-origin}"
  {
    printf '%s\n' "$top" "$r" "$url_alias" "$runner_override" "$generic_runner" "$git_forgejo" "$fj_api" "$gh_bin" \
      "${BG_OFFLOAD_TOOLS_EXTRA:-}"
    git -C "$top" remote get-url --all -- "$r" 2>/dev/null
    git -C "$top" remote get-url --push --all -- "$r" 2>/dev/null
    git -C "$top" remote get-url --push --all -- forgejo 2>/dev/null
    git -C "$top" rev-parse HEAD refs/heads/ci/base "refs/remotes/$r/ci/base" refs/remotes/forgejo/ci/base 2>/dev/null
    git -C "$top" ls-files -s -- scripts/bg-offload-run scripts/github-ci-run scripts/forgejo-ci-run 2>/dev/null
    for s in scripts/bg-offload-run scripts/github-ci-run scripts/forgejo-ci-run; do [ -x "$top/$s" ] && echo "x $s"; done
    git -C "$top" config --get-regexp '^(push|submodule)\.' 2>/dev/null
  } | gsha256sum | gawk '{ print $1 }'
}

if [ "${1:-}" = --probe ]; then
  top="${2:-}"
  [ -n "$top" ] || { say "offload: usage: bg-offload --probe TOP"; exit 2; }
  tools_ok || exit 69
  top=$(greadlink -f "$top") || { say "offload: no such directory: $2"; exit 69; }
  mktmp
  cache=""
  if [ "$probe_ttl" -gt 0 ]; then
    cache="$HOME/.local/state/bg-offload/probe-cache/$(probe_key)"
    c_t=""; c_rc=""; c_why=""
    [ -f "$cache" ] && IFS=$'\t' read -r c_t c_rc c_why < "$cache"
    case "$c_t" in ""|*[!0-9]*) c_t=0 ;; esac
    c_age=$(( $(gdate +%s) - c_t ))
    if [ "$c_rc" = 0 ] && [ "$c_age" -lt "$probe_ttl" ]; then exit 0; fi
    if [ "$c_rc" = 69 ] && [ "$c_age" -lt "$probe_ttl" ] && [ "$c_age" -lt 60 ]; then
      say "offload: $c_why"
      exit 69
    fi
  fi
  p_rc=0
  route || p_rc=69
  if [ -n "$cache" ] && [ "$transient" = 0 ]; then
    mkdir -p "${cache%/*}" && printf '%s\t%s\t%s\n' "$(gdate +%s)" "$p_rc" "$route_why" > "$cache.$$" && mv -f "$cache.$$" "$cache"
  fi
  [ "$p_rc" = 0 ] && exit 0
  say "offload: $route_why"
  exit 69
fi

top="${1:-}"
if [ -z "$top" ] || [ "${2:-}" != -- ]; then
  echo "usage: bg-offload --probe TOP | bg-offload TOP -- CMD [ARGS...]" >&2
  exit 2
fi
shift 2
cmd_text="$*"

tools_ok || exit 69
top=$(greadlink -f "$top") || exit 69
mktmp
route || { say "offload: no CI route: $route_why"; exit 69; }

# 1. Tree state. No grep: the porcelain output is used as git prints it, and a failing git refuses.
git -C "$top" status --porcelain --untracked-files=no > "$tmp/tracked" 2>/dev/null || { say "offload: git status failed in $top"; exit 69; }
tracked_dirty=$(gwc -l < "$tmp/tracked") || exit 69
tracked_dirty=${tracked_dirty// /}
git -C "$top" ls-files --others --exclude-standard > "$tmp/untracked" 2>/dev/null || : > "$tmp/untracked"  # only listed
untracked=$(ghead -n 20 "$tmp/untracked")
head_sha=$(git -C "$top" rev-parse --verify HEAD 2>/dev/null) || { say "offload: no HEAD commit in $top"; exit 69; }

# 2. A test path CI cannot see: missing (a typo, or deleted here), untracked, git-ignored, an untracked-only
# directory, or outside the repo. CI would run the repo's own tests and report success for what it never saw.
# Only pytest/unittest arguments are read; flags and everything up to the runner word are skipped.
seen=0 prev=""
for a in "$@"; do
  if [ "$seen" = 0 ]; then
    case "${a##*/}" in pytest|py.test) seen=1 ;; esac
    [ "$prev" = -m ] && case "$a" in pytest|unittest) seen=1 ;; esac
    prev=$a
    continue
  fi
  case "$a" in -*) continue ;; esac
  p="${a%%::*}"
  case "$p" in *.py|*/*|*::*) ;; *) [ -d "$p" ] || continue ;; esac
  if [ ! -e "$p" ]; then
    say "offload: $a names $p, which does not exist here (a typo, or deleted in the working tree); not offloading"
    exit 69
  fi
  full=$(greadlink -f "$p") || exit 69
  case "$full/" in
    "$top"/*) ;;
    *) say "offload: $p is outside the repo $top, so CI cannot run it; not offloading"; exit 69 ;;
  esac
  if [ -d "$p" ]; then
    if [ -z "$(git ls-files -- "$p" | ghead -n 1)" ]; then
      say "offload: directory $p has no tracked file, so CI cannot run it; not offloading"
      exit 69
    fi
  elif ! git ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
    say "offload: $p is untracked (or git-ignored), so CI cannot run it; not offloading"
    exit 69
  fi
done

# 3. Publish NOTHING that is not already on the remote (header: (a) clean tracked tree, (b) HEAD reachable from a ref
# the real push target advertises, (c) the overlaid ci/base too). One line per failed reason, exit 69, bg keeps waiting.
refuse=0
# Grafts rewrite parents for every git command here and in the runner's push; GIT_NO_REPLACE_OBJECTS does not turn
# them off. rev-parse --git-path honours $GIT_GRAFT_FILE. A failing rev-parse refuses too.
graft_file=$(git -C "$top" rev-parse --path-format=absolute --git-path info/grafts 2>/dev/null) || graft_file=""
if [ -z "$graft_file" ] || [ -e "$graft_file" ] || [ -L "$graft_file" ]; then
  refuse=1
  say "offload: a graft file (${graft_file:-unknown path}) rewrites history here, so what is on the remote cannot be checked"
fi
if [ "$tracked_dirty" != 0 ]; then
  refuse=1
  say "offload: $tracked_dirty tracked file(s) with uncommitted changes (working tree or index) in $top; CI would not see them:"
  ghead -n 20 "$tmp/tracked" | gsed 's/^/bg:   /' >&2
  [ "$tracked_dirty" -gt 20 ] && say "offload:   ... and $((tracked_dirty - 20)) more"
fi

# (b) the push target. Fetch and push url must be the same single url (the runners push to the push url, gh is polled on
# the url the runner prints), then ask that remote what it has (route (3): through git-forgejo, which has the token).
remote_ok=0
fetch_urls=$(git -C "$top" remote get-url --all -- "$remote" 2>/dev/null) || fetch_urls=""
push_urls=$(git -C "$top" remote get-url --push --all -- "$remote" 2>/dev/null) || push_urls=""
if [ -z "$fetch_urls" ] || [ -z "$push_urls" ]; then
  refuse=1
  say "offload: remote $remote has no url here; cannot tell where the runner would push"
elif [ "$fetch_urls" != "$push_urls" ] || [ "$(printf '%s\n' "$push_urls" | gwc -l)" != 1 ]; then
  refuse=1
  say "offload: remote $remote does not have exactly one url that is both its fetch and push url (set-url, pushurl, pushInsteadOf or several urls); the push target cannot be verified"
else
  if [ "$kind" = forgejo ]; then
    run_group "$t_fj_lsremote" "$tmp/lsr" "$tmp/lsr.err" env FORGEJO_HOST="$fj_host" "$git_forgejo" -C "$top" ls-remote --refs "$remote"
  else
    run_group "$t_lsremote" "$tmp/lsr" "$tmp/lsr.err" git -C "$top" ls-remote --refs "$remote"
  fi
  if [ "$rc" != 0 ]; then
    refuse=1
    if [ "$kind" = forgejo ]; then
      say "FORGEJO UNREACHABLE: could not list the refs of the forgejo remote ($fj_host/$fj_repo) through git-forgejo ($(fj_rc_why "$rc" "$t_fj_lsremote")): $(ghead -n 1 "$tmp/lsr.err" | redact)"
      say "fix Forgejo (forgejo / forgejo-ci skills); if you cannot, notify djbclark (hermes-ping) and keep doing work that is not blocked"
    fi
    say "offload: could not list the refs at the push target of $remote (rc $rc); not offloading: $(ghead -n 1 "$tmp/lsr.err" | gsed -E 's#//[^/@ ]*@#//#g')"
  else
    # The advertised tips that exist here, as exclusions: a commit is "on the remote" if it is reachable from one.
    gawk '{print $1}' "$tmp/lsr" | GIT_NO_LAZY_FETCH=1 git -C "$top" cat-file --batch-check 2>/dev/null | gawk '$2 == "commit" || $2 == "tag" { print "^" $1 }' > "$tmp/tips" || : > "$tmp/tips"
    remote_ok=1
  fi
fi
published_count() { GIT_NO_LAZY_FETCH=1 git -C "$top" rev-list --count "$1" --stdin < "$tmp/tips" 2>/dev/null; }
if [ "$remote_ok" = 1 ]; then
  local_n=$(published_count "$head_sha") || { say "offload: rev-list failed in $top"; exit 69; }
  if [ "$local_n" != 0 ]; then
    refuse=1
    say "offload: $local_n commit(s) in HEAD are not on the remote $remote (unpushed):"
    GIT_NO_LAZY_FETCH=1 git -C "$top" log --oneline -n 10 "$head_sha" --stdin < "$tmp/tips" | gsed 's/^/bg:   /' >&2
    [ "$local_n" -gt 10 ] && say "offload:   ... and $((local_n - 10)) more"
  fi
  # (c) the ref the runner overlays (find_base_ref); unreadable counts as not on the remote.
  find_base_ref
  if [ "$base_bad" = 1 ]; then
    refuse=1
    say "offload: could not read ci/base (git could not read a ref); treating it as not on the remote"
  elif [ -n "$base_ref" ]; then
    base_n=$(published_count "$base_ref") || base_n=-1
    case "$base_n" in ""|*[!0-9-]*) base_n=-1 ;; esac
    if [ "$base_n" = -1 ]; then
      refuse=1
      say "offload: could not compare $base_ref with the refs at $remote (git failed); treating it as not on the remote"
    elif [ "$base_n" != 0 ]; then
      refuse=1
      say "offload: $base_ref (overlaid onto the run) has $base_n commit(s) that are not on the remote $remote, so it would be published"
    fi
  fi
fi
if [ "$refuse" = 1 ]; then
  say "offload: not publishing anything that is not already on the remote; commit and push, then run bg again to offload."
  exit 69
fi

# 3b. Everything the runner reads must be here: HEAD's tree and the ci/base tree it overlays (adversary round 6). In
# a partial clone a ci/base that was fetched but never checked out lacks its blobs, and github-ci-run skips an overlay
# path whose `cat-file -e` fails. Missing objects are fetched (lazy fetch through `cat-file --batch-check`, from the
# clone's promisor remote; a fetch publishes nothing), then any object still missing refuses.
need_trees=("$head_sha^{tree}")
[ -n "$base_ref" ] && need_trees+=("$base_ref^{tree}")
missing_objects() {  # writes $tmp/missing; exit 0 = none missing, 1 = some missing, 2 = git failed
  GIT_NO_LAZY_FETCH=1 git -C "$top" rev-list --objects --missing=print "${need_trees[@]}" > "$tmp/objs" 2>/dev/null || return 2
  gawk '/^\?/ { print substr($1, 2) }' "$tmp/objs" > "$tmp/missing" || return 2
  [ ! -s "$tmp/missing" ]
}
missing_objects; st=$?
if [ "$st" = 1 ]; then
  say "offload: $(gwc -l < "$tmp/missing" | gsed 's/ //g') object(s) of the trees the runner reads are not in this partial clone; fetching them"
  rg_in="$tmp/missing"
  run_group "$t_fetch" "$tmp/fetch.out" "$tmp/fetch.err" git -C "$top" cat-file --batch-check
  rg_in=""
  missing_objects; st=$?
fi
if [ "$st" = 2 ]; then
  say "offload: could not list the objects of HEAD's tree${base_ref:+ and $base_ref} (git failed); not offloading"
  exit 69
elif [ "$st" = 1 ]; then
  say "offload: $(gwc -l < "$tmp/missing" | gsed 's/ //g') object(s) of HEAD's tree${base_ref:+ or $base_ref} are missing here and could not be fetched (rc $rc: $(ghead -n 1 "$tmp/fetch.err" | gsed -E 's#//[^/@ ]*@#//#g')); the runner would build without them. Not offloading; waiting at the gate instead."
  exit 69
fi
# A GitHub route is followed on the repo its remote names (adversary F11): no github.com remote, nothing to follow.
if [ "$kind" != forgejo ] && [ -z "$gh_repo" ]; then
  say "offload: no CI route: the CI remote '$remote' is not one github.com repo, so its CI run could not be followed; not offloading"
  exit 69
fi
ref="$head_sha"
if [ -n "$untracked" ]; then what="HEAD ${head_sha:0:8}, already on $remote (the tree has untracked files, which CI does not get)"
else what="HEAD ${head_sha:0:8}, already on $remote"; fi

# Untracked files are never in the ref: listed.
if [ -n "$untracked" ]; then
  say "offload: untracked files are NOT in the CI run:"
  printf '%s\n' "$untracked" | gsed 's/^/bg:   ?? /' >&2
  [ "$(gwc -l < "$tmp/untracked")" -gt 20 ] && say "offload:   ... and more"
fi

# 4. Run the route. Route (3): this helper pushes the checked commit itself and follows the Forgejo run that push
# starts; the others run their runner (its own wait is skipped: --no-wait) and this helper polls GitHub below.
if [ "$kind" = forgejo ]; then
  say "offload: running the repo's CI on $what: push to forgejo ci-run, then follow its Forgejo run"
else
  say "offload: running the repo's CI on $what via ${runner#$top/}${remote:+ (remote $remote)}"
fi
out="$tmp/runner.out"
cd "$top" || exit 69
# The runner's `git push` must carry the one ref and nothing else, whatever the caller's git config says:
# push.followTags would publish local annotated tags, push.recurseSubmodules submodule commits. GIT_CONFIG_PARAMETERS
# is read after every config file and after GIT_CONFIG_COUNT/KEY/VALUE, and the last value wins, so appending to it
# overrides both (a caller's own entries are kept). A malformed caller value already failed `git status` above.
export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'push.followtags'='false' 'push.recursesubmodules'='no'"
if [ "$kind" = forgejo ]; then
  # Route (3) (adversary F3, F4, F8, N2, N7; djbclark 2026-11-01). Forgejo is the only CI a private repo may use, so
  # when Forgejo cannot run the build (the API or the push fails, or no run of this push shows up) bg refuses it:
  # exit 69 with a FORGEJO UNREACHABLE line, never a local run and never GitHub.
  fj_unreachable() {
    say "FORGEJO UNREACHABLE: $1"
    say "fix Forgejo (forgejo / forgejo-ci skills); if you cannot, notify djbclark (hermes-ping) and keep doing work that is not blocked"
    exit 69
  }
  fj_get() { run_group 120 "$2" "$tmp/fj.err" "$fj_api" --host "$fj_host" GET "$1"; }
  runs_api="/repos/$fj_repo/actions/runs"
  # A run list must be an object with workflow_runs (null when the repo has none); any other 2xx body is unreadable
  # (adversary r3 F6: a missing key used to read as "no runs yet", id floor 0).
  runs_ok='if type == "object" and has("workflow_runs") and ((.workflow_runs | type) == "array" or .workflow_runs == null) then (.workflow_runs // []) else error("not a run list") end'
  # A run we accept must be newer than every run that exists before our push (N2: the same commit may already have
  # runs on other branches, or an older ci-run run).
  fj_get "$runs_api?limit=1" "$tmp/fj.min"
  [ "$rc" = 0 ] || fj_unreachable "could not list the Actions runs of $fj_host/$fj_repo ($(fj_rc_why "$rc" 120)): $(ghead -n 1 "$tmp/fj.err" | redact)"
  min_id=$(jq -r "$runs_ok | [.[].id] | max // 0" "$tmp/fj.min" 2>/dev/null)
  case "$min_id" in ""|*[!0-9]*) fj_unreachable "unreadable Actions run list from $fj_host/$fj_repo" ;; esac
  cur=$(gawk '$2 == "refs/heads/ci-run" { print $1; exit }' "$tmp/lsr")  # ci-run as check (b) saw it; empty: none
  follow=""
  if [ "$cur" = "$head_sha" ]; then
    # ci-run already holds this commit, so a push would be a no-op and start no run. If a run of it on ci-run is still
    # going (another session pushed the same commit), follow that run; deleting and re-pushing would cancel it
    # (adversary r3 F3). Only when every such run is complete is ci-run deleted and re-pushed for a fresh run (N2).
    fj_get "$runs_api?limit=50" "$tmp/fj.cur"
    [ "$rc" = 0 ] || fj_unreachable "could not list the Actions runs of $fj_host/$fj_repo ($(fj_rc_why "$rc" 120)): $(ghead -n 1 "$tmp/fj.err" | redact)"
    pend=$(jq -r --arg s "$head_sha" "$runs_ok"' | [.[] | select(.commit_sha == $s and .prettyref == "ci-run")
      | select((.status as $x | ["success", "failure", "cancelled", "skipped"] | index($x)) == null) | .id] | min // empty' \
      "$tmp/fj.cur" 2>/dev/null) || fj_unreachable "unreadable Actions run list from $fj_host/$fj_repo"
    case "$pend" in
      "") ;;
      *[!0-9]*) fj_unreachable "unreadable Actions run list from $fj_host/$fj_repo" ;;
      *) follow=1; min_id=$((pend - 1)) ;;
    esac
  fi
  if [ -z "$follow" ]; then
    # Every write to ci-run carries a lease on the value check (b) saw (adversary r3 F3): if another session moved
    # ci-run since, git refuses, and bg-offload backs off instead of overwriting or deleting that session's commit.
    lease="refs/heads/ci-run:$cur"
    if [ "$cur" = "$head_sha" ]; then
      run_group "$t_push" "$tmp/del.out" "$tmp/push.err" env FORGEJO_HOST="$fj_host" "$git_forgejo" -C "$top" push \
        --force-with-lease="$lease" --no-follow-tags --no-recurse-submodules forgejo :refs/heads/ci-run
      [ "$rc" = 0 ] && lease="refs/heads/ci-run:"
    fi
    # Push exactly the commit checked above, never "whatever HEAD is by now", with the flags on the command line
    # (sudo-secretspec may not pass GIT_CONFIG_PARAMETERS through). A failed push published nothing.
    [ "$rc" = 0 ] && run_group "$t_push" "$tmp/push.out" "$tmp/push.err" env FORGEJO_HOST="$fj_host" "$git_forgejo" -C "$top" push \
      --force-with-lease="$lease" --no-follow-tags --no-recurse-submodules forgejo "$head_sha:refs/heads/ci-run"
    if [ "$rc" != 0 ]; then
      gtail -n 8 "$tmp/push.err" | redact | gsed 's/^/bg:   /' >&2
      if gawk '/stale info/ { f = 1 } END { exit !f }' "$tmp/push.err"; then
        say "offload: ci-run on $fj_host/$fj_repo moved since it was checked (another session is using it); not overwriting it. Run bg again."
        exit 69
      fi
      fj_unreachable "pushing ${head_sha:0:8} to ci-run on $fj_host/$fj_repo failed ($(fj_rc_why "$rc" "$t_push"); its stderr tail is above)"
    fi
    say "offload: pushed ${head_sha:0:8} to ci-run on $fj_host/$fj_repo; following the run it starts (newer than run $min_id), up to $t_wait s"
  else
    say "offload: ci-run on $fj_host/$fj_repo already holds ${head_sha:0:8} and its run $pend is still going; following it, up to $t_wait s"
  fi
  say "offload: this runs the repo's whole CI workflow, not only: $cmd_text"
  t0=$(gdate +%s); errs=0; seen=0
  while :; do
    fj_get "$runs_api?limit=50" "$tmp/fj.runs"
    el=$(( $(gdate +%s) - t0 ))
    if [ "$rc" != 0 ] || ! jq -r --arg s "$head_sha" --argjson min "$min_id" \
        "$runs_ok"' | .[] | select(.id > $min and .commit_sha == $s and .prettyref == "ci-run") | [.id, .status, .html_url] | @tsv' \
        "$tmp/fj.runs" > "$tmp/fj.rows" 2>/dev/null; then
      errs=$((errs + 1))
      if [ "$errs" -ge 5 ]; then
        [ "$seen" = 1 ] || fj_unreachable "the Actions run list of $fj_host/$fj_repo failed $errs times in a row after the push: $(ghead -n 1 "$tmp/fj.err" | redact)"
        say "offload: the Forgejo run list failed $errs times in a row; no verdict: https://$fj_host/$fj_repo/actions"
        exit 77
      fi
    else
      errs=0
      if [ ! -s "$tmp/fj.rows" ]; then
        [ "$el" -lt "$t_appear" ] || fj_unreachable "no Forgejo run of ${head_sha:0:8} on ci-run appeared within ${el} s of the push (Actions off, or no workflow for ci-run)"
      else
        seen=1; pending=0 failed=0 odd=0 ok=0 first_fail="" first_url="" n=0 queued=0
        while IFS=$'\t' read -r id status rurl; do
          n=$((n + 1)); [ -n "$first_url" ] || first_url="$rurl"
          case "$status" in
            success) ok=$((ok + 1)) ;;
            skipped) ;;
            failure) failed=1; [ -n "$first_fail" ] || { first_fail="$id"; fail_url="$rurl"; } ;;
            cancelled) odd=1; say "offload: Forgejo run $id was cancelled: $rurl" ;;
            waiting|blocked) pending=1; queued=$((queued + 1)) ;;
            *) pending=1 ;;
          esac
        done < "$tmp/fj.rows"
        # Every run still queued past BG_OFFLOAD_APPEAR: no runner took it, so Forgejo cannot run the build (r3 F4).
        if [ "$queued" = "$n" ] && [ "$el" -ge "$t_appear" ]; then
          fj_unreachable "no Forgejo runner picked up the run(s) of ${head_sha:0:8} on ci-run within ${el} s (status waiting/blocked): $first_url"
        fi
        if [ "$pending" = 0 ]; then
          if [ "$failed" = 1 ]; then
            echo "bg: CI FAILED (${el} s, Forgejo): $fail_url"
            case "$first_fail" in ""|*[!0-9]*) ;; *)
              fj_get "$runs_api/$first_fail/jobs" "$tmp/fj.jobs"
              job=$(jq -r '(if type == "array" then . else .jobs end)[0].id // empty' "$tmp/fj.jobs" 2>/dev/null)
              case "$job" in ""|*[!0-9]*) ;; *)
                fj_get "/repos/$fj_repo/actions/jobs/$job/logs" "$tmp/fj.log"
                if [ "$rc" = 0 ] && [ -s "$tmp/fj.log" ]; then echo "bg: job log, last 60 lines:"; gtail -n 60 "$tmp/fj.log"; fi ;;
              esac ;;
            esac
            exit 1
          elif [ "$odd" = 1 ]; then
            exit 77
          elif [ "$ok" = 0 ]; then
            say "offload: all $n Forgejo run(s) were skipped, so nothing was tested: $first_url"
            exit 77
          fi
          echo "bg: CI workflow PASSED on this tree (${el} s, Forgejo, $ok of $n run(s) succeeded): $first_url"
          echo "bg: ref: $what. The repo's whole CI workflow passed; the command you named was not selected on its own: $cmd_text"
          exit 0
        fi
      fi
    fi
    if [ "$el" -ge "$t_wait" ]; then
      say "offload: the Forgejo run had not finished after ${el} s (BG_OFFLOAD_WAIT=$t_wait); it may still be going: ${first_url:-https://$fj_host/$fj_repo/actions}"
      exit 76
    fi
    sleep "$poll" &
    wait $!
  done
fi
export GITHUB_CI_REMOTE="$remote"  # the CI remote the checks above asked; github-ci-run pushes to it
run_group "$t_push" "$out" "$tmp/runner.err" "$runner" --no-wait "$ref"
if [ "$rc" != 0 ]; then
  say "offload: the CI runner exited $rc (it may have pushed before failing; no run is followed). Its stderr tail:"
  gtail -n 8 "$tmp/runner.err" | gsed 's/^/bg:   /' >&2
  exit 69
fi
commit=$(gawk '/^overlay [0-9a-f]+ for /{print $2; exit}' "$out")
url=$(gawk '/^(pushed|branch:) https:\/\/github.com\//{print $2; exit}' "$out")
repo=${url#https://github.com/}; repo=${repo%%/tree/*}; repo=${repo%/}
branch=${url#*/tree/}
case "$commit" in *[!0-9a-f]*|"") commit="" ;; esac
[ "${#commit}" = 40 ] || commit=""
case "$repo" in */*/*|*[!A-Za-z0-9._/-]*|""|/*|*/) repo="" ;; esac
case "$branch" in *[!A-Za-z0-9._/-]*|"") branch="" ;; esac
if [ -z "$commit" ] || [ -z "$repo" ] || [ -z "$branch" ]; then
  say "offload: the runner pushed (rc 0) but its output has no 'overlay <sha> for ...' and 'pushed|branch: https://github.com/OWNER/REPO/tree/BRANCH' lines; no verdict. Its stdout:"
  gtail -n 8 "$out" | gsed 's/^/bg:   /' >&2
  exit 77
fi
# Follow the repo the checks and the guard were about (adversary F11), and only if the runner says it pushed there.
if [ "$(printf '%s' "$repo" | gtr 'A-Z' 'a-z')" != "$(printf '%s' "$gh_repo" | gtr 'A-Z' 'a-z')" ]; then
  say "offload: the runner says it pushed to $repo, but the CI remote '$remote' is $gh_repo; no verdict"
  exit 77
fi
repo="$gh_repo"
say "offload: pushed $branch on $repo (commit ${commit:0:8}); waiting for CI, up to $t_wait s"
say "offload: this runs the repo's whole CI workflow, not only: $cmd_text"

# download_artifacts: header, Artifacts. Never changes the verdict. Each run is downloaded into a temporary directory
# beside its target and moved into place (adversary F10: a re-run keeps its id, and a partial download must not
# linger); then runs older than 7 days, and all but the newest 20 per repo, are pruned.
download_artifacts() {
  local id d base part
  [ "${BG_OFFLOAD_ARTIFACTS:-1}" = 0 ] && return 0
  base="$HOME/.local/state/bg-offload/artifacts/${repo%%/*}__${repo#*/}"
  mkdir -p "$base" || { say "offload: warning: cannot create $base; artifacts not downloaded (the verdict stands)"; return 0; }
  for id in "${ok_ids[@]}"; do
    case "$id" in ""|*[!0-9]*) continue ;; esac
    d="$base/$id"
    part=$(gmktemp -d "$base/.part.XXXXXX") || { say "offload: warning: cannot create a download directory in $base (the verdict stands)"; continue; }
    if gtimeout "$t_art" "$gh_bin" run download "$id" -R "$repo" -D "$part" > "$tmp/dl.out" 2> "$tmp/dl.err" \
        && rm -rf -- "$d" && mv -- "$part" "$d"; then
      touch -- "$d"
      echo "bg: artifacts of run $id: $d"
    else
      rm -rf -- "$part"
      say "offload: warning: could not download the artifacts of run $id to $d (the verdict stands): $(ghead -n 1 "$tmp/dl.err")"
    fi
  done
  gfind "$base" -mindepth 1 -maxdepth 1 -type d -name '.part.*' -mmin +120 -exec rm -rf -- {} + 2>/dev/null
  gfind "$base" -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9]+' -mtime +7 -exec rm -rf -- {} + 2>/dev/null
  gfind "$base" -mindepth 1 -maxdepth 1 -type d -regex '.*/[0-9]+' -printf '%T@\t%p\n' 2>/dev/null \
    | gsort -rn | gtail -n +21 | gawk -F'\t' '{ print $2 }' | while IFS= read -r d; do rm -rf -- "$d"; done
}

# 5. Wait for every run on that commit.
t0=$(gdate +%s)
limit="$t_wait"
appear="$t_appear"
errs=0
rows="$tmp/rows"
while :; do
  "$gh_bin" run list -R "$repo" --branch "$branch" --limit 20 \
    --json databaseId,headSha,status,conclusion,url,name \
    --jq ".[] | select(.headSha==\"$commit\") | [.databaseId, .status, (if (.conclusion // \"\") == \"\" then \"-\" else .conclusion end), .url, .name] | @tsv" \
    > "$rows" 2> "$tmp/gh.err"
  grc=$?
  now=$(gdate +%s); el=$((now - t0))
  if [ "$grc" != 0 ]; then
    errs=$((errs + 1))
    if [ "$errs" -ge 5 ]; then
      say "offload: gh run list failed $errs times in a row (last: $(ghead -n 1 "$tmp/gh.err")); no verdict. Branch: https://github.com/$repo/tree/$branch"
      exit 77
    fi
  else
    errs=0
    if [ ! -s "$rows" ]; then
      if [ "$el" -ge "$appear" ]; then
        say "offload: no CI run for commit ${commit:0:8} appeared on $branch after ${el} s; no verdict. Branch: https://github.com/$repo/tree/$branch"
        exit 77
      fi
    else
      pending=0 failed=0 odd=0 ok=0 first_fail="" first_url="" n=0 ok_ids=()
      while IFS=$'\t' read -r id status concl rurl rname; do
        n=$((n + 1)); [ -n "$first_url" ] || first_url="$rurl"
        if [ "$status" != completed ]; then pending=1; continue; fi
        case "$concl" in
          success) ok=$((ok + 1)); ok_ids+=("$id") ;;
          skipped|neutral) ;;
          failure) failed=1; [ -n "$first_fail" ] || first_fail="$id" ;;
          *) odd=1; say "offload: run $id ($rname) ended '$concl': $rurl" ;;
        esac
      done < "$rows"
      if [ "$pending" = 0 ]; then
        if [ "$failed" = 1 ]; then
          # The failing job's log: the useful part. Kept whole in the bg state dir, tail printed.
          case "$first_fail" in ""|*[!0-9]*) say "offload: odd run id '$first_fail'; no verdict"; exit 77 ;; esac
          logd="$HOME/.local/state/bg/offload"; mkdir -p "$logd"
          "$gh_bin" run view "$first_fail" -R "$repo" --log-failed > "$tmp/failed.log" 2> "$tmp/gh.err"
          if [ -s "$tmp/failed.log" ]; then
            chmod 600 "$tmp/failed.log"
            mv -f "$tmp/failed.log" "$logd/$first_fail.log.tmp" && mv -f "$logd/$first_fail.log.tmp" "$logd/$first_fail.log"
            echo "bg: CI FAILED (${el} s): https://github.com/$repo/actions/runs/$first_fail"
            echo "bg: failed-step log, last 60 lines (full: $logd/$first_fail.log):"
            gtail -n 60 "$logd/$first_fail.log"
          else
            echo "bg: CI FAILED (${el} s): https://github.com/$repo/actions/runs/$first_fail"
            echo "bg: no failed-step log available yet; gh run view $first_fail -R $repo --log-failed"
          fi
          exit 1
        elif [ "$odd" = 1 ]; then
          exit 77
        elif [ "$ok" = 0 ]; then
          say "offload: all $n run(s) were skipped or neutral, so nothing was tested: $first_url"
          exit 77
        fi
        echo "bg: CI workflow PASSED on this tree (${el} s, $ok of $n run(s) succeeded): $first_url"
        echo "bg: ref: $what. The repo's whole CI workflow passed; the command you named was not selected on its own: $cmd_text"
        download_artifacts
        exit 0
      fi
    fi
  fi
  if [ "$el" -ge "$limit" ]; then
    say "offload: CI had not finished after ${el} s (BG_OFFLOAD_WAIT=$limit); the run is still going: ${first_url:-https://github.com/$repo/tree/$branch}"
    exit 76
  fi
  sleep "$poll" &
  wait $!
done
