#!/usr/bin/env bash
# bg-offload — run a held test command on CI instead, and report CI's verdict (bg's helper, 2026-10-23).
#
#   bg-offload --probe TOP            exit 0 when TOP has a runnable CI route (bg asks once, up front)
#   bg-offload TOP -- CMD [ARGS...]   run the repo's CI route on TOP's HEAD (which must already be on the
#                                     remote), wait, print the result; CMD is only used to name the run and to
#                                     check the test paths it names (CI cannot see a path that is missing,
#                                     untracked or outside the repo)
#
# Why (djbclark, 2026-10-23, answering a question card): in a repo recorded as `ci` (load-watch ci) a
# targeted test run stays on this Mac, and on a busy Mac bg's load gate parked a 2 s pytest file for over
# an hour. So when the gate has held such a run past BG_OFFLOAD_AFTER seconds (bg decides that), bg calls
# this helper instead of waiting on: the repo's CI runs and bg exits with CI's verdict. bg never execs
# the command after an offload.
#
# The runnable route is a convention, not a recorded string (the `load-watch ci` text is free text of many
# shapes and is never executed): an executable `scripts/bg-offload-run` in the repo top, else
# `scripts/github-ci-run`. It is called as `RUNNER --no-wait REF` from the repo top and must push the run
# and print two lines on stdout, which scripts/github-ci-run already does:
#   overlay <40-hex commit that the CI run builds> for <ref sha> -> <remote> <branch>
#   pushed https://github.com/<owner>/<repo>/tree/<branch>      (ShizukuTendCF prints `branch: https://...`
#                                                                 instead; both are accepted)
# A repo with a faster route than the whole CI workflow (sudo-secretspec: a plain push runs only the
# 2-minute `packaging` job) ships its own scripts/bg-offload-run with the same contract. A linked git
# worktree (.git is a file) has no route: github-ci-run sets GIT_DIR=$top/.git. No route, no gh, no
# git, nothing publishable (see below): this helper says so and exits 69, and bg goes on waiting at the gate as it
# always did.
#
# What may be offloaded (adversary reviews of c7cab20, 200776a and 3bf4122, 2026-10-23, and djbclark's ruling
# that followed: bg-offload publishes NOTHING that is not already on the remote. Three review rounds each found
# another way past a scan of what would be pushed, so there is no scan and no opt-in): all of
#   (a) no tracked file is modified, in the working tree or the index (`git status --porcelain`, untracked files
#       aside: they never travel and never block; they are listed);
#   (b) HEAD is contained in the remote: `git rev-list --count HEAD --not --remotes=$remote` is 0, remote =
#       $GITHUB_CI_REMOTE or origin, the name the runners use;
#   (c) a local branch ci/base, if there is one, is not ahead of refs/remotes/$remote/ci/base (the runners overlay
#       it onto the run, so it is published content).
# If any fails: one line per reason (dirty files capped, N unpushed commits, ci/base ahead), nothing is pushed or
# built, exit 69, and bg keeps waiting at the gate as it always did. The dev flow: commit and push, then bg
# offloads. The runner is then called on HEAD itself, and the only thing it pushes is the CI overlay branch
# built from commits that are already public.
# A named test path that does not exist, is untracked or git-ignored, is a directory with no tracked file, or
# resolves outside the repo top also exits 69 (pytest/unittest arguments that look like paths: end in .py,
# contain `/` or `::`, or are directories; a unittest dotted id is not checked).
#
# Budget: the offload has its own budget, not BG_MAX_WAIT: up to BG_OFFLOAD_PUSH_TIMEOUT (900 s) for the runner
# plus BG_OFFLOAD_WAIT (2400 s) for CI, after the hold that triggered it. bg's own ping is not sent for it.
#
# The wait is ours, not the runner's (github-ci-run's own wait gives up at 480 s and a full Linux CI run
# of sudo-secretspec takes longer): the runner is started with --no-wait, then this polls `gh run list -R
# OWNER/REPO` (always -R: gh in some checkouts resolves to an upstream remote) for the runs whose head is
# the pushed commit until all are completed, up to BG_OFFLOAD_WAIT seconds (default 2400).
#
# Exit codes (bg 3 = refused CI-first and 75 = wait budget keep their meaning; neither is used here):
#   0   at least one CI run concluded success and none failed: "CI's workflow passed on this tree". It does NOT
#       mean the test the caller named passed on its own: CI ran the repo's whole workflow
#   1   a CI run concluded failure: the failed-step log tail and the full log's path are printed
#   69  not offloaded (no route, no gh, a tracked change, an unpushed commit, ci/base ahead, a named test path CI
#       cannot see, or the runner failed: it may have pushed before failing, but no run is followed): bg falls
#       back to waiting at the gate
#   76  CI did not finish within BG_OFFLOAD_WAIT; the run is still going, its URL is printed
#   77  pushed, but no verdict: no run appeared, gh kept failing, every run was skipped/neutral, or a run
#       was cancelled/timed out
# Test hooks, honoured ONLY with BG_OFFLOAD_TESTING=1 (an inherited BG_GH or BG_OFFLOAD_RUNNER must not redirect a
# real run): BG_GH (gh binary), BG_OFFLOAD_RUNNER (route). Timing knobs: BG_OFFLOAD_POLL
# (poll seconds, default 20), BG_OFFLOAD_APPEAR (seconds to wait for the run to show up, default 240).
export PATH="/opt/homebrew/bin:$PATH"
if [ "${BG_OFFLOAD_TESTING:-0}" = 1 ]; then
  gh_bin="${BG_GH:-gh}"; runner_override="${BG_OFFLOAD_RUNNER:-}"
else
  gh_bin=gh; runner_override=""
fi
poll="${BG_OFFLOAD_POLL:-20}"

say() { echo "bg: $*" >&2; }

# route <top>: print the runner path, or fail.
route() {
  local top="$1" r
  [ -d "$top/.git" ] || return 1
  if [ -n "$runner_override" ]; then
    [ -x "$runner_override" ] && { printf '%s\n' "$runner_override"; return 0; }
    return 1
  fi
  for r in "$top/scripts/bg-offload-run" "$top/scripts/github-ci-run"; do
    [ -f "$r" ] && [ -x "$r" ] && { printf '%s\n' "$r"; return 0; }
  done
  return 1
}

if [ "${1:-}" = --probe ]; then
  top="${2:-}"
  [ -n "$top" ] && command -v git >/dev/null 2>&1 && command -v "$gh_bin" >/dev/null 2>&1 \
    && command -v gdate >/dev/null 2>&1 && route "$top" >/dev/null
  exit $?
fi

top="${1:-}"
if [ -z "$top" ] || [ "${2:-}" != -- ]; then
  echo "usage: bg-offload --probe TOP | bg-offload TOP -- CMD [ARGS...]" >&2
  exit 2
fi
shift 2
cmd_text="$*"

top=$(greadlink -f "$top") || exit 69
runner=$(route "$top") || { say "offload: no runnable CI route in $top (scripts/bg-offload-run or scripts/github-ci-run)"; exit 69; }
command -v "$gh_bin" >/dev/null 2>&1 || { say "offload: gh not found"; exit 69; }
command -v gdate >/dev/null 2>&1 || { say "offload: gdate not found"; exit 69; }

tmp=$(gmktemp -d "${TMPDIR:-/tmp}/bg-offload.XXXXXX") || exit 69
trap 'rm -rf "$tmp"' EXIT
# bg may kill us (it runs us as a child): bash runs the EXIT trap above when a TERM ends it (checked 2026-10-23), so
# no TERM trap is needed while polling; only the push phase below traps TERM, to kill the runner's process group.

# 1. Tree state.
porc="$tmp/porcelain"
git -C "$top" status --porcelain > "$porc" 2>/dev/null || { say "offload: git status failed in $top"; exit 69; }
untracked=$(ggrep '^?? ' "$porc" | gcut -c4-)
ggrep -v '^?? ' "$porc" > "$tmp/tracked" || true
tracked_dirty=$(gwc -l < "$tmp/tracked" | gtr -d ' ')
head_sha=$(git -C "$top" rev-parse --verify HEAD 2>/dev/null) || { say "offload: no HEAD commit in $top"; exit 69; }
remote="${GITHUB_CI_REMOTE:-origin}"
case "$remote" in ""|*[!A-Za-z0-9._-]*) say "offload: odd remote name '$remote'"; exit 69 ;; esac
local_n=$(git -C "$top" rev-list --count "$head_sha" --not "--remotes=$remote" 2>/dev/null) || { say "offload: rev-list failed in $top"; exit 69; }

# 2. A test path CI cannot see: missing (a typo, or deleted here), untracked, git-ignored, an untracked-only
# directory, or outside the repo. CI would run the repo's own tests and report success for what it never saw.
# Only pytest/unittest arguments are read; flags and everything up to the runner word are skipped.
seen=0 prev=""
for a in "$@"; do
  if [ "$seen" = 0 ]; then
    case "${a##*/}" in pytest|py.test) seen=1 ;; esac
    [ "$prev" = -m ] && case "$a" in pytest|unittest) seen=1 ;; esac
    prev=$a
    continue
  fi
  case "$a" in -*) continue ;; esac
  p="${a%%::*}"
  case "$p" in *.py|*/*|*::*) ;; *) [ -d "$p" ] || continue ;; esac
  if [ ! -e "$p" ]; then
    say "offload: $a names $p, which does not exist here (a typo, or deleted in the working tree); not offloading"
    exit 69
  fi
  full=$(greadlink -f "$p") || exit 69
  case "$full/" in
    "$top"/*) ;;
    *) say "offload: $p is outside the repo $top, so CI cannot run it; not offloading"; exit 69 ;;
  esac
  if [ -d "$p" ]; then
    if [ -z "$(git ls-files -- "$p" | ghead -n 1)" ]; then
      say "offload: directory $p has no tracked file, so CI cannot run it; not offloading"
      exit 69
    fi
  elif ! git ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
    say "offload: $p is untracked (or git-ignored), so CI cannot run it; not offloading"
    exit 69
  fi
done

# 3. Publish NOTHING that is not already on the remote (adversary reviews of c7cab20, 200776a and 3bf4122,
# 2026-10-23: three rounds of "scan what we publish" each found another way past the scan, so the mechanism is
# gone: a load threshold must not push anything). All of (a) no tracked modification, working tree or index,
# (b) HEAD contained in the remote, (c) local ci/base, if any, not ahead of the remote's, must hold; else one
# line per reason, exit 69, and bg keeps waiting at the gate. The caller can commit and push, then retry.
refuse=0
if [ "$tracked_dirty" != 0 ]; then
  refuse=1
  say "offload: $tracked_dirty tracked file(s) with uncommitted changes (working tree or index) in $top; CI would not see them:"
  ghead -n 20 "$tmp/tracked" | gsed 's/^/bg:   /' >&2
  [ "$tracked_dirty" -gt 20 ] && say "offload:   ... and $((tracked_dirty - 20)) more"
fi
if [ "$local_n" != 0 ]; then
  refuse=1
  say "offload: $local_n commit(s) in HEAD are not on remote $remote (unpushed):"
  git -C "$top" log --oneline -n 10 "$head_sha" --not "--remotes=$remote" | gsed 's/^/bg:   /' >&2
  [ "$local_n" -gt 10 ] && say "offload:   ... and $((local_n - 10)) more"
fi
# The runners overlay the local branch ci/base onto the run, so it is published content too. show-ref exits 0
# (exists), 1 (absent) or 128 (a ref that cannot be read, e.g. its object is missing): only 1 means "no ci/base";
# anything unreadable is treated as ahead, never as absent.
git -C "$top" show-ref --verify --quiet refs/heads/ci/base; base_state=$?
if [ "$base_state" != 1 ]; then
  base_n=-1
  if [ "$base_state" = 0 ]; then
    git -C "$top" show-ref --verify --quiet "refs/remotes/$remote/ci/base"; rem_state=$?
    if [ "$rem_state" = 0 ]; then
      base_n=$(git -C "$top" rev-list --count refs/heads/ci/base --not "refs/remotes/$remote/ci/base" 2>/dev/null) || base_n=-1
    elif [ "$rem_state" = 1 ]; then
      base_n=$(git -C "$top" rev-list --count refs/heads/ci/base --not "--remotes=$remote" 2>/dev/null) || base_n=-1
    fi
  fi
  case "$base_n" in ""|*[!0-9-]*) base_n=-1 ;; esac
  if [ "$base_n" = -1 ]; then
    refuse=1
    say "offload: could not compare local ci/base with $remote/ci/base (git could not read a ref); treating it as ahead"
  elif [ "$base_n" != 0 ]; then
    refuse=1
    say "offload: local branch ci/base is ahead of $remote/ci/base ($base_n commit(s)); the runners overlay it onto the run, so it would be published"
  fi
fi
if [ "$refuse" = 1 ]; then
  say "offload: not publishing anything just because the machine is busy; commit and push, then run bg again to offload. Waiting at the gate instead."
  exit 69
fi
ref="$head_sha"
if [ -n "$untracked" ]; then what="HEAD ${head_sha:0:8}, already on $remote (the tree has untracked files, which CI does not get)"
else what="HEAD ${head_sha:0:8}, already on $remote"; fi

# Untracked files are never in the ref: listed.
if [ -n "$untracked" ]; then
  say "offload: untracked files are NOT in the CI run:"
  printf '%s\n' "$untracked" | ghead -n 20 | gsed 's/^/bg:   ?? /' >&2
  [ "$(printf '%s\n' "$untracked" | gwc -l)" -gt 20 ] && say "offload:   ... and more"
fi

# 4. Push the run (the runner's own wait is skipped: --no-wait).
say "offload: running the repo's CI on $what via ${runner#$top/}"
out="$tmp/runner.out"
cd "$top" || exit 69
# In its own process group (set -m) and a background job we wait on: a kill of bg reaches us as TERM and our trap
# then kills the whole group (gtimeout, the runner script, its git push), not just the runner's top process.
set -m
gtimeout "${BG_OFFLOAD_PUSH_TIMEOUT:-900}" "$runner" --no-wait "$ref" > "$out" 2> "$tmp/runner.err" < /dev/null &
rpid=$!
set +m
trap 'kill -TERM -- "-$rpid" 2>/dev/null; kill -TERM "$rpid" 2>/dev/null; exit 143' TERM INT HUP
wait "$rpid"
rc=$?
trap - TERM INT HUP
if [ "$rc" != 0 ]; then
  say "offload: the CI runner exited $rc (it may have pushed before failing; no run is followed). Its stderr tail:"
  gtail -n 8 "$tmp/runner.err" | gsed 's/^/bg:   /' >&2
  exit 69
fi
commit=$(gawk '/^overlay [0-9a-f]+ for /{print $2; exit}' "$out")
url=$(gawk '/^(pushed|branch:) https:\/\/github.com\//{print $2; exit}' "$out")
repo=${url#https://github.com/}; repo=${repo%%/tree/*}
branch=${url#*/tree/}
case "$commit" in *[!0-9a-f]*|"") commit="" ;; esac
[ "${#commit}" = 40 ] || commit=""
case "$repo" in */*/*|*[!A-Za-z0-9._/-]*|""|/*|*/) repo="" ;; esac
case "$branch" in *[!A-Za-z0-9._/-]*|"") branch="" ;; esac
if [ -z "$commit" ] || [ -z "$repo" ] || [ -z "$branch" ]; then
  say "offload: the runner pushed (rc 0) but its output has no 'overlay <sha> for ...' and 'pushed|branch: https://github.com/OWNER/REPO/tree/BRANCH' lines; no verdict. Its stdout:"
  gtail -n 8 "$out" | gsed 's/^/bg:   /' >&2
  exit 77
fi
say "offload: pushed $branch on $repo (commit ${commit:0:8}); waiting for CI, up to ${BG_OFFLOAD_WAIT:-2400} s"
say "offload: this runs the repo's whole CI workflow, not only: $cmd_text"

# 5. Wait for every run on that commit.
t0=$(gdate +%s)
limit="${BG_OFFLOAD_WAIT:-2400}"
appear="${BG_OFFLOAD_APPEAR:-240}"
errs=0
rows="$tmp/rows"
while :; do
  "$gh_bin" run list -R "$repo" --branch "$branch" --limit 20 \
    --json databaseId,headSha,status,conclusion,url,name \
    --jq ".[] | select(.headSha==\"$commit\") | [.databaseId, .status, (if (.conclusion // \"\") == \"\" then \"-\" else .conclusion end), .url, .name] | @tsv" \
    > "$rows" 2> "$tmp/gh.err"
  grc=$?
  now=$(gdate +%s); el=$((now - t0))
  if [ "$grc" != 0 ]; then
    errs=$((errs + 1))
    if [ "$errs" -ge 5 ]; then
      say "offload: gh run list failed $errs times in a row (last: $(ghead -n 1 "$tmp/gh.err")); no verdict. Branch: https://github.com/$repo/tree/$branch"
      exit 77
    fi
  else
    errs=0
    if [ ! -s "$rows" ]; then
      if [ "$el" -ge "$appear" ]; then
        say "offload: no CI run for commit ${commit:0:8} appeared on $branch after ${el} s; no verdict. Branch: https://github.com/$repo/tree/$branch"
        exit 77
      fi
    else
      pending=0 failed=0 odd=0 ok=0 first_fail="" first_url="" n=0
      while IFS=$'\t' read -r id status concl rurl rname; do
        n=$((n + 1)); [ -n "$first_url" ] || first_url="$rurl"
        if [ "$status" != completed ]; then pending=1; continue; fi
        case "$concl" in
          success) ok=$((ok + 1)) ;;
          skipped|neutral) ;;
          failure) failed=1; [ -n "$first_fail" ] || first_fail="$id" ;;
          *) odd=1; say "offload: run $id ($rname) ended '$concl': $rurl" ;;
        esac
      done < "$rows"
      if [ "$pending" = 0 ]; then
        if [ "$failed" = 1 ]; then
          # The failing job's log: the useful part. Kept whole in the bg state dir, tail printed.
          case "$first_fail" in ""|*[!0-9]*) say "offload: odd run id '$first_fail'; no verdict"; exit 77 ;; esac
          logd="$HOME/.local/state/bg/offload"; mkdir -p "$logd"
          "$gh_bin" run view "$first_fail" -R "$repo" --log-failed > "$tmp/failed.log" 2> "$tmp/gh.err"
          if [ -s "$tmp/failed.log" ]; then
            chmod 600 "$tmp/failed.log"
            mv -f "$tmp/failed.log" "$logd/$first_fail.log.tmp" && mv -f "$logd/$first_fail.log.tmp" "$logd/$first_fail.log"
            echo "bg: CI FAILED (${el} s): https://github.com/$repo/actions/runs/$first_fail"
            echo "bg: failed-step log, last 60 lines (full: $logd/$first_fail.log):"
            gtail -n 60 "$logd/$first_fail.log"
          else
            echo "bg: CI FAILED (${el} s): https://github.com/$repo/actions/runs/$first_fail"
            echo "bg: no failed-step log available yet; gh run view $first_fail -R $repo --log-failed"
          fi
          exit 1
        elif [ "$odd" = 1 ]; then
          exit 77
        elif [ "$ok" = 0 ]; then
          say "offload: all $n run(s) were skipped or neutral, so nothing was tested: $first_url"
          exit 77
        fi
        echo "bg: CI workflow PASSED on this tree (${el} s, $ok of $n run(s) succeeded): $first_url"
        echo "bg: ref: $what. The repo's whole CI workflow passed; the command you named was not selected on its own: $cmd_text"
        exit 0
      fi
    fi
  fi
  if [ "$el" -ge "$limit" ]; then
    say "offload: CI had not finished after ${el} s (BG_OFFLOAD_WAIT=$limit); the run is still going: ${first_url:-https://github.com/$repo/tree/$branch}"
    exit 76
  fi
  sleep "$poll" &
  wait $!
done
