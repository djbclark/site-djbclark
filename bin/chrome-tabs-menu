#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyobjc-framework-Cocoa"]
# ///
"""Pop up a menu of the tabs open in Chrome; the one you pick opens in Safari.

  chrome-tabs-menu               pop the menu at the pointer (bind it to an ExtraBar button)
  chrome-tabs-menu --count       print window and tab counts per profile, no UI
  chrome-tabs-menu --bookmarks   pop the menu of every profile's bookmarks (read at click time)
  chrome-tabs-menu --bookmarks --count   print bookmark and folder counts per profile, no UI
  chrome-tabs-menu --all-profiles  also use each profile's newest session file (stale if the profile is closed)
  chrome-tabs-menu --install     fetch lemnos/chrome-session-dump into ~/.local/bin (sha256 checked)

Tabs come from lemnos/chrome-session-dump, which reads Chrome's own Session_* files, so the
list is the open tabs of every profile Chrome has open right now (found with lsof) and needs no
browser extension or debugging port. Only http(s) tabs are listed; chrome:// pages and the like
are counted but hidden, because Safari cannot open them. Opening runs
"open -a Safari URL" as an argument vector (no shell), so a tab URL is never interpreted.

Bookmarks (--bookmarks) come straight from each profile's AccountBookmarks (the signed-in
bookmarks) merged with its local Bookmarks file, read when the menu is popped, so the menu is
current. A profile with no bookmarks is skipped; with two or more, each gets a submenu. Under each
come Chrome's own roots (Bookmarks bar, Other bookmarks, Mobile bookmarks) and then the folders as
submenus; a pick opens in Safari like a tab. javascript: bookmarklets and other non-web URLs are
counted but hidden.

Environment: CHROME_SESSION_DUMP (binary path), CHROME_USER_DATA_DIR (default
~/Library/Application Support/Google/Chrome), CHROME_TABS_BROWSER (default Safari).
"""

from __future__ import annotations

import argparse
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from collections import OrderedDict
from pathlib import Path
from urllib.parse import unquote, urlsplit

DUMP_VERSION = "v0.0.2"
# sha256 of the v0.0.2 release asset chrome-session-dump-osx (x86_64; runs under Rosetta).
DUMP_SHA256 = "81d9c1880ffb81c95050bf684c4934339f72ca08c063617de81932bbbafb44c6"
DUMP_URL = f"https://github.com/lemnos/chrome-session-dump/releases/download/{DUMP_VERSION}/chrome-session-dump-osx"
GROUP_MIN = 4  # a site with this many tabs in one window gets its own submenu
TITLE_MAX = 80
SESSION_RE = re.compile(r"/([^/]+)/Sessions/Session_(\d+)$")


def user_data_dir() -> Path:
    return Path(
        os.environ.get("CHROME_USER_DATA_DIR")
        or "~/Library/Application Support/Google/Chrome"
    ).expanduser()


def find_dump() -> str:
    for cand in (
        os.environ.get("CHROME_SESSION_DUMP"),
        shutil.which("chrome-session-dump"),
        str(Path("~/.local/bin/chrome-session-dump").expanduser()),
    ):
        if cand and os.access(cand, os.X_OK):
            return cand
    sys.exit(
        "chrome-tabs-menu: chrome-session-dump not found; run: chrome-tabs-menu --install"
    )


def install() -> None:
    dest = Path("~/.local/bin/chrome-session-dump").expanduser()
    dest.parent.mkdir(parents=True, exist_ok=True)
    with urllib.request.urlopen(DUMP_URL, timeout=60) as r:
        data = r.read()
    digest = hashlib.sha256(data).hexdigest()
    if digest != DUMP_SHA256:
        sys.exit(f"chrome-tabs-menu: sha256 mismatch for {DUMP_URL}: got {digest}")
    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=".chrome-session-dump.")
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.chmod(tmp, 0o755)
    os.replace(tmp, dest)  # atomic
    print(f"installed {dest} ({DUMP_VERSION}, sha256 verified)")


def profile_names(base: Path) -> dict[str, str]:
    try:
        cache = json.loads((base / "Local State").read_text())["profile"]["info_cache"]
    except (OSError, ValueError, KeyError):
        return {}
    return {d: str(v.get("name") or d) for d, v in cache.items()}


def parse_lsof(text: str) -> dict[str, str]:
    """Profile directory -> session file, from lsof -Fn output (newest file wins)."""
    found: dict[str, tuple[int, str]] = {}
    for line in text.splitlines():
        if not line.startswith("n"):
            continue
        m = SESSION_RE.search(line[1:])
        if m and (m.group(1) not in found or int(m.group(2)) > found[m.group(1)][0]):
            found[m.group(1)] = (int(m.group(2)), line[1:])
    return {k: v[1] for k, v in found.items()}


def live_session_files(base: Path) -> dict[str, str]:
    out = subprocess.run(
        ["lsof", "-n", "-w", "-c", "Google Chrome", "-Fn"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    return {k: v for k, v in parse_lsof(out).items() if v.startswith(str(base) + "/")}


def newest_session_files(base: Path) -> dict[str, str]:
    found = {}
    for d in base.iterdir():
        files = glob.glob(str(d / "Sessions" / "Session_*"))
        if files:
            found[d.name] = max(files, key=lambda p: int(p.rsplit("_", 1)[1]))
    return found


def trim_to_last_record(data: bytes) -> bytes:
    """Cut an SNSS session snapshot at its last complete record.

    Chrome appends to the live Session_* file, so a read can end inside a record, and
    chrome-session-dump panics on that ("Failed to read N bytes"). Records are
    [uint16 size][size bytes] after an 8-byte header, so the last whole one is easy to find.
    """
    pos = 8
    while pos + 2 <= len(data):
        size = int.from_bytes(data[pos : pos + 2], "little")
        if size == 0 or pos + 2 + size > len(data):
            break
        pos += 2 + size
    return data[:pos] if data[:4] == b"SNSS" else data


def dump_windows(dump: str, session_file: str) -> list[list[dict[str, str]]]:
    """Open tabs per window: [[{url, title}, ...], ...]; deleted tabs are dropped.

    Reads a trimmed private (0600) snapshot, never the live file, and removes it afterwards.
    """
    fd, snap = tempfile.mkstemp(prefix="chrome-tabs-menu.", suffix=".Session_snapshot")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(trim_to_last_record(Path(session_file).read_bytes()))
        r = subprocess.run(
            [dump, "-json", snap], capture_output=True, text=True, check=False
        )
    finally:
        os.unlink(snap)
    if r.returncode != 0:
        # The Go panic prints its message first and a long goroutine trace after it.
        first = (r.stderr.strip().splitlines() or ["no output"])[0][:200]
        raise RuntimeError(
            f"chrome-session-dump failed on {Path(session_file).name}: {first}"
        )
    wins = json.loads(r.stdout).get("windows", [])
    return [
        [
            {"url": t.get("url", ""), "title": t.get("title", "")}
            for t in w.get("tabs", [])
            if not t.get("deleted")
        ]
        for w in wins
        if not w.get("deleted")
    ]


def real_url(url: str) -> str:
    """The page a tab really shows: unwrap tab-suspender extension pages (suspended.html#...&uri=URL,
    park.html?title=...&url=ENCODED, discarded pages), whose own address Safari could not open."""
    u = urlsplit(url)
    if u.scheme not in ("chrome-extension", "moz-extension"):
        return url
    for part in (u.fragment, u.query):
        m = re.search(r"(?:^|&)(?:uri|url)=(.+)$", part)
        if m and re.match(r"https?://", m.group(1)):
            return m.group(1)  # unencoded and last, as The Great Suspender writes it
        m = re.search(r"(?:^|&)(?:uri|url)=([^&]+)", part)
        if m and re.match(r"https?://", unquote(m.group(1))):
            return unquote(m.group(1))
    return url


def split_openable(tabs: list[dict]) -> tuple[list[dict], int]:
    tabs = [{**t, "url": real_url(t["url"])} for t in tabs]
    ok = [
        t
        for t in tabs
        if urlsplit(t["url"]).scheme in ("http", "https") and urlsplit(t["url"]).netloc
    ]
    return ok, len(tabs) - len(ok)


def group_by_host(tabs: list[dict]) -> list[tuple[str, list[dict]]]:
    """Ordered (label, tabs) entries; a host with GROUP_MIN+ tabs is one group, the rest stay flat singles."""
    by_host: OrderedDict[str, list[dict]] = OrderedDict()
    for t in tabs:
        by_host.setdefault(urlsplit(t["url"]).hostname or "", []).append(t)
    big = {h for h, ts in by_host.items() if len(ts) >= GROUP_MIN}
    entries: list[tuple[str, list[dict]]] = []
    emitted: set[str] = set()
    for t in tabs:
        h = urlsplit(t["url"]).hostname or ""
        if h in big:
            if h not in emitted:
                emitted.add(h)
                entries.append((h, by_host[h]))
        else:
            entries.append(("", [t]))
    return entries


def collect(all_profiles: bool) -> list[dict]:
    base = user_data_dir()
    dump = find_dump()
    files = newest_session_files(base) if all_profiles else live_session_files(base)
    names = profile_names(base)
    wins = []
    for pdir in sorted(files):
        for i, tabs in enumerate(dump_windows(dump, files[pdir]), 1):
            ok, hidden = split_openable(tabs)
            if tabs:
                wins.append(
                    {
                        "profile": names.get(pdir, pdir),
                        "n": i,
                        "tabs": ok,
                        "hidden": hidden,
                    }
                )
    return wins


ROOT_ORDER = ("bookmark_bar", "other", "synced")
ROOT_DEFAULT_NAMES = {
    "bookmark_bar": "Bookmarks bar",
    "other": "Other bookmarks",
    "synced": "Mobile bookmarks",
}
BOOKMARK_FILES = (
    "AccountBookmarks",
    "Bookmarks",
)  # signed-in copy first, then the local file


def is_web_url(url: str) -> bool:
    u = urlsplit(url)
    return u.scheme in ("http", "https") and bool(u.netloc)


def clean_node(node: dict) -> dict | None:
    """A Chrome bookmark node as {"name", "url"} or {"name", "children"}; None when it has no web link.

    Non-web URLs (javascript: bookmarklets, chrome:// pages) and folders left empty by that are dropped.
    """
    if not isinstance(node, dict):
        return None
    name = str(node.get("name") or "")
    if node.get("type") == "folder" or "children" in node:
        kids = [c for c in map(clean_node, node.get("children") or []) if c]
        return {"name": name, "children": kids} if kids else None
    url = str(node.get("url") or "")
    return {"name": name, "url": url} if is_web_url(url) else None


def merge_children(first: list[dict], second: list[dict]) -> list[dict]:
    """first then second; a folder of the same name is merged, a link already present is dropped."""
    out = [dict(n) for n in first]
    for n in second:
        if "children" in n:
            twin = next(
                (o for o in out if "children" in o and o["name"] == n["name"]), None
            )
            if twin is not None:
                twin["children"] = merge_children(twin["children"], n["children"])
            else:
                out.append(dict(n))
        elif not any(o.get("url") == n["url"] for o in out):
            out.append(dict(n))
    return out


def merge_bookmark_files(docs: list[dict]) -> list[dict]:
    """Bookmark JSON documents (signed-in first) -> [{"key","name","children"}] for the roots that hold a link."""
    merged: dict[str, dict] = {}
    for doc in docs:
        roots = doc.get("roots") if isinstance(doc, dict) else None
        if not isinstance(roots, dict):
            continue
        for key in ROOT_ORDER:
            node = clean_node(roots.get(key) or {})
            if not node:
                continue
            if key in merged:
                merged[key]["children"] = merge_children(
                    merged[key]["children"], node["children"]
                )
            else:
                name = node["name"] or ROOT_DEFAULT_NAMES[key]
                merged[key] = {"key": key, "name": name, "children": node["children"]}
    return [merged[k] for k in ROOT_ORDER if k in merged]


def count_bookmarks(nodes: list[dict]) -> tuple[int, int]:
    """(links, folders) below a list of nodes."""
    links = folders = 0
    for n in nodes:
        if "children" in n:
            folders += 1
            a, b = count_bookmarks(n["children"])
            links, folders = links + a, folders + b
        else:
            links += 1
    return links, folders


def profile_bookmarks(pdir: Path) -> list[dict]:
    """Merged roots of one profile directory; a file that is missing or not JSON is skipped.

    PermissionError is not swallowed: it means Chrome's folder is unreadable (macOS privacy).
    """
    docs = []
    for fn in BOOKMARK_FILES:
        try:
            docs.append(json.loads((pdir / fn).read_text()))
        except (FileNotFoundError, NotADirectoryError, ValueError):
            continue
    return merge_bookmark_files(docs)


def profile_dirs(base: Path) -> list[Path]:
    """Default first, then the others in natural order (Profile 2 before Profile 10)."""

    def key(p: Path):
        m = re.fullmatch(r"Profile (\d+)", p.name)
        return (0, 0) if p.name == "Default" else (1, int(m.group(1))) if m else (2, 0)

    return sorted(
        (
            d
            for d in base.iterdir()
            if d.name == "Default" or d.name.startswith("Profile ")
        ),
        key=lambda d: (key(d), d.name),
    )


def collect_bookmarks() -> list[dict]:
    """[{"profile", "roots"}] for every profile holding at least one web bookmark."""
    base = user_data_dir()
    names = profile_names(base)
    found = []
    for d in profile_dirs(base):
        if not d.is_dir():
            continue
        roots = profile_bookmarks(d)
        if roots:
            found.append({"profile": names.get(d.name, d.name), "roots": roots})
    return found


def menu_helpers(target):
    """(item, sub) builders shared by the tabs and bookmarks menus; PyObjC is imported lazily."""
    from AppKit import NSMenu, NSMenuItem

    def item(menu, title, url=None):
        it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            title[:TITLE_MAX], "openTab:" if url else None, ""
        )
        if url:
            it.setTarget_(target)
            it.setRepresentedObject_(url)
            it.setToolTip_(url)
        else:
            it.setEnabled_(False)
        menu.addItem_(it)
        return it

    def sub(menu, title):
        it = item(menu, title)
        it.setEnabled_(True)
        m = NSMenu.alloc().initWithTitle_(title)
        m.setAutoenablesItems_(False)
        it.setSubmenu_(m)
        return m

    return item, sub


def build_menu(wins: list[dict], target, notice: str | None = None):
    from AppKit import (
        NSMenu,
        NSMenuItem,
    )  # lazy so --count, --install and the tests need no PyObjC

    item, sub = menu_helpers(target)

    def fill(menu, tabs):
        for label, ts in group_by_host(tabs):
            if label:
                m = sub(menu, f"{label} ({len(ts)})")
                for t in ts:
                    item(m, t["title"] or t["url"], t["url"])
            else:
                item(menu, ts[0]["title"] or ts[0]["url"], ts[0]["url"])

    menu = NSMenu.alloc().initWithTitle_("Chrome tabs")
    menu.setAutoenablesItems_(False)
    if notice:
        item(menu, notice)
    elif not wins:
        item(menu, "No open Chrome tabs found")
    for w in wins if len(wins) > 1 else []:
        label = f"{w['profile']} · window {w['n']} ({len(w['tabs'])})"
        fill(sub(menu, label), w["tabs"])
    if len(wins) == 1:
        fill(menu, wins[0]["tabs"])
    hidden = sum(w["hidden"] for w in wins)
    if hidden:
        menu.addItem_(NSMenuItem.separatorItem())
        item(menu, f"{hidden} chrome:// and other non-web tabs hidden")
    return menu


def build_bookmarks_menu(profiles: list[dict], target, notice: str | None = None):
    from AppKit import NSMenu

    item, sub = menu_helpers(target)

    def fill(menu, nodes):
        for n in nodes:
            if "children" in n:
                fill(sub(menu, n["name"] or "(unnamed folder)"), n["children"])
            else:
                item(menu, n["name"] or n["url"], n["url"])

    def fill_roots(menu, roots):
        for r in roots:
            fill(sub(menu, r["name"]), r["children"])

    menu = NSMenu.alloc().initWithTitle_("Chrome bookmarks")
    menu.setAutoenablesItems_(False)
    if notice:
        item(menu, notice)
    elif not profiles:
        item(menu, "No Chrome bookmarks found")
    elif len(profiles) == 1:
        fill_roots(menu, profiles[0]["roots"])
    else:
        for p in profiles:
            fill_roots(sub(menu, p["profile"]), p["roots"])
    return menu


def show(wins: list, notice: str | None = None, builder=None) -> None:
    import time

    from AppKit import (
        NSApplication,
        NSApplicationActivationPolicyAccessory,
        NSBackingStoreBuffered,
        NSEvent,
        NSPopUpMenuWindowLevel,
        NSWindow,
    )
    from Foundation import NSMakeRect, NSObject, NSPoint

    browser = os.environ.get("CHROME_TABS_BROWSER", "Safari")

    class Target(NSObject):
        def openTab_(self, sender):
            subprocess.run(
                ["open", "-a", browser, str(sender.representedObject())], check=False
            )

    class Delegate(NSObject):
        # A menu popped before the run loop is up, or while the app is not active, is dismissed at once,
        # so pop it from applicationDidFinishLaunching after activating.
        def applicationDidFinishLaunching_(self, _note):
            app = NSApplication.sharedApplication()
            loc = NSEvent.mouseLocation()
            win = NSWindow.alloc().initWithContentRect_styleMask_backing_defer_(
                NSMakeRect(loc.x, loc.y, 1, 1), 0, NSBackingStoreBuffered, False
            )
            win.setLevel_(NSPopUpMenuWindowLevel)
            win.setOpaque_(False)
            win.setAlphaValue_(0.0)
            win.makeKeyAndOrderFront_(None)
            app.activateIgnoringOtherApps_(True)
            started = time.monotonic()
            self.menu.popUpMenuPositioningItem_atLocation_inView_(
                None, NSPoint(0, 0), win.contentView()
            )
            if os.environ.get("CHROME_TABS_DEBUG"):
                print(
                    f"chrome-tabs-menu: popUp returned after {time.monotonic() - started:.2f}s, active={app.isActive()}",
                    file=sys.stderr,
                )
            if time.monotonic() - started < 0.3:
                print(
                    "chrome-tabs-menu: the menu closed at once (the app could not take focus)",
                    file=sys.stderr,
                )
            app.terminate_(None)

    app = NSApplication.sharedApplication()
    app.setActivationPolicy_(NSApplicationActivationPolicyAccessory)
    target = Target.alloc().init()
    delegate = Delegate.alloc().init()
    delegate.menu = (builder or build_menu)(wins, target, notice)
    app.setDelegate_(delegate)
    app.run()


def main_bookmarks(count_only: bool) -> int:
    try:
        profiles = collect_bookmarks()
    except PermissionError as e:
        print(f"chrome-tabs-menu: {e}", file=sys.stderr)
        if count_only:
            return 1
        show(
            [],
            "Cannot read Chrome data: grant Full Disk Access to the launcher",
            build_bookmarks_menu,
        )
        return 1
    except OSError as e:
        print(f"chrome-tabs-menu: {e}", file=sys.stderr)
        if count_only:
            return 1
        show(
            [],
            "Could not read Chrome bookmarks (see the script's stderr)",
            build_bookmarks_menu,
        )
        return 1
    if count_only:
        total_links = total_folders = 0
        for p in profiles:
            links, folders = count_bookmarks(
                [n for r in p["roots"] for n in r["children"]]
            )
            total_links, total_folders = total_links + links, total_folders + folders
            print(f"{p['profile']}\t{links} bookmarks\t{folders} folders")
        print(
            f"total\t{total_links} bookmarks, {total_folders} folders in {len(profiles)} profiles"
        )
        return 0
    show(profiles, None, build_bookmarks_menu)
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument(
        "--count", action="store_true", help="print counts per profile window, no UI"
    )
    ap.add_argument(
        "--bookmarks",
        action="store_true",
        help="menu of the bookmarks of every profile (with --count: counts only)",
    )
    ap.add_argument(
        "--all-profiles",
        action="store_true",
        help="use each profile's newest session file, open or not",
    )
    ap.add_argument(
        "--install",
        action="store_true",
        help="install chrome-session-dump into ~/.local/bin",
    )
    a = ap.parse_args(argv)
    if a.install:
        install()
        return 0
    if a.bookmarks:
        return main_bookmarks(a.count)
    try:
        wins = collect(a.all_profiles)
    except PermissionError as e:
        # macOS privacy (TCC): a process started by a launcher without Full Disk Access cannot read Chrome's folder.
        print(f"chrome-tabs-menu: {e}", file=sys.stderr)
        if a.count:
            return 1
        show([], "Cannot read Chrome data: grant Full Disk Access to the launcher")
        return 1
    except (OSError, RuntimeError) as e:
        print(f"chrome-tabs-menu: {e}", file=sys.stderr)
        if a.count:
            return 1
        show([], "Could not read Chrome tabs (see the script's stderr)")
        return 1
    if a.count:
        for w in wins:
            print(
                f"{w['profile']}\twindow {w['n']}\t{len(w['tabs'])} openable\t{w['hidden']} hidden"
            )
        print(
            f"total\t{sum(len(w['tabs']) for w in wins)} openable in {len(wins)} windows"
        )
        return 0
    show(wins)
    return 0


if __name__ == "__main__":
    sys.exit(main())
