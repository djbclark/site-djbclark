#!/usr/bin/env bash
# EDITING THIS FILE: other agents run it live. Never edit in place: write the new version to a temp file in this
# directory, `bash -n` it, then `mv -f` it over (~/AGENTS.md item 2; 2026-11-01: in-place edits gave callers a syntax error).
# bg — run a command at utility QoS (taskpolicy -c utility).
#
# Utility QoS is biased toward the efficiency cores and lower power, but it still
# gets close to a normal share of CPU (measured 2026-10-04: 0.48 of a core against
# 0.52 for a normal process, with the machine at load 30-100), so a build or test
# run finishes in about normal time without crowding the UI. Children inherit it.
#
# Do NOT use `taskpolicy -b` for this: background QoS gave 0.02 of a core under the
# same load (25x slower). If you really want that, use `bgb`. `renice` does little
# on Apple silicon.
#
#   bg swift test
#   bg pytest -q tests/
#
# For a process that is already running: taskpolicy -B -p <pid> undoes background
# mode; there is no per-pid utility clamp, restart the command through bg instead.
#
# Admission gate: before starting, wait while the 1-minute load average per core is above
# BG_MAX_LOAD_PER_CORE (default 5.0, i.e. 50 on the 10-core M1 Pro; was 3.0 until 2026-11-21, 2.5 until 2026-11-14 and 1.5 until 2026-11-01, raised because load
# per core is a weak signal on this Mac and memory churn is the real one). Piling another
# build onto an overloaded machine makes every build slower. BG_LOAD_WAIT=0 skips the gate for a
# test or a small command, never for a Gradle command (2026-10-10); any other value just means
# "gate on". When the load drops after a wait, bg pauses 5-30 s at random and reads it again, so
# queued commands don't all start in the same second. The gate also asks `load-watch admit` for the
# memory side (compressor churn, 2026-10-23); it fails open if load-watch is missing or errors. Since 2026-11-14 bg looks once with
# `admit --wait 0` and, once held, hands the waiting to `load-watch admit --wait CHUNK` (CHUNK = BG_ADMIT_CHUNK, default 420 s, cut to the
# rest of BG_MAX_WAIT and, in a `ci` repo, to the CI-offload threshold): load-watch polls every 15 s, staggers, and applies its
# starvation valve (refused 300 s on soft gates only: one job through, one per 120 s machine-wide; hard gates never yield; its clock
# spans the chunks since bg passes `--refused-since EPOCH`, the epoch of the hold's first refusal, on every `--wait CHUNK` call, so the
# valve fires 300 s after the first refusal, not only in the last part of a chunk; an older load-watch without the flag: bg retries that
# call without it and drops it for the run, and the clock is per call again); a
# 15 s poll loop of bg's own got no valve and wrote one admit-log line per poll. Without load-watch (missing, erroring) or on the macOS CI
# fallback gate bg still polls every 15 s itself. Also reverts an expired Gradle profile
# (gradle-limits check). When testing bg itself, pass BG_LOAD_WAIT=0.
#
# Wait budget (djbclark, 2026-10-18): bg never starts a command "anyway". Until then the load gate
# gave up after 900 s and the slots after 1800 s, so on a day at load 40-70 every queued build ran at
# once regardless. Now the load gate and the slot waits share one budget, BG_MAX_WAIT seconds
# (default 21600, 6 h); past it bg exits 75 (EX_TEMPFAIL) without running anything. Agents start bg
# with run_in_background: a foreground tool call is cut off long before 6 h. Exit 3 stays "refused"
# (CI-first, Plektra), so a caller can tell the two apart. The command, once started, is never
# killed by bg.
#
# Apple `container` (2026-11-21, ADE queue 85 (a)-(c), cfengine lead 4c788430): a command whose key is `container ...` is not
# exec'd but run as a child so bg can (1) start the apiserver if it is down (`container system status --format json` exits 0 when it
# runs; a definite "down" runs `container system start --disable-kernel-install`, the same command the sh.brew.container login job
# runs; a status call that does not answer within BG_CONTAINER_STATUS_TIMEOUT, default 20 s, is "unknown": warn and run anyway;
# BG_CONTAINER_AUTOSTART=0 turns it off; exit 72 if it is still definitely down), and (2) fail a run whose stderr carries an
# `Error: ... XPC connection error ... Connection invalid` line even though the CLI exited 0 (exit 70; any other nonzero status
# is passed through unchanged). The apiserver is an on-demand LaunchAgent that `container system start` registers itself
# (RunAtLoad, no KeepAlive; the plist is rewritten on each start and pins the keg path), so launchd cannot be told to keep it up. Autostart also restarts an apiserver stopped on purpose (there is no
# 'stopped deliberately' marker): a call that must leave it stopped sets BG_CONTAINER_AUTOSTART=0.
# The key must be the command itself: `bgrun container run ...`, not `bgrun bash lane.sh` whose script calls `container run` inside
# (that gets neither the preflight nor the XPC check); only Apple's CLI qualifies (bare name, or an absolute path to the PATH's
# `container` or a Cellar keg, `--version` checked). The guard is the command's PARENT, not an exec: the slot file holds the guard's
# pid, and a SIGKILL of the guard ALONE frees the slot while the command runs on, so stop a container run with TERM to the bgrun pid
# (forwarded once; SIGUSR1/USR2 are forwarded too). The command stays in the guard's process group, so a group SIGKILL (deadline run after its
# grace, `gtimeout -k`) takes both down, and a command that prompts on /dev/tty is never stopped by SIGTTIN; the price is that a TERM sent to
# the whole group reaches the CLI twice (kernel + forward), under Apple's 3-signal force-exit threshold. In a terminal Ctrl-C reaches the
# command from the kernel, so INT is not forwarded there. SIGHUP/SIGINT/SIGTERM already ignored when the guard starts (nohup, `cmd &`) stay ignored.
# Every command also gets BGRUN_RUN_ID (UTC time + bg's pid) and BGRUN_RUN_START (epoch seconds) in its environment: a gate that
# writes `out/<sha>` should write `out/<sha>-$BGRUN_RUN_ID` and judge only that directory (a gate that never launched leaves an
# older sha-only directory that looks like a pass). Caveat: read $BGRUN_RUN_ID INSIDE the run; `bgrun cmd -e X=$BGRUN_RUN_ID` expands
# in the caller's shell, before bgrun sets it, to nothing (a gate script that mints its own id, as the PR body proposes, avoids that).
#
# Long-run ping (2026-10-18): a small watcher, forked just before the exec and detached from the
# caller's output, records each run's duration in ~/.local/state/bg/history.tsv, keyed by repo and
# the command's first two words ("python pytest", "cargo test", "gradlew assembleDebug"). It sends
# djbclark one hermes-ping when the run passes max(2 x the median of the last 10 runs,
# BG_RUN_PING_MIN, default 1800 s), or BG_RUN_PING_DEFAULT (3600 s) with no history, and one when
# the wait passes BG_PING_WAIT (3600 s). BG_PING_CMD replaces hermes-ping (tests).
#
# Deadline (djbclark 2026-11-01, "bg registers deadlines, alert-only first"; ~/src/djbclark-ade/docs/deadline.md): bg registers
# two records with `deadline start ... --on-expire notify`, which tells the owner (PASEO_AGENT_ID, when set) and Hermes and NEVER
# kills anything: `bg-wait-PID-T` (first real wait, load gate or slot: budget = the rest of BG_MAX_WAIT, heartbeat from the wait
# loop, `done` on every exit path through an EXIT trap) and `bg-run-PID-T` (the run, registered and beaten every poll by the
# detached watcher above, `done` when the process ends; budget 30m, BG_DEADLINE=45m for a known long run). Neither record has
# a --pid: `deadline start` refuses a pid that is its own caller's ancestor, and bg is that ancestor. Each has a --holder instead
# (2026-11-02; never signalled, so the ancestor rule does not apply): bg's own pid for the wait, the watcher's pid for the run.
# When the holder is gone and `done` never ran (a SIGKILLed process group: the EXIT trap and the watcher die with it), the sweep
# retires the record silently as `abandoned` instead of announcing an expiry for work that never ran. The run record is also
# registered only once the run has STARTED: bg touches a private marker file ($HOME/.local/state/bg/run-started.PID.T) just
# before the exec, the watcher waits for it, and if bg is gone first the watcher registers nothing and logs no history line.
# BG_NO_DEADLINE=1 opts out;
# under `deadline run` (DEADLINE_NAME set) bg registers nothing. `deadline` missing or failing: one warning on stderr (the
# watcher's, which has no stderr, goes to ~/.local/state/bg/deadline.log), and bg goes on; its output and exit status are
# unchanged. Tests: DEADLINE_STATE_DIR to a temp dir (never ~/.local/state/deadlines), BG_DEADLINE_CMD for a stand-in.
#
# Gradle slots: a command that runs gradle or gradlew (also behind `env VAR=… ./gradlew`) takes
# one of BG_GRADLE_SLOTS machine-wide slots (default 1) for its whole run, waiting up to
# up to the wait budget (BG_MAX_WAIT) for one. On 2026-10-06 eight agents
# built at once, each worktree started its own daemon, and the 16 GB Mac went 11 GB into swap.
# A slot is a shlock(1) file holding the build's pid (exec keeps the pid), so a killed build
# frees its slot. --stop/--status/--version don't take one. BG_GRADLE_SLOTS=0 disables it
# (don't advertise that in messages agents see: they'd bypass the queue). Every build is also
# gated inside Gradle by gradle/init.d/machine-slot.gradle (one at a time, all callers); this
# slot just waits before a JVM starts, so a queued bg build costs no idle daemon.
#
# Parallelism cap (2026-10-08): the admission gate above looks at load once, at launch, and QoS
# changes priority, not how many workers a command starts. On 2026-10-08 one Hermes full-suite
# run (a runner sized by os.cpu_count() = 8, one pytest per file, each spawning children) took the
# load average from 17 to 220 and starved every other session. So bg also caps parallelism for the
# command it wraps, with env vars that only apply when the caller has not set them:
#   BG_CPUS (default 3)  -> PYTHON_CPU_COUNT (Python 3.13+: caps os.cpu_count() and xdist `-n auto`),
#                           PYTEST_XDIST_AUTO_NUM_WORKERS, HERMES_TEST_WORKERS
#   thread pools -> 1:      OMP/OPENBLAS/MKL/NUMEXPR/VECLIB/NUMBA/RAYON_NUM_THREADS
#   TOKENIZERS_PARALLELISM=false
# Rust/C pools and Python < 3.13 ignore PYTHON_CPU_COUNT; pass the tool's own worker flag too.
#
# Test slots: a pytest/tox/nox/run_tests*.py, `swift build|test|run` or xcodebuild command takes one of BG_TEST_SLOTS machine-wide slots
# (default 2) for its whole run, waiting up to the wait budget (BG_MAX_WAIT), the same
# shlock mechanism as the Gradle slot. --version/--help/--collect-only don't take one.
# BG_TEST_SLOTS=0 disables it (don't advertise that in messages agents see).
#
# macOS fallback (2026-11-12): CI first. BG_CI_PLATFORM=macos (default for Swift/Xcode)
# plus BG_CI_JOB=<stable job> reads load-watch ci route. One failure/cancellation or
# BG_CI_SLOW=1 permits local at load <=16; two failures bypass the load gate.
# BG_CI_ATTEMPT=<CI run/job id> records known offload success/failure; cancellation/slow can be recorded
# with load-watch ci record. Slots/caps stay. Unknown CI verdicts do not count.
#
# CI offload (djbclark, 2026-10-23; builds 2026-11-01): in a repo recorded `ci` (load-watch ci), bg hands work to
# bin/bg-offload, which runs the repo's CI on its HEAD (untracked files are never in it) and waits; bg then exits
# with CI's verdict and never runs the command here:
#   - a build or full suite (anything not targeted and not a release): AT ONCE, before the load gate and without
#     a slot (djbclark 2026-11-01: "route builds to github ci for public repo linux and macos builds, or forgejo
#     for private repo linux builds"; this 16 GB Mac is memory-starved). No CI route, or an offload refused (see
#     below): exit 3 as before, naming the recorded CI command, plus one line saying why there is no route. A
#     command that names another tree (a directory flag -C/-p/--project-dir/--directory/--manifest-path, or an
#     argument that is an existing path outside the repo, other than a tool from a $PATH directory) is never
#     offloaded, since this repo's CI cannot vouch for it: exit 3 (adversary F6, 2026-11-01);
#   - a targeted test run stays here, but once the gate has held it for BG_OFFLOAD_AFTER seconds (default 60) it
#     goes to CI instead (2026-10-23: a 2 s pytest file sat over an hour in the gate at load 25-93 on 8 cores, the
#     carve-out defeated CI-first exactly when the machine is busiest). No route or a refusal: it keeps waiting;
#   - a release, `local`, `pending` and undecided repos: unchanged, nothing offloads.
# Routes (header of bin/bg-offload): (1) a tracked scripts/bg-offload-run, (2) a tracked scripts/github-ci-run,
# (3) Forgejo, for a repo with a tracked scripts/forgejo-ci-run: bg-offload pushes the checked commit to ci-run on the
# `forgejo` remote (forgejo.mit.edu) itself and follows the run that push starts, (4) generic GitHub: the CI remote
# (git config bgoffload.remote, else $GITHUB_CI_REMOTE, else origin) is djbclark's github.com repo whose ci/base holds
# agent-ci.yml or linux-ci.yml triggered by a push to ci/run/**, run with the committed
# ~/src/djbclark-ade/scripts/github-ci-run. By GitHub visibility (djbclark 2026-11-01, herdr included): a PUBLIC repo
# uses (1)/(2)/(4), and (3) only if it has none of those; a PRIVATE repo uses (3) ONLY, never GitHub, Linux or not:
# no usable Forgejo route, or Forgejo unreachable, refuses the build (exit 3) with a first line `bg: private repo has
# no Forgejo route: ...` or `bg: FORGEJO UNREACHABLE: ...` and "fix Forgejo (forgejo / forgejo-ci skills); if you
# cannot, notify djbclark (hermes-ping) and keep doing work that is not blocked"; visibility unreadable (gh failed):
# no route for that run. After a GitHub success the run's artifacts land in
# ~/.local/state/bg-offload/artifacts/OWNER__REPO/RUN/ (path printed; 7 days, 20 per repo).
# bg waits up to BG_OFFLOAD_WAIT (2400 s; the offload has its own budget, outside BG_MAX_WAIT). It needs `gh`,
# `git` and the GNU tools bg-offload lists (gdate, gawk, gtimeout...). Exit codes: 0 CI's workflow passed on this
# tree (not "the test you named passed": CI runs the repo's whole workflow), 1 CI failed (log tail printed; it can
# come from a test you did not name), 76 CI still running at BG_OFFLOAD_WAIT, 77 pushed but no verdict (nothing
# succeeded, cancelled, no run); 3 and 75 keep their meaning. BG_OFFLOAD=0 keeps the old behaviour (refuse a
# build, wait with a targeted run). bg-offload publishes NOTHING that is not already on
# the remote (a public repo's CI is outward-facing, the checkout may hold another session's work; djbclark's
# ruling 2026-10-23 after six review rounds): it offloads only when no tracked file is modified (working tree
# or index), every commit of HEAD is reachable from a ref the REAL push target advertises (`git ls-remote` of
# the remote by name, resolved as the runner's push resolves it, with the remote's fetch and push url the same
# single url; not the local remote-tracking refs, which go stale; no replace refs, no grafts), and the ci/base
# the runner overlays is too. The runner's git config is forced to push.followTags=false (no local tags go
# along). Otherwise bg-offload says why and bg refuses (build) or keeps waiting (targeted): commit and push, then
# bg offloads. A named test path that is missing, untracked, a directory with no tracked file or outside the repo
# stops the offload too (header of bin/bg-offload).
# Not a way round the gate for local work: `local` repos and releases never offload.
#
# Agents must call `~/ops/site-private-djbclark/bin/bgrun`: bare `bg` is the shell job-control builtin.
#
# JAVA_HOME: callers keep their own. ~/.bashrc (sourced via BASH_ENV) only sets its JDK 25
# default when JAVA_HOME is unset; `bg env JAVA_HOME=<jdk> ./gradlew …` also works.
export PATH="/opt/homebrew/bin:$PATH"

# Linux fallbacks for the macOS/Homebrew names this script calls. When the g-names
# and shlock are on PATH (the Mac), these functions are not defined and behaviour
# is unchanged. Without them, a slot wait used to loop forever: gseq/shlock failed
# and gdate never advanced the wait budget.
if ! command -v gdate >/dev/null 2>&1; then gdate() { date "$@"; }; fi
if ! command -v gseq >/dev/null 2>&1; then gseq() { seq "$@"; }; fi
if ! command -v gawk >/dev/null 2>&1; then gawk() { awk "$@"; }; fi
if ! command -v gtr >/dev/null 2>&1; then gtr() { tr "$@"; }; fi
if ! command -v greadlink >/dev/null 2>&1; then greadlink() { readlink "$@"; }; fi
if ! command -v ghead >/dev/null 2>&1; then ghead() { head "$@"; }; fi
if ! command -v gtimeout >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  gtimeout() { timeout "$@"; }
fi
if ! command -v sysctl >/dev/null 2>&1; then
  sysctl() {
    [ "$1" = "-n" ] || return 1
    case "$2" in
      hw.ncpu)
        nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1\n'
        ;;
      vm.loadavg)
        # macOS prints "{ 1.23 1.23 1.23 }"; bg's gawk uses field 2 as the 1-minute load.
        set -- $(cat /proc/loadavg 2>/dev/null)
        printf '{ %s %s %s }\n' "${1:-0}" "${2:-0}" "${3:-0}"
        ;;
      *) return 1 ;;
    esac
  }
fi
if ! command -v shlock >/dev/null 2>&1; then
  bg_lock_fd=8
  # shlock -f FILE -p PID: lock FILE, writing PID into it (for "held by pid" messages).
  # flock is held on a inherited fd so a killed command still frees the slot.
  shlock() {
    local file="" pid="" fd
    while [ $# -gt 0 ]; do
      case "$1" in
        -f) file=$2; shift 2 ;;
        -p) pid=$2; shift 2 ;;
        *) return 1 ;;
      esac
    done
    [ -n "$file" ] && [ -n "$pid" ] || return 1
    command -v flock >/dev/null 2>&1 || return 1
    fd=$bg_lock_fd
    bg_lock_fd=$((bg_lock_fd + 1))
    eval "exec $fd>>\"$file\"" || return 1
    if flock -n "$fd" 2>/dev/null; then
      printf '%s\n' "$pid" > "$file"
      return 0
    fi
    eval "exec $fd>&-"
    return 1
  }
fi
# One-run approval (djbclark via the lead, 2026-11-14: "an agent should be able to use the override with his approval").
# `bg approve-local [--ttl 1h] -- CMD...` asks djbclark for fresh authentication, then writes a one-shot token under
# ~/.local/state/bg/approvals/ (mode 0600, written atomically), bound to sha256(physical cwd + argv) and an expiry (default 1 h,
# at most 24 h). The next `bg CMD...` in that directory with the same argv that bg would otherwise send to CI (a bare suite, an
# unknown runner) consumes the token (renamed away, then deleted, before the load gate and any slot wait) and runs here; a run
# that then gives up (exit 75) or is killed has spent it, and djbclark is asked again. A run that is
# targeted anyway never consumes it. Authentication: djbclark's Touch ID helper `sudo-ask` (an Allow dialog that shows the
# command and directory, then sudo's Touch ID/password), else `sudo -k /usr/bin/true`; both run under `env -i` with only a fixed PATH, HOME, USER, LANG and TERM (bg_scrub_run), so a caller's BASH_ENV/ENV/DYLD_* never reaches them. Each approval and each consumption is
# appended to ~/.local/state/bg/approvals.log (time, event, hash prefix, directory, program name; never the arguments). The
# command itself is shown to djbclark (that is the point) and so lands in sudo-ask's own log (~/.local/state/sudo-ask/log) and in
# the system log's record of the sudo call: never put a secret in an argument (secretspec injects environment instead).
# This guards against honest mistakes, not evasion: a token is plain files, like the other overrides here.
bg_state="$HOME/.local/state/bg"
bg_appr_dir="$bg_state/approvals"
bg_sha256() { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi; }
# bg_appr_key ARGV...: sha256 of the physical working directory and the argv, NUL-separated (no two commands share a key)
bg_appr_key() {
  local cwd key
  cwd=$(pwd -P) || return 1
  key=$(printf '%s\0' "$cwd" "$@" | bg_sha256 | gawk '{print $1}')
  [ "${#key}" = 64 ] || return 1
  printf '%s\n' "$key"
}
# bg_appr_log EVENT KEY PROGRAM
bg_appr_log() {
  mkdir -p "$bg_state" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\n' "$(gdate -Is)" "$1" "${2:0:12}" "$(printf '%q' "$(pwd -P)")" "$(printf '%q' "${3##*/}")" >> "$bg_state/approvals.log" 2>/dev/null || true
}
# bg_approval_consume ARGV...: succeed (once) when an unexpired token for this cwd+argv exists. The rename is the claim: of two
# racing runs one wins; the token is gone before the caller runs anything. An expired or damaged token is deleted and refused.
bg_approval_consume() {
  local key f claimed exp k now
  key=$(bg_appr_key "$@") || return 1
  f="$bg_appr_dir/$key"
  [ -f "$f" ] || return 1
  claimed="$f.used.$$"
  mv "$f" "$claimed" 2>/dev/null || return 1
  exp=$(gawk -F= '$1 == "expires" { print $2 }' "$claimed" 2>/dev/null)
  k=$(gawk -F= '$1 == "key" { print $2 }' "$claimed" 2>/dev/null)
  rm -f "$claimed"
  now=$(gdate +%s)
  if [[ "$exp" =~ ^[0-9]+$ ]] && [ "$k" = "$key" ] && [ "$now" -lt "$exp" ]; then
    bg_appr_log consumed "$key" "$1"
    return 0
  fi
  bg_appr_log refused-expired-or-damaged "$key" "$1"
  return 1
}
# bg_scrub_run CMD ARGV...: run CMD under `env -i` with ONLY an allow-list (operator 2026-11-15): a fixed trusted PATH (never the
# caller's), HOME, USER, LANG, TERM. Everything else the caller exported (BASH_ENV, ENV, PYTHONSTARTUP, LD_*/DYLD_*, IFS, LC_*,
# PATH entries, XDG_STATE_HOME, SUDO_ASK_MAX_WAIT...) is dropped, so it cannot reach sudo-ask or sudo, the
# helper that decides whether djbclark approved (as root they run only /usr/bin/printf; the approved command itself runs later, unprivileged,
# with the caller's environment). This protects sudo-ask's shell, not bg's own: a BASH_ENV or exported function runs inside bg before this
# point (same user, no privilege boundary: honest mistakes only, as below). LANG, TERM and USER pass only if they are plain names ([A-Za-z0-9_.@-]), else a safe default. HOME is
# the caller's (the helper is found under it, and it is on the allow-list). Both authentication calls below go through here.
bg_scrub_run() {
  local lang=${LANG-} term=${TERM-} user=${USER-}
  [[ "$lang" =~ ^[A-Za-z0-9_.@-]+$ ]] || lang=en_US.UTF-8
  [[ "$term" =~ ^[A-Za-z0-9_.@-]+$ ]] || term=dumb
  [[ "$user" =~ ^[A-Za-z0-9_.@-]+$ ]] || user=$(/usr/bin/id -un)
  /usr/bin/env -i PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin HOME="$HOME" USER="$user" LANG="$lang" TERM="$term" "$@"
}
# bg_approve_one_shot [--ttl T] -- CMD...: the one-shot token (header).
bg_approve_one_shot() {
  local ttl=1h secs unit key tmp now sa="$HOME/.local/bin/sudo-ask" shown
  while [ $# -gt 0 ]; do
    case "$1" in
      --ttl) [ $# -ge 2 ] || { echo "bg approve-local: --ttl needs a value (30m, 1h, 90s)" >&2; return 2; }; ttl=$2; shift 2 ;;
      --ttl=*) ttl=${1#--ttl=}; shift ;;
      --) shift; break ;;
      *) echo "usage: bgrun approve-local [--ttl 1h] -- <command> [args...]" >&2; return 2 ;;
    esac
  done
  if [ $# -eq 0 ]; then echo "usage: bgrun approve-local [--ttl 1h] -- <command> [args...]" >&2; return 2; fi
  if [[ "$ttl" =~ ^([0-9]+)([smhd]?)$ ]]; then
    secs=$((10#${BASH_REMATCH[1]})); unit=${BASH_REMATCH[2]}
    case "$unit" in m) secs=$((secs * 60)) ;; h) secs=$((secs * 3600)) ;; d) secs=$((secs * 86400)) ;; esac
  else
    secs=0
  fi
  if [ "$secs" -lt 1 ] || [ "$secs" -gt 86400 ]; then
    echo "bg approve-local: --ttl must be between 1 s and 24 h (got '$ttl'); examples: 30m, 1h, 90s" >&2
    return 2
  fi
  key=$(bg_appr_key "$@") || { echo "bg approve-local: cannot hash the command" >&2; return 1; }
  shown=$(printf '%q ' "$@"); shown=${shown% }
  echo "bg approve-local: asking djbclark to approve ONE local run in $(pwd -P): $shown" >&2
  if [ -x "$sa" ]; then
    # The Allow dialog shows the command and directory (mouse click only); sudo then asks for Touch ID or the password.
    # -k: sudo ignores any cached credential for this one command (the machine's sudo timestamp is global), so Touch ID is asked
    bg_scrub_run "$sa" -k /usr/bin/printf 'bg approve-local (one run, %s s) in %s: %s\n' "$secs" "$(pwd -P)" "$shown" >/dev/null || {
      echo "bg approve-local: not approved; nothing was written" >&2; return 1; }
  else
    # -k with a command: ask afresh, run /usr/bin/true, and leave the machine's sudo ticket neither cleared nor refreshed
    # (`sudo -k` then `sudo -v` would cache a new global ticket for every session; lead adversary B4)
    bg_scrub_run /usr/bin/sudo -k /usr/bin/true || { echo "bg approve-local: authentication failed; nothing was written" >&2; return 1; }
  fi
  mkdir -p "$bg_appr_dir" && chmod 700 "$bg_appr_dir" || return 1
  tmp=$(mktemp "$bg_appr_dir/.tmp.XXXXXX") || return 1
  now=$(gdate +%s)
  printf 'key=%s\nexpires=%s\ncreated=%s\n' "$key" "$((now + secs))" "$now" > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$bg_appr_dir/$key" || {
    rm -f "$tmp"; echo "bg approve-local: could not write the approval" >&2; return 1; }
  bg_appr_log approved "$key" "$1"
  echo "bg approve-local: approved; the next identical run here (same directory and arguments, within ${ttl}) runs locally once" >&2
}
# ---- Approval tickets (Kerberos/OpenAFS pattern; operator 2026-11-21): ONE Touch ID, then many local runs until an expiry.
# `bgrun approve-local --for 7h` / `--until "tomorrow 8am"` [--scope DIR] [-- CMD...] writes a ticket under ~/.local/state/bg/tickets/
# (dir 0700, file 0600, atomic) after the same sudo-ask Allow dialog + Touch ID as a one-shot token; the dialog text and the output
# show the expiry as America/New_York 12-hour time. While it lives, a run that bg would send to CI under `ci` mode runs here instead
# (any command, or only CMD's argv; any directory, or only under DIR), and every use is logged (tickets/ID.uses and approvals.log: time,
# directory, argv hash, program; never the arguments). `approve-local status` (klist) lists tickets, `revoke [ID]` (kdestroy) removes
# them and the one-shot tokens, `check [DIR]` says whether one covers DIR. `approve-local --ask -- CMD` first shows a duration chooser
# (this run only / 1 h / 7 h / until a time). A ticket is signed with a per-install salt (ticket.salt, 0600) so a hand-edited or
# hand-written file is refused; the salt is readable by the same user, so this is tamper-evidence, not a boundary (same trust level as
# the one-shot token and as every agent here: honest mistakes, ~/AGENTS.md trust rule). No upper cap on the duration: the operator picks it (the dialog
# starts with the expiry and the scope, marks a ticket over 30 days LONG-LIVED, and cuts only the command text, saying so). A scope is matched against
# the directory bgrun is invoked from, not the tree a command touches. `revoke` with no ID also rotates ticket.salt.
bg_ticket_dir="$bg_state/tickets"
bg_ticket_salt="$bg_state/ticket.salt"
bg_argv_hash() { printf '%s\0' "$@" | bg_sha256 | gawk '{print $1}'; }
bg_ticket_fmt() { TZ=America/New_York gdate -d "@$1" '+%a %b %-d %Y %-I:%M %p %Z'; }
bg_ticket_left() { local s=$1; if [ "$s" -ge 86400 ]; then echo "$((s / 86400)) d $(((s % 86400) / 3600)) h"; elif [ "$s" -ge 3600 ]; then echo "$((s / 3600)) h $(((s % 3600) / 60)) min"; elif [ "$s" -ge 60 ]; then echo "$((s / 60)) min"; else echo "$s s"; fi; }
bg_stat_mode_uid() { stat -c '%a %u' "$1" 2>/dev/null || stat -f '%Lp %u' "$1" 2>/dev/null; }
# bg_dur_secs 7h | 90m | 1h30m | 2d | 1w | 45 (seconds) -> seconds, 0 on a bad value
bg_now() { /bin/date +%s; }   # never PATH's gdate: a shim there must not stretch a ticket
# bg_scope_covers SCOPE DIR: 0 when DIR is SCOPE or below it ('/' covers everything; '*' is any directory).
bg_scope_covers() { local s=$1; [ "$s" = '*' ] && return 0; s=${s%/}; case "$2/" in "$s"/*) return 0 ;; esac; return 1; }
# bg_ticket_mksalt [force]: create ticket.salt (0600) when missing; with force, replace it (revoke rotates it so a restored copy of an old ticket dies).
bg_ticket_mksalt() {
  local tmp
  [ "${1:-}" = force ] || [ ! -s "$bg_ticket_salt" ] || return 0
  tmp=$(mktemp "$bg_state/.salt.XXXXXX") || return 1
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$tmp" && chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  if [ "${1:-}" = force ]; then mv -f "$tmp" "$bg_ticket_salt"; else mv -n "$tmp" "$bg_ticket_salt"; rm -f "$tmp"; fi
}
# bg_dur_secs 7h | 90m | 1h30m | 2d | 1w | 45 (seconds) -> seconds, 0 on a bad value (terms of more than 9 digits are bad: they overflow)
bg_dur_secs() {
  local s=$1 total=0 n u
  [[ "$s" =~ ^([0-9]{1,9}[smhdw]?)+$ ]] || { echo 0; return; }
  while [[ "$s" =~ ^([0-9]+)([smhdw]?)(.*)$ ]]; do
    [ "${#BASH_REMATCH[1]}" -le 9 ] || { echo 0; return; }
    n=$((10#${BASH_REMATCH[1]})); u=${BASH_REMATCH[2]}; s=${BASH_REMATCH[3]}
    case "$u" in m) n=$((n * 60)) ;; h) n=$((n * 3600)) ;; d) n=$((n * 86400)) ;; w) n=$((n * 604800)) ;; esac
    total=$((total + n))
  done
  echo "$total"
}
bg_ticket_sig() { # id created expires scope argv uid
  printf '%s\0%s\0%s\0%s\0%s\0%s\0%s' "$(cat "$bg_ticket_salt")" "$1" "$2" "$3" "$4" "$5" "$6" | bg_sha256 | gawk '{print $1}'
}
bg_ticket_load() { # FILE -> t_id t_created t_expires t_scope t_argv t_uid t_sig
  local line k
  t_id= t_created= t_expires= t_scope= t_argv= t_uid= t_sig=
  while IFS= read -r line || [ -n "$line" ]; do
    k=${line%%=*}
    case "$k" in id) t_id=${line#*=} ;; created) t_created=${line#*=} ;; expires) t_expires=${line#*=} ;; scope) t_scope=${line#*=} ;;
      argv) t_argv=${line#*=} ;; uid) t_uid=${line#*=} ;; sig) t_sig=${line#*=} ;; esac
  done < "$1"
}
bg_ticket_log() { # EVENT ID ARGVHASH PROGRAM
  mkdir -p "$bg_state" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\tticket=%s\n' "$(gdate -Is)" "$1" "${3:0:12}" "$(printf '%q' "$(pwd -P)")" "$(printf '%q' "${4##*/}")" "$(printf '%q' "$2")" >> "$bg_state/approvals.log" 2>/dev/null || true
}
# bg_ticket_check FILE NOW: 0 when FILE is a genuine, unexpired ticket of this user (sets t_*); an expired one is removed.
bg_ticket_check() {
  local f=$1 now=$2 why=
  if [ -L "$f" ] || [ ! -f "$f" ]; then why=not-a-plain-file
  elif [ "$(bg_stat_mode_uid "$f")" != "600 $(id -u)" ]; then why=bad-owner-or-mode
  elif [ ! -s "$bg_ticket_salt" ]; then why=no-salt
  else
    bg_ticket_load "$f"
    if [[ ! "$t_expires" =~ ^[0-9]+$ ]] || [[ ! "$t_created" =~ ^[0-9]+$ ]] || [ -z "$t_id" ] || [ -z "$t_scope" ] || [ -z "$t_argv" ] \
       || [ "$t_uid" != "$(id -u)" ] || [ "$t_sig" != "$(bg_ticket_sig "$t_id" "$t_created" "$t_expires" "$t_scope" "$t_argv" "$t_uid")" ]; then
      why=bad-signature
    elif [[ ! "$t_id" =~ ^[0-9a-f]{8}$ ]] || [ "$t_id.ticket" != "${f##*/}" ]; then
      why=id-not-file-name   # a copy under another name, or an id that is a path, is no ticket
    elif [ -f "$bg_ticket_dir/.revoked" ] && grep -qxF "$t_id" "$bg_ticket_dir/.revoked" 2>/dev/null; then
      why=revoked   # `revoke ID` is remembered: a copy kept aside and restored under the same name is refused
    elif [ "$now" -lt "$t_created" ]; then
      why=clock-before-created
    elif [ "$now" -ge "$t_expires" ]; then
      rm -f "$f"; bg_ticket_log ticket-expired "$t_id" "" ticket; return 1
    fi
  fi
  [ -z "$why" ] && return 0
  bg_ticket_log "ticket-refused-$why" "${f##*/}" "" ticket
  return 1
}
# bg_ticket_honour ARGV...: 0 (and the use is logged) when a live ticket covers this cwd and argv.
bg_ticket_honour() {
  local f cwd ah now
  [ -d "$bg_ticket_dir" ] || return 1
  cwd=$(pwd -P) || return 1; ah=$(bg_argv_hash "$@"); now=$(bg_now)
  for f in "$bg_ticket_dir"/*.ticket; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    bg_ticket_check "$f" "$now" || continue
    bg_scope_covers "$t_scope" "$cwd" || continue
    [ "$t_argv" = '*' ] || [ "$t_argv" = "$ah" ] || continue
    ( umask 077; printf '%s\t%s\t%s\t%s\n' "$(gdate -Is)" "$(printf '%q' "$cwd")" "${ah:0:12}" "$(printf '%q' "${1##*/}")" >> "$bg_ticket_dir/$t_id.uses" ) 2>/dev/null || true
    bg_ticket_log ticket-used "$t_id" "$ah" "$1"
    bg_ticket_used="$t_id until $(bg_ticket_fmt "$t_expires")"
    return 0
  done
  return 1
}
# bg_ticket_status: klist.
bg_ticket_status() {
  local f now n=0 left uses scope what
  now=$(bg_now)
  echo "bgrun approval tickets ($(bg_ticket_fmt "$now"), America/New_York):"
  for f in "$bg_ticket_dir"/*.ticket; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    if ! bg_ticket_check "$f" "$now"; then [ -e "$f" ] && { echo "  ${f##*/}: REFUSED (not a genuine ticket; see $bg_state/approvals.log)"; n=$((n + 1)); }; continue; fi
    left=$(bg_ticket_left "$((t_expires - now))"); uses=0; [ -f "$bg_ticket_dir/$t_id.uses" ] && uses=$(wc -l < "$bg_ticket_dir/$t_id.uses" | tr -d ' ')
    scope="any directory"; [ "$t_scope" = '*' ] || scope="under $t_scope"
    what="any command"; [ "$t_argv" = '*' ] || what="one command (argv hash ${t_argv:0:12})"
    echo "  $t_id  $scope; $what; expires $(bg_ticket_fmt "$t_expires") ($left left); used $uses time(s)"
    n=$((n + 1))
  done
  [ "$n" -gt 0 ] || echo "  (none)"
  n=$(ls "$bg_appr_dir" 2>/dev/null | grep -Ec '^[0-9a-f]{64}$')
  echo "one-shot tokens waiting: $n"
}
# bg_ticket_revoke [ID...]: kdestroy: no argument removes every ticket and one-shot token.
bg_ticket_revoke() {
  local id f c=0
  if [ $# -eq 0 ]; then
    for f in "$bg_ticket_dir"/*.ticket; do [ -e "$f" ] || [ -L "$f" ] || continue; rm -f "$f"; c=$((c + 1)); done
    rm -f "$bg_appr_dir"/[0-9a-f]*[0-9a-f] 2>/dev/null
    # kdestroy: a new salt too, so a ticket copied aside (or restored from a backup) before this revoke is refused afterwards
    if [ -s "$bg_ticket_salt" ]; then ( umask 077; mkdir -p "$bg_state"; bg_ticket_mksalt force ) || echo "bg approve-local revoke: could not rotate ticket.salt" >&2; fi
  else
    for id in "$@"; do
      [[ "$id" =~ ^[0-9a-f]{8}$ ]] || { echo "bg approve-local revoke: '$id' is not a ticket id (see: approve-local status)" >&2; return 2; }
      ( umask 077; mkdir -p "$bg_ticket_dir" && chmod 700 "$bg_ticket_dir" && echo "$id" >> "$bg_ticket_dir/.revoked" ) 2>/dev/null \
        || echo "bg approve-local revoke: could not record $id as revoked" >&2
      if [ -e "$bg_ticket_dir/$id.ticket" ]; then rm -f "$bg_ticket_dir/$id.ticket"; c=$((c + 1)); else echo "bg approve-local revoke: no ticket $id (recorded as revoked anyway)" >&2; fi
    done
  fi
  bg_appr_log revoked "" "$c-tickets"
  echo "bg approve-local: revoked $c ticket(s)$([ $# -eq 0 ] && echo ' and every one-shot token')" >&2
}
# bg_ticket_check_dir DIR: 0 when a live ticket (any command) covers DIR; prints id and expiry. For callers such as load-watch.
bg_ticket_check_dir() {
  local d f now
  d=$(cd "${1:-.}" 2>/dev/null && pwd -P) || { echo "bg approve-local check: no such directory" >&2; return 2; }
  now=$(bg_now)
  for f in "$bg_ticket_dir"/*.ticket; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    bg_ticket_check "$f" "$now" || continue
    [ "$t_argv" = '*' ] || continue
    bg_scope_covers "$t_scope" "$d" || continue
    echo "$t_id until $(bg_ticket_fmt "$t_expires")"; return 0
  done
  return 1
}
# bg_approve_choose: the duration chooser behind `--ask` (BG_APPROVE_CHOOSER with BG_APPROVE_CHOOSER_TEST=1 replaces it, for tests). Prints once | for:<dur> | until:<text>.
bg_approve_choose() {
  local pick text
  # the test seam needs a second, deliberate marker, so a stray BG_APPROVE_CHOOSER in an agent's environment cannot stand in for the operator's chooser
  if [ -n "${BG_APPROVE_CHOOSER:-}" ] && [ "${BG_APPROVE_CHOOSER_TEST:-}" = 1 ]; then "$BG_APPROVE_CHOOSER"; return $?; fi
  pick=$(/usr/bin/osascript -e 'set r to choose from list {"This run only", "Any local run for 1 hour", "Any local run for 7 hours", "Any local run until a time..."} with title "bgrun: allow local runs" with prompt "How long should bgrun run builds and suites on this Mac without asking again? Touch ID comes next." default items {"This run only"}' 2>/dev/null) || return 1
  case "$pick" in
    "This run only") echo once ;;
    "Any local run for 1 hour") echo for:1h ;;
    "Any local run for 7 hours") echo for:7h ;;
    "Any local run until a time...")
      text=$(/usr/bin/osascript -e 'text returned of (display dialog "Until when? (e.g. 2026-11-22 08:00, or tomorrow 8am)" default answer "" with title "bgrun: allow local runs")' 2>/dev/null) || return 1
      echo "until:$text" ;;
    *) return 1 ;;
  esac
}
# bg_approve_local: subcommands status | revoke [ID...] | check [DIR]; a ticket when --for/--until/--ask is given; else the one-shot token.
bg_approve_local() {
  local long ttl_seen=0 forv= untilv= scope='*' ask=0 narrow=0 pick="" a before=1 secs now exp sa="$HOME/.local/bin/sudo-ask" shown where what msg id argh tmp
  case "${1:-}" in
    status) shift; bg_ticket_status; return $? ;;
    revoke) shift; bg_ticket_revoke "$@"; return $? ;;
    check) shift; bg_ticket_check_dir "$@"; return $? ;;
  esac
  local args=("$@") rest=() i=0
  while [ "$i" -lt "${#args[@]}" ]; do
    a=${args[$i]}
    if [ "$a" = -- ]; then rest=("${args[@]:$((i + 1))}"); break; fi
    case "$a" in
      --for) forv=${args[$((i + 1))]-}; i=$((i + 1)) ;;
      --for=*) forv=${a#--for=} ;;
      --until) untilv=${args[$((i + 1))]-}; i=$((i + 1)) ;;
      --until=*) untilv=${a#--until=} ;;
      --scope) scope=${args[$((i + 1))]-}; i=$((i + 1)) ;;
      --scope=*) scope=${a#--scope=} ;;
      --ask) ask=1 ;;
      --ttl) [ "${args[$((i + 1))]+x}" ] || { echo "bg approve-local: --ttl needs a value (30m, 1h, 90s)" >&2; return 2; }; ttl_seen=1; i=$((i + 1)) ;;
      --ttl=*) ttl_seen=1 ;;
      *) bg_approve_one_shot "$@"; return $? ;;   # not a ticket request: the one-shot path reports a usage error itself
    esac
    i=$((i + 1))
  done
  if [ -z "$forv$untilv" ] && [ "$ask" = 0 ] && [ "$scope" = '*' ]; then bg_approve_one_shot "$@"; return $?; fi
  [ "${#rest[@]}" -gt 0 ] && narrow=1
  if [ "$ask" = 1 ]; then
    [ -z "$forv$untilv" ] || { echo "bg approve-local: --ask asks for the duration; do not combine it with --for/--until" >&2; return 2; }
    pick=$(bg_approve_choose) || { echo "bg approve-local: no duration chosen; nothing was written" >&2; return 1; }
    case "$pick" in
      once) [ "${#rest[@]}" -gt 0 ] || { echo "usage: bgrun approve-local --ask -- <command> [args...]" >&2; return 2; }
            [ "$scope" = '*' ] || { echo "bg approve-local: --scope narrows a ticket; 'this run only' is one command here" >&2; return 2; }
            bg_approve_one_shot -- "${rest[@]}"; return $? ;;
      for:*) forv=${pick#for:}; narrow=0 ;;
      until:*) untilv=${pick#until:}; narrow=0 ;;
      *) echo "bg approve-local: unknown choice; nothing was written" >&2; return 1 ;;
    esac
  fi
  if [ -n "$forv" ] && [ -n "$untilv" ]; then echo "bg approve-local: give --for or --until, not both" >&2; return 2; fi
  [ -n "$forv$untilv" ] || { echo "bg approve-local: --scope needs --for or --until (a one-shot token is bound to its directory already)" >&2; return 2; }
  [ "${ttl_seen:-0}" = 0 ] || { echo "bg approve-local: --ttl is for a one-shot token; a ticket takes --for or --until" >&2; return 2; }
  now=$(bg_now)
  if [ -n "$forv" ]; then
    secs=$(bg_dur_secs "$forv")
    [ "$secs" -ge 1 ] || { echo "bg approve-local: --for needs a duration like 7h, 90m, 1h30m, 2d, each number at most 9 digits (got '$forv')" >&2; return 2; }
    exp=$((now + secs))
  else
    exp=$(gdate -d "$untilv" +%s 2>/dev/null) || exp=
    [[ "$exp" =~ ^[0-9]+$ ]] || { echo "bg approve-local: --until could not read '$untilv' as a local date/time (try '2026-11-22 08:00' or 'tomorrow 8am')" >&2; return 2; }
    [ "$exp" -gt "$now" ] || { echo "bg approve-local: --until '$untilv' is not in the future (it reads as $(bg_ticket_fmt "$exp")); give a full date" >&2; return 2; }
    secs=$((exp - now))
  fi
  # No upper cap (operator's ruling), but a period that cannot be shown as a date cannot be shown to the operator either
  bg_ticket_fmt "$exp" >/dev/null 2>&1 || { echo "bg approve-local: that expiry is too far away to be shown as a date; nothing was written" >&2; return 2; }
  if [ "$scope" != '*' ]; then
    scope=$(cd "$scope" 2>/dev/null && pwd -P) || { echo "bg approve-local: --scope is not a directory" >&2; return 2; }
    # The path goes into the dialog, so only characters sudo-ask shows 1:1 are allowed: no quote (sudo-ask turns each ' into 4
    # characters and could push the expiry-first text past its 700-character cut), no control or bidi/non-ASCII character (display tricks).
    [[ "$scope" =~ ^[-A-Za-z0-9_./=:,+@%~\ ]+$ ]] || { echo "bg approve-local: --scope has a character the approval dialog cannot show safely (allowed: letters, digits, space and _ . / = : , + @ % ~ -)" >&2; return 2; }
    # the dialog must show the whole scope (sudo-ask cuts its text at 700 characters), so a very long path is refused, never cut
    [ "${#scope}" -le 250 ] || { echo "bg approve-local: --scope path is over 250 characters, too long to show whole in the approval dialog" >&2; return 2; }
  fi
  argh='*'; [ "$narrow" = 1 ] && argh=$(bg_argv_hash "${rest[@]}")
  where="in any directory"; [ "$scope" = '*' ] || where="under $scope"
  what="ANY bgrun local run"; shown=
  if [ "$narrow" = 1 ]; then
    # The dialog is the operator's only view of the period, so expiry and scope come FIRST and are never cut; only the command text is
    # capped (120 characters), with a marker that says how much was left out and the argv hash that the ticket is bound to.
    shown=$(printf '%q ' "${rest[@]}"); shown=${shown% }
    shown=${shown//\'/\"}; shown=$(printf '%s' "$shown" | LC_ALL=C tr -c ' -~' '?')   # display only (the hash binds the real argv): no quote, no control or non-ASCII character
    if [ "${#shown}" -gt 120 ]; then shown="${shown:0:120}... [command truncated: ${#shown} characters in all]"; fi
    what="bgrun local runs of ONE command ($shown; argv hash ${argh:0:12})"
  fi
  long=; [ "$secs" -gt 2592000 ] && long="LONG-LIVED (over 30 days): "
  msg="bgrun TICKET ${long}until $(bg_ticket_fmt "$exp") ($(bg_ticket_left "$secs") from now), $where: allow $what. Revoke: bgrun approve-local revoke"
  echo "bg approve-local: asking djbclark for a ticket: $what $where until $(bg_ticket_fmt "$exp")" >&2
  if [ -x "$sa" ]; then
    bg_scrub_run "$sa" -k /usr/bin/printf '%s\n' "$msg" >/dev/null || { echo "bg approve-local: not approved; nothing was written" >&2; return 1; }
  else
    # A bare sudo prompt says nothing about an open-ended ticket, so it is no consent for one (a one-shot token still falls back to it).
    echo "bg approve-local: a ticket needs the sudo-ask dialog ($sa is missing), which shows the expiry and scope; nothing was written" >&2; return 1
  fi
  ( umask 077; mkdir -p "$bg_ticket_dir" "$bg_state" && chmod 700 "$bg_ticket_dir" || exit 1
    bg_ticket_mksalt || exit 1
    [ -s "$bg_ticket_salt" ] || exit 1
    id=$(od -An -tx1 -N4 /dev/urandom | tr -d ' \n')
    tmp=$(mktemp "$bg_ticket_dir/.tmp.XXXXXX") || exit 1
    printf 'id=%s\ncreated=%s\nexpires=%s\nscope=%s\nargv=%s\nuid=%s\nsig=%s\n' "$id" "$now" "$exp" "$scope" "$argh" "$(id -u)" \
      "$(bg_ticket_sig "$id" "$now" "$exp" "$scope" "$argh" "$(id -u)")" > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$bg_ticket_dir/$id.ticket" || { rm -f "$tmp"; exit 1; }
    echo "$id" > "$bg_ticket_dir/.last-issued.$$" ) || { echo "bg approve-local: could not write the ticket" >&2; return 1; }
  id=$(cat "$bg_ticket_dir"/.last-issued.$$ 2>/dev/null); rm -f "$bg_ticket_dir"/.last-issued.$$
  bg_ticket_log ticket-issued "$id" "$argh" "${rest[0]:-any}"
  echo "bg approve-local: ticket $id issued: $what $where until $(bg_ticket_fmt "$exp") ($(bg_ticket_left "$secs") from now). 'bgrun approve-local status' lists it; 'bgrun approve-local revoke' ends it." >&2
}
# bg has no flags of its own: everything after the name is the command. Agents
# sometimes invent `--name`/`--log`/`--` (from other wrappers); those become
# `taskpolicy -c utility --name …` and macOS taskpolicy errors with
# `illegal option -- -` (seen 2026-10-22). Catch that before the QoS exec.
bg_usage() {
  cat >&2 <<'EOF'
usage: bgrun <command> [args...]

Runs <command> at utility QoS (taskpolicy -c utility). No bgrun-owned flags:
  right:  bgrun ./build-searxng-image
  right:  bgrun pytest -q tests/
  wrong:  bgrun --name job --log out.log -- ./build   # those args go to taskpolicy

Redirect or name the run yourself (bgrun does not take --log/--name):
  bgrun bash -lc './build >out.log 2>&1'

One run that bgrun sends to CI but must run here: ask djbclark to approve exactly that run (his Touch ID):
  bgrun approve-local [--ttl 1h] -- <the exact command>
  bgrun approve-local --for 7h | --until "tomorrow 8am" [--scope DIR] [-- <command>]   (a ticket: one Touch ID, many local runs)
  bgrun approve-local --ask -- <command>      (a dialog offers this run only / 1 h / 7 h / until a time)
  bgrun approve-local status | revoke [ID...] | check [DIR]   (check: only a live any-command ticket counts; --scope matches the directory you run bgrun from)
EOF
}
if [ "$#" -eq 0 ]; then
  bg_usage
  exit 2
fi
if [ "$1" = approve-local ]; then
  shift
  bg_approve_local "$@"
  exit $?
fi
case "$1" in
  -h|--help)
    bg_usage
    exit 0
    ;;
  --)
    echo "bg: lone -- is not supported; pass the command directly (see bgrun --help)" >&2
    exit 2
    ;;
  --*)
    echo "bg: unknown option '$1' (bg has no flags; the first argument must be the command)" >&2
    echo "bg: example: bg ./build-searxng-image   — not: bg --name x -- ./build-searxng-image" >&2
    exit 2
    ;;
esac
"$(dirname "$0")/gradle-limits" check 2>/dev/null || true

is_gradle=0
for a in "$@"; do
  case "$a" in
    --stop|--status|--version|-v) is_gradle=0; break ;;
  esac
  case "${a##*/}" in
    gradle|gradlew) is_gradle=1 ;;
  esac
done
# Plektra is built only on CI (Forgejo 2026-10-14, GitHub runners 2026-10-18; djbclark): refuse a Gradle command in a
# Plektra checkout (from its cwd, or a gradlew path into one). BG_ALLOW_LOCAL_PLEKTRA=1 overrides
# it on djbclark's say only (don't advertise it in messages agents see).
if [ "$is_gradle" = 1 ] && [ "${BG_ALLOW_LOCAL_PLEKTRA:-0}" != 1 ]; then
  plektra_dirs=("$PWD")
  for a in "$@"; do
    case "$a" in */gradlew|*/gradle) plektra_dirs+=("$(dirname "$a")") ;; esac
  done
  for d in "${plektra_dirs[@]}"; do
    top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || continue
    if ggrep -qs 'namespace = "rocks.pkb.plektra"' "$top/app/build.gradle.kts"; then
      echo "bg: Plektra is built on GitHub Actions only, never on this Mac ($top)." >&2
      echo "bg: tests or any Gradle task: scripts/github-test-ref REF [GRADLE_ARGS...]; an APK: scripts/github-test-ref --release plk/main" >&2
      echo "bg: (a release is built), then scripts/github-install-latest. See the repo's AGENTS.md." >&2
      exit 3
    fi
  done
fi
# CI-first (djbclark, 2026-10-18): before a build or test runs here, its repo needs a recorded decision
# about CI: `load-watch ci decide DIR ci "CMD"` (bg refuses and names the command), `local "why"`
# (runs here; recording it needs djbclark's Allow dialog + Touch ID, like `bg approve-local`: operator 2026-11-15) or `pending` (seeded from repos bg already ran in; runs here, with a reminder). No decision:
# refuse until the agent has looked at offloading it (forgejo-ci skill) and recorded one. Worktrees and
# cow pastures take their main repo's decision. BG_ALLOW_LOCAL_CI_ONLY=1 on djbclark's say only (don't
# advertise it in messages agents see); BG_CI_UNDECIDED_OK=1 lets one small test file through undecided.
# Fails open if load-watch is missing or errors.
# In `ci` mode a small targeted test run still runs here (djbclark via djbclark-ade-4d, 2026-10-18): one
# that names test files, path::test ids or -k (pytest, python -m unittest ids) or gradle --tests; -k or a
# ::id also narrows a directory (`pytest tests/ -k foo`). A bare suite, a bare directory and any build go
# to CI. cargo stays out: a filtered `cargo test` still compiles the whole crate graph here. A filter
# that matches nearly everything (`-k "not slow"`, `--tests '*'`) gets through: this guards against
# honest mistakes, not evasion.
# JavaScript (2026-11-14): vitest, jest and `bun test`, bare or behind bunx/npx/pnpm exec/yarn, and `npm|pnpm|yarn|bun [run]
# test[:x]`, count the same way: a test file path (.test./.spec./_test./__tests__/tests/ names that exist, `file:12` too), or a -t /
# --testNamePattern (or --testPathPattern) filter, which also narrows a directory. A bare suite, a bare directory, `npm test`,
# `bun run test` and `vitest run` alone go to CI. A run bg sends to CI that must run here: `bg approve-local` (header).
# ci_pm_script_ok NAME (2026-11-14, lead adversary B1): `npm|pnpm|yarn|bun run NAME` runs whatever ./package.json says, and its pre/post
# scripts, and appends the extra arguments only to the LAST command of a compound script (`bun test ./a && bun test ./b`,
# `pnpm -r test && node --test`, `pnpm run build && playwright test`), so a file or -t on it proves nothing. Targeted only when
# scripts.NAME is ONE plain runner call (vitest, jest or `bun test`, behind env assignments, npx, bunx or `pnpm exec`), with no
# shell metacharacter, no pre/post script of that name, and the file readable here (the current directory's; --prefix/-C already
# send the run to CI). A missing file, a parse failure or no python3 is not targeted: fail closed.
ci_pm_script_ok() {
  [ -f package.json ] || return 1
  python3 -I -c '
import json, os, re, sys
n = sys.argv[1]
try:
    s = json.load(open("package.json"))["scripts"]
    b = s[n]
except Exception:
    sys.exit(1)
if not isinstance(b, str) or ("pre" + n) in s or ("post" + n) in s or re.search(r"[&|;<>$`()\n\\]", b):
    sys.exit(1)
# a workspace setting makes `npm test` run the script of every workspace, whatever ./package.json says
for rc in ("./.npmrc", os.path.expanduser("~/.npmrc")):
    try:
        if re.search(r"^\s*[\"\x27]?workspaces?(\[\])?[\"\x27]?\s*=", open(rc).read(), re.I | re.M):
            sys.exit(1)
    except OSError:
        pass
if any(k.lower() in ("npm_config_workspace", "npm_config_workspaces") for k in os.environ):
    sys.exit(1)
w = b.split()
while w and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=\S*", w[0]):
    w.pop(0)
if w[:2] == ["pnpm", "exec"]:
    w = w[2:]
while w and w[0] in ("npx", "bunx", "--no-install", "--yes", "-y"):
    w.pop(0)
if w[:2] == ["bun", "test"]:
    rest = w[2:]
elif w and w[0].rsplit("/", 1)[-1] == "vitest":
    rest = w[1:]
    if rest[:1] == ["run"]:
        rest = rest[1:]
elif w and w[0].rsplit("/", 1)[-1] == "jest":
    rest = w[1:]
else:
    sys.exit(1)
# the runner may carry options only: a positional (`vitest run src`), a glob, a comment or a bare `--` in the body would
# widen what the file or -t the caller adds narrows (its arguments are appended after the body)
valued = ("-c", "--config", "--project", "--dir", "--root", "--reporter", "--outputFile", "--exclude", "--pool", "--bail", "--shard", "--environment", "--testPathIgnorePatterns", "-t", "--testNamePattern", "--mode", "--testTimeout", "--maxWorkers", "--retry", "--logLevel", "--setupFiles", "--globalSetup")
if rest and rest[-1] in valued:
    sys.exit(1)   # a trailing option that takes a value would swallow the file the caller adds
for t in rest:
    if re.match(r"--test-?(path-?patterns?|match|regex)\b", t, re.I):
        sys.exit(1)   # jest ORs these with the positionals the caller adds: the run would widen
    if t == "--" or not re.fullmatch(r"-[A-Za-z0-9._-]+(=[^\s*?\[#]*)?", t):
        sys.exit(1)
sys.exit(0)
' "$1" 2>/dev/null
}
ci_targeted() {
  local a prev="" runner="" sel=0 narrow=0 broad=0 pm=0 f npm=0 dd=0 okf okp cmdpos=1 cp jsrun pmw="" bunrun=0 script="" pmbad=0
  for a in "$@"; do
    # cp: this word is still in command position (only wrappers, options, numbers and assignments before it), so a JS runner or
    # package-manager word counts; `make -j8 vitest x` and `pytest tests/jest` do not make a JS run (lead adversary B3).
    cp=$cmdpos
    if [ "$cmdpos" = 1 ]; then
      # an assignment or option that moves npm/pnpm to another workspace or directory (`env npm_config_workspaces=true npm test`,
      # `env -C /x npm test`) makes the package.json bg reads the wrong one (lead adversary round 2, WARN1, WARN2)
      case "$a" in
        [nN][pP][mM]_[cC][oO][nN][fF][iI][gG]_*=*|[pP][nN][pP][mM]_[cC][oO][nN][fF][iI][gG]_*=*|-C*|-[!-]*C*|--c|--c=*|--ch*) pmbad=1 ;;
      esac
      case "$a" in
        -*|[0-9]*|*=*|env|nice|time|timeout|gtimeout|caffeinate|taskpolicy|npx|bunx|npm|pnpm|yarn|bun|exec|x|dlx|run|node|*/node|*/node_modules/.bin/*|vitest|vitest.*|jest|jest.js|jest-cli) ;;
        *) cmdpos=0 ;;
      esac
    fi
    jsrun=0
    [ "$prev" = -m ] && [ "$runner" != js ] && case "$a" in pytest) runner=pytest ;; unittest) runner=unittest ;; esac
    case "${a##*/}" in
      pytest|py.test) [ "$runner" = js ] || runner=pytest ;;
      gradle|gradlew) [ "$runner" = js ] || runner=gradle ;;
      # JavaScript runners (2026-11-14): the runner itself, behind any wrapper (bunx/npx/pnpm exec/yarn)...
      vitest|vitest.js|vitest.[cm]js|jest|jest.js|jest-cli) [ -z "$runner" ] && [ "$cp" = 1 ] && { runner=js; jsrun=1; } ;;
      # ...or a package manager's test script: `npm|pnpm|yarn|bun [run] test[:x]` (`bun test` is bun's own runner).
      npm|pnpm|yarn|bun)
        # a package manager's own word, not part of another runner's arguments (`pytest tests/bun` is a directory)
        if [ -z "$runner" ] && [ "$cp" = 1 ]; then
          pm=1; pmw=${a##*/}; prev=$a
          [ "$pmw" = npm ] && npm=1
          continue
        fi
        ;;
    esac
    if [ "$pm" = 1 ] && [ -z "$runner" ]; then
      case "$a" in
        # an option here (`-r`, `--filter=a`, `--prefix=x`, `-w`, `--workspaces`) can choose another package.json than the
        # one bg reads: only the plainly harmless ones pass (lead adversary round 2, BLOCK1)
        --silent|-s|--if-present|--no-color) ;;
        -*) pmbad=1 ;;
        exec|x|dlx) ;;
        run|run-script) bunrun=1 ;;
        test|test:*)
          runner=js; pm=0; prev=$a
          # a script (read from ./package.json at the end), except `bun test` itself, which is bun's own runner
          if [ "$pmw" = bun ] && [ "$bunrun" = 0 ] && [ "$a" = test ]; then :; else script=$a; fi
          continue ;;
        *) pm=0 ;;
      esac
    fi
    # (pytest's -k and path::id, gradle's --tests: not for a JS runner, whose own forms are below)
    [ "$runner" = js ] || case "$a" in
      -k|-k?*|*::*) sel=1; narrow=1 ;;
      --tests|--tests=*) sel=1 ;;
    esac
    case "$runner" in
      js)
        # npm reads the flags before `--` itself and drops them (`npm test -t foo` runs the whole suite), then passes what follows its
        # one `--`. Anywhere else a `--` moves what follows into the runner's double-dash option, not its filters (vitest, 2026-11-14:
        # `pnpm test -- tests/a.test.ts` starts the whole suite, cobuildwithus/murph#2917). So a filter counts when no `--` precedes
        # it (npm: exactly one), a file path likewise (npm: up to one).
        okf=0; okp=0
        if [ "$npm" = 1 ]; then
          [ "$dd" = 1 ] && okf=1
          [ "$dd" -le 1 ] && okp=1
        else
          [ "$dd" = 0 ] && okf=1 && okp=1
        fi
        [ "$jsrun" = 1 ] || case "$a" in
          --) dd=$((dd + 1)) ;;
          # a name or path-pattern filter narrows even a directory (as pytest -k does)
          -t|-t=*|--testNamePattern|--testNamePattern=*|--test-name-pattern|--test-name-pattern=*|--testPathPattern|--testPathPattern=*|--testPathPatterns|--testPathPatterns=*)
            [ "$okf" = 1 ] && { sel=1; narrow=1; } ;;
          -*)
            # a package manager's own option after the script name and before `--`: npm eats all of them, and the others
            # have workspace selectors that may sit here too; either can run another package's script (BLOCK1)
            if [ -n "$script" ] && [ "$dd" = 0 ]; then
              case "$a" in
                -r|--recursive|--filter|--filter=*|-F|--dir|--dir=*|-C|--workspace*|-w|--workspaces|-ws|--ws|--prefix|--prefix=*|--cwd|--cwd=*|--include-workspace-root|--workspace-root) pmbad=1 ;;
                *) [ "$npm" = 1 ] && pmbad=1 ;;
              esac
            fi ;;
          *)
            # the value of an option is not a filter (`--config tests/jest.config.js`, `--pool threads`)...
            case "$prev" in -c|--config|--setupFiles|--globalSetup|--root|--dir|--project|--reporter|--outputFile|--exclude|--setupFilesAfterEnv|--roots|--collectCoverageFrom|--coverage.include|--coverage.exclude|--testPathIgnorePatterns|--coveragePathIgnorePatterns|--modulePathIgnorePatterns|--watchPathIgnorePatterns|--pool|--testTimeout|--maxWorkers|--workers|--shard|--environment|--mode|--logLevel|--retry|--bail|--coverage.reporter|--browser|-w|--globalTeardown|--testSequencer|--resolver|--rootDir|--snapshotSerializers|--typecheck.include|--transform|--reporters|--testEnvironment|--cacheDirectory) ;; *)
              # ...and vitest's subcommands are not either; any OTHER positional is a substring/regex filter that widens the
              # run by union (`f.test.ts ""` or `f.test.ts integration` runs more than f; lead adversary B2), so it counts as
              # broad (a -t filter can still narrow it) unless it is an existing test file.
              case "$a" in run|watch|dev|related|bench|typecheck|list) ;; *)
                if [ "$okp" = 1 ]; then
                  f=${a%%:[0-9]*}   # file.test.ts:12 (vitest line filter)
                  case "${f##*/}" in
                    *.test.*|*.spec.*|*_test.*|*_spec.*) if [ -f "$f" ]; then sel=1; else broad=1; fi ;;
                    *) case "$f" in __tests__/*|*/__tests__/*) if [ -f "$f" ]; then sel=1; else broad=1; fi ;; *) broad=1 ;; esac ;;
                  esac
                fi ;;
              esac ;;
            esac
            ;;
        esac
        ;;
      pytest|unittest)
        case "$a" in
          -*) ;;
          *.py) [ -f "$a" ] && sel=1 ;;
          *) [ -d "$a" ] && broad=1 ;;
        esac
        if [ "$runner" = unittest ] && [ "$a" != unittest ]; then
          case "$a" in -*|*/*) ;; test*.*|*.test*|*.Test*) sel=1 ;; esac
        fi
        ;;
    esac
    prev=$a
  done
  [ -n "$runner" ] && [ "$sel" = 1 ] || return 1
  [ "$broad" = 0 ] || [ "$narrow" = 1 ] || return 1
  [ "$pmbad" = 0 ] || return 1
  [ -z "$script" ] || ci_pm_script_ok "$script"
}
# A release also runs here in `ci` mode (djbclark, 2026-10-18): `just release*` or a release.py, whose
# test gate is the CI run itself; what stays local is the publish step (tag, tap sync, brew reinstall and
# brew test on this Mac). `--local-tests` asks a release to run its suites here, so it goes to CI as usual.
ci_release() {
  local a runner=""
  for a in "$@"; do [ "$a" = --local-tests ] && return 1; done
  for a in "$@"; do
    case "${a##*/}" in
      just) runner=just; continue ;;
      release.py) return 0 ;;
    esac
    if [ "$runner" = just ]; then
      case "$a" in -*) ;; release|release-*) return 0 ;; *) return 1 ;; esac
    fi
  done
  return 1
}
lw="$HOME/src/djbclark-ade/bin/load-watch"
# macOS CI retry policy (2026-11-12); explicit platform for non-Swift/Xcode jobs.
bg_ci_platform="${BG_CI_PLATFORM:-}"
if [ -z "$bg_ci_platform" ]; then
  for a in "$@"; do
    case "${a##*/}" in swift|xcodebuild) bg_ci_platform=macos; break ;; esac
  done
fi
bg_ci_job="${BG_CI_JOB:-$*}"
bg_mac_gate=
bg_mac_route() {
  local answer route gate failures
  [ "$bg_ci_platform" = macos ] && [ "$(uname -s)" = Darwin ] || return 1
  local slow=()
  [ "${BG_CI_SLOW:-0}" = 1 ] && slow=(--slow)
  answer=$("$lw" ci route "$top" --job "$bg_ci_job" --platform macos "${slow[@]}" 2>/dev/null) || return 1
  IFS=$'\t' read -r route gate failures <<< "$answer"
  case "$route:$gate" in local:16|wait:16|local:bypass) bg_mac_gate=$gate; return 0 ;; esac
  return 1
}
# Offload (header): set below only for a targeted run in a `ci` repo that has a runnable CI route.
# offload_now ARGS: run bg-offload on $top as a child, not an exec (killing bg must stop it too, or it polls on as an
# orphan); its status is left in $off_rc.
offload_now() {
  "$bg_offload" "$top" -- "$@" &
  off_pid=$!
  trap 'kill "$off_pid" 2>/dev/null; exit 143' TERM INT HUP
  wait "$off_pid"; off_rc=$?
  trap - TERM INT HUP
  # Only a known CI verdict counts. 76/77 (timeout or no verdict) must not unlock local builds.
  if [ -n "$bg_ci_platform" ] && [ -n "${BG_CI_ATTEMPT:-}" ]; then
    local result=
    case "$off_rc" in 0) result=success ;; 1) result=failure ;; esac
    if [ -n "$result" ]; then
      "$lw" ci record "$top" --job "$bg_ci_job" --platform "$bg_ci_platform" \
        --attempt "$BG_CI_ATTEMPT" --result "$result" >/dev/null 2>&1 || true
    fi
  fi
}
# probe_route: exit 0 when bg-offload finds a CI route for $top; else $no_route says why (one line).
probe_route() {
  no_route=""
  if [ "${BG_OFFLOAD:-1}" = 0 ]; then no_route="BG_OFFLOAD=0"; return 1; fi
  if [ ! -x "$bg_offload" ]; then no_route="bin/bg-offload not found next to bg"; return 1; fi
  no_route=$("$bg_offload" --probe "$top" 2>&1 >/dev/null) && return 0
  no_route=${no_route##*$'\n'}; no_route=${no_route#bg: }; no_route=${no_route#offload: }
  [ -n "$no_route" ] || no_route="bg-offload --probe failed"
  return 1
}
# foreign_target ARGS: print why a build's command names something outside $top (a directory flag, or an argument
# that is an existing path outside the repo), or nothing. A tool given by path from a $PATH directory
# (/usr/bin/make, /opt/homebrew/bin/just) is not another tree. `--opt=VALUE` and `NAME=VALUE` are read as VALUE, a
# short option's attached value (`-p../x`) as that value. A shell's -c string or -s stdin script (`bash -c 'cd ../x
# && make'`) cannot be read at all, so it counts too, and so does an interpreter's inline code (`python3 -c`,
# `perl -e`, `node -e`, before its script or module); -C anywhere in a short-option cluster (`make -sC/x`) is a
# directory flag; -p is one for gradle only (`cargo build -p crate` names a package) (adversary N3). A working
# directory with no tracked file, or a git-ignored one, is not this repo's build either (adversary r3 F2).
foreign_target() {
  local a v full dir p top_real path_dirs=() shell=0 gradle=0 interp=0
  top_real=$(greadlink -f -- "$top") || { echo "cannot resolve $top"; return; }
  if [ -z "$(git -C "$PWD" ls-files -- . 2>/dev/null | ghead -n 1)" ] || git -C "$PWD" check-ignore -q . 2>/dev/null; then
    echo "the working directory $PWD holds no tracked file of $top"; return
  fi
  IFS=: read -r -a path_dirs <<< "$PATH"
  for a in "$@"; do
    case "${a##*/}" in
      sh|bash|zsh|dash|ksh|mksh|yash|fish|tcsh|csh|nu|elvish|xonsh|pwsh|powershell) shell=1 ;;
      gradle|gradlew) gradle=1 ;;
    esac
  done
  for a in "$@"; do
    # An interpreter's own options (up to its script or module) may hold inline code.
    if [ "$interp" = 1 ]; then
      case "$a" in
        --eval|--eval=*|--command|--command=*|-c|-e|-E|-[!-]*[ceE]*) echo "inline interpreter code ($a)"; return ;;
        -W|-X|-I|-r) interp=2 ;;  # these take the next word as their value
        -m|[!-]*) interp=0 ;;
      esac
    elif [ "$interp" = 2 ]; then
      interp=1
    fi
    case "${a##*/}" in python|python[0-9]*|perl|ruby|node|bun|deno|osascript) interp=1 ;; esac
    if [ "$shell" = 1 ]; then
      case "$a" in --command|--command=*|-Command|-EncodedCommand|-c|-s|-[!-]*[cs]*) echo "a shell command string ($a)"; return ;; esac
    fi
    case "$a" in
      --project-dir|--project-dir=*|--directory|--directory=*|--manifest-path|--manifest-path=*)
        echo "directory flag ${a%%=*}"; return ;;
      -*=*) ;;
      -[A-Za-z]*)
        [[ "$a" =~ ^-[A-Za-z]*C ]] && { echo "directory flag -C ($a)"; return; }
        [ "$gradle" = 1 ] && [[ "$a" =~ ^-p ]] && { echo "directory flag -p ($a)"; return; }
        ;;
      [A-Za-z_]*=*)
        case "${a#*=}" in -C*|*" -C"*|*--directory*) echo "directory flag in $a"; return ;; esac
        ;;
    esac
    v=$a
    case "$a" in
      -*=*|[A-Za-z_]*=*) v=${a#*=} ;;
      -[A-Za-z]?*) v=${a#-?} ;;
    esac
    [ -n "$v" ] && [ -e "$v" ] || continue
    full=$(greadlink -f -- "$v") || { echo "cannot resolve $v"; return; }
    case "$full/" in "$top_real"/*) continue ;; esac
    case "$v" in
      */*)
        if [ "$v" = "$a" ] && [ -f "$full" ] && [ -x "$full" ]; then
          dir=$(greadlink -f -- "${v%/*}" 2>/dev/null) || dir=""
          for p in "${path_dirs[@]}"; do
            [ -n "$dir" ] && [ -n "$p" ] && [ "$(greadlink -f -- "$p" 2>/dev/null)" = "$dir" ] && continue 2
          done
        fi
        ;;
    esac
    echo "$v is outside $top"; return
  done
}
offload_ok=0
# A failed greadlink must leave this empty, never "./bg-offload" (a file in the caller's repo).
bg_offload=$(greadlink -f "$0") && bg_offload="${bg_offload%/*}/bg-offload" || bg_offload=
offload_after="${BG_OFFLOAD_AFTER:-60}"
if [ -x "$lw" ] && [ "${BG_ALLOW_LOCAL_CI_ONLY:-0}" != 1 ] \
    && top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ]; then
  dec=$("$lw" ci check "$top" 2>/dev/null); rc=$?
  mode=${dec%%$'\t'*}; rest=${dec#*$'\t'}; text=${rest%%$'\t'*}
  if [ "$rc" = 1 ] && [ "${BG_CI_UNDECIDED_OK:-0}" != 1 ]; then
    echo "bg: $top has no CI-first decision yet, so bg will not build or test in it." >&2
    echo "bg: First see whether this work can run on CI instead of this Mac (GitHub runners, forgejo-ci skill):" >&2
    echo "bg: Linux-capable builds and tests usually can; macOS-only work can use GitHub's macOS runners." >&2
    echo "bg: Ask djbclark before pushing CI branches to a repo he does not own. Then record the decision and rerun:" >&2
    echo "bg:   $lw ci decide $top ci \"<command that runs it on CI>\"" >&2
    echo "bg:   $lw ci decide $top local \"<why it must run on this Mac>\"   (asks djbclark: Allow dialog + Touch ID)" >&2
    exit 3
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && bg_mac_route; then
    echo "bg: macOS CI fallback for $bg_ci_job (load gate $bg_mac_gate); running locally through bg." >&2
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && ci_targeted "$@"; then
    if probe_route; then
      offload_ok=1
      echo "bg: $top runs full suites and builds on CI (load-watch ci); this targeted test run stays here," >&2
      echo "bg: unless the load gate holds it past ${offload_after} s, when it runs on CI instead (BG_OFFLOAD=0: wait here)." >&2
    else
      echo "bg: $top runs full suites and builds on CI (load-watch ci); this targeted test run stays here." >&2
      [ "$no_route" = BG_OFFLOAD=0 ] || echo "bg: (no CI route to hand it to if the load gate holds it: $no_route)" >&2
    fi
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && ci_release "$@"; then
    echo "bg: $top runs full suites and builds on CI (load-watch ci); a release gates on CI and publishes here." >&2
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && bg_ticket_honour "$@"; then
    echo "bg: $top runs full suites and builds on CI (load-watch ci); djbclark's approval ticket $bg_ticket_used covers this local run (bgrun approve-local status)." >&2
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && bg_approval_consume "$@"; then
    echo "bg: $top runs full suites and builds on CI (load-watch ci); djbclark approved this one local run (bg approve-local), now used up." >&2
  elif [ "$rc" = 0 ] && [ "$mode" = ci ]; then
    # A build or full suite: to CI at once, no load wait and no slot (header); never run here. Not when the command
    # names another tree (adversary F6, 2026-11-01): `bg make -C ~/src/other` run from inside a `ci` repo would get
    # this repo's green CI for a build that never ran anywhere.
    no_route=$(foreign_target "$@")
    if [ -n "$no_route" ]; then
      no_route="the command names another tree ($no_route), so this repo's CI cannot vouch for it"
    elif probe_route; then
      echo "bg: $top runs full suites and builds on CI, never on this Mac (load-watch ci): running it on CI now." >&2
      offload_now "$@"
      [ "$off_rc" = 69 ] || exit "$off_rc"
      no_route="the offload was refused (reason above); nothing ran here"
    fi
    case "$no_route" in
      "private repo has no Forgejo route:"*|"FORGEJO UNREACHABLE:"*)
        # djbclark 2026-11-01: a private repo builds on Forgejo only; say so first, greppably.
        echo "bg: $no_route" >&2
        echo "bg: fix Forgejo (forgejo / forgejo-ci skills); if you cannot, notify djbclark (hermes-ping) and keep doing work that is not blocked" >&2
        ;;
    esac
    echo "bg: $top runs full suites and builds on CI, never on this Mac (load-watch ci)." >&2
    echo "bg: run instead: $text" >&2
    echo "bg: a targeted run may stay here: test files, path::test ids or -k, gradle --tests, vitest/jest/bun test file paths or -t; so may a release." >&2
    bg_self=$0
    bg_cmd=$(printf '%q ' "$@"); bg_cmd=${bg_cmd% }
    echo "bg: if this run really must run on this Mac, ask djbclark to approve this one run: run \`$bg_self approve-local -- $bg_cmd\` yourself;" >&2
    echo "bg: it asks for his Touch ID/password, then the next identical run here goes through once." >&2
    echo "bg: to let this and later local runs through for a while instead (he picks the duration in a dialog, one Touch ID): $bg_self approve-local --ask -- $bg_cmd" >&2
    case "$no_route" in
      "private repo has no Forgejo route:"*|"FORGEJO UNREACHABLE:"*) ;;
      *) echo "bg: no CI route was found to run it there now: $no_route" >&2 ;;
    esac
    exit 3
  elif [ "$rc" = 0 ] && [ "$mode" = pending ]; then
    echo "bg: reminder: $top runs locally pending a CI-first decision; see whether it can move to" >&2
    echo "bg: CI (GitHub runners, forgejo-ci skill), then: $lw ci decide $top ci|local \"...\"" >&2
  fi
fi
is_test=0
for a in "$@"; do
  case "$a" in
    --version|-V|--help|-h|--collect-only|--co) is_test=0; break ;;
  esac
  case "${a##*/}" in
    pytest|py.test|tox|nox|run_tests*.py) is_test=1 ;;
    *" pytest "*|*" pytest"|"pytest "*|*"run_tests"*) is_test=1 ;;
  esac
done
# Swift/Xcode builds and tests (2026-10-13): `swift test --filter X` on CodexBar compiled the whole
# test target with one swift-frontend per core (8 on 8 cores, 0.2-3.5 GB each) and, with a Gradle
# daemon, pushed the 16 GB Mac to load 180 and 10.6 of 11.3 GB of swap. So `swift build|test|run`
# and `xcodebuild` take a test slot and get a jobs cap (-j / -jobs BG_CPUS) unless the caller set one.
swift_idx=0
xcode=0
i=0
for a in "$@"; do
  i=$((i + 1))
  case "${a##*/}" in
    swift) [ "$swift_idx" = 0 ] && swift_idx=$i ;;
    xcodebuild) xcode=1 ;;
  esac
done
if [ "$swift_idx" -gt 0 ]; then
  j=0
  sub=0
  for a in "$@"; do
    j=$((j + 1))
    [ "$j" -le "$swift_idx" ] && continue
    case "$a" in -*) continue ;; esac
    case "$a" in build|test|run) sub=$j ;; esac
    break
  done
  if [ "$sub" -gt 0 ]; then
    has_jobs=0
    for a in "$@"; do
      case "$a" in -j|-j[0-9]*|--jobs|--jobs=*) has_jobs=1 ;; esac
    done
    is_test=1
    if [ "$has_jobs" = 0 ]; then
      jobs_n="${BG_CPUS:-3}"
      set -- "${@:1:$sub}" -j "$jobs_n" "${@:$((sub + 1))}"
    fi
  fi
fi
if [ "$xcode" = 1 ]; then
  is_test=1
  has_jobs=0
  for a in "$@"; do
    case "$a" in -jobs|-jobs=*) has_jobs=1 ;; esac
  done
  [ "$has_jobs" = 1 ] || set -- "$@" -jobs "${BG_CPUS:-3}"
fi
bg_t0=$(gdate +%s)
max_wait="${BG_MAX_WAIT:-21600}"
bg_repo=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || bg_repo=$PWD
bg_ping="${BG_PING_CMD:-$HOME/.local/bin/hermes-ping}"
# bg_key: the command's first two words, past wrappers (nice -n N, env, VAR=x, timeouts) and flags.
bg_key() {
  local a skip=0 out=()
  for a in "$@"; do
    if [ "$skip" -gt 0 ]; then skip=$((skip - 1)); continue; fi
    if [ "${#out[@]}" = 0 ]; then
      case "$a" in
        nice|env|time|caffeinate|taskpolicy|timeout|gtimeout|[0-9]*|*=*) continue ;;
        -n) skip=1; continue ;;
      esac
    fi
    case "$a" in -*) continue ;; esac
    out+=("${a##*/}")
    [ "${#out[@]}" -ge 2 ] && break
  done
  echo "${out[*]}"
}
bg_k=$(bg_key "$@")
waited_s() { echo $(( $(gdate +%s) - bg_t0 )); }
# dur <seconds>: "6 h" / "45 min" / "20 s" for messages.
dur() { if [ "$1" -ge 3600 ]; then echo "$(($1 / 3600)) h"; elif [ "$1" -ge 60 ]; then echo "$(($1 / 60)) min"; else echo "$1 s"; fi; }

# Deadlines (header, "Deadline"): alert-only. A missing or failing `deadline` only costs a warning, never the run.
bg_deadline_cmd="${BG_DEADLINE_CMD:-$HOME/src/djbclark-ade/bin/deadline}"
bg_dl_owner="${PASEO_AGENT_ID:--}"
bg_dl_on=1
bg_dl_warned=0
bg_dl_log=       # set in the detached watcher, whose stderr is /dev/null: warnings go to this file instead
bg_wait_name=
bg_wait_live=0
bg_wait_beat=0
bg_dl_to=()
command -v gtimeout >/dev/null 2>&1 && bg_dl_to=(gtimeout 10)
bg_dl_warn() {
  [ "$bg_dl_warned" = 1 ] && return 0
  bg_dl_warned=1
  if [ -n "$bg_dl_log" ]; then
    printf '%s bg: deadline: %s\n' "$(gdate -Is)" "$1" >> "$bg_dl_log" 2>/dev/null
  else
    echo "bg: deadline: $1 (continuing without it; BG_NO_DEADLINE=1 silences this)" >&2
  fi
  return 0
}
# bg_dl SUBCOMMAND ARGS...: run `deadline`, output discarded (bg's own output stays as it was), stdin untouched,
# never longer than 10 s; its failure warns once and is returned, never fatal.
bg_dl() {
  local err rc=0
  err=$("${bg_dl_to[@]}" "$bg_deadline_cmd" "$@" 2>&1 >/dev/null </dev/null) || rc=$?
  if [ "$rc" != 0 ]; then
    err=${err##*$'\n'}
    bg_dl_warn "deadline $1 failed (exit $rc${err:+: $err})"
  fi
  return "$rc"
}
if [ "${BG_NO_DEADLINE:-0}" = 1 ] || [ -n "${DEADLINE_NAME:-}" ]; then
  bg_dl_on=0   # opted out, or already under `deadline run`
elif [ ! -x "$bg_deadline_cmd" ]; then
  bg_dl_warn "$bg_deadline_cmd is not executable"
  bg_dl_on=0
fi
# --holder only when the installed `deadline` knows it: bg deploys on its own (site-public master) while `deadline` arrives with a
# djbclark-ade merge, so an older deadline must not turn every run into "unrecognized arguments" (2026-11-02, Dann 7).
bg_dl_h=0
[ "$bg_dl_on" = 1 ] && /usr/bin/grep -q -e "--holder" "$bg_deadline_cmd" 2>/dev/null && bg_dl_h=1
bg_holder() { [ "$bg_dl_h" = 1 ] && printf -- "--holder\n%s\n" "$1"; return 0; }
# bg_wait_rec <seconds waited>: first call (the first real wait, load gate or slot) registers the wait deadline with the
# rest of BG_MAX_WAIT as its budget; later calls beat it at most once a minute. Never registered when nothing waits.
bg_wait_rec() {
  [ "$bg_dl_on" = 1 ] || return 0
  local n; n=$(gdate +%s)
  if [ -z "$bg_wait_name" ]; then
    bg_wait_name="bg-wait-$$-$bg_t0"
    if bg_dl start "$bg_wait_name" --budget "$((max_wait - $1))s" --heartbeat 10m --owner "$bg_dl_owner" --on-expire notify $(bg_holder "$$"); then
      bg_wait_live=1
      bg_wait_beat=$n
      trap bg_wait_end EXIT
    fi
  elif [ "$bg_wait_live" = 1 ] && [ $((n - bg_wait_beat)) -ge 60 ]; then
    bg_wait_beat=$n
    bg_dl beat "$bg_wait_name" || bg_wait_live=0
  fi
}
# bg_wait_end: deregister the wait deadline; the EXIT trap runs it on every exit path, and it runs before the exec.
bg_wait_end() {
  [ "$bg_wait_live" = 1 ] || return 0
  bg_wait_live=0
  bg_dl done "$bg_wait_name"
  return 0
}
wait_pinged=0
# wait_tick <what>: give up past the budget; ping djbclark once past BG_PING_WAIT.
wait_tick() {
  local w; w=$(waited_s)
  if [ "$w" -ge "$max_wait" ]; then
    echo "bg: still waiting for $1 after ${w}s (BG_MAX_WAIT=$max_wait); giving up without running it" >&2
    exit 75
  fi
  bg_wait_rec "$w"
  if [ "$wait_pinged" = 0 ] && [ "$w" -ge "${BG_PING_WAIT:-3600}" ]; then
    wait_pinged=1
    "$bg_ping" "${bg_repo##*/}: bg job \"$bg_k\" has waited $(dur "$w") for $1; it gives up at $(dur "$max_wait")" >/dev/null 2>&1 &
  fi
}

max_per_core="${BG_MAX_LOAD_PER_CORE:-5.0}"
wait_s="${BG_LOAD_WAIT:-900}"
# A Gradle build always keeps the load gate (2026-10-10: a release build started with
# BG_LOAD_WAIT=0 at load 30 and the machine went to 50-70). BG_LOAD_WAIT=0 is for small test files.
if [ "$is_gradle" = 1 ] && [ "$wait_s" = 0 ]; then
  echo "bg: Gradle builds always wait for low load (BG_LOAD_WAIT=0 ignored)" >&2
  wait_s=900
fi
# Retry route overrides the generic per-core/churn gate, preserving slots and caps below.
[ "$bg_mac_gate" = 16 ] && wait_s=900
[ "$bg_mac_gate" = bypass ] && wait_s=0
if [ "$wait_s" != 0 ]; then
  cores=$(sysctl -n hw.ncpu)
  announced=0
  clear=0
  lw_since= lw_flag_ok=1   # epoch of this hold's first refusal; 0 once an older load-watch rejected --refused-since
  while :; do
    lw_wait=0 lw_rc=x lw_t=$SECONDS   # reset every pass: the sleep decision at the loop end must never read a stale call
    load1=$(sysctl -n vm.loadavg | gawk '{print $2}')
    over=$(gawk -v l="$load1" -v c="$cores" -v m="$max_per_core" 'BEGIN { print (l / c > m) ? 1 : 0 }')
    why="load below $max_per_core per core (now $load1)"
    if [ "$bg_mac_gate" = 16 ]; then
      over=$(gawk -v l="$load1" 'BEGIN { print (l > 16) ? 1 : 0 }')
      why="machine load <=16 for macOS CI fallback (now $load1)"
    elif [ -x "$lw" ]; then
      # Ask the watcher's gate (compressor churn, 2026-10-23), which load alone cannot show. Since 2026-10-25 it
      # also raises the per-core limit to its calm boost (load-watch's ADMIT_BOOST_PER_CORE; the value moves, so it
      # is not repeated here) while the compressor is calm, so a load between
      # $max_per_core and the boost is its call, not the awk check's. Exit 0 admit, 75 too hot; anything else
      # (error, missing) keeps the plain $max_per_core check above.
      # The first look is a pure check (--wait 0) so the hold message and the CI offload below keep their timing; once held,
      # load-watch does the waiting (2026-11-14): `admit --wait CHUNK` polls, staggers and applies its starvation valve (a soft-gate
      # refusal that lasts LW_STARVE_SOFT_S, 300 s, lets one job through, at most one per 120 s machine-wide), none of which a
      # bare `--wait 0` poll loop could get. A chunk, not the whole budget, so bg still ticks its own budget, ping, deadline
      # heartbeat and offload between calls (BG_ADMIT_CHUNK 420; the valve clock spans chunks via `--refused-since`, see below).
      lw_wait=0
      if [ "$announced" = 1 ]; then
        lw_wait=$((max_wait - $(waited_s)))
        # digits only, at most 4 (a leading zero would read as octal; 10# forces decimal), clamped to 480 s: bg's wait record
        # beats a 10 min heartbeat once per chunk, and bg's own 5-30 s pause plus process start-up add to the gap between beats
        case "${BG_ADMIT_CHUNK:-420}" in *[!0-9]*|"") chunk=420 ;; ?????*) chunk=420 ;; *) chunk=$((10#${BG_ADMIT_CHUNK:-420})) ;; esac
        [ "$chunk" -ge 1 ] || chunk=420
        [ "$chunk" -le 480 ] || chunk=480
        [ "$lw_wait" -le "$chunk" ] || lw_wait=$chunk
        if [ "$offload_ok" = 1 ] && [ "$(waited_s)" -lt "$offload_after" ]; then
          [ "$lw_wait" -le $((offload_after - $(waited_s))) ] || lw_wait=$((offload_after - $(waited_s)))
        fi
        [ "$lw_wait" -ge 1 ] || lw_wait=1
      fi
      lw_rc=0
      lw_t=$SECONDS
      # The valve clock spans chunks (2026-11-14, load-watch `--refused-since EPOCH`): every `--wait CHUNK` call of one hold carries
      # the epoch of the hold's first refusal, inline (never exported: LW_REFUSED_SINCE would then credit every later child). The
      # `--wait 0` look gets none. An older load-watch rejects the flag with argparse exit 2, `unrecognized arguments: --refused-since`;
      # on exactly that, the call is retried once without it and the flag is dropped for the rest of this run (a usage error is
      # never a refusal or an admit). stderr goes to a throwaway file only when the flag is passed, to read that message.
      lw_args=(admit --wait "$lw_wait")
      lw_errf=
      if [ "$lw_wait" != 0 ] && [ "$lw_flag_ok" = 1 ]; then
        [ -n "$lw_since" ] || lw_since=$(gdate +%s)   # a hold the look did not stamp: it starts now
        lw_errf=$(mktemp "${TMPDIR:-/tmp}/bg-lw-err.XXXXXX" 2>/dev/null) || lw_errf=
        if [ -n "$lw_errf" ]; then lw_args+=(--refused-since "$lw_since")
        else lw_flag_ok=0; echo "bg: no temp file for load-watch's stderr; waiting without --refused-since" >&2; fi
      fi
      lw_args+=(--max-per-core "$max_per_core")
      lw_out=$("$lw" "${lw_args[@]}" 2>"${lw_errf:-/dev/null}") || lw_rc=$?
      if [ "$lw_rc" = 2 ] && [ -n "$lw_errf" ] && grep -q 'unrecognized arguments:.*--refused-since' "$lw_errf" 2>/dev/null; then
        lw_flag_ok=0
        echo "bg: this load-watch does not know --refused-since; waiting without it" >&2
        lw_rc=0
        lw_t=$SECONDS   # the rejected call took no wait: the "load-watch waited" test below must time the retry only
        lw_out=$("$lw" admit --wait "$lw_wait" --max-per-core "$max_per_core" 2>/dev/null) || lw_rc=$?
      fi
      [ -z "$lw_errf" ] || rm -f "$lw_errf"
      if [ "$lw_rc" = 75 ]; then
        over=1; why="load or memory churn above the load-watch limit (load $load1)"
        [ -n "$lw_since" ] || lw_since=$(gdate +%s)   # the hold's first refusal (the --wait 0 look): the valve clock starts here
      elif [ "$lw_rc" = 0 ]; then
        over=0
        lw_since=   # the hold ended (admitted): a later refusal is a new hold with its own epoch
        # After a waiting call load-watch has staggered and re-read itself, and a forced admit must not be re-read (the claim is
        # spent): go. Its line carries ` waited_s=N` only after a real wait; a call that admitted at its first reading staggered
        # nothing, so it takes bg's own pause and re-read below, as before.
        if [ "$lw_wait" != 0 ]; then
          case "$lw_out" in *forced=starved*|*" waited_s="*) clear=1 ;; esac
        fi
        case "$lw_out" in *forced=starved*) echo "bg: load-watch's starvation valve admitted this job after a long hold (${lw_out#*admit ok })" >&2 ;; esac
      fi
    fi
    if [ "$over" = 0 ]; then
      # Straight through at low load; after a wait, read it twice with a random pause between.
      [ "$announced" = 0 ] || [ "$clear" = 1 ] && break
      clear=1
      sleep $((5 + RANDOM % 26))
      continue
    fi
    clear=0
    wait_tick "$why"
    if [ "$offload_ok" = 1 ] && [ "$(waited_s)" -ge "$offload_after" ]; then
      # Held past the threshold in a `ci` repo: CI runs the test instead of a busy Mac (header).
      echo "bg: held $(dur "$(waited_s)") for $why; running it on CI instead of waiting longer" >&2
      offload_now "$@"
      [ "$off_rc" = 69 ] || exit "$off_rc"
      offload_ok=0
      echo "bg: could not offload to CI (reason above); waiting for the gate as usual" >&2
    fi
    if [ "$announced" = 0 ]; then
      announced=1
      echo "bg: holding for $why ($cores cores); will wait up to $(dur "$max_wait") (normal: do not kill or retry)" >&2
    fi
    # load-watch's own wait was the pause; no wait on that path (missing/erroring load-watch, the macOS CI fallback gate, or a
    # --wait call that came back at once, which would otherwise spin) keeps the 15 s poll.
    lw_waited=0
    if [ "${lw_rc:-x}" = 75 ]; then
      if [ "$((SECONDS - ${lw_t:-0}))" -ge $((${lw_wait:-0} - 2)) ]; then lw_waited=1; fi
    fi
    [ "$lw_waited" = 1 ] || sleep 15
  done
fi

# take_slot <label> <slots> <dir>: wait for a free shlock slot, within the wait budget; the lock
# holds this shell's pid, which exec keeps, so a killed command frees its slot.
take_slot() {
  local label="$1" slots="$2" dir="$3" i got announced=0 held
  mkdir -p "$dir"
  while :; do
    got=
    for i in $(gseq 1 "$slots"); do
      if shlock -f "$dir/slot.$i" -p $$ 2>/dev/null; then got=$i; break; fi
    done
    [ -n "$got" ] && return 0
    wait_tick "a machine-wide $label slot"
    if [ "$announced" = 0 ]; then
      announced=1
      held=$(cat "$dir"/slot.* 2>/dev/null | gtr '\n' ' ')
      echo "bg: waiting for a machine-wide $label slot (held by pid $held); this is normal, do not kill or retry" >&2
    fi
    sleep 10
  done
}

slots="${BG_GRADLE_SLOTS:-1}"
if [ "$is_gradle" = 1 ] && [ "$slots" -gt 0 ]; then
  take_slot Gradle "$slots" "$HOME/.local/state/bg/gradle-slots"
fi

tslots="${BG_TEST_SLOTS:-2}"
if [ "$is_test" = 1 ] && [ "$tslots" -gt 0 ]; then
  take_slot test "$tslots" "$HOME/.local/state/bg/test-slots"
fi

# bg_container_exe ARGS...: Apple's `container` CLI named in the command. Past the wrappers bg_key skips (nice -n N, env, VAR=x,
# flags) the first word must be `container` or an absolute path that resolves to the `container` on bgrun's PATH or into a
# .../Cellar/container/... keg (decided before anything runs: any other script named container is never executed to be tested; never
# ./container or scripts/container either) and must answer `--version` with "container CLI version"; prints it, else fails (the
# command then runs as before, unguarded). BG_CONTAINER_TEST_CLI=PATH adds one more accepted path, for tests.
bg_container_exe() {
  local a skip=0 ver real std tst
  for a in "$@"; do
    if [ "$skip" -gt 0 ]; then skip=$((skip - 1)); continue; fi
    case "$a" in
      nice|env|time|caffeinate|taskpolicy|timeout|gtimeout|[0-9]*|*=*) continue ;;
      -n) skip=1; continue ;;
      -*) continue ;;
    esac
    case "$a" in
      container) ;;
      /*/container)   # decide BEFORE running anything: a script named container must not be run twice (--version, then for real)
        real=$(greadlink -f "$a" 2>/dev/null) || return 1
        std=$(command -v container 2>/dev/null); [ -n "$std" ] && std=$(greadlink -f "$std" 2>/dev/null)
        tst=; [ -n "${BG_CONTAINER_TEST_CLI:-}" ] && tst=$(greadlink -f "$BG_CONTAINER_TEST_CLI" 2>/dev/null)   # test seam
        case "$real" in */Cellar/container/*) ;; *) [ -n "$real" ] && { [ "$real" = "$std" ] || [ "$real" = "$tst" ]; } || return 1 ;; esac ;;
      *) return 1 ;;
    esac
    if command -v gtimeout >/dev/null 2>&1; then ver=$(gtimeout 20 "$a" --version 2>/dev/null | head -n 1); else ver=$("$a" --version 2>/dev/null | head -n 1); fi
    case "$ver" in "container CLI version"*) printf '%s\n' "$a"; return 0 ;; esac
    return 1
  done
  return 1
}

# bg_container_state EXE: up | down | unknown, from the exit status of `system status --format json` (0 running; upstream exits 1
# when the apiserver is unregistered or not running). A timeout (a loaded Mac answering slowly) is unknown, never down.
bg_container_state() {
  local rc t="${BG_CONTAINER_STATUS_TIMEOUT:-20}"
  if command -v gtimeout >/dev/null 2>&1; then gtimeout "$t" "$1" system status --format json >/dev/null 2>&1; rc=$?
  else "$1" system status --format json >/dev/null 2>&1; rc=$?; fi
  case "$rc" in 0) echo up ;; 124|137) echo unknown ;; *) echo down ;; esac
}

# bg_container_preflight EXE SUB: start a definitely-down apiserver once (header). `system` and help/version calls need none.
bg_container_preflight() {
  local exe="$1" sub="$2" st
  case "$sub" in system|""|-h|--help|--version|-v|help) return 0 ;; esac
  [ "${BG_CONTAINER_AUTOSTART:-1}" = 1 ] || return 0
  st=$(bg_container_state "$exe")
  [ "$st" = up ] && return 0
  if [ "$st" = unknown ]; then
    echo "bg: 'container system status' did not answer in time (a loaded Mac?); running the command anyway: the XPC check catches a real failure" >&2
    return 0
  fi
  echo "bg: the container apiserver is not running; starting it: container system start --disable-kernel-install" >&2
  if command -v gtimeout >/dev/null 2>&1; then gtimeout 120 "$exe" system start --disable-kernel-install </dev/null >&2 || true
  else "$exe" system start --disable-kernel-install </dev/null >&2 || true; fi
  st=$(bg_container_state "$exe")
  [ "$st" = down ] || return 0
  echo "bg: the container apiserver is still not running after 'container system start'; not running the command (check 'container system status' and /opt/homebrew/var/log/container.log)" >&2
  return 72
}

# bg_container_guard_exec ARGS...: exec bin/bgrun-container-guard (next to the real bgrun file, not a symlink to it), which runs
# the command as a child, relays its output, forwards signals and turns an XPC "Connection invalid" error reported with exit 0
# into exit 70 (header). exec keeps bg's pid for the guard (the command is its child), so the slot locks and the long-run watcher follow the guard.
bg_container_guard_exec() {
  local self dir
  self=$(greadlink -f "$0" 2>/dev/null) || self=$0
  dir=$(cd "$(dirname "$self")" 2>/dev/null && pwd)
  if [ -x "$dir/bgrun-container-guard" ] && command -v python3 >/dev/null 2>&1; then
    exec python3 -I "$dir/bgrun-container-guard" -- "$@"
  fi
  echo "bg: bgrun-container-guard or python3 is missing; running the container command without the XPC check" >&2
  return 1
}

# Long-run watcher (see the header): forked here, so it watches this pid through the exec.
bg_hist="$HOME/.local/state/bg/history.tsv"
mkdir -p "${bg_hist%/*}"
bg_mark="$HOME/.local/state/bg/run-started.$$.$bg_t0"
bg_watch() {
  local pid="$1" t0 lstart now el med limit pinged=0 poll="${BG_WATCH_POLL:-30}" dl="" hb dl_beat=1 w=0
  # The run has started once bg has touched the marker, the moment before its exec (the pid stays the same through the exec).
  # bg gone first (killed in between): nothing started, nothing is registered or recorded.
  lstart=$(ps -o lstart= -p "$pid" 2>/dev/null)
  while [ ! -e "$bg_mark" ]; do
    if [ -z "$lstart" ] || [ "$(ps -o lstart= -p "$pid" 2>/dev/null)" != "$lstart" ]; then rm -f "$bg_mark"; return 0; fi
    [ "$w" -ge 600 ] && break   # 60 s: never seen, bg alive: treat it as started rather than watch nothing
    w=$((w + 1))
    sleep 0.1
  done
  rm -f "$bg_mark"
  t0=$(gdate +%s)
  # Run deadline (header): registered here, in the detached watcher, so bg never waits for it. Its stderr is /dev/null,
  # so a failure is logged to bg_dl_log instead of printed. The watcher is the holder ($BASHPID; bash 3.2 has none and falls
  # back to the command's pid, which is gone just as well when the group is killed).
  if [ "$bg_dl_on" = 1 ]; then
    bg_dl_log="$HOME/.local/state/bg/deadline.log"
    case "$poll" in *[!0-9]*|"") hb=600 ;; *) hb=$((4 * poll)); [ "$hb" -lt 600 ] && hb=600 ;; esac
    dl="bg-run-$pid-$t0"
    bg_dl start "$dl" --budget "${BG_DEADLINE:-30m}" --heartbeat "${hb}s" --owner "$bg_dl_owner" --on-expire notify $(bg_holder "${BASHPID:-$$}") || dl=""
  fi
  lstart=$(ps -o lstart= -p "$pid" 2>/dev/null)
  med=$(gawk -F'\t' -v r="$bg_repo" -v k="$bg_k" '$3 == r && $4 == k { d[n++] = $2 }
    END { if (!n) exit; s = (n > 10) ? n - 10 : 0; m = 0
          for (i = s; i < n; i++) v[m++] = d[i]
          asort(v); print (m % 2) ? v[(m + 1) / 2] : int((v[m / 2] + v[m / 2 + 1]) / 2) }' "$bg_hist" 2>/dev/null)
  if [ -n "$med" ]; then
    limit=$((2 * med)); [ "$limit" -lt "${BG_RUN_PING_MIN:-1800}" ] && limit=${BG_RUN_PING_MIN:-1800}
  else
    limit=${BG_RUN_PING_DEFAULT:-3600}
  fi
  while [ -n "$lstart" ] && [ "$(ps -o lstart= -p "$pid" 2>/dev/null)" = "$lstart" ]; do
    sleep "$poll"
    # Heartbeat. After expiry the beat is refused by design: that stops the beats and is not worth a warning.
    if [ -n "$dl" ] && [ "$dl_beat" = 1 ]; then "${bg_dl_to[@]}" "$bg_deadline_cmd" beat "$dl" >/dev/null 2>&1 </dev/null || dl_beat=0; fi
    now=$(gdate +%s); el=$((now - t0))
    if [ "$pinged" = 0 ] && [ "$el" -ge "$limit" ]; then
      pinged=1
      "$bg_ping" "${bg_repo##*/}: bg job \"$bg_k\" (pid $pid) has run $(dur "$el")${med:+, usually ~$(dur "$med")}; still running, check whether it is stuck" >/dev/null 2>&1
    fi
  done
  printf '%s\t%s\t%s\t%s\n' "$(gdate +%s)" "$(( $(gdate +%s) - t0 ))" "$bg_repo" "$bg_k" >> "$bg_hist"
  [ -z "$dl" ] || bg_dl done "$dl"
}
# Apple `container` (header): preflight before the run record starts, so a refused run leaves no deadline or history row.
bg_cexe=$(bg_container_exe "$@") || bg_cexe=
if [ -n "$bg_cexe" ]; then
  bg_csub=${bg_k#container}; bg_csub=${bg_csub# }; bg_csub=${bg_csub%% *}
  bg_container_preflight "$bg_cexe" "$bg_csub" || exit $?
fi
# The wait record ends here; the run's record belongs to the watcher below (header, "Deadline").
bg_wait_end
trap - EXIT
bg_watch $$ </dev/null >/dev/null 2>&1 &

cpus="${BG_CPUS:-3}"
export PYTHON_CPU_COUNT="${PYTHON_CPU_COUNT:-$cpus}"
export PYTEST_XDIST_AUTO_NUM_WORKERS="${PYTEST_XDIST_AUTO_NUM_WORKERS:-$cpus}"
export HERMES_TEST_WORKERS="${HERMES_TEST_WORKERS:-$cpus}"
for v in OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS NUMEXPR_NUM_THREADS \
         VECLIB_MAXIMUM_THREADS NUMBA_NUM_THREADS RAYON_NUM_THREADS; do
  [ -n "${!v:-}" ] || export "$v=1"
done
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
: > "$bg_mark" 2>/dev/null   # the run starts now (see the header): the watcher registers its deadline on seeing this
export BGRUN_RUN_ID="$(gdate -u +%Y%m%dT%H%M%SZ)-$$"
export BGRUN_RUN_START="$(gdate +%s)"
if [ -n "$bg_cexe" ]; then
  if command -v taskpolicy >/dev/null 2>&1; then bg_container_guard_exec taskpolicy -c utility "$@"; else bg_container_guard_exec "$@"; fi
fi
if command -v taskpolicy >/dev/null 2>&1; then
  exec taskpolicy -c utility "$@"
else
  exec "$@"
fi
