#!/usr/bin/env python3
"""Run a command for bgrun and fail it when Apple `container` hid an XPC failure behind exit 0.

usage: bgrun-container-guard -- CMD [ARGS...]

bgrun execs this for a command whose key is `container ...` (ADE queue 85 (b), 2026-11-21). The command runs as a child with
stdin and stdout inherited and stderr relayed live; SIGTERM/SIGHUP/SIGUSR1/SIGUSR2 to this process go on to the child (SIGINT too, except on a tty, where the kernel already delivers
Ctrl-C to the child). When the child
exits 0 but its stderr carried a line like `Error: interrupted: "XPC connection error: Connection invalid"`, the command did
not run, so this exits 70 and says so. Any other status is passed through (a death by signal N is 128+N).
"""

import os
import re
import signal
import subprocess
import sys
import threading
import time

EXIT_XPC_HIDDEN = 70
XPC_ERROR = re.compile(rb"^Error: .*(XPC connection error|Connection invalid)", re.M)
TAIL_KEEP = 64 * 1024


def _idle_setting(name, default):
    """A test-only knob (BG_CONTAINER_TEST_IDLE_*): a number of seconds from 0.1 to 600, else the default (nan, inf, negatives and huge values would make the guard give up at once or hold the slot for as long as a stray grandchild lives) (a stray value must neither crash
    the guard nor make it give up at once or never)."""
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        v = float(raw)
    except ValueError:
        return default
    return v if 0.1 <= v <= 600 else default


IDLE_READ = _idle_setting("BG_CONTAINER_TEST_IDLE_READ", 2.0)  # seconds without progress while the relay waits for the child (a grandchild holding stderr open) before giving up
IDLE_WRITE = _idle_setting("BG_CONTAINER_TEST_IDLE_WRITE", 60.0)  # ... while it waits for a slow consumer of our own stderr (the XPC line may still be queued behind it)


def main(argv):
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        print("usage: bgrun-container-guard -- CMD [ARGS...]", file=sys.stderr)
        return 2
    child = None
    pending = []  # a signal that arrived before the child existed

    def forward(signum, _frame):
        if child is None:
            pending.append(signum)
            return
        try:
            child.send_signal(signum)
        except OSError:
            pass

    # Handlers first: a TERM between Popen and the install would kill only the guard and orphan the command.
    # A signal that was already ignored (nohup sets SIGHUP; `cmd &` in a script sets SIGINT) stays ignored, as it was when bgrun
    # exec'd the command directly: the child inherits the ignore, since Popen resets only PIPE and XFSZ/XFZ.
    # The child stays in OUR process group, always: a group SIGKILL (deadline run after its grace, gtimeout -k) must take it down with us,
    # and a command that talks to the controlling terminal (a prompt on /dev/tty, raw mode for -t) must stay in the job the shell manages
    # (a private group would be stopped by SIGTTIN/SIGTTOU). The price: a TERM sent to the whole group reaches the CLI twice (once from the
    # kernel, once from our forward), which stays under Apple's 3-signal force-exit threshold; stop a run with TERM to the bgrun pid.
    # Where the terminal already delivers a Ctrl-C to the whole foreground group (stdin is our tty and we are its foreground group),
    # the child gets that INT from the kernel: forwarding it too would deliver it twice, so on a tty INT is not forwarded and our own
    # INT handler does nothing (Python's default would raise KeyboardInterrupt in the drain loop and lose the exit status).
    # USR1/USR2 are forwarded as well: Apple's CLI passes them on.
    on_tty = False
    try:
        on_tty = os.isatty(0) and os.tcgetpgrp(0) == os.getpgrp()
    except OSError:
        pass
    forwarded = [signal.SIGTERM, signal.SIGHUP, signal.SIGUSR1, signal.SIGUSR2] + ([] if on_tty else [signal.SIGINT])
    for sig in forwarded:
        if signal.getsignal(sig) == signal.SIG_IGN:
            continue
        signal.signal(sig, forward)
    if on_tty and signal.getsignal(signal.SIGINT) != signal.SIG_IGN:
        signal.signal(signal.SIGINT, lambda *_: None)
    try:
        child = subprocess.Popen(argv, stderr=subprocess.PIPE)
    except OSError as e:
        print(f"bg: cannot run {argv[0]}: {e.strerror}", file=sys.stderr)
        return 127 if isinstance(e, FileNotFoundError) else 126
    for signum in pending:
        forward(signum, None)

    seen = bytearray()  # the last TAIL_KEEP bytes of stderr, scanned after the child ends
    progress = [0]  # bytes the relay has read and written on; a slow consumer is progress, a stalled grandchild is not
    writing = [False]  # the relay is inside a write to OUR stderr: the consumer is slow, so the XPC line may still be queued

    def relay():
        out = sys.stderr.buffer
        while True:
            chunk = child.stderr.read1(8192)
            if not chunk:
                return
            seen.extend(chunk)
            del seen[:-TAIL_KEEP]
            progress[0] += len(chunk)
            try:
                writing[0] = True
                out.write(chunk)
                out.flush()
                writing[0] = False
                progress[0] += len(chunk)
            except OSError:
                # Our own stderr reader went away (`2>&1 | head`). Close the child's stderr pipe so its next write gets SIGPIPE
                # and it ends, as it did before this guard existed; never leave it blocked on a full pipe.
                child.stderr.close()
                return

    reader = threading.Thread(target=relay, daemon=True)
    reader.start()
    while True:
        try:
            rc = child.wait()
            break
        except KeyboardInterrupt:  # a SIGINT handler is installed (a no-op on a tty), so this is only a fallback
            continue
    # Keep waiting while the relay still makes progress (a slow consumer must not hide the XPC line, which is the last thing written):
    # up to IDLE_WRITE s without progress while it is blocked writing to a slow consumer, IDLE_READ s while it is blocked reading (a
    # grandchild that kept stderr open must not hold the exit status hostage).
    idle_since, last = time.monotonic(), progress[0]
    while reader.is_alive():
        reader.join(timeout=0.25)
        if progress[0] != last:
            idle_since, last = time.monotonic(), progress[0]
        elif time.monotonic() - idle_since >= (IDLE_WRITE if writing[0] else IDLE_READ):
            break
    if rc < 0:
        return 128 - rc
    if rc == 0 and XPC_ERROR.search(bytes(seen)):
        try:
            # os.write, not print: a relay thread blocked on a slow consumer holds sys.stderr's lock, and print would wait for it
            os.write(2, b'bg: the container CLI exited 0 but reported an XPC "Connection invalid" error: the command did not run; '
                        b"exiting 70 (is `container system status` running?)\n")
        except OSError:
            pass  # stderr is gone (2>&1 | head): the status below is what counts
        return EXIT_XPC_HIDDEN
    return rc


if __name__ == "__main__":
    # os._exit: a daemon relay thread may still hold sys.stderr's buffer lock (slow consumer, grandchild holding the pipe), and a normal
    # interpreter shutdown then aborts (SIGABRT, "could not acquire lock for <stderr>"), which would replace the status below.
    _rc = main(sys.argv[1:])
    os._exit(_rc)
