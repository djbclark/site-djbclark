#!/usr/bin/env bash
# bg — run a command at utility QoS (taskpolicy -c utility).
#
# Utility QoS is biased toward the efficiency cores and lower power, but it still
# gets close to a normal share of CPU (measured 2026-10-04: 0.48 of a core against
# 0.52 for a normal process, with the machine at load 30-100), so a build or test
# run finishes in about normal time without crowding the UI. Children inherit it.
#
# Do NOT use `taskpolicy -b` for this: background QoS gave 0.02 of a core under the
# same load (25x slower). If you really want that, use `bgb`. `renice` does little
# on Apple silicon.
#
#   bg swift test
#   bg pytest -q tests/
#
# For a process that is already running: taskpolicy -B -p <pid> undoes background
# mode; there is no per-pid utility clamp, restart the command through bg instead.
#
# Admission gate: before starting, wait while the 1-minute load average per core is above
# BG_MAX_LOAD_PER_CORE (default 1.5, i.e. 12 on 8 cores), checking every 15 s. Piling another
# build onto an overloaded machine makes every build slower. BG_LOAD_WAIT=0 skips the gate for a
# test or a small command, never for a Gradle command (2026-10-10); any other value just means
# "gate on". When the load drops after a wait, bg pauses 5-30 s at random and reads it again, so
# queued commands don't all start in the same second. The gate also asks `load-watch admit` for the
# memory side (compressor churn, 2026-10-23); it fails open if load-watch is missing or errors. Also reverts an expired Gradle profile
# (gradle-limits check). When testing bg itself, pass BG_LOAD_WAIT=0.
#
# Wait budget (djbclark, 2026-10-18): bg never starts a command "anyway". Until then the load gate
# gave up after 900 s and the slots after 1800 s, so on a day at load 40-70 every queued build ran at
# once regardless. Now the load gate and the slot waits share one budget, BG_MAX_WAIT seconds
# (default 21600, 6 h); past it bg exits 75 (EX_TEMPFAIL) without running anything. Agents start bg
# with run_in_background: a foreground tool call is cut off long before 6 h. Exit 3 stays "refused"
# (CI-first, Plektra), so a caller can tell the two apart. The command, once started, is never
# killed by bg.
#
# Long-run ping (2026-10-18): a small watcher, forked just before the exec and detached from the
# caller's output, records each run's duration in ~/.local/state/bg/history.tsv, keyed by repo and
# the command's first two words ("python pytest", "cargo test", "gradlew assembleDebug"). It sends
# djbclark one hermes-ping when the run passes max(2 x the median of the last 10 runs,
# BG_RUN_PING_MIN, default 1800 s), or BG_RUN_PING_DEFAULT (3600 s) with no history, and one when
# the wait passes BG_PING_WAIT (3600 s). BG_PING_CMD replaces hermes-ping (tests).
#
# Gradle slots: a command that runs gradle or gradlew (also behind `env VAR=… ./gradlew`) takes
# one of BG_GRADLE_SLOTS machine-wide slots (default 1) for its whole run, waiting up to
# up to the wait budget (BG_MAX_WAIT) for one. On 2026-10-06 eight agents
# built at once, each worktree started its own daemon, and the 16 GB Mac went 11 GB into swap.
# A slot is a shlock(1) file holding the build's pid (exec keeps the pid), so a killed build
# frees its slot. --stop/--status/--version don't take one. BG_GRADLE_SLOTS=0 disables it
# (don't advertise that in messages agents see: they'd bypass the queue). Every build is also
# gated inside Gradle by gradle/init.d/machine-slot.gradle (one at a time, all callers); this
# slot just waits before a JVM starts, so a queued bg build costs no idle daemon.
#
# Parallelism cap (2026-10-08): the admission gate above looks at load once, at launch, and QoS
# changes priority, not how many workers a command starts. On 2026-10-08 one Hermes full-suite
# run (a runner sized by os.cpu_count() = 8, one pytest per file, each spawning children) took the
# load average from 17 to 220 and starved every other session. So bg also caps parallelism for the
# command it wraps, with env vars that only apply when the caller has not set them:
#   BG_CPUS (default 3)  -> PYTHON_CPU_COUNT (Python 3.13+: caps os.cpu_count() and xdist `-n auto`),
#                           PYTEST_XDIST_AUTO_NUM_WORKERS, HERMES_TEST_WORKERS
#   thread pools -> 1:      OMP/OPENBLAS/MKL/NUMEXPR/VECLIB/NUMBA/RAYON_NUM_THREADS
#   TOKENIZERS_PARALLELISM=false
# Rust/C pools and Python < 3.13 ignore PYTHON_CPU_COUNT; pass the tool's own worker flag too.
#
# Test slots: a pytest/tox/nox/run_tests*.py, `swift build|test|run` or xcodebuild command takes one of BG_TEST_SLOTS machine-wide slots
# (default 2) for its whole run, waiting up to the wait budget (BG_MAX_WAIT), the same
# shlock mechanism as the Gradle slot. --version/--help/--collect-only don't take one.
# BG_TEST_SLOTS=0 disables it (don't advertise that in messages agents see).
#
# CI offload (djbclark, 2026-10-23): in a repo recorded `ci` (load-watch ci) a targeted test run stays
# here, and on 2026-10-23 a 2 s pytest file sat over an hour in the load gate at load 25-93 on 8 cores:
# the carve-out defeated CI-first exactly when the machine is busiest. So once the gate has held such a
# run for BG_OFFLOAD_AFTER seconds (default 60), bg hands it to bin/bg-offload instead of waiting on:
# a commit of the working tree (HEAD when clean, `git stash create` when dirty; untracked files are not
# in it and are listed) goes to the repo's CI through its executable scripts/bg-offload-run or
# scripts/github-ci-run, bg waits (BG_OFFLOAD_WAIT, 2400 s) and exits with CI's verdict, never running
# the command here. It needs such a route, `gh` and `git`; without them, or if the push fails, bg says so and
# keeps waiting as before. Exit codes: 0 CI passed, 1 CI failed (log tail printed), 76 CI still running
# at BG_OFFLOAD_WAIT, 77 pushed but no verdict; 3 and 75 keep their meaning. CI runs the repo's whole
# workflow, so a 1 can come from a test you did not name. BG_OFFLOAD=0 keeps the old waiting behaviour.
# Not a way round the gate: builds, non-targeted runs and `local` repos never offload and still wait.
#
# Agents must call `~/ops/site-private/bin/bg`: bare `bg` is the shell job-control builtin.
#
# JAVA_HOME: callers keep their own. ~/.bashrc (sourced via BASH_ENV) only sets its JDK 25
# default when JAVA_HOME is unset; `bg env JAVA_HOME=<jdk> ./gradlew …` also works.
export PATH="/opt/homebrew/bin:$PATH"
# bg has no flags of its own: everything after the name is the command. Agents
# sometimes invent `--name`/`--log`/`--` (from other wrappers); those become
# `taskpolicy -c utility --name …` and macOS taskpolicy errors with
# `illegal option -- -` (seen 2026-10-22). Catch that before the QoS exec.
bg_usage() {
  cat >&2 <<'EOF'
usage: bg <command> [args...]

Runs <command> at utility QoS (taskpolicy -c utility). No bg-owned flags:
  right:  bg ./build-searxng-image
  right:  bg pytest -q tests/
  wrong:  bg --name job --log out.log -- ./build   # those args go to taskpolicy

Redirect or name the run yourself (bg does not take --log/--name):
  bg bash -lc './build >out.log 2>&1'
EOF
}
if [ "$#" -eq 0 ]; then
  bg_usage
  exit 2
fi
case "$1" in
  -h|--help)
    bg_usage
    exit 0
    ;;
  --)
    echo "bg: lone -- is not supported; pass the command directly (see bg --help)" >&2
    exit 2
    ;;
  --*)
    echo "bg: unknown option '$1' (bg has no flags; the first argument must be the command)" >&2
    echo "bg: example: bg ./build-searxng-image   — not: bg --name x -- ./build-searxng-image" >&2
    exit 2
    ;;
esac
"$(dirname "$0")/gradle-limits" check 2>/dev/null || true

is_gradle=0
for a in "$@"; do
  case "$a" in
    --stop|--status|--version|-v) is_gradle=0; break ;;
  esac
  case "${a##*/}" in
    gradle|gradlew) is_gradle=1 ;;
  esac
done
# Plektra is built only on CI (Forgejo 2026-10-14, GitHub runners 2026-10-18; djbclark): refuse a Gradle command in a
# Plektra checkout (from its cwd, or a gradlew path into one). BG_ALLOW_LOCAL_PLEKTRA=1 overrides
# it on djbclark's say only (don't advertise it in messages agents see).
if [ "$is_gradle" = 1 ] && [ "${BG_ALLOW_LOCAL_PLEKTRA:-0}" != 1 ]; then
  plektra_dirs=("$PWD")
  for a in "$@"; do
    case "$a" in */gradlew|*/gradle) plektra_dirs+=("$(dirname "$a")") ;; esac
  done
  for d in "${plektra_dirs[@]}"; do
    top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || continue
    if ggrep -qs 'namespace = "rocks.pkb.plektra"' "$top/app/build.gradle.kts"; then
      echo "bg: Plektra is built on GitHub Actions only, never on this Mac ($top)." >&2
      echo "bg: tests or any Gradle task: scripts/github-test-ref REF [GRADLE_ARGS...]; an APK: scripts/github-test-ref --release plk/main" >&2
      echo "bg: (a release is built), then scripts/github-install-latest. See the repo's AGENTS.md." >&2
      exit 3
    fi
  done
fi
# CI-first (djbclark, 2026-10-18): before a build or test runs here, its repo needs a recorded decision
# about CI: `load-watch ci decide DIR ci "CMD"` (bg refuses and names the command), `local "why"`
# (runs here) or `pending` (seeded from repos bg already ran in; runs here, with a reminder). No decision:
# refuse until the agent has looked at offloading it (forgejo-ci skill) and recorded one. Worktrees and
# cow pastures take their main repo's decision. BG_ALLOW_LOCAL_CI_ONLY=1 on djbclark's say only (don't
# advertise it in messages agents see); BG_CI_UNDECIDED_OK=1 lets one small test file through undecided.
# Fails open if load-watch is missing or errors.
# In `ci` mode a small targeted test run still runs here (djbclark via djbclark-ade-4d, 2026-10-18): one
# that names test files, path::test ids or -k (pytest, python -m unittest ids) or gradle --tests; -k or a
# ::id also narrows a directory (`pytest tests/ -k foo`). A bare suite, a bare directory and any build go
# to CI. cargo stays out: a filtered `cargo test` still compiles the whole crate graph here. A filter
# that matches nearly everything (`-k "not slow"`, `--tests '*'`) gets through: this guards against
# honest mistakes, not evasion.
ci_targeted() {
  local a prev="" runner="" sel=0 narrow=0 broad=0
  for a in "$@"; do
    [ "$prev" = -m ] && case "$a" in pytest) runner=pytest ;; unittest) runner=unittest ;; esac
    case "${a##*/}" in
      pytest|py.test) runner=pytest ;;
      gradle|gradlew) runner=gradle ;;
    esac
    case "$a" in
      -k|-k?*|*::*) sel=1; narrow=1 ;;
      --tests|--tests=*) sel=1 ;;
    esac
    case "$runner" in
      pytest|unittest)
        case "$a" in
          -*) ;;
          *.py) [ -f "$a" ] && sel=1 ;;
          *) [ -d "$a" ] && broad=1 ;;
        esac
        if [ "$runner" = unittest ] && [ "$a" != unittest ]; then
          case "$a" in -*|*/*) ;; test*.*|*.test*|*.Test*) sel=1 ;; esac
        fi
        ;;
    esac
    prev=$a
  done
  [ -n "$runner" ] && [ "$sel" = 1 ] && { [ "$broad" = 0 ] || [ "$narrow" = 1 ]; }
}
# A release also runs here in `ci` mode (djbclark, 2026-10-18): `just release*` or a release.py, whose
# test gate is the CI run itself; what stays local is the publish step (tag, tap sync, brew reinstall and
# brew test on this Mac). `--local-tests` asks a release to run its suites here, so it goes to CI as usual.
ci_release() {
  local a runner=""
  for a in "$@"; do [ "$a" = --local-tests ] && return 1; done
  for a in "$@"; do
    case "${a##*/}" in
      just) runner=just; continue ;;
      release.py) return 0 ;;
    esac
    if [ "$runner" = just ]; then
      case "$a" in -*) ;; release|release-*) return 0 ;; *) return 1 ;; esac
    fi
  done
  return 1
}
lw="$HOME/src/djbclark-ade/bin/load-watch"
# Offload (header): set below only for a targeted run in a `ci` repo that has a runnable CI route.
offload_ok=0
bg_offload="$(dirname "$(greadlink -f "$0")")/bg-offload"
offload_after="${BG_OFFLOAD_AFTER:-60}"
if [ -x "$lw" ] && [ "${BG_ALLOW_LOCAL_CI_ONLY:-0}" != 1 ] \
    && top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ]; then
  dec=$("$lw" ci check "$top" 2>/dev/null); rc=$?
  mode=${dec%%$'\t'*}; rest=${dec#*$'\t'}; text=${rest%%$'\t'*}
  if [ "$rc" = 1 ] && [ "${BG_CI_UNDECIDED_OK:-0}" != 1 ]; then
    echo "bg: $top has no CI-first decision yet, so bg will not build or test in it." >&2
    echo "bg: First see whether this work can run on CI instead of this Mac (GitHub runners, forgejo-ci skill):" >&2
    echo "bg: Linux-capable builds and tests usually can; macOS-only work can use GitHub's macOS runners." >&2
    echo "bg: Ask djbclark before pushing CI branches to a repo he does not own. Then record the decision and rerun:" >&2
    echo "bg:   $lw ci decide $top ci \"<command that runs it on CI>\"" >&2
    echo "bg:   $lw ci decide $top local \"<why it must run on this Mac>\"" >&2
    exit 3
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && ci_targeted "$@"; then
    if [ "${BG_OFFLOAD:-1}" != 0 ] && [ -x "$bg_offload" ] && "$bg_offload" --probe "$top"; then
      offload_ok=1
      echo "bg: $top runs full suites and builds on CI (load-watch ci); this targeted test run stays here," >&2
      echo "bg: unless the load gate holds it past ${offload_after} s, when it runs on CI instead (BG_OFFLOAD=0: wait here)." >&2
    else
      echo "bg: $top runs full suites and builds on CI (load-watch ci); this targeted test run stays here." >&2
    fi
  elif [ "$rc" = 0 ] && [ "$mode" = ci ] && ci_release "$@"; then
    echo "bg: $top runs full suites and builds on CI (load-watch ci); a release gates on CI and publishes here." >&2
  elif [ "$rc" = 0 ] && [ "$mode" = ci ]; then
    echo "bg: $top runs full suites and builds on CI, never on this Mac (load-watch ci)." >&2
    echo "bg: run instead: $text" >&2
    echo "bg: a targeted run may stay here: test files, path::test ids or -k, gradle --tests; so may a release." >&2
    exit 3
  elif [ "$rc" = 0 ] && [ "$mode" = pending ]; then
    echo "bg: reminder: $top runs locally pending a CI-first decision; see whether it can move to" >&2
    echo "bg: CI (GitHub runners, forgejo-ci skill), then: $lw ci decide $top ci|local \"...\"" >&2
  fi
fi
is_test=0
for a in "$@"; do
  case "$a" in
    --version|-V|--help|-h|--collect-only|--co) is_test=0; break ;;
  esac
  case "${a##*/}" in
    pytest|py.test|tox|nox|run_tests*.py) is_test=1 ;;
    *" pytest "*|*" pytest"|"pytest "*|*"run_tests"*) is_test=1 ;;
  esac
done
# Swift/Xcode builds and tests (2026-10-13): `swift test --filter X` on CodexBar compiled the whole
# test target with one swift-frontend per core (8 on 8 cores, 0.2-3.5 GB each) and, with a Gradle
# daemon, pushed the 16 GB Mac to load 180 and 10.6 of 11.3 GB of swap. So `swift build|test|run`
# and `xcodebuild` take a test slot and get a jobs cap (-j / -jobs BG_CPUS) unless the caller set one.
swift_idx=0
xcode=0
i=0
for a in "$@"; do
  i=$((i + 1))
  case "${a##*/}" in
    swift) [ "$swift_idx" = 0 ] && swift_idx=$i ;;
    xcodebuild) xcode=1 ;;
  esac
done
if [ "$swift_idx" -gt 0 ]; then
  j=0
  sub=0
  for a in "$@"; do
    j=$((j + 1))
    [ "$j" -le "$swift_idx" ] && continue
    case "$a" in -*) continue ;; esac
    case "$a" in build|test|run) sub=$j ;; esac
    break
  done
  if [ "$sub" -gt 0 ]; then
    has_jobs=0
    for a in "$@"; do
      case "$a" in -j|-j[0-9]*|--jobs|--jobs=*) has_jobs=1 ;; esac
    done
    is_test=1
    if [ "$has_jobs" = 0 ]; then
      jobs_n="${BG_CPUS:-3}"
      set -- "${@:1:$sub}" -j "$jobs_n" "${@:$((sub + 1))}"
    fi
  fi
fi
if [ "$xcode" = 1 ]; then
  is_test=1
  has_jobs=0
  for a in "$@"; do
    case "$a" in -jobs|-jobs=*) has_jobs=1 ;; esac
  done
  [ "$has_jobs" = 1 ] || set -- "$@" -jobs "${BG_CPUS:-3}"
fi
bg_t0=$(gdate +%s)
max_wait="${BG_MAX_WAIT:-21600}"
bg_repo=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || bg_repo=$PWD
bg_ping="${BG_PING_CMD:-$HOME/.local/bin/hermes-ping}"
# bg_key: the command's first two words, past wrappers (nice -n N, env, VAR=x, timeouts) and flags.
bg_key() {
  local a skip=0 out=()
  for a in "$@"; do
    if [ "$skip" -gt 0 ]; then skip=$((skip - 1)); continue; fi
    if [ "${#out[@]}" = 0 ]; then
      case "$a" in
        nice|env|time|caffeinate|taskpolicy|timeout|gtimeout|[0-9]*|*=*) continue ;;
        -n) skip=1; continue ;;
      esac
    fi
    case "$a" in -*) continue ;; esac
    out+=("${a##*/}")
    [ "${#out[@]}" -ge 2 ] && break
  done
  echo "${out[*]}"
}
bg_k=$(bg_key "$@")
waited_s() { echo $(( $(gdate +%s) - bg_t0 )); }
# dur <seconds>: "6 h" / "45 min" / "20 s" for messages.
dur() { if [ "$1" -ge 3600 ]; then echo "$(($1 / 3600)) h"; elif [ "$1" -ge 60 ]; then echo "$(($1 / 60)) min"; else echo "$1 s"; fi; }
wait_pinged=0
# wait_tick <what>: give up past the budget; ping djbclark once past BG_PING_WAIT.
wait_tick() {
  local w; w=$(waited_s)
  if [ "$w" -ge "$max_wait" ]; then
    echo "bg: still waiting for $1 after ${w}s (BG_MAX_WAIT=$max_wait); giving up without running it" >&2
    exit 75
  fi
  if [ "$wait_pinged" = 0 ] && [ "$w" -ge "${BG_PING_WAIT:-3600}" ]; then
    wait_pinged=1
    "$bg_ping" "${bg_repo##*/}: bg job \"$bg_k\" has waited $(dur "$w") for $1; it gives up at $(dur "$max_wait")" >/dev/null 2>&1 &
  fi
}

max_per_core="${BG_MAX_LOAD_PER_CORE:-1.5}"
wait_s="${BG_LOAD_WAIT:-900}"
# A Gradle build always keeps the load gate (2026-10-10: a release build started with
# BG_LOAD_WAIT=0 at load 30 and the machine went to 50-70). BG_LOAD_WAIT=0 is for small test files.
if [ "$is_gradle" = 1 ] && [ "$wait_s" = 0 ]; then
  echo "bg: Gradle builds always wait for low load (BG_LOAD_WAIT=0 ignored)" >&2
  wait_s=900
fi
if [ "$wait_s" != 0 ]; then
  cores=$(sysctl -n hw.ncpu)
  announced=0
  clear=0
  while :; do
    load1=$(sysctl -n vm.loadavg | gawk '{print $2}')
    over=$(gawk -v l="$load1" -v c="$cores" -v m="$max_per_core" 'BEGIN { print (l / c > m) ? 1 : 0 }')
    why="load below $max_per_core per core (now $load1)"
    if [ "$over" = 0 ] && [ -x "$lw" ]; then
      # The load is fine: also ask the watcher's memory gate (compressor churn, 2026-10-23), which
      # load alone cannot show. Exit 75 is "too hot"; anything else (missing, error) fails open.
      lw_rc=0
      "$lw" admit --wait 0 --max-per-core "$max_per_core" >/dev/null 2>&1 || lw_rc=$?
      if [ "$lw_rc" = 75 ]; then over=1; why="memory churn below the load-watch limit (load $load1 is fine)"; fi
    fi
    if [ "$over" = 0 ]; then
      # Straight through at low load; after a wait, read it twice with a random pause between.
      [ "$announced" = 0 ] || [ "$clear" = 1 ] && break
      clear=1
      sleep $((5 + RANDOM % 26))
      continue
    fi
    clear=0
    wait_tick "$why"
    if [ "$offload_ok" = 1 ] && [ "$(waited_s)" -ge "$offload_after" ]; then
      # Held past the threshold in a `ci` repo: CI runs the test instead of a busy Mac (header).
      echo "bg: held $(dur "$(waited_s)") for $why; running it on CI instead of waiting longer" >&2
      "$bg_offload" "$top" -- "$@"; off_rc=$?
      [ "$off_rc" = 69 ] || exit "$off_rc"
      offload_ok=0
      echo "bg: could not offload to CI (reason above); waiting for the gate as usual" >&2
    fi
    if [ "$announced" = 0 ]; then
      announced=1
      echo "bg: holding for $why ($cores cores); will wait up to $(dur "$max_wait") (normal: do not kill or retry)" >&2
    fi
    sleep 15
  done
fi

# take_slot <label> <slots> <dir>: wait for a free shlock slot, within the wait budget; the lock
# holds this shell's pid, which exec keeps, so a killed command frees its slot.
take_slot() {
  local label="$1" slots="$2" dir="$3" i got announced=0 held
  mkdir -p "$dir"
  while :; do
    got=
    for i in $(gseq 1 "$slots"); do
      if shlock -f "$dir/slot.$i" -p $$ 2>/dev/null; then got=$i; break; fi
    done
    [ -n "$got" ] && return 0
    wait_tick "a machine-wide $label slot"
    if [ "$announced" = 0 ]; then
      announced=1
      held=$(cat "$dir"/slot.* 2>/dev/null | gtr '\n' ' ')
      echo "bg: waiting for a machine-wide $label slot (held by pid $held); this is normal, do not kill or retry" >&2
    fi
    sleep 10
  done
}

slots="${BG_GRADLE_SLOTS:-1}"
if [ "$is_gradle" = 1 ] && [ "$slots" -gt 0 ]; then
  take_slot Gradle "$slots" "$HOME/.local/state/bg/gradle-slots"
fi

tslots="${BG_TEST_SLOTS:-2}"
if [ "$is_test" = 1 ] && [ "$tslots" -gt 0 ]; then
  take_slot test "$tslots" "$HOME/.local/state/bg/test-slots"
fi

# Long-run watcher (see the header): forked here, so it watches this pid through the exec.
bg_hist="$HOME/.local/state/bg/history.tsv"
mkdir -p "${bg_hist%/*}"
bg_watch() {
  local pid="$1" t0 lstart now el med limit pinged=0 poll="${BG_WATCH_POLL:-30}"
  t0=$(gdate +%s)
  lstart=$(ps -o lstart= -p "$pid" 2>/dev/null)
  med=$(gawk -F'\t' -v r="$bg_repo" -v k="$bg_k" '$3 == r && $4 == k { d[n++] = $2 }
    END { if (!n) exit; s = (n > 10) ? n - 10 : 0; m = 0
          for (i = s; i < n; i++) v[m++] = d[i]
          asort(v); print (m % 2) ? v[(m + 1) / 2] : int((v[m / 2] + v[m / 2 + 1]) / 2) }' "$bg_hist" 2>/dev/null)
  if [ -n "$med" ]; then
    limit=$((2 * med)); [ "$limit" -lt "${BG_RUN_PING_MIN:-1800}" ] && limit=${BG_RUN_PING_MIN:-1800}
  else
    limit=${BG_RUN_PING_DEFAULT:-3600}
  fi
  while [ -n "$lstart" ] && [ "$(ps -o lstart= -p "$pid" 2>/dev/null)" = "$lstart" ]; do
    sleep "$poll"
    now=$(gdate +%s); el=$((now - t0))
    if [ "$pinged" = 0 ] && [ "$el" -ge "$limit" ]; then
      pinged=1
      "$bg_ping" "${bg_repo##*/}: bg job \"$bg_k\" (pid $pid) has run $(dur "$el")${med:+, usually ~$(dur "$med")}; still running, check whether it is stuck" >/dev/null 2>&1
    fi
  done
  printf '%s\t%s\t%s\t%s\n' "$(gdate +%s)" "$(( $(gdate +%s) - t0 ))" "$bg_repo" "$bg_k" >> "$bg_hist"
}
bg_watch $$ </dev/null >/dev/null 2>&1 &

cpus="${BG_CPUS:-3}"
export PYTHON_CPU_COUNT="${PYTHON_CPU_COUNT:-$cpus}"
export PYTEST_XDIST_AUTO_NUM_WORKERS="${PYTEST_XDIST_AUTO_NUM_WORKERS:-$cpus}"
export HERMES_TEST_WORKERS="${HERMES_TEST_WORKERS:-$cpus}"
for v in OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS NUMEXPR_NUM_THREADS \
         VECLIB_MAXIMUM_THREADS NUMBA_NUM_THREADS RAYON_NUM_THREADS; do
  [ -n "${!v:-}" ] || export "$v=1"
done
