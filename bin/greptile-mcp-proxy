#!/usr/bin/env python3
"""greptile-mcp-proxy: one shared local MCP endpoint for Greptile's review tools (stdlib only).

Greptile's hosted MCP server (https://api.greptile.com/mcp, streamable HTTP) exposes 21 tools, ~47.7 KB of
schemas. Review agents need eight of them. This daemon listens on 127.0.0.1:18808 at /mcp, adds the bearer key
Greptile requires, and enforces an allowlist, so every agent TUI registers ONE keyless URL and carries only the
eight schemas:

    get_me, list_pull_requests, get_merge_request, list_merge_request_comments,
    list_code_reviews, get_code_review, trigger_code_review, search_greptile_comments

  * tools/list results (JSON or SSE) are filtered to the allowlist; a tools/call for anything else is answered
    locally with a JSON-RPC error and NEVER forwarded. A batch that contains one is refused whole.
  * The request that is forwarded is re-serialised from what was validated (duplicate JSON keys are rejected),
    so the bytes checked are the bytes sent.
  * GREPTILE_API_KEY is read ONCE through `sudo-secretspec get` (argv list, stdin /dev/null, stdout captured,
    stderr discarded) and held in memory. It is never in argv, the environment, a log line, an error message or
    a response: every outgoing body, SSE event and header value is scrubbed of it. A client-supplied
    Authorization header (or any header not named below) is dropped, never forwarded.
  * Mcp-Session-Id and MCP-Protocol-Version pass both ways. Upstream 401/403 become a local 502 without
    WWW-Authenticate, so a client never starts an OAuth flow against this proxy.
  * GET is 405 (the spec allows a server to offer no standalone SSE stream; Greptile hands out no session).
    DELETE is forwarded only with an Mcp-Session-Id, else 405.
  * Loopback only (bind, Host and Origin checks: a browser page cannot reach it through DNS rebinding).
  * Every upstream call has a connect timeout, an idle-read timeout and a total deadline.
  * One log line per request on stderr: HTTP method, JSON-RPC method, tool, status, milliseconds. Never bodies.

Run: greptile-mcp-proxy [--listen 127.0.0.1:18808]. Supervised by roles/shared_mcp (com.djbclark.greptile-mcp).
"""

from __future__ import annotations

import argparse
import http.client
import http.server
import json
import re
import signal
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse

ALLOWED_TOOLS = frozenset(
    {
        "get_me",
        "list_pull_requests",
        "get_merge_request",
        "list_merge_request_comments",
        "list_code_reviews",
        "get_code_review",
        "trigger_code_review",
        "search_greptile_comments",
    }
)
UPSTREAM = "https://api.greptile.com/mcp"
SECRET_NAME = "GREPTILE_API_KEY"
SECRET_REASON = "greptile-mcp-proxy: bearer key for api.greptile.com/mcp (held in memory only)"
LOOPBACK_HOSTS = frozenset({"127.0.0.1", "localhost", "::1"})
MAX_REQUEST_BYTES = 1 << 20
MAX_RESPONSE_BYTES = 8 << 20
KEY_RETRY_SECONDS = 60.0
FORWARDED_REQUEST_HEADERS = ("Mcp-Session-Id", "MCP-Protocol-Version")
FORWARDED_RESPONSE_HEADERS = ("Mcp-Session-Id", "MCP-Protocol-Version", "Cache-Control")
_SAFE_HEADER_VALUE = re.compile(r"^[\x21-\x7e]{1,256}$")
_SAFE_KEY = re.compile(r"^[\x21-\x7e]{8,512}$")

# JSON-RPC codes
PARSE_ERROR, INVALID_PARAMS, UNAVAILABLE = -32700, -32602, -32000


def log(msg: str) -> None:
    print(time.strftime("%Y-%m-%dT%H:%M:%S"), msg, file=sys.stderr, flush=True)


def _clean(s: object, n: int = 60) -> str:
    """Log-safe, bounded rendering of a client-supplied value."""
    return re.sub(r"[^\x21-\x7e]", "?", str(s))[:n] or "-"


# --------------------------------------------------------------------------- the key (memory only)


def load_key(secretspec: str, name: str = SECRET_NAME, reason: str = SECRET_REASON) -> str | None:
    try:
        r = subprocess.run(
            [secretspec, "get", name, "--reason", reason],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=45,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"key load failed: {type(e).__name__}")
        return None
    value = r.stdout.decode("utf-8", "replace").rstrip("\r\n")
    if r.returncode != 0 or not _SAFE_KEY.match(value):
        log(f"key load failed: rc={r.returncode} usable={bool(_SAFE_KEY.match(value))}")
        return None
    return value


class KeyState:
    """The key is read at start; a failed read is retried lazily, at most once per KEY_RETRY_SECONDS."""

    def __init__(self, loader, retry_s: float = KEY_RETRY_SECONDS):
        self._loader, self._retry, self._lock = loader, retry_s, threading.Lock()
        self._key: str | None = None
        self._last: float | None = None

    def get(self) -> str | None:
        with self._lock:
            if self._key:
                return self._key
            if self._last is not None and time.monotonic() - self._last < self._retry:
                return None
            self._last = time.monotonic()
            self._key = self._loader()
            return self._key


# --------------------------------------------------------------------------- JSON handling


def _no_dup_keys(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise ValueError("duplicate key")
        d[k] = v
    return d


def _reject_constant(_c):
    raise ValueError("non-standard JSON constant")


def parse_json(raw: bytes):
    return json.loads(raw.decode("utf-8"), object_pairs_hook=_no_dup_keys, parse_constant=_reject_constant)


def dump_json(obj) -> bytes:
    return json.dumps(obj, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def rpc_error(rid, code: int, message: str) -> dict:
    return {"jsonrpc": "2.0", "id": rid, "error": {"code": code, "message": message}}


def inspect_request(obj) -> tuple[list[dict], bool, str]:
    """(refused tools/call messages, any tools/list, log tag)."""
    msgs = obj if isinstance(obj, list) else [obj]
    refused, tools_list, tags = [], False, []
    for m in msgs:
        if not isinstance(m, dict):
            continue
        method = m.get("method")
        if method == "tools/list":
            tools_list = True
        if method == "tools/call":
            p = m.get("params")
            name = p.get("name") if isinstance(p, dict) else None
            if not isinstance(name, str) or name not in ALLOWED_TOOLS:
                refused.append(m)
                tags.append(f"tools/call {_clean(name)} REFUSED")
            else:
                tags.append(f"tools/call {name}")
        else:
            tags.append(_clean(method))
    return refused, tools_list, ",".join(tags[:4]) or "-"


def filter_tools_message(obj):
    """Drop every tool outside the allowlist from a tools/list result (single message or batch)."""
    if isinstance(obj, list):
        return [filter_tools_message(m) for m in obj]
    if isinstance(obj, dict) and isinstance(obj.get("result"), dict) and "tools" in obj["result"]:
        tools = obj["result"]["tools"]
        kept = [t for t in tools if isinstance(t, dict) and t.get("name") in ALLOWED_TOOLS] if isinstance(tools, list) else []
        obj = {**obj, "result": {**obj["result"], "tools": kept}}
    return obj


def refusal_body(obj, refused: list[dict]) -> bytes:
    def msg_for(m):
        name = (m.get("params") or {}).get("name") if isinstance(m.get("params"), dict) else None
        return rpc_error(m.get("id"), INVALID_PARAMS, f"tool not allowed by greptile-mcp-proxy: {_clean(name, 80)}")

    if not isinstance(obj, list):
        return dump_json(msg_for(obj))
    ids = {id(m) for m in refused}
    out = []
    for m in obj:
        if isinstance(m, dict) and "id" in m and "method" in m:
            out.append(msg_for(m) if id(m) in ids else rpc_error(m["id"], INVALID_PARAMS, "batch refused: it contains a tool not allowed by greptile-mcp-proxy; resend the calls separately"))
    return dump_json(out)


# --------------------------------------------------------------------------- the server


class Proxy(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, addr, upstream: str, keys: KeyState, connect_timeout: float, read_timeout: float, total_timeout: float):
        super().__init__(addr, Handler)
        u = urllib.parse.urlsplit(upstream)
        if u.scheme not in ("https", "http") or not u.hostname:
            raise SystemExit(f"bad upstream {upstream!r}")
        if u.scheme == "http" and u.hostname not in LOOPBACK_HOSTS:
            raise SystemExit("plain-http upstream is only allowed on loopback (the bearer key would travel in clear)")
        self.up_scheme, self.up_host, self.up_port = u.scheme, u.hostname, u.port or (443 if u.scheme == "https" else 80)
        self.up_path = u.path or "/"
        self.keys, self.connect_timeout, self.read_timeout, self.total_timeout = keys, connect_timeout, read_timeout, total_timeout


class UpstreamTimeout(Exception):
    pass


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "greptile-mcp-proxy"
    sys_version = ""
    protocol_version = "HTTP/1.0"  # connection close delimits SSE bodies; loopback, so no keep-alive loss
    timeout = 30  # client socket: bounds a stalled request read

    def log_message(self, *args):  # the one-line request log is ours
        pass

    # ---- plumbing
    def _reply(self, status: int, body: bytes, ctype: str = "application/json", extra: dict | None = None) -> None:
        self._status = status
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _rpc_reply(self, status: int, rid, code: int, message: str, extra: dict | None = None) -> None:
        self._reply(status, dump_json(rpc_error(rid, code, message)), extra=extra)

    def _guard(self) -> bool:
        host = urllib.parse.urlsplit("//" + (self.headers.get("Host") or "")).hostname
        origin = self.headers.get("Origin")
        if host not in LOOPBACK_HOSTS or (origin and urllib.parse.urlsplit(origin).hostname not in LOOPBACK_HOSTS):
            self._reply(403, b'{"error":"forbidden"}')
            return False
        if urllib.parse.urlsplit(self.path).path != "/mcp":
            self._reply(404, b'{"error":"not found"}')
            return False
        return True

    def _run(self, method: str, fn) -> None:
        t0 = time.monotonic()
        self._status, self._tag = 0, "-"
        try:
            fn()
        except (BrokenPipeError, ConnectionResetError, TimeoutError):
            self._status = self._status or 499
        except Exception as e:  # never str(e): nothing from an exception reaches a client or a log
            log(f"internal error: {type(e).__name__}")
            if not self._status:
                try:
                    self._rpc_reply(500, None, -32603, "internal error")
                except OSError:
                    pass
        finally:
            log(f"{method} {self._tag} {self._status} {int((time.monotonic() - t0) * 1000)}ms")

    # ---- verbs
    def do_POST(self):
        self._run("POST", self._post)

    def do_DELETE(self):
        self._run("DELETE", self._delete)

    def do_GET(self):
        self._run("GET", self._no_stream)

    do_PUT = do_PATCH = do_OPTIONS = do_HEAD = do_GET

    def _no_stream(self):
        if self._guard():
            self._reply(405, b'{"error":"method not allowed"}', extra={"Allow": "POST, DELETE"})

    def _delete(self):
        if not self._guard():
            return
        if not self.headers.get("Mcp-Session-Id"):
            return self._no_stream()
        self._tag = "session-delete"
        self._forward("DELETE", None, False, None)

    def _post(self):
        if not self._guard():
            return
        if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
            return self._reply(411, b'{"error":"Content-Length required"}')
        try:
            n = int(self.headers.get("Content-Length", ""))
        except ValueError:
            return self._reply(411, b'{"error":"Content-Length required"}')
        if n < 0 or n > MAX_REQUEST_BYTES:
            return self._reply(413, b'{"error":"request too large"}')
        raw = self.rfile.read(n)
        try:
            obj = parse_json(raw)
        except (ValueError, UnicodeDecodeError):
            self._tag = "unparseable"
            return self._rpc_reply(400, None, PARSE_ERROR, "parse error")
        refused, tools_list, self._tag = inspect_request(obj)
        if refused:
            return self._reply(200, refusal_body(obj, refused))
        rid = obj.get("id") if isinstance(obj, dict) else None
        self._forward("POST", dump_json(obj), tools_list, rid)

    # ---- upstream
    def _forward(self, method: str, body: bytes | None, filter_tools: bool, rid) -> None:
        srv: Proxy = self.server  # type: ignore[assignment]
        key = srv.keys.get()
        if not key:
            return self._rpc_reply(503, rid, UNAVAILABLE, "greptile api key unavailable (sudo-secretspec read failed); retrying")
        scrub = lambda b: b.replace(key.encode(), b"[redacted]")  # noqa: E731
        hdrs = {
            "Authorization": "Bearer " + key,
            "Accept": self.headers.get("Accept") or "application/json, text/event-stream",
            "Accept-Encoding": "identity",
            "User-Agent": "greptile-mcp-proxy",
        }
        if body is not None:
            hdrs["Content-Type"] = "application/json"
        for h in FORWARDED_REQUEST_HEADERS:
            v = self.headers.get(h)
            if v and _SAFE_HEADER_VALUE.match(v):
                hdrs[h] = v
        deadline = time.monotonic() + srv.total_timeout
        conn_cls = http.client.HTTPSConnection if srv.up_scheme == "https" else http.client.HTTPConnection
        conn = conn_cls(srv.up_host, srv.up_port, timeout=srv.connect_timeout)
        try:
            try:
                conn.connect()
                conn.sock.settimeout(srv.read_timeout)
                conn.request(method, srv.up_path, body=body, headers=hdrs)
                resp = conn.getresponse()
            except (TimeoutError, OSError) as e:  # socket.timeout is TimeoutError; ssl and connect errors are OSError
                timed_out = isinstance(e, TimeoutError)
                self._tag += " upstream-timeout" if timed_out else " upstream-error"
                return self._rpc_reply(504 if timed_out else 502, rid, UNAVAILABLE, "greptile upstream " + ("timed out" if timed_out else "unreachable"))
            if resp.status in (401, 403):
                self._tag += " upstream-auth"
                return self._rpc_reply(502, rid, UNAVAILABLE, "greptile upstream rejected the proxy's credentials")
            extra = {}
            for h in FORWARDED_RESPONSE_HEADERS:
                v = resp.getheader(h)
                if v and _SAFE_HEADER_VALUE.match(v) and key not in v:
                    extra[h] = v
            ctype = resp.getheader("Content-Type") or "application/octet-stream"
            try:
                if ctype.lower().startswith("text/event-stream"):
                    self._stream_sse(resp, resp.status, extra, filter_tools, scrub, deadline)
                else:
                    data = self._read_all(resp, deadline)
                    if filter_tools and ctype.lower().startswith("application/json"):
                        try:
                            data = dump_json(filter_tools_message(parse_json(data)))
                        except (ValueError, UnicodeDecodeError):
                            self._tag += " unfilterable"
                            return self._rpc_reply(502, rid, UNAVAILABLE, "greptile upstream sent an unparseable tools/list reply")
                    self._reply(resp.status, scrub(data), ctype, extra)
            except (UpstreamTimeout, TimeoutError, http.client.HTTPException, OSError):
                # Headers may already be out; if not, answer, if so the truncated stream is the signal.
                self._tag += " upstream-timeout"
                if not self._status:
                    self._rpc_reply(504, rid, UNAVAILABLE, "greptile upstream timed out")
        finally:
            conn.close()

    @staticmethod
    def _read_all(resp, deadline: float) -> bytes:
        out, size = [], 0
        while True:
            if time.monotonic() > deadline:
                raise UpstreamTimeout
            chunk = resp.read1(65536)
            if not chunk:
                return b"".join(out)
            size += len(chunk)
            if size > MAX_RESPONSE_BYTES:
                raise UpstreamTimeout
            out.append(chunk)

    def _stream_sse(self, resp, status: int, extra: dict, filter_tools: bool, scrub, deadline: float) -> None:
        self._status = status
        self.send_response(status)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        for k, v in extra.items():
            if k != "Cache-Control":
                self.send_header(k, v)
        self.end_headers()
        event: list[bytes] = []
        while True:
            if time.monotonic() > deadline:
                raise UpstreamTimeout
            line = resp.readline(1 << 20)
            if line:
                event.append(line)
            if line and line.strip(b"\r\n"):
                continue
            if event:  # blank line or EOF: the event is complete
                out = self._sse_event(event, filter_tools, scrub)
                if out:
                    self.wfile.write(out)
                    self.wfile.flush()
                event = []
            if not line:
                return

    @staticmethod
    def _sse_event(lines: list[bytes], filter_tools: bool, scrub) -> bytes:
        if filter_tools:
            datas = [ln for ln in lines if ln.startswith(b"data:")]
            if datas:
                payload = b"\n".join(re.sub(rb"^data: ?", b"", ln).rstrip(b"\r\n") for ln in datas)
                try:
                    msg = dump_json(filter_tools_message(parse_json(payload)))
                except (ValueError, UnicodeDecodeError):
                    return b""  # unverifiable tools/list data is dropped, never passed through
                rest = [ln for ln in lines if not ln.startswith(b"data:") and ln.strip(b"\r\n")]
                lines = rest + [b"data: " + msg + b"\n", b"\n"]
        return scrub(b"".join(lines))


# --------------------------------------------------------------------------- main


def parse_listen(s: str) -> tuple[str, int]:
    host, _, port = s.rpartition(":")
    if host not in ("127.0.0.1", "localhost", "::1") or not port.isdigit():
        raise argparse.ArgumentTypeError("--listen must be a loopback HOST:PORT (127.0.0.1:18808)")
    return host, int(port)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Allowlisting local proxy for Greptile's MCP server")
    ap.add_argument("--listen", type=parse_listen, default=("127.0.0.1", 18808))
    ap.add_argument("--upstream", default=UPSTREAM)
    ap.add_argument("--secretspec", default="sudo-secretspec", help="sudo-secretspec binary (a fake in tests)")
    ap.add_argument("--connect-timeout", type=float, default=10.0)
    ap.add_argument("--read-timeout", type=float, default=60.0, help="idle seconds on the upstream socket")
    ap.add_argument("--total-timeout", type=float, default=300.0, help="deadline for one whole upstream exchange")
    args = ap.parse_args(argv)
    keys = KeyState(lambda: load_key(args.secretspec))
    keys.get()  # read once at start; a failure is retried lazily on requests
    srv = Proxy(args.listen, args.upstream, keys, args.connect_timeout, args.read_timeout, args.total_timeout)
    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=srv.shutdown, daemon=True).start())
    log(f"listening on {args.listen[0]}:{args.listen[1]} -> {srv.up_scheme}://{srv.up_host}:{srv.up_port}{srv.up_path}; allowlist={len(ALLOWED_TOOLS)} tools")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
