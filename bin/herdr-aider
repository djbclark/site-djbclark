#!/bin/sh
# Launches `aider` with Herdr sidebar/pane-border state reporting. Also wires
# aider's own `--notifications-command` hook (a real upstream signal, unlike
# goose which has none) for a more precise idle transition, layered on top of
# the same content-polling monitor the wrapper always runs.
# See docs/reference/herdr-workstation.md and bin/herdr_agent_wrapper.py.
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
wrapper="$here/herdr_agent_wrapper.py"

# Respect an operator override: don't fight a user-supplied notifications flag.
inject_notify_hook=1
for arg in "$@"; do
  case "$arg" in
    --notifications-command | --notifications-command=* | --no-notifications)
      inject_notify_hook=0
      ;;
  esac
done

if [ "$inject_notify_hook" -eq 1 ]; then
  exec "$wrapper" aider -- aider --notifications \
    --notifications-command "$wrapper --notify-idle aider" "$@"
else
  exec "$wrapper" aider -- aider "$@"
fi
