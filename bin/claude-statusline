#!/usr/bin/env bash
# claude-statusline — Claude Code statusLine command: Orca forwarding shim around claude-powerline.
#
# Claude Code pipes a JSON payload to the statusLine command on each update
# (https://code.claude.com/docs/en/statusline). The line itself is drawn by the existing
# mod claude-powerline (https://github.com/Owloops/claude-powerline, npm
# @owloops/claude-powerline, pinned install in ~/.local/bin; config ~/.claude/claude-powerline.json;
# `/powerline` from its plugin reconfigures it). djbclark 2026-10-17: use an existing mod, not a
# home-grown line.
#
# Why a shim at all: Orca's own script (~/.orca/agent-hooks/claude-statusline.sh) prints nothing;
# it posts the payload to Orca's hook endpoint and exits, and outside Orca exits at once, so herdr
# panes had no status line. The shim keeps Orca fed when its environment is present, then hands
# the payload to claude-powerline. CLAUDE_STATUSLINE_DISABLE=1 prints nothing.
set -u
payload=$(cat)
[ -n "$payload" ] || exit 0
[ -z "${CLAUDE_STATUSLINE_DISABLE:-}" ] || exit 0
orca=$HOME/.orca/agent-hooks/claude-statusline.sh
if [ -n "${ORCA_PANE_KEY:-}" ] && [ -x "$orca" ]; then
  printf '%s' "$payload" | /bin/sh "$orca" >/dev/null 2>&1 || :
fi
pl=$HOME/.local/bin/claude-powerline
[ -x "$pl" ] || { echo "statusline: claude-powerline missing (npm install -g @owloops/claude-powerline)"; exit 0; }
printf '%s' "$payload" | exec "$pl" --config="$HOME/.claude/claude-powerline.json" 2>>"$HOME/.local/state/claude-statusline/last.err"
