# Freeze/kill-on-sight for the Apple background daemons disabled by
# macos/sip-doit-with-sudo.sh. 2026-10-10: the launchd disable flags do NOT
# stop launchd activating these jobs on XPC/event demand, and bootout is
# SIP-refused (rc 150 by label, rc 5 by plist path), so the enforcement is
# this probe: it SIGSTOPs the gui-domain daemons (no CPU, and launchd never
# respawns a job that has not exited), TERMs triald/helpd/sirittsd, the Apple Intelligence agents and the root
# system-domain half, and reports healthy. Exit 1 = the root helper is
# broken (config problem worth one alert); exit 75 = no console user
# (skip). Action log: ~/Library/Logs/watchdogd/apple-daemon-ban.log; the
# reporting layer stays the sip script's --check.
name = "apple-daemons"
interval_s = 60

[probe]
kind = "command"
command = ["{{ watchdogd_repo_bin }}/apple_daemon_ban.sh"]
timeout_s = 30

[policy]
# Enforcement happens inside the probe; there is nothing to restart. A
# "down" verdict means enforcement itself is failing — alert, don't act.
action = "alert"
down_before_action = 2
grace_s = 120
