#!/usr/bin/env bash
# Notify when free disk space is low enough to threaten the emergency
# hibernation write (which can need up to RAM size, 16GB on this Mac).
# Site-managed: roles/site_agents (Phase F1). Run by LaunchAgent
# com.<site_ns>.hibernate-disk-check.plist
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail

THRESHOLD_GB="${HIBERNATE_DISK_THRESHOLD_GB:-25}"
RENOTIFY_SECS=$((6 * 3600))
STATE="$HOME/.local/state/hibernate-disk-check.last"

FREE_GB=$(df -g / | gawk 'NR==2 {print $4}')

if (( FREE_GB >= THRESHOLD_GB )); then
    rm -f "$STATE"
    exit 0
fi

now=$(gdate +%s)
if [[ -f "$STATE" ]]; then
    last=$(cat "$STATE")
    (( now - last < RENOTIFY_SECS )) && exit 0
fi

mkdir -p "$(dirname "$STATE")"
echo "$now" > "$STATE"
MSG="Only ${FREE_GB}GB free — an emergency hibernate write can need up to 16GB. Free up space soon."
# Both a macOS banner and a Hermes notice (operator's choice, 2026-10-05).
osascript -e "display notification \"${MSG}\" with title \"Low disk space for hibernation\" sound name \"Basso\"" || true

# Destination: HERMES_TO env wins; else the register (inbox-target on PATH), falling
# back to the literal Watch-topic thread only when inbox-target isn't available here.
HERMES_TO="${HERMES_TO:-}"
if [[ -z "$HERMES_TO" ]] && INBOX_TARGET_BIN="$(command -v inbox-target 2>/dev/null)"; then
    HERMES_TO="$("$INBOX_TARGET_BIN" hibernate-disk-check 2>/dev/null)" || true
fi
if [[ -z "$HERMES_TO" ]]; then
    echo "hibernate-disk-check: WARN: inbox-target not on PATH; falling back to literal destination 44132" >&2
    HERMES_TO="telegram:838808636:44132"
fi

"${HERMES_BIN:-$HOME/.local/bin/hermes}" send -t "$HERMES_TO" \
    "Low disk space for hibernation: ${MSG}" >/dev/null 2>&1 || true
