#!/usr/bin/env bash
set -euo pipefail

# site-djbclark — brew-fast-upgrade maintenance script
# Upgrades every Homebrew formula and cask (--greedy: auto_updates casks too),
# globally-installed npm packages (both the user ~/.local npm tree and
# Homebrew's own) and uv tools, under the
# exclusive site advisory lock (Phase F4); zcode-app-cli is always pulled
# to @latest each run (it ships several builds a day). Nothing is pinned
# (djbclark 2026-10-24: current beats stable); a pinned formula counts as
# outdated and fails verification. Retries a bounded number of times until
# everything verifies as up to date, or gives up loudly for manual
# intervention. Automatically restarts Google Chrome cleanly if it
# was running and got upgraded, and restarts any `brew services` daemon or
# user launchd job left running a deleted (upgraded-away) binary. Redirects
# HOMEBREW_CACHE to the external volume when mounted, and purges the default
# downloads cache either way. Run by hand (`brew-fast-upgrade`) it is the same
# script, and with a terminal it also upgrades the casks that need sudo.

export PATH="{{ site_agents_homebrew_prefix }}/bin:{{ site_agents_homebrew_prefix }}/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Scheduled runs don't source ~/.bashrc, so they miss the HOMEBREW_CACHE
# redirect to the external drive and fill ~/Library/Caches/Homebrew instead.
# Set it here too — but only when the volume is really mounted. ~/.bashrc
# tests `[ -d "$USB_DRIVE" ]`, which a stale mount-point directory left on the
# boot disk also satisfies; that would silently put the cache back on the disk
# we are trying to keep free. A mount-table check cannot be fooled that way.
BREW_CACHE_VOLUME="{{ site_agents_brew_cache_volume }}"
if [ -n "$BREW_CACHE_VOLUME" ] && mount | ggrep -q " on ${BREW_CACHE_VOLUME} "; then
  export HOMEBREW_CACHE="$BREW_CACHE_VOLUME/Caches/Homebrew"
else
  BREW_CACHE_VOLUME=""
fi

LOG_DIR="{{ site_agents_state_dir }}/brew-fast-upgrade"
LOG_FILE="$LOG_DIR/run.log"
mkdir -p "$LOG_DIR"
# Keep at most four 5 MiB files (~20 MiB total), including the active log.
if [ -f "$LOG_FILE" ] && [ "$(gstat -c '%s' "$LOG_FILE")" -ge 5242880 ]; then
  for n in 3 2 1; do
    [ -f "$LOG_FILE.$n" ] && mv -f "$LOG_FILE.$n" "$LOG_FILE.$((n + 1))"
  done
  mv -f "$LOG_FILE" "$LOG_FILE.1"
fi
exec > >(gtee -a "$LOG_FILE") 2>&1
STARTED_AT="$(gdate -u '+%Y-%m-%dT%H:%M:%SZ')"
trap 'rc=$?; echo "[$(gdate -u +%Y-%m-%dT%H:%M:%SZ)] finished rc=$rc"; exit "$rc"' EXIT
echo "[$STARTED_AT] started; scheduled/manual Jobber invocation"

LOCK_BIN="{{ site_agents_home }}/ops/site-djbclark/bin/brew_flock.py"
{% raw %}
MAX_ATTEMPTS="${BREW_FAST_UPGRADE_MAX_ATTEMPTS:-3}"
RETRY_DELAY_SECS=10
# Exported: run_upgrade_and_restart_apps may execute inside a fresh `bash -c`
# spawned by brew_flock.py, which inherits only the environment, not these
# shell variables.
# A cask whose upgrade runs a .pkg or vendor installer needs sudo, which a
# Jobber run cannot answer (no terminal, no NOPASSWD rule). Unattended runs
# leave those casks out and list them; a run from a terminal includes them.
if [ -t 0 ]; then INTERACTIVE=1; else INTERACTIVE=0; fi
export MAX_ATTEMPTS RETRY_DELAY_SECS INTERACTIVE

run_brew_update() {
  local update_output
  local update_rc
  local attempt

  # Runs were scheduled at 03:00 until 2026-10-10, so the first brew update
  # was still fetching at the known ~03:01 nightly Wi-Fi blip (see the
  # mac_dns note in jobber.yaml.j2) and failed every tap in 14 of 46 logged
  # runs; the schedule is now 03:10. Keep retrying the update in-pass as
  # belt-and-suspenders in case the blip drifts.
  update_rc=0
  for attempt in 1 2 3; do
    update_rc=0
    update_output="$(brew update 2>&1)" || update_rc=$?
    [ "$update_rc" -eq 0 ] && break
    echo "$update_output"
    if [ "$attempt" -lt 3 ]; then
      echo "[brew-fast-upgrade] brew update failed (attempt $attempt/3); retrying in 15s..."
      sleep 15
    fi
  done
  [ "$update_rc" -eq 0 ] || return "$update_rc"
  echo "$update_output"
}

# Installed casks whose upgrade needs root (a pkg or installer artifact), one
# per line. Empty for a run from a terminal, where sudo can prompt.
sudo_casks() {
  [ "$INTERACTIVE" = "1" ] && return 0
  brew info --json=v2 --installed 2>/dev/null | jq -r '
    .casks[] | select([.artifacts[] | keys[]] | any(. == "pkg" or . == "installer")) | .token'
}

# Casks never upgraded by this script, even by hand (BREW_FAST_UPGRADE_SKIP_CASKS
# overrides, space-separated). paseo (djbclark 2026-10-24): every cask upgrade
# quits Paseo.app and runs `paseo daemon stop --force`, killing every agent
# session on the production daemon, and three upgrades on 2026-10-24 still left
# Paseo.app at 0.12.0 (cause unknown). The app updates itself; take paseo back
# out of this list once the revert is explained and a daemon stop is acceptable.
held_casks() {
  printf '%s\n' ${BREW_FAST_UPGRADE_SKIP_CASKS-paseo}
}

# Outdated formulae and casks (greedy: auto_updates and :latest casks too),
# one per line, minus the casks this run cannot or must not upgrade
# (sudo_casks, held_casks). Pinned formulae are NOT filtered out: nothing may
# be pinned, so one shows up here.
brew_outdated_upgradable() {
  local skip
  skip="$(sudo_casks; held_casks)"
  { brew outdated --formula --quiet 2>/dev/null; brew outdated --cask --greedy --quiet 2>/dev/null; } |
    gawk 'NR == FNR { if ($0 != "") skipset[$0] = 1; next } { short = $0; sub(/^.*\//, "", short); if (!(short in skipset)) print }' \
      <(printf '%s\n' "$skip") -
}

# Say which outdated casks were left out (sudo or held), so they are seen.
report_sudo_casks() {
  local skip pending held
  skip="$(sudo_casks)"
  if [ -n "$skip" ]; then
    pending="$(brew outdated --cask --greedy --quiet 2>/dev/null | ggrep -Fx -f <(printf '%s\n' "$skip") || true)"
    [ -n "$pending" ] && echo "[brew-fast-upgrade] needs sudo, left for an interactive run (brew-fast-upgrade from a terminal): $(printf '%s ' $pending)"
  fi
  skip="$(held_casks)"
  if [ -n "$skip" ]; then
    held="$(brew outdated --cask --greedy --quiet 2>/dev/null | ggrep -Fx -f <(printf '%s\n' "$skip") || true)"
    [ -n "$held" ] && echo "[brew-fast-upgrade] held, not upgraded (BREW_FAST_UPGRADE_SKIP_CASKS): $(printf '%s ' $held)"
  fi
  return 0
}

# Homebrew removed `--no-quarantine`, and some casks ship un-notarized helper
# binaries that Gatekeeper then blocks/SIGKILLs (kotlin-lsp's bundled
# intellij-server, used by Claude Code's LSP tool). A fresh version dir comes
# back quarantined after every upgrade, so strip the attribute here. Scoped to
# an explicit allowlist (override with BREW_FAST_UPGRADE_UNQUARANTINE_CASKS,
# space-separated) - never the whole Caskroom. Standalone equivalent:
# site-private/bin/brew-unquarantine.
unquarantine_casks() {
  local cask root
  root="$(brew --caskroom 2>/dev/null)" || return 0
  for cask in ${BREW_FAST_UPGRADE_UNQUARANTINE_CASKS:-kotlin-lsp}; do
    [ -d "$root/$cask" ] || continue
    if xattr -rl "$root/$cask" 2>/dev/null | ggrep -q com.apple.quarantine; then
      xattr -dr com.apple.quarantine "$root/$cask" 2>/dev/null || true
      echo "[brew-fast-upgrade] cleared Gatekeeper quarantine on cask: $cask"
    fi
  done
}

run_brew_pass() {
  local chrome_outdated=0
  local chrome_running=0
  local rc=0

  # Pre-check: is google-chrome cask outdated?
  if brew outdated --cask google-chrome 2>/dev/null | ggrep -q "google-chrome"; then
    chrome_outdated=1
  fi

  # Pre-check: is Google Chrome currently running?
  if pgrep -x "Google Chrome" >/dev/null 2>&1; then
    chrome_running=1
  fi

  if ! run_brew_update; then
    echo "[brew-fast-upgrade] brew update failed; skipping brew upgrade this pass."
    return 1
  fi
  local outdated
  outdated="$(brew_outdated_upgradable)"
  if [ -n "$outdated" ]; then
    # Names only, so the casks sudo_casks excludes stay out; --greedy makes
    # brew accept auto_updates casks given by name.
    # shellcheck disable=SC2086
    brew upgrade --greedy $outdated || rc=1
  else
    echo "[brew-fast-upgrade] brew: nothing to upgrade."
  fi
  report_sudo_casks
  unquarantine_casks

  # Post-check: if Chrome was running and upgraded, restart it gracefully
  if [ "$chrome_outdated" -eq 1 ] && [ "$chrome_running" -eq 1 ]; then
    echo "[brew-fast-upgrade] Google Chrome was upgraded while running. Restarting gracefully..."

    # 1. Graceful quit via AppleScript (flushes SQLite/session tabs to disk)
    osascript -e 'tell application "Google Chrome" to quit' 2>/dev/null || true

    # 2. Wait up to 15s for clean exit
    local count=0
    while pgrep -x "Google Chrome" >/dev/null 2>&1; do
      sleep 1
      count=$((count + 1))
      if [ "$count" -ge 15 ]; then
        echo "[brew-fast-upgrade] Google Chrome did not exit within 15s. Force killing..."
        pkill -x "Google Chrome" 2>/dev/null || true
        sleep 2
        break
      fi
    done

    # 3. Relaunch Chrome
    echo "[brew-fast-upgrade] Relaunching Google Chrome..."
    open -a "Google Chrome"
  fi

  return "$rc"
}

# `brew upgrade` repoints /opt/homebrew/opt/<formula> at the new Cellar dir but
# never restarts a running `brew services` daemon, which keeps the deleted old
# binary open (moshi-hook ran a deleted 0.4.9 for a day on 2026-10-02 and the
# phone app hung against it). Detect that state directly instead of guessing
# from formula names: a started service whose executable (lsof txt) no longer
# exists on disk is stale, and gets `brew services restart`. Root-owned
# services are reported, not touched (no sudo here). Opt-outs:
#   BREW_FAST_UPGRADE_SKIP_RESTART="name1 name2"   never restart these
#   BREW_FAST_UPGRADE_RESTART_DRY_RUN=1            report only
restart_stale_brew_services() {
  local rc=0 svc user pid exe skip name
  command -v jq >/dev/null 2>&1 || { echo "[brew-fast-upgrade] jq not found; skipping stale-service check." >&2; return 0; }
  while IFS=$'\t' read -r svc user; do
    [ -n "$svc" ] || continue
    skip=0
    for name in ${BREW_FAST_UPGRADE_SKIP_RESTART:-}; do [ "$name" = "$svc" ] && skip=1; done
    pid="$(brew services info "$svc" --json 2>/dev/null | jq -r '.[0].pid // empty')"
    [ -n "$pid" ] || continue
    # First Cellar/Caskroom-resident text segment = the service executable as
    # actually running (opt/ symlinks already resolved by the loader).
    exe="$(lsof -a -p "$pid" -d txt -Fn 2>/dev/null | gsed -n 's/^n//p' | ggrep -m1 -E '/(Cellar|Caskroom)/' || true)"
    [ -n "$exe" ] || continue
    [ -e "$exe" ] && continue
    if [ "$skip" -eq 1 ]; then
      echo "[brew-fast-upgrade] stale service $svc (pid $pid runs deleted $exe) — skipped by BREW_FAST_UPGRADE_SKIP_RESTART"
      continue
    fi
    if [ "$user" != "$(id -un)" ]; then
      echo "[brew-fast-upgrade] stale service $svc runs as $user (pid $pid, deleted $exe); restart it manually: sudo brew services restart $svc"
      rc=1; continue
    fi
    if [ "${BREW_FAST_UPGRADE_RESTART_DRY_RUN:-0}" = "1" ]; then
      echo "[brew-fast-upgrade] DRY RUN: would restart stale service $svc (pid $pid runs deleted $exe)"
      continue
    fi
    echo "[brew-fast-upgrade] restarting stale service $svc (pid $pid runs deleted $exe)"
    if brew services restart "$svc" >/dev/null 2>&1; then
      sleep 2
      if [ "$(brew services info "$svc" --json 2>/dev/null | jq -r '.[0].running')" = "true" ]; then
        echo "[brew-fast-upgrade] restarted $svc OK"
      else
        echo "[brew-fast-upgrade] ERROR: $svc not running after restart"; rc=1
      fi
    else
      echo "[brew-fast-upgrade] ERROR: brew services restart $svc failed"; rc=1
    fi
  done < <(brew services list --json 2>/dev/null | jq -r '.[] | select(.status == "started" or .status == "scheduled") | [.name, (.user // "")] | @tsv')
  return "$rc"
}

# The same check for user launchd jobs that are not `brew services` (the
# stayturgid serverapps com.djbclark.{caddy,grafana,vector,victoriametrics},
# agents running a brew python or node, ...): a running job whose
# Cellar/Caskroom executable is gone gets `launchctl kickstart -k`, which
# restarts it from the same plist onto the upgraded binary. Honours the same
# BREW_FAST_UPGRADE_SKIP_RESTART (labels) and _RESTART_DRY_RUN switches.
restart_stale_launchd_jobs() {
  local rc=0 uid pid label exe skip name
  uid="$(id -u)"
  while IFS=$'\t' read -r pid _ label; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    case "$label" in homebrew.mxcl.* | application.*) continue ;; esac
    exe="$(lsof -a -p "$pid" -d txt -Fn 2>/dev/null | gsed -n 's/^n//p' | ggrep -m1 -E '/(Cellar|Caskroom)/' || true)"
    [ -n "$exe" ] || continue
    [ -e "$exe" ] && continue
    skip=0
    for name in ${BREW_FAST_UPGRADE_SKIP_RESTART:-}; do [ "$name" = "$label" ] && skip=1; done
    if [ "$skip" -eq 1 ]; then
      echo "[brew-fast-upgrade] stale launchd job $label (pid $pid runs deleted $exe) — skipped by BREW_FAST_UPGRADE_SKIP_RESTART"
      continue
    fi
    if [ "${BREW_FAST_UPGRADE_RESTART_DRY_RUN:-0}" = "1" ]; then
      echo "[brew-fast-upgrade] DRY RUN: would kickstart stale launchd job $label (pid $pid runs deleted $exe)"
      continue
    fi
    echo "[brew-fast-upgrade] restarting stale launchd job $label (pid $pid runs deleted $exe)"
    if launchctl kickstart -k "gui/$uid/$label" >/dev/null 2>&1; then
      echo "[brew-fast-upgrade] restarted $label OK"
    else
      echo "[brew-fast-upgrade] ERROR: launchctl kickstart -k gui/$uid/$label failed"; rc=1
    fi
  done < <(launchctl list 2>/dev/null | gtail -n +2)
  return "$rc"
}

# uv tools are installed once (`uv tool install`, Ansible `creates:` guards)
# and nothing else upgrades them. --all keeps each tool's own interpreter.
run_uv_pass() {
  command -v uv >/dev/null 2>&1 || { echo "[brew-fast-upgrade] uv not installed; skipping uv tools."; return 0; }
  uv tool upgrade --all
}

# Outdated uv tools, one "name vX [required: …] [latest: Y]" line each (empty
# when clean). An exact `==` pin shows up here on purpose (nothing may be
# pinned). Tools installed from a local path or git (e.g. pytgcli from
# ~/src/tgcli) are skipped: their PyPI "latest" is a different project.
uv_outdated_tools() {
  command -v uv >/dev/null 2>&1 || return 0
  uv tool list --outdated --show-version-specifiers 2>/dev/null |
    ggrep -E '^[^- ].* \[latest: ' | ggrep -vE '\[required: (file:|git\+|/)' || true
}

# npm binaries whose global trees this script manages, one per line,
# deduped: the user-prefix npm (~/.local — hermes-managed, holds
# zcode-app-cli, the ACP servers and friends) and Homebrew's own npm
# (/opt/homebrew — cline, bailian-cli and friends). The trimmed script
# PATH resolves bare `npm` to Homebrew's, so callers must pass one of
# these explicitly or they silently manage only the Homebrew tree (which
# is exactly what happened before 2026-10-10: the ~/.local agent CLIs
# were never upgraded by this script).
npm_global_bins() {
  local bin seen=""
  for bin in "$HOME/.local/bin/npm" "$(command -v npm 2>/dev/null || true)"; do
    [ -n "$bin" ] && [ -x "$bin" ] || continue
    [ "$bin" = "$seen" ] && continue
    echo "$bin"
    seen="$bin"
  done
}

# Outdated globally-installed npm package names for the npm binary passed
# as $1, one per line (empty when clean, or when npm/jq isn't available).
npm_outdated_globals() {
  local npm_bin="${1:-npm}"
  command -v "$npm_bin" >/dev/null 2>&1 || return 0
  if ! command -v jq >/dev/null 2>&1; then
    echo "[brew-fast-upgrade] jq not found; skipping npm global upgrade check." >&2
    return 0
  fi
  # Never chase `npm` itself: Homebrew's tree is owned by the node formula
  # (self-install dies against its EEXIST bin symlinks), and the user
  # tree's npm is a hermes-managed symlink (both observed failing in the
  # 2026-10-08/09 nightly logs).
  "$npm_bin" outdated -g --json 2>/dev/null | jq -r 'keys[]? | select(. != "npm")'
}

run_npm_pass() {
  local npm_bin pkg rc=0 ran=0
  local pkgs

  while IFS= read -r npm_bin; do
    ran=1
    pkgs=()
    # zcode-app-cli ships several builds a day; pin @latest every run in the
    # user tree only (a fast no-op when already current). Pinning it in
    # Homebrew's tree would fork a second install whose
    # /opt/homebrew/bin/zcode symlink can shadow ~/.local/bin/zcode in
    # daemon PATHs (stray created and removed 2026-10-10).
    if [ "$npm_bin" = "$HOME/.local/bin/npm" ]; then
      pkgs=("zcode-app-cli@latest")
    fi
    while IFS= read -r pkg; do
      [ -n "$pkg" ] && [ "$pkg" != "zcode-app-cli" ] && pkgs+=("${pkg}@latest")
    done < <(npm_outdated_globals "$npm_bin")

    if [ "${#pkgs[@]}" -eq 0 ]; then
      echo "[brew-fast-upgrade] npm globals ($npm_bin): nothing to upgrade."
      continue
    fi

    # One batched install call per tree avoids per-package npm startup
    # overhead. (Not bun: `bun add -g` installs into its own ~/.bun tree,
    # ignoring npm prefixes, so it would fork both trees this manages.)
    echo "[brew-fast-upgrade] npm globals ($npm_bin): upgrading ${pkgs[*]}"
    if ! "$npm_bin" install -g "${pkgs[@]}"; then
      echo "[brew-fast-upgrade] npm install -g failed for: ${pkgs[*]}"
      rc=1
    fi
  done < <(npm_global_bins)

  if [ "$ran" -eq 0 ]; then
    echo "[brew-fast-upgrade] npm globals: npm not installed; skipping."
    return 0
  fi
  return "$rc"
}

# A successful brew/npm/uv invocation is not enough: confirm nothing is still
# outdated. Prints what remains when verification fails.
verify_clean() {
  local brew_remaining npm_remaining uv_remaining npm_bin
  brew_remaining="$(brew_outdated_upgradable)"
  npm_remaining=""
  while IFS= read -r npm_bin; do
    npm_remaining+="$(npm_outdated_globals "$npm_bin")"
  done < <(npm_global_bins)
  uv_remaining="$(uv_outdated_tools)"

  if [ -n "$brew_remaining" ] || [ -n "$npm_remaining" ] || [ -n "$uv_remaining" ]; then
    echo "[brew-fast-upgrade] outdated items remain:"
    [ -n "$brew_remaining" ] && printf 'brew: %s\n' $brew_remaining
    [ -n "$npm_remaining" ] && printf 'npm:  %s\n' "$npm_remaining"
    [ -n "$uv_remaining" ] && printf 'uv:   %s\n' "$uv_remaining"
    return 1
  fi
  return 0
}

run_upgrade_and_restart_apps() {
  local attempt stale_rc=0

  for attempt in $(gseq 1 "$MAX_ATTEMPTS"); do
    echo "[brew-fast-upgrade] attempt $attempt/$MAX_ATTEMPTS"

    if ! run_brew_pass; then
      echo "[brew-fast-upgrade] brew pass failed on attempt $attempt"
    fi
    if ! restart_stale_brew_services; then
      echo "[brew-fast-upgrade] stale brew service(s) could not be restarted on attempt $attempt"
      stale_rc=1
    fi
    if ! restart_stale_launchd_jobs; then
      echo "[brew-fast-upgrade] stale launchd job(s) could not be restarted on attempt $attempt"
      stale_rc=1
    fi
    if ! run_npm_pass; then
      echo "[brew-fast-upgrade] npm pass failed on attempt $attempt"
    fi
    if ! run_uv_pass; then
      echo "[brew-fast-upgrade] uv tool pass failed on attempt $attempt"
    fi

    if verify_clean; then
      echo "[brew-fast-upgrade] Verification passed: nothing outdated remains (attempt $attempt)."
      return "$stale_rc"
    fi

    if [ "$attempt" -lt "$MAX_ATTEMPTS" ]; then
      echo "[brew-fast-upgrade] retrying in ${RETRY_DELAY_SECS}s..."
      sleep "$RETRY_DELAY_SECS"
    fi
  done

  echo "[brew-fast-upgrade] ERROR: outdated items remain after $MAX_ATTEMPTS attempts; needs manual intervention:"
  verify_clean || true
  return 1
}

if [ -f "$LOCK_BIN" ]; then
  "$LOCK_BIN" -- bash -c "$(declare -f run_brew_update sudo_casks held_casks brew_outdated_upgradable report_sudo_casks unquarantine_casks run_brew_pass restart_stale_brew_services restart_stale_launchd_jobs run_uv_pass uv_outdated_tools npm_global_bins npm_outdated_globals run_npm_pass verify_clean run_upgrade_and_restart_apps); run_upgrade_and_restart_apps"
  rc=$?
else
  run_upgrade_and_restart_apps
  rc=$?
fi

# Safety net for the default cache location. With HOMEBREW_CACHE set above
# this should stay empty, but anything else that shells out to brew without
# the redirect (or a run where the volume was unmounted) still lands here, so
# purge it unconditionally, independent of upgrade success/failure.
if [ -n "$BREW_CACHE_VOLUME" ]; then
  echo "[brew-fast-upgrade] HOMEBREW_CACHE=$HOMEBREW_CACHE"
else
  echo "[brew-fast-upgrade] external cache volume not mounted; used the default Homebrew cache"
fi
downloads_cache="$HOME/Library/Caches/Homebrew/downloads"
if [ -d "$downloads_cache" ]; then
  before_size="$(gdu -sh "$downloads_cache" 2>/dev/null | gcut -f1)"
  gfind "$downloads_cache" -mindepth 1 -delete
  echo "[brew-fast-upgrade] purged $downloads_cache (was $before_size)"
fi
# The default cache's API copy goes stale while the volume holds the live one,
# and something still read it: paseo's 2026-10-24 install receipt came from a
# day-old ~/Library/Caches/Homebrew/api/internal. Drop it whenever the volume
# is the cache, so nothing can read an old package index.
if [ -n "$BREW_CACHE_VOLUME" ] && [ -d "$HOME/Library/Caches/Homebrew/api" ]; then
  gfind "$HOME/Library/Caches/Homebrew/api" -mindepth 1 -delete
  echo "[brew-fast-upgrade] purged stale $HOME/Library/Caches/Homebrew/api"
fi

exit "$rc"
{% endraw %}

