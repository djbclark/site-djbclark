#!/usr/bin/env bash
set -euo pipefail

# site-djbclark — brew-fast-upgrade maintenance script
# Upgrades Homebrew packages under exclusive site advisory lock (Phase F4).
# Automatically restarts Google Chrome cleanly if it was running and upgraded.

export PATH="{{ site_agents_homebrew_prefix }}/bin:{{ site_agents_homebrew_prefix }}/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

LOG_DIR="{{ site_agents_state_dir }}/brew-fast-upgrade"
LOG_FILE="$LOG_DIR/run.log"
mkdir -p "$LOG_DIR"
# Keep at most four 5 MiB files (~20 MiB total), including the active log.
if [ -f "$LOG_FILE" ] && [ "$(stat -f '%z' "$LOG_FILE")" -ge 5242880 ]; then
  for n in 3 2 1; do
    [ -f "$LOG_FILE.$n" ] && mv -f "$LOG_FILE.$n" "$LOG_FILE.$((n + 1))"
  done
  mv -f "$LOG_FILE" "$LOG_FILE.1"
fi
exec > >(tee -a "$LOG_FILE") 2>&1
STARTED_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
trap 'rc=$?; echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] finished rc=$rc"; exit "$rc"' EXIT
echo "[$STARTED_AT] started; scheduled/manual Jobber invocation"

LOCK_BIN="{{ site_agents_home }}/ops/site-djbclark/bin/brew_flock.py"

run_brew_update() {
  local update_output
  local update_rc

  # cfengine-local is intentionally a remote-less local tap. Keep its
  # expected Homebrew warning out of the nightly log, but preserve all other
  # update output and failures.
  update_output="$(brew update 2>&1)" || {
    update_rc=$?
    echo "$update_output"
    return "$update_rc"
  }
  while IFS= read -r line; do
    case "$line" in
      "Warning: No remote 'origin' in "*"/Library/Taps/cfengine-local/homebrew-cfengine, skipping update!") ;;
      *) echo "$line" ;;
    esac
  done <<< "$update_output"
}

run_upgrade_and_restart_apps() {
  local chrome_outdated=0
  local chrome_running=0

  # Pre-check: is google-chrome cask outdated?
  if brew outdated --cask google-chrome 2>/dev/null | grep -q "google-chrome"; then
    chrome_outdated=1
  fi

  # Pre-check: is Google Chrome currently running?
  if pgrep -x "Google Chrome" >/dev/null 2>&1; then
    chrome_running=1
  fi

  # Run upgrade
  run_brew_update && brew upgrade

  # A successful brew invocation is not enough: fail visibly if any
  # non-pinned formula or cask remains outdated.
  local remaining_outdated
  remaining_outdated="$(
    {
      brew outdated --formula 2>/dev/null
      brew outdated --cask 2>/dev/null
    } | while IFS= read -r item; do
      if ! brew list --pinned 2>/dev/null | grep -Fqx "$item"; then
        echo "$item"
      fi
    done
  )"
  if [ -n "$remaining_outdated" ]; then
    echo "[brew-fast-upgrade] ERROR: non-pinned outdated items remain:"
    echo "$remaining_outdated"
    return 1
  fi
  echo "[brew-fast-upgrade] Verification passed: no non-pinned outdated items remain."

  # Post-check: if Chrome was running and upgraded, restart it gracefully
  if [ "$chrome_outdated" -eq 1 ] && [ "$chrome_running" -eq 1 ]; then
    echo "[brew-fast-upgrade] Google Chrome was upgraded while running. Restarting gracefully..."

    # 1. Graceful quit via AppleScript (flushes SQLite/session tabs to disk)
    osascript -e 'tell application "Google Chrome" to quit' 2>/dev/null || true

    # 2. Wait up to 15s for clean exit
    local count=0
    while pgrep -x "Google Chrome" >/dev/null 2>&1; do
      sleep 1
      count=$((count + 1))
      if [ "$count" -ge 15 ]; then
        echo "[brew-fast-upgrade] Google Chrome did not exit within 15s. Force killing..."
        pkill -x "Google Chrome" 2>/dev/null || true
        sleep 2
        break
      fi
    done

    # 3. Relaunch Chrome
    echo "[brew-fast-upgrade] Relaunching Google Chrome..."
    open -a "Google Chrome"
  fi
}

if [ -f "$LOCK_BIN" ]; then
  "$LOCK_BIN" -- bash -c "$(declare -f run_brew_update run_upgrade_and_restart_apps); run_upgrade_and_restart_apps"
  rc=$?
else
  run_upgrade_and_restart_apps
  rc=$?
fi
exit "$rc"

