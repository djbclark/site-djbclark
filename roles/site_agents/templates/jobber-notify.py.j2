#!/usr/bin/env python3
"""Jobber failure notification handler.

Implements:
  - Option B: Hermes notice to the Telegram Inbox topic (hermes send)
  - Option C: Log Sinks & Filesystem Capture (structured notifications log)
"""

import contextlib
import json
import os
import socket
import subprocess
import sys
from datetime import UTC, datetime


def parse_jobber_input():
    """Parse Jobber JSON record from stdin or environment fallback."""
    data = {}
    if not sys.stdin.isatty():
        # Unreadable or malformed input still yields a notice from the env fallbacks.
        with contextlib.suppress(OSError, ValueError):
            raw = sys.stdin.read()
            if raw.strip():
                data = json.loads(raw)

    job_obj = data.get("job", {})
    job_name = job_obj.get("name") or os.environ.get("JOB_NAME") or "Unknown Job"
    status = (
        data.get("status")
        or job_obj.get("status")
        or os.environ.get("JOB_STATUS")
        or "Failed"
    )
    start_time = (
        data.get("startTime")
        or os.environ.get("JOB_START_TIME")
        or datetime.now(UTC).astimezone().isoformat()
    )

    stdout = data.get("stdout", "")
    stderr = data.get("stderr", "")
    err_msg = data.get("errMessage", "")

    error_snippet = (
        stderr.strip()
        or stdout.strip()
        or err_msg
        or os.environ.get("JOB_ERROR")
        or "No output logged."
    )

    if len(error_snippet) > 1500:
        error_snippet = error_snippet[-1500:]

    return {
        "job_name": job_name,
        "status": status,
        "start_time": start_time,
        "stdout": stdout,
        "stderr": stderr,
        "err_msg": err_msg,
        "error_snippet": error_snippet,
        "raw_data": data,
    }


def send_hermes_notification(info):
    """Option B: Hermes notice to the operator's Telegram Inbox topic (the only alert channel)."""
    job_name = info["job_name"]
    snippet = info["error_snippet"].replace("\n", " ")
    if len(snippet) > 400:
        snippet = snippet[:397] + "..."
    msg = (
        f"Jobber failure: {job_name} ({info['status']}) on {socket.gethostname()} "
        f"at {info['start_time']}: {snippet}"
    )
    try:
        subprocess.run(
            ["{{ site_agents_hermes_bin }}", "send", "-t", "telegram:838808636:22158", msg],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        sys.stderr.write(f"Failed to send Hermes notification: {e}\n")


def log_notification(info):
    """Option C: Log Sinks & Filesystem Capture."""
    state_dir = os.path.expanduser("{{ site_agents_jobber_state_dir }}")
    os.makedirs(state_dir, exist_ok=True)
    log_file = os.path.join(state_dir, "notifications.log")

    record = {
        "timestamp": datetime.now(UTC).astimezone().isoformat(),
        "hostname": socket.gethostname(),
        "job": info["job_name"],
        "status": info["status"],
        "start_time": info["start_time"],
        "error_snippet": info["error_snippet"],
    }

    # The log is best effort; the Hermes notice below must still go out.
    with contextlib.suppress(OSError), open(log_file, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")


def main():
    info = parse_jobber_input()

    log_notification(info)
    # Hermes only, no macOS notification (operator's choice, 2026-10-05).
    send_hermes_notification(info)


if __name__ == "__main__":
    main()
