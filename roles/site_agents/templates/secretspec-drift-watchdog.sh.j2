#!/usr/bin/env bash
# Alert-only: the product checker inspects metadata/configuration and never repairs.
set -euo pipefail

checker={{ site_agents_secretspec_drift_checker | quote }}
if [[ ! -f "$checker" ]]; then
  printf '%s\n' 'SecretSpec drift watchdog: product checker is missing' >&2
  exit 1
fi

# Healthy runs are silent. Drift and inspection failures remain nonzero so
# Jobber sends the value-free checker output to Telegram Inbox topic 22158.
set +e
output=$(/usr/bin/python3 "$checker" \
  --home {{ site_agents_home | quote }} \
  --ops-root {{ (site_agents_home ~ '/ops') | quote }} 2>&1)
status=$?
set -e
if [[ "$status" -eq 0 ]]; then
  exit 0
fi
printf '%s\n' "$output" >&2
exit "$status"
