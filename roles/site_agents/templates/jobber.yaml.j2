version: 1.4

resultSinks:
  - &programSink
    type: program
    path: {{ site_agents_jobber_notify_script }}
  - &filesystemSink
    type: filesystem
    path: {{ site_agents_jobber_state_dir }}
    maxAgeDays: 14

jobs:
  brew-fast-upgrade:
    cmd: {{ site_agents_brew_fast_upgrade_script }}
    # 03:10 (was 03:00 until 2026-10-10): the first brew update was still
    # fetching at the known ~03:01 nightly Wi-Fi blip and failed every tap
    # in 14 of 46 logged runs. 03:10 clears the blip and still finishes
    # before mac-dns-apply at 03:30 (typical run ~12 min). Jobber cron is
    # seconds-first: 0 10 3 = 03:10:00.
    time: 0 10 3 * * *
    # Continue, never Backoff (2026-10-24): Backoff skips later scheduled runs
    # after a failed one and eventually stops the job (status Failed). With a
    # transient download error failing ~1 run in 5, 25 nights between
    # 2026-08-17 and 2026-10-15 had no run, nearly all straight after a
    # failure (08-28..09-08 in one stretch). Every night must try again;
    # failures still notify.
    onError: Continue
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  # Keep the tool-managed OpenCode plugin (rtk) at the v2 module shape that
  # OpenCode 2 requires. `rtk init -g --opencode` rewrites the file from a
  # still-v1 embedded template and silently breaks the plugin; this restores it
  # only when the v2 shape is missing, and retires itself once rtk ships v2
  # upstream. OpenUsage was uninstalled 2026-10-29 and is no longer guarded.
  # 03:45 = after brew-fast-upgrade (03:10, typically ~12 min) and
  # mac-dns-apply (03:30). Source: djbclark-ade/bin/opencode-plugin-guard,
  # notes in djbclark-ade/docs/opencode-plugin-v2.md.
  opencode-plugin-guard:
    cmd: {{ site_agents_home }}/src/djbclark-ade/bin/opencode-plugin-guard
    time: 0 45 3 * * *
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  # NeoFinder batch volume upkeep: the 01:15 neofinder-nightly job was removed
  # 2026-10-19 (operator: no scheduled runs, Spotlight indexing was a CPU hog).
  # Run it by hand with ~/.local/bin/neofinder-update (`just nightly` in
  # macos/neofinder/).

  landing-health:
    cmd: {{ site_agents_landing_health_script }}
    time: 0 0 * * * *
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  check-apk-updates:
    cmd: export PATH="{{ site_agents_homebrew_prefix }}/bin:$PATH" && {{ site_agents_home }}/ops/stayturgid/control/bin/check_apk_updates.py
    time: 0 0 10 * * *
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  # Termux apt layer (pkg) — same hermes path as check-apk-updates; also runs
  # as a pre-step inside termux_pkg_nightly.py before the 04:15 upgrade.
  # Mid-day residual catch if nightly was skipped/disabled/failed (#152).
  check-termux-pkg-updates:
    cmd: export PATH="{{ site_agents_homebrew_prefix }}/bin:$PATH" && {{ site_agents_home }}/ops/stayturgid/control/bin/check_termux_pkg_updates.py
    time: 0 0 10 * * *
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  # Daily re-apply of this Mac's tailnet DNS plumbing (roles/mac_dns): keeps
  # /etc/resolver/<tailnet>, Wi-Fi search domains and accept-dns in sync with
  # group_vars/all.yml. 03:30 = after brew-fast-upgrade (03:10 since
  # 2026-10-10) and after the nightly
  # ~03:01 Wi-Fi blip the role exists to survive. Privileged step is sudo -n
  # to the root-owned applier installed by `just mac-dns-setup`.
  mac-dns-apply:
    cmd: export PATH="{{ site_agents_homebrew_prefix }}/bin:{{ site_agents_bin_dir }}:$PATH" && cd {{ site_agents_home }}/ops/site-public-djbclark && just mac-dns-apply
    time: 0 30 3 * * *
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  # Chrome profile caches (Service Worker/CacheStorage + ScriptCache, Code
  # Cache, GPU/shader caches) the DiskCacheSize/MediaCacheSize policy does not
  # cover — the HTTP/media disk cache itself is policy-capped and untouched.
  # The script skips any pass with Chrome running, so it is scheduled a few
  # times a day to catch a window with the browser quit. Silent on success.
  # Weekly: re-apply APFS compression to the pnpm store, uv cache and Android SDK
  # (new files land uncompressed). Skips any cache whose tooling is running.
  apfs-compress:
    cmd: {{ site_agents_apfs_compress_script }}
    time: 0 30 4 * * 0
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]
    mode: "0755"

  # Weekly: in-place VACUUM of app databases that are mostly free pages (a sync
  # app's 352 MB file was 99.9% empty). Skips any file a process has open, so the
  # live stores on the list are done whenever their app is closed. Exit 1 (Jobber
  # notifies) only when a VACUUM failed its integrity or row-count check.
  sqlite-vacuum:
    cmd: {{ site_agents_sqlite_vacuum_script }}{% for db in site_agents_sqlite_vacuum_dbs %} '{{ db }}'{% endfor %}

    time: 0 0 5 * * 0
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]

  chrome-cache-trim:
    cmd: {{ site_agents_chrome_cache_trim_script }}
    time: 0 45 0,6,12,18 * * *
    onError: Backoff
    notifyOnError: [*programSink]
    notifyOnFailure: [*programSink, *filesystemSink]
