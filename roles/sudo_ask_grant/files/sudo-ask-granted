#!/usr/bin/python3 -IS
# sudo-ask-granted: the root side of the sudo-ask approval window.
#
# Installed root:wheel 0755 at /usr/local/libexec/sudo-ask-granted. Every path below is
# HARD-CODED on purpose: no environment variable, argument or config file can move them
# (tests patch the module constants in-process instead). Python runs isolated (-I: no
# PYTHON* variables, no cwd or script dir on sys.path) and without site (-S): stdlib only.
#
# sudoers (see the setup script) lets the operator's user run, WITHOUT a password:
#     sudo-ask-granted exec *      sudo-ask-granted status [*]
# and nothing else. `grant` and `revoke` only ever reach this file through the normal
# password/Touch ID rule, and the drop-in sets `timestamp_timeout=0` for this command so a
# cached sudo ticket never satisfies it. An agent (running as the operator) therefore can
# use an open window but cannot open, extend or close one.
#
#   exec -- CMD...       run CMD as root IF a valid window is open and CMD is not denylisted
#   status               print key=value lines about the window; exit 0 open, 1 not open
#   status --check -- CMD...   exit 0 only if a window is open AND CMD would be allowed
#   grant DURATION       write the grant file (DURATION: 60s..24h, e.g. 30m 2h 8h)
#   revoke               delete the grant file
#
# The denylist is a guard rail for the commands an agent types, NOT a sandbox: while a
# window is open, anything not listed (a script the agent wrote, `python3 x.py`) runs as
# root. See roles/sudo_ask_grant/README.md "What an agent can do during a window".
import calendar
import json
import os
import pwd
import re
import shlex
import stat
import subprocess
import sys
import time

GRANT_DIR = "/var/db/sudo-ask"
GRANT_FILE = GRANT_DIR + "/grant"
LOG_FILE = "/var/log/sudo-ask-grant.log"
OWNER_UID = 0  # the grant dir/file/log must be owned by root
MIN_SECONDS = 60
MAX_SECONDS = 86400
CLOCK_SLACK = 120  # tolerated clock skew for a grant stamped "in the future"
MAX_DEPTH = 6

EX_USAGE, EX_REFUSED, EX_DENIED, EX_NOEXEC = 64, 75, 76, 126
INSTALLED_PATH = "/usr/local/libexec/sudo-ask-granted"   # `grant` runs only from here (a copy elsewhere cannot open a window)
# What `exec` resolves programs with and runs them with (never the caller's PATH or HOME): system dirs first.
EXEC_PATH = "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin"
EXEC_HOME = "/var/root"
INVOKER_UID = None   # the user who ran sudo (SUDO_UID); set by main(). None or 0 = unknown: code outside system dirs prompts.
LOG_MAX_BYTES = 8 * 1024 * 1024   # the log rotates to LOG_FILE.1 above this
CMD_LOG_MAX = 4096                # characters of a command line kept per log line
# Agent-writable by definition, whatever the mode bits say (compared case-insensitively on a realpath).
TEMP_ROOTS = ("/tmp", "/private/tmp", "/var/folders", "/private/var/folders", "/var/tmp", "/private/var/tmp")

# ---------------------------------------------------------------- time and duration


def parse_duration(text):
    """'30m' -> 1800. Only <digits><s|m|h|d>; 60 s .. 24 h. Raises ValueError."""
    m = re.fullmatch(r"([0-9]{1,6})([smhd])", text or "")
    if not m:
        raise ValueError("duration must look like 30m, 2h or 8h (units s m h d)")
    secs = int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
    if secs < MIN_SECONDS:
        raise ValueError("duration must be at least 60s")
    if secs > MAX_SECONDS:
        raise ValueError("duration must be at most 24h")
    return secs


def iso(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def parse_iso(text):
    if not isinstance(text, str) or not re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", text
    ):
        raise ValueError("bad timestamp")
    return calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ"))


# ---------------------------------------------------------------- grant file


def _trusted(st, want_dir):
    if want_dir != stat.S_ISDIR(st.st_mode) or (not want_dir and not stat.S_ISREG(st.st_mode)):
        return False
    return st.st_uid == OWNER_UID and (st.st_mode & 0o022) == 0


def read_grant(now):
    """-> (open, reason, data). Closed on ANY doubt (fail closed)."""
    try:
        if not _trusted(os.lstat(GRANT_DIR), True):
            return False, "grant dir is not a root-owned, non-writable directory", {}
        fd = os.open(GRANT_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return False, "no window is open", {}
    except OSError as e:
        return False, "cannot read the grant file (%s)" % e.strerror, {}
    try:
        st = os.fstat(fd)
        if not _trusted(st, False) or st.st_size > 4096:
            return False, "grant file is not a small root-owned, non-writable file", {}
        raw = os.read(fd, 4097)
    finally:
        os.close(fd)
    try:
        d = json.loads(raw.decode("utf-8"))
        exp, gra = parse_iso(d["expires_utc"]), parse_iso(d["granted_utc"])
        dur, uid, nonce = d["duration_s"], d["granted_by_uid"], d["nonce"]
        if not isinstance(dur, int) or isinstance(dur, bool) or not isinstance(uid, int):
            raise ValueError("types")
        if not isinstance(nonce, str) or not re.fullmatch(r"[0-9a-f]{32}", nonce):
            raise ValueError("nonce")
    except (ValueError, KeyError, TypeError, UnicodeDecodeError):
        return False, "grant file is damaged", {}
    if not MIN_SECONDS <= dur <= MAX_SECONDS or exp - gra != dur:
        return False, "grant file has an impossible duration", {}
    if gra > now + CLOCK_SLACK:
        return False, "grant file is dated in the future", {}
    if exp - now > MAX_SECONDS:
        return False, "grant file expires more than 24h from now (tampered?)", {}
    if exp <= now:
        return False, "the window expired at " + iso(exp), {"expired_utc": iso(exp)}
    data = {"expires_epoch": exp, "expires_utc": iso(exp), "granted_utc": iso(gra),
            "duration_s": dur, "granted_by_uid": uid, "remaining_s": exp - now}
    return True, "window open", data


def write_grant(seconds, now, by_uid):
    """Atomic root-only write: temp file in the (root-owned) dir, then rename."""
    if not _trusted(os.lstat(GRANT_DIR), True):
        raise OSError("grant dir is not a root-owned, non-writable directory")
    d = {"expires_utc": iso(now + seconds), "granted_utc": iso(now), "granted_by_uid": by_uid,
         "duration_s": seconds, "nonce": os.urandom(16).hex()}
    tmp = "%s/.grant.%d.tmp" % (GRANT_DIR, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    try:
        os.fchown(fd, OWNER_UID, -1)
        os.fchmod(fd, 0o644)
        os.write(fd, (json.dumps(d, sort_keys=True) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, GRANT_FILE)
    return d


# ---------------------------------------------------------------- log


def clean(text):
    return "".join(c if " " <= c < "\x7f" else "\\x%02x" % ord(c) for c in text)


def log(event, cmd_text=""):
    """Append one line; a log that cannot be written refuses the action (audit is part of it)."""
    cmd_text = cmd_text if len(cmd_text) <= CMD_LOG_MAX else cmd_text[:CMD_LOG_MAX] + "...[%d chars]" % len(cmd_text)
    line = "%s\t%s\t%s\t%s\t%s\n" % (
        iso(time.time()), clean(os.environ.get("SUDO_UID", "-")), event,
        clean(os.getcwd()), clean(cmd_text))
    try:
        if os.lstat(LOG_FILE).st_size > LOG_MAX_BYTES:
            os.replace(LOG_FILE, LOG_FILE + ".1")
    except FileNotFoundError:
        pass
    fd = os.open(LOG_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        if os.fstat(fd).st_uid != OWNER_UID:
            raise OSError("log file is not owned by root")
        os.fchmod(fd, 0o600)   # holds full command lines: root only
        os.write(fd, line.encode("utf-8", "replace"))
    finally:
        os.close(fd)


# ---------------------------------------------------------------- the denylist
# Everything below is pure (argv, cwd, PATH in; a refusal reason or None out).

# Paths that may not be written/changed (compared case-insensitively: APFS is, by default;
# realpath first, so /etc is /private/etc and symlinks cannot hide a target).
