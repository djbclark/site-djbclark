    "/private/etc/sudoers", "/private/etc/sudoers.d", "/private/etc/sudo.conf",
    "/private/etc/pam.d", "/usr/lib/pam",                      # sudo policy, PAM
    "/private/var/db/sudo-ask", "/private/var/log/sudo-ask-grant.log",   # this feature
    "/usr/local/libexec", "/usr/local/sbin",                   # root helpers, sudo-secretspec broker
    "/private/var/db/dslocal",                                 # users/groups/admin membership
    "/library/application support/com.apple.tcc", "/private/var/db/tcc",   # TCC
    "/library/keychains",
    # persistence: what a root process could use to outlive the window
    "/library/launchdaemons", "/library/launchagents", "/library/startupitems", "/private/var/at",
    "/usr/lib/cron", "/private/etc/periodic", "/private/etc/zshenv", "/private/etc/zprofile",
