def mode_sets_id(mode):
    """A chmod/install mode (octal or symbolic) that sets a setuid or setgid bit."""
    if re.fullmatch(r"[0-7]+", mode):
        return len(mode) >= 4 and int(mode[-4]) & 6 != 0
    return "s" in mode.lower() and re.fullmatch(r"[ugoaA-Za-z,+\-=]+", mode) is not None


def canon(p, cwd):
    return os.path.realpath(os.path.join(cwd, p)).casefold()


def _is_under(p, root):
    return p == root or p.startswith(root.rstrip("/") + "/")


def _user_groups(uid):
    try:
        pw = pwd.getpwuid(uid)
        return set(os.getgrouplist(pw.pw_name, pw.pw_gid))
    except (KeyError, OSError):
        return None


def _dropped_access(real, uid):
    """As root only: ask the kernel, from a child that has dropped to UID, whether the file or any directory above it
    is writable (this sees ACLs and noowners volumes, which the mode bits do not). True/False, or None when unknown."""
    if os.geteuid() != 0:
        return None
    try:
        pw = pwd.getpwuid(uid)
        rd, wr = os.pipe()
        pid = os.fork()
    except (KeyError, OSError):
        return None
    if pid == 0:
        code = b"?"
        try:
            os.close(rd)
            os.initgroups(pw.pw_name, pw.pw_gid)
            os.setgid(pw.pw_gid)
            os.setuid(uid)
            p, code = real, b"0"
            while True:
                if os.access(p, os.W_OK):
                    code = b"1"
                    break
                parent = os.path.dirname(p)
                if parent == p:
                    break
                p = parent
        except BaseException:
            code = b"?"
        finally:
            try:
                os.write(wr, code)
            finally:
                os._exit(0)
    os.close(wr)
    try:
        got = os.read(rd, 1)
    finally:
        os.close(rd)
        os.waitpid(pid, 0)
    return {b"1": True, b"0": False}.get(got)


def agent_writable(real):
    """True when the file at REAL (a realpath) could be changed by the invoking user, or when that cannot be
    told (then: prompt). The file or any directory above it is owned by, or group/world-writable for, that user,
    sits on a nosuid volume (a user-attached image), or the kernel says the user can write it (as root: ACLs too)."""
    uid = INVOKER_UID
    if not uid:
        return True
    if any(_is_under(real.casefold(), r) for r in TEMP_ROOTS):
        return True
    groups = _user_groups(uid)
    if groups is None:
        return True
    try:
        if os.statvfs(real).f_flag & os.ST_NOSUID:
            return True
    except OSError:
        return True
    p = real
    while True:
        try:
            st = os.stat(p)
        except OSError:
            return True
        if st.st_uid == uid or st.st_mode & 0o002 or (st.st_mode & 0o020 and st.st_gid in groups):
            return True
        parent = os.path.dirname(p)
        if parent == p:
            break
        p = parent
    return _dropped_access(real, uid) is not False if os.geteuid() == 0 else False


def changed_since_grant(real):
    """True when the file was created or changed (ctime/mtime) at or after the open window was granted: root cannot
    be fooled into running something the window's own commands wrote."""
    if GRANTED_EPOCH is None:
        return False
    try:
        st = os.stat(real)
    except OSError:
        return True
    return st.st_ctime >= GRANTED_EPOCH or st.st_mtime >= GRANTED_EPOCH


def script_problem(arg, cwd):
    """A script an interpreter or shell would run as root must be a file the invoking user cannot change. The
    realpath judged here is what exec then runs (CHECKED_ARGS), so a link switched afterwards changes nothing."""
    sp = os.path.realpath(os.path.join(cwd, arg))
    if sp.startswith("/dev/") or not os.path.isfile(sp):
        return "script %r is not a plain file (stdin, a device or missing)" % arg
    if agent_writable(sp):
        return "script %s is in a location the invoking user can write" % sp
    if changed_since_grant(sp):
        return "script %s changed after the window was granted" % sp
    if LIBRARY_SCRIPT_RE.search(sp.casefold()):
        return "script %s is a library module, which runs code from its arguments" % sp
    CHECKED_ARGS[arg] = sp
    return None


_LAUNCH_CACHE = {"key": None, "at": 0.0, "val": []}


def launch_targets():
    """Real paths named as Program or an absolute ProgramArguments entry by the root launchd plists, plus the plists:
    a root service runs these, so overwriting one is persistence. Re-read every few seconds."""
    key, now = tuple(LAUNCH_DIRS), time.monotonic()
    if _LAUNCH_CACHE["key"] == key and now - _LAUNCH_CACHE["at"] < 5:
        return _LAUNCH_CACHE["val"]
    out = []
    for d in LAUNCH_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".plist"):
                continue
            fp = os.path.join(d, n)
            out.append(os.path.realpath(fp))
            try:
                with open(fp, "rb") as f:
                    pl = plistlib.load(f)
            except (OSError, ValueError, plistlib.InvalidFileException):
                continue
            if not isinstance(pl, dict):
                continue
            cands = [pl.get("Program")]
            pa = pl.get("ProgramArguments")
            cands += pa if isinstance(pa, list) else []
            for c in cands:
                if isinstance(c, str) and c.startswith("/"):
                    out.append(os.path.realpath(c))
    _LAUNCH_CACHE.update(key=key, at=now, val=out)
    return out


def path_problem(token, cwd, recursive_critical=False):
    """Why this argument, taken as a path, may not be touched (or None)."""
    cands = {token}
    if "=" in token:
        cands.add(token.split("=", 1)[1])
    if re.match(r"-[A-Za-z][^-]", token):
        cands.add(token[2:])
    low = token.casefold()
    for t in TRIPWIRE:
        if t in low:
            return "argument %r mentions %s" % (token, t)
    for c in cands:
        if not c or "\0" in c:
            continue
        p = canon(c, cwd)
        lexical = os.path.normpath(os.path.join(cwd, c)).casefold()
        if p != lexical:   # a link: the words that guard a path count on where it leads, too
            for t in TRIPWIRE:
                if t in p:
                    return "argument %r leads to %s, which mentions %s" % (token, p, t)
        try:
            st = os.lstat(os.path.realpath(os.path.join(cwd, c)))
            if stat.S_ISREG(st.st_mode) and st.st_nlink > 1 and st.st_uid != INVOKER_UID:
                return "argument %r is a file owned by someone else with other hard links" % token
        except (OSError, ValueError):
            pass
        for root in PROTECTED + [t.casefold() for t in launch_targets()]:
            if _is_under(p, root):
                return "argument %r is protected (%s)" % (token, root)
            if p == "/" or root.startswith(p.rstrip("/") + "/"):
                return "argument %r contains the protected path %s" % (token, root)
        for rx in PROTECTED_RE:
            if re.search(rx, p):
                return "argument %r is protected (%s)" % (token, rx)
        if recursive_critical and (p.count("/") <= 1 or p.startswith(("/private/", "/users/", "/volumes/"))
                                   and p.count("/") <= 2):
            return "recursive change of %r" % token
    return None


def resolve(name, cwd, path):
    if "/" in name:
        c = os.path.join(cwd, name)
        return c if os.path.isfile(c) and os.access(c, os.X_OK) else None
    for d in (path or "").split(":"):
        if not d.startswith("/"):
            continue  # an empty or relative PATH entry is never searched
        c = os.path.join(d, name)
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def skip_options(args, flags, with_arg, positionals, numeric=False):
    """Skip a wrapper's own options; returns the rest (the wrapped command) or None."""
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if not a.startswith("-") or a == "-":
            break
        if a in flags or (numeric and re.fullmatch(r"-[0-9]+", a)):
            i += 1
        elif a in with_arg:
            i += 2
        elif a.startswith("--") and "=" in a and a.split("=")[0] in with_arg:
            i += 1
        elif a[:2] in with_arg and len(a) > 2 and not a.startswith("--"):
            i += 1
        else:
            return None
    i += positionals
    return args[i:] if i <= len(args) else None


SHELL_BAD_CHARS = set("$`{}()*?[]!#\n\r\0")
SEP = {";", "&&", "||", "|", "&", "|&"}


def parse_shell(text):
    """A conservative parse of `sh -c TEXT`: [(argv, [redirect targets])] or None."""
    if len(text) > 4000 or SHELL_BAD_CHARS & set(text) or "<<" in text:
        return None
    lex = shlex.shlex(text, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    try:
        toks = list(lex)
    except ValueError:
        return None
    cmds, cur, redirs, want = [], [], [], False
    for t in toks:
        if want:
            redirs.append(t)
            want = False
        elif t in SEP:
            if cur:
                cmds.append((cur, redirs))
            cur, redirs = [], []
        elif t and set(t) <= set("<>&") and ("<" in t or ">" in t):
            want = t.find(">") >= 0  # only output redirections name a file we must vet
            if "<" in t and ">" not in t:
                want = False
                redirs.append("/dev/null")  # input redirection: nothing to protect
        elif set(t) <= set("();<>|&") and t:
            return None
        elif t.startswith("~"):
            return None
        else:
            cur.append(t)
    if want:
        return None
    if cur:
        cmds.append((cur, redirs))
    out = []
    for argv, rd in cmds:
        while argv and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", argv[0]):
            if re.match(r"(PATH|IFS|ENV|BASH_ENV|SHELLOPTS|PS4|LD_|DYLD_)", argv[0]):
                return None
            argv = argv[1:]
        while argv[:1] in (["exec"], ["command"]):  # builtins that just run what follows
            argv = argv[1:]
            if argv[:1] in (["-a"], ["-c"], ["-p"], ["-v"], ["-V"]):
                return None
        if not argv or argv[0] == ":":
            continue
        if argv[0] in SH_BAD_FIRST:
            return None
        out.append((argv, rd))
    return out


def evaluate(argv, cwd, path, depth=0):
    """A refusal reason, or None when the window may run this command."""
    if depth > MAX_DEPTH:
        return "wrappers nested too deeply"
    if depth == 0:
        CHECKED_ARGS.clear()
    if not argv:
        return "empty command"
    prog = resolve(argv[0], cwd, path)
    if prog is None:
        return "program %r not found" % argv[0]
    real = os.path.realpath(prog)
    names = {os.path.basename(argv[0]).lower(), os.path.basename(prog).lower(),
             os.path.basename(real).lower()}
    name, args = os.path.basename(real).lower(), argv[1:]
    for n in names:
        if n in ALWAYS_DENY or n.startswith(ALWAYS_DENY_PREFIX):
            return "program %s is on the denylist" % n
    if agent_writable(real):
        return "program %s is in a location the invoking user can write" % real
    if changed_since_grant(real):
        return "program %s changed after the window was granted" % real
    ro = name in READ_ONLY   # judged on the REAL program: a link named `cat` that points at cp is cp
    ccwd = canon(".", cwd)
    for root in PROTECTED:
        if _is_under(ccwd, root) and not ro:
            return "working directory is protected (%s)" % root

    def hit(n):
        return n in names

    if hit("diskutil"):
        verb = args[0].lower() if args else ""
        if verb in ("apfs", "cs", "appleraid", "corestorage"):
            verb = (args[1].lower() if len(args) > 1 else "")
            if verb not in DISKUTIL_SUB_OK:
                return "diskutil %s is not a read-only verb" % verb
        elif verb not in DISKUTIL_OK:
            return "diskutil %r is not a read-only verb" % verb
    if hit("dscl"):
        low = {a.lstrip("-").lower() for a in args}
        if low & DSCL_WRITE or not low & DSCL_READ:
            return "dscl may change users or groups"
    if hit("dseditgroup"):
        ops = [args[i + 1].lower() for i, a in enumerate(args[:-1]) if a == "-o"]
        if not ops or args[-1] == "-o" or any(o not in ("read", "checkmember") for o in ops):
            return "dseditgroup may change group membership"
    if hit("crontab") and args != ["-l"]:
        return "crontab may install a job"
    if hit("sysadminctl") and args != ["-secureTokenStatus"] and (
            len(args) != 2 or args[0] != "-secureTokenStatus"):
        return "sysadminctl may change accounts"
    if hit("security"):
        verb = args[0] if args else ""
        if verb not in SECURITY_OK or (verb == "list-keychains" and any(a.startswith(("-s", "-d")) for a in args[1:])):
            return "security %r may change the keychain" % verb
    if hit("date") and "-j" not in args and any(not a.startswith(("-", "+")) for a in args):
        return "date may set the clock"
    if hit("rm") and "--no-preserve-root" in args:
        return "rm --no-preserve-root"

    if hit("chmod"):
        modes = [a for a in args if not a.startswith("-")][:1]
        if any(mode_sets_id(m) for m in modes):
            return "chmod would set a setuid or setgid bit"
    if hit("install"):
        for i, a in enumerate(args):
            m = args[i + 1] if a == "-m" and i + 1 < len(args) else (
                a[2:] if a.startswith("-m") and len(a) > 2 else (a.split("=", 1)[1] if a.startswith("--mode=") else None))
            if m is not None and mode_sets_id(m):
                return "install would set a setuid or setgid bit"
    if names & COPIERS:
        for a in args:
            if a.startswith("--chmod=") and any(mode_sets_id(m) for m in a.split("=", 1)[1].split(",")):
                return "%s would set a setuid or setgid bit" % name
            try:
                st = os.stat(os.path.join(cwd, a))
            except (OSError, ValueError):
                continue
            if stat.S_ISREG(st.st_mode) and st.st_mode & 0o6000:
                return "%s would copy or move a setuid/setgid file (%s)" % (name, a)
    if hit("defaults") and any("loginwindow" in a.casefold() for a in args) and args[:1] not in (
            ["read"], ["read-type"], ["domains"], ["find"], ["help"]):
        return "defaults may change the login window (LoginHook/LogoutHook run as root)"

    why = runner_problem(names, args)
    if why:
        return why

    # wrappers: judge the wrapped command
    if name == "env":
        return eval_env(args, cwd, path, depth)
    for w, (flags, with_arg, pos) in WRAPPERS.items():
        if hit(w):
            if w == "command" and args[:1] in (["-v"], ["-V"]):
                return None
            rest = skip_options(args, flags, with_arg, pos, numeric=(w == "nice"))
            if rest is None:
                return "%s options are not understood" % w
            return evaluate(rest, cwd, path, depth + 1) if rest else None
    if hit("xargs"):
        return eval_xargs(args, cwd, path, depth)
    if hit("find"):
        return eval_find(args, cwd, path, depth)
    if names & SHELLS:
        return eval_shell(args, cwd, path, depth)
    base_interp = re.sub(r"[0-9.]+$", "", name)
    if hit("make") or hit("gmake") or hit("just") or hit("xcodebuild") or hit("git"):
        if agent_writable(os.path.realpath(cwd)):
            return "%s reads files from the working directory, which the invoking user can write" % name
    if INTERPRETERS.match(name):
        flag = INLINE_FLAGS.get(base_interp, "")
        opts = []
        for a in args:
            if not a.startswith("-") or a == "--":
                break
            opts.append(a)
        for a in opts:
            if (base_interp in ("python", "pypy") and re.fullmatch(r"-[A-Za-z]*m[A-Za-z]*", a)) or (
                    base_interp in ("node", "nodejs", "bun", "deno") and a in (
                        "-r", "--require", "--import", "--loader", "--experimental-loader")) or (
                    base_interp == "perl" and re.match(r"-[Mm]", a)
                    and not re.fullmatch(r"-[Mm][A-Za-z0-9_:]+(=[A-Za-z0-9_,]*)?", a)):
                return "%s option %s loads code that cannot be checked" % (name, a)
        for a in args:
            if a == "--":
                break
            if a in ("--eval", "--print", "--exec") or (
                    flag and re.fullmatch(r"-[A-Za-z]*[%s][A-Za-z]*" % re.escape(flag), a)):
                return "%s with inline code cannot be checked" % name
        scripts = [a for a in args if not a.startswith("-")]
        if not scripts:
            return "%s with no script reads code from stdin" % name
        why = script_problem(scripts[0], cwd)
        if why:
            return why
    if hit("launchctl") and args[:1] in (["submit"], ["asuser"], ["bootstrap"], ["load"], ["enable"], ["kickstart"],
                                          ["bsexec"]):
        return "launchctl %s runs an unchecked command" % args[0]
    if ro:
        if any(a.startswith(f) for f in READ_ONLY_BANNED_FLAG.get(name, ()) for a in args):
            return "%s flag is not read-only" % name
        return None
    crit = CRITICAL_RECURSIVE.get(name)
    recursive = bool(crit) and any(re.fullmatch(r"-[A-Za-z]*[%s][A-Za-z]*" % crit, a) or a in ("--recursive",)
                                   for a in args)
    for a in args:
        why = path_problem(a, cwd, recursive_critical=recursive)
        if why:
            return why
    return None


def eval_env(args, cwd, path, depth):
    i, ncwd = 0, cwd
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in ("-i", "-", "-0", "-v", "--ignore-environment", "--null", "--debug"):
            i += 1
        elif a in ("-u", "--unset"):
            i += 2
        elif a.startswith("--unset="):
            i += 1
        elif a in ("-C", "--chdir") and i + 1 < len(args):
            ncwd, i = os.path.join(cwd, args[i + 1]), i + 2
        elif a.startswith("--chdir="):
            ncwd, i = os.path.join(cwd, a.split("=", 1)[1]), i + 1
        elif a in ("-S", "--split-string") or (a.startswith("-S") and len(a) > 2) or a.startswith("--split-string="):
            if a in ("-S", "--split-string"):
                s, i = (args[i + 1] if i + 1 < len(args) else ""), i + 2
            elif a.startswith("--split-string="):
                s, i = a.split("=", 1)[1], i + 1
            else:
                s, i = a[2:], i + 1
            if SHELL_BAD_CHARS & set(s) or "\\" in s or "#" in s:
                return "env -S string cannot be checked"
            try:
                return evaluate(shlex.split(s) + args[i:], ncwd, path, depth + 1)
            except ValueError:
                return "env -S string cannot be checked"
        elif a.startswith("-"):
            return "env option %s is not understood" % a
        elif "=" in a:
            if re.match(r"(PATH|IFS|ENV|BASH_ENV|SHELLOPTS|LD_|DYLD_|PYTHON)", a):
                return "env sets %s" % a.split("=")[0]
            i += 1
        else:
            break
    rest = args[i:]
    return evaluate(rest, ncwd, path, depth + 1) if rest else None


def eval_xargs(args, cwd, path, depth):
    rest = skip_options(args, {"-0", "-r", "-t", "-p", "-x", "--null", "--no-run-if-empty"},
                        {"-n", "-I", "-L", "-P", "-s", "-E", "-J", "-R", "-S", "-d", "-a"}, 0)
    if rest is None:
        return "xargs options are not understood"
    if not rest:
        return None  # default command is echo
    inner = evaluate(rest, cwd, path, depth + 1)
    if inner:
        return inner
    p = resolve(rest[0], cwd, path)
    if os.path.basename(os.path.realpath(p)).lower() not in READ_ONLY:
        return "xargs feeds unknown arguments to a command that is not read-only"
    return None


def eval_find(args, cwd, path, depth):
    starts, i = [], 0
    flags = set()
    while i < len(args) and args[i] in ("-H", "-L", "-P", "-E", "-X", "-d", "-x", "-s", "-f"):
        if args[i] == "-f":   # BSD find: the next word is a start path
            if i + 1 >= len(args):
                return "find -f without a path"
            starts.append(args[i + 1])
            i += 2
            continue
        flags.add(args[i])
        i += 1
    while i < len(args) and not args[i].startswith(("-", "(", "!")):
        starts.append(args[i])
        i += 1
    acting, inner, j = False, [], i
    while j < len(args):
        a = args[j]
        if a in ("-delete", "-fprint", "-fprint0", "-fprintf", "-fls"):
            acting = True
            if a != "-delete":
                inner.append(["tee", args[j + 1] if j + 1 < len(args) else "/"])
        elif a in ("-exec", "-execdir", "-ok", "-okdir"):
            acting = True
            k = j + 1
            while k < len(args) and args[k] not in (";", "+", "\\;"):
                k += 1
            if k >= len(args):
                return "find %s without a terminator cannot be checked" % a
            cmd = ["/nonexistent-match" if x == "{}" else x for x in args[j + 1:k]]
            if not cmd:
                return "find %s with no command" % a
            inner.append(cmd)
            j = k
        j += 1
    if acting and flags & {"-L", "-H"}:
        return "find -L/-H with an action follows links that cannot be checked"
    if acting:
        for s in starts or ["."]:
            why = path_problem(s, cwd, recursive_critical=True)
            if why:
                return "find acts on " + why
    for cmd in inner:
        why = evaluate(cmd, cwd, path, depth + 1)
        if why:
            return why
    return None


def eval_shell(args, cwd, path, depth):
    i, code = 0, None
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if re.fullmatch(r"-[A-Za-z]+", a) and "c" in a and not set(a[1:]) & set("os"):
            if i + 1 >= len(args):
                return "shell -c without a command"
            code, i = args[i + 1], i + 2
            break
        if re.fullmatch(r"-[A-Za-z]+", a) and not set(a[1:]) & set("cos"):
            i += 1
        elif a.startswith("--") and "=" not in a and a in ("--login", "--noprofile", "--norc", "--posix"):
            i += 1
        elif not a.startswith("-"):
            break   # the script file
        else:
            return "shell option %s is not understood" % a
    if code is None:
        rest = args[i:]
        if not rest:
            return "a shell with no script reads commands from stdin"
        return path_problem(rest[0], cwd) or script_problem(rest[0], cwd)  # a script file: its path and its place
    cmds = parse_shell(code)
    if cmds is None:
        return "shell command text cannot be parsed confidently"
    for argv, redirs in cmds:
        for r in redirs:
            why = path_problem(r, cwd)
            if why:
                return "redirection: " + why
        why = evaluate(argv, cwd, path, depth + 1)
        if why:
            return why
    return None


# ---------------------------------------------------------------- environment, modes

ENV_KEEP = re.compile(r"^(PATH|HOME|LOGNAME|USER|SHELL|TERM|TZ|LANG|LC_[A-Z]+|COLORTERM|CLICOLOR[A-Z_]*|"
                      r"LSCOLORS|COLUMNS|LINES|SUDO_USER|SUDO_UID|SUDO_GID|__CF_USER_TEXT_ENCODING)$")


def clean_env(src, cwd):
    env = {k: v for k, v in src.items() if ENV_KEEP.match(k)}
    env["PWD"] = cwd
    env["PATH"], env["HOME"] = EXEC_PATH, EXEC_HOME   # never the caller's: its ~/bin and dotfiles do not run as root
    return env


def die(msg, code):
    sys.stderr.write("sudo-ask-granted: %s\n" % msg)
    sys.exit(code)


def need_root():
    if os.geteuid() != 0:
        die("must run as root through sudo", EX_NOEXEC)


def split_command(rest):
    if len(rest) < 2 or rest[0] != "--":
        die("usage: ... -- COMMAND [ARG...]", EX_USAGE)
    return rest[1:]


ProcInfo = collections.namedtuple("ProcInfo", "ppid ruid exec_path argv")


def _bsdinfo(libc, pid):
    """(ppid, real uid, start seconds, start microseconds) from proc_pidinfo(PROC_PIDTBSDINFO), or None."""
    buf = ctypes.create_string_buffer(136)
    if libc.proc_pidinfo(ctypes.c_int(pid), ctypes.c_int(3), ctypes.c_uint64(0), buf, ctypes.c_int(136)) != 136:
        return None
    ppid, = struct.unpack_from("=I", buf.raw, 16)
    ruid, = struct.unpack_from("=I", buf.raw, 28)
    sec, usec = struct.unpack_from("=QQ", buf.raw, 120)
    return ppid, ruid, sec, usec


def _procargs(libc, pid):
    """(exec path, [argv words]) exactly as the kernel holds them (sysctl KERN_PROCARGS2), or None."""
    mib = (ctypes.c_int * 3)(1, 49, pid)
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, ctypes.c_size_t(0)) != 0 or size.value < 8:
        return None
    buf = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, ctypes.c_size_t(0)) != 0:
        return None
    data = buf.raw[:size.value]
    argc, = struct.unpack_from("=i", data, 0)
    path, _, rest = data[4:].partition(b"\0")
    words = rest.lstrip(b"\0").split(b"\0")
    if argc < 1 or len(words) < argc:
        return None
    dec = lambda b: b.decode("utf-8", "surrogateescape")
    return dec(path), [dec(w) for w in words[:argc]]


def proc_info(pid):
    """ProcInfo of a process: parent, REAL uid and the exact argv words (never a space-joined line), read so that a
    process that exited and whose pid was reused between the reads is noticed (None)."""
    libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
    first = _bsdinfo(libc, pid)
    if first is None:
        return None
    pa = _procargs(libc, pid)
    if pa is None or _bsdinfo(libc, pid) != first:
        return None
    return ProcInfo(first[0], first[1], pa[0], pa[1])


def fresh_auth_problem(duration, info=None, start=None):
    """Why this process cannot prove that sudo asked for authentication afresh (None when it can).

    The machine has a global sudo ticket (10-timestamp-global) and `timestamp_timeout=0` covers only the helper's own
    path, so a cached ticket could otherwise let `sudo -n <anything> grant` through. What is accepted is exactly
    one thing: this helper's parent chain is sudo processes only (sudo and its pty monitor), and the outermost of them
    is `/usr/bin/sudo -k HELPER grant DURATION` run by the real user the helper was told (SUDO_UID, not root). Anything
    between (a shell, awk, a second sudo above the first) or any argv that is not that exact list fails, because words
    are compared as words (no `-p 'x -k'`) and `sudo -k CMD` never uses a cached ticket."""
    info = info or proc_info
    uid = INVOKER_UID
    if not uid:
        return "the invoking user is unknown (SUDO_UID missing or 0)"
    pid = start if start is not None else os.getppid()
    outer = None
    for _ in range(8):
        try:
            pi = info(pid)
        except (OSError, ValueError, AttributeError, ctypes.ArgumentError):
            pi = None
        if pi is None:
            if outer is None:
                return "cannot read the parent process, so fresh authentication cannot be proven"
            break
        if pi.exec_path != SUDO or pi.argv[:1] != [SUDO]:
            break
        outer, pid = pi, pi.ppid
        if pid <= 1:
            break
    if outer is None:
        return "grant must be started directly by `sudo -k`: its parent is not /usr/bin/sudo"
    if list(outer.argv) != [SUDO, "-k", INSTALLED_PATH, "grant", duration]:
        return "sudo was not run exactly as: sudo -k %s grant %s; use: sudo-ask --grant" % (INSTALLED_PATH, duration)
    if outer.ruid != uid:
        return "the sudo above this process was not started by the invoking user"
    return None


def last_granted_epoch():
    """When the newest grant happened: the grant file if it parses, else the newest GRANT( record in the log."""
    try:
        fd = os.open(GRANT_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            return parse_iso(json.loads(os.read(fd, 4097).decode("utf-8"))["granted_utc"])
        finally:
            os.close(fd)
    except (OSError, ValueError, KeyError, TypeError):
        pass
    for f in (LOG_FILE, LOG_FILE + ".1"):
        try:
            with open(f, errors="replace") as fh:
                rows = [ln.split("\t") for ln in fh if "\tGRANT(" in ln]
            if rows:
                return parse_iso(rows[-1][0])
        except (OSError, ValueError, IndexError):
            continue
    return None


def audit(since):
    """Lines describing setuid/setgid files and root launchd targets (plus their plists) that changed at or after
    SINCE (epoch seconds): persistence a window can leave behind, which `revoke` does not undo."""
    found, ref = [], None
    roots = [r for r in AUDIT_ROOTS if os.path.isdir(r)]
    try:
        home = pwd.getpwuid(INVOKER_UID).pw_dir if INVOKER_UID else None
    except KeyError:
        home = None
    if home and os.path.isdir(home):
        roots.append(home)   # last: the largest tree, so a timeout still reports the rest
    try:
        fd, ref = tempfile.mkstemp(prefix=".audit.", dir=GRANT_DIR)
        os.close(fd)
        os.utime(ref, (since, since))
        for root in roots:
            try:
                r = subprocess.run(["/usr/bin/find", root, "-xdev", "-type", "f", "(", "-perm", "-4000", "-o", "-perm", "-2000", ")",
                                    "-cnewer", ref, "-print"], capture_output=True, text=True, timeout=AUDIT_TIMEOUT, env={}, check=False)
            except subprocess.TimeoutExpired:
                found.append("audit of %s timed out (incomplete)" % root)
                continue
            found += ["setuid/setgid file changed: " + ln for ln in r.stdout.splitlines()[:50]]
    except OSError as e:
        found.append("audit could not run (%s)" % e.strerror)
    finally:
        if ref:
            try:
                os.unlink(ref)
            except OSError:
                pass
    for t in launch_targets():
        try:
            st = os.stat(t)
        except OSError:
            continue
        if st.st_ctime >= since or st.st_mtime >= since:
            found.append("root launchd program or plist changed: " + t)
    return found


def print_audit(since):
    if since is None:
        print("audit: no grant time known; nothing compared")
        return 0
    found = audit(since)
    for ln in found:
        print("AUDIT " + ln)
    print("audit: %d finding(s) since %s" % (len(found), iso(since)))
    try:
        log("AUDIT(%d finding(s) since %s)" % (len(found), iso(since)))
    except OSError:
        pass
    return 1 if found else 0


def main(argv):
    global INVOKER_UID, GRANTED_EPOCH
    mode = argv[1] if len(argv) > 1 else ""
    now = time.time()
    cwd = os.getcwd()
    su = os.environ.get("SUDO_UID", "")
    INVOKER_UID = int(su) if su.isdigit() else None
    path = EXEC_PATH   # the caller's PATH decides nothing here
    if mode == "status":
        is_open, reason, d = read_grant(now)
        if len(argv) > 2 and argv[2] == "--audit":
            if len(argv) > 4 or (len(argv) == 4 and not argv[3].isdigit()):
                die("usage: status --audit [SINCE_EPOCH]", EX_USAGE)
            return print_audit(int(argv[3]) if len(argv) == 4 else last_granted_epoch())
        if len(argv) > 2:
            if argv[2] != "--check":
                die("usage: status [--check -- COMMAND...] | status --audit [SINCE_EPOCH]", EX_USAGE)
            cmd = split_command(argv[3:])
            if not is_open:
                die("REFUSED: " + reason, 1)
            GRANTED_EPOCH = parse_iso(d["granted_utc"])
            why = evaluate(cmd, cwd, path)
            if why:
                die("REFUSED: " + why, EX_DENIED)
            return 0
        print("open=%d" % is_open)
        print("reason=" + clean(reason))
        for k in ("expires_epoch", "expires_utc", "granted_utc", "remaining_s", "duration_s", "expired_utc"):
            if k in d:
                print("%s=%s" % (k, d[k]))
        return 0 if is_open else 1
    if mode == "exec":
        need_root()
        cmd = split_command(argv[2:])
        text = " ".join(shlex.quote(c) for c in cmd)
        first = resolve(cmd[0], cwd, path)
        checked = os.path.realpath(first) if first else None   # judged once; exec runs exactly this
        is_open, reason, gdata = read_grant(now)
        if is_open:
            GRANTED_EPOCH = parse_iso(gdata["granted_utc"])
        why = None if not is_open else evaluate(cmd, cwd, path)
        try:
            if not is_open:
                log("REFUSED(%s)" % reason, text)
                die("REFUSED: " + reason, EX_REFUSED)
            if why:
                log("DENYLISTED(%s)" % why, text)
                die("REFUSED: " + why, EX_DENIED)
            log("GRANTED-EXEC", text)
        except OSError as e:
            die("cannot write the audit log (%s); not running anything" % e.strerror, EX_NOEXEC)
        first = resolve(cmd[0], cwd, path)
        target = os.path.realpath(first) if first else None
        if target != checked:
            log("DENYLISTED(program changed during the check)", text)
            die("REFUSED: the program changed during the check", EX_DENIED)
        # a script is run by the realpath that was judged, so a link switched after the check changes nothing
        cmd = [cmd[0]] + [CHECKED_ARGS.get(a, a) for a in cmd[1:]]
        try:
            os.execve(target, cmd, clean_env(os.environ, cwd))
        except OSError as e:
            die("cannot run %s: %s" % (cmd[0], e.strerror), 127)
    if mode == "grant":
        need_root()
        if len(argv) != 3:
            die("usage: grant DURATION (30m, 2h, 8h; max 24h)", EX_USAGE)
        try:
            secs = parse_duration(argv[2])
        except ValueError as e:
            die(str(e), EX_USAGE)
        if os.path.realpath(__file__) != INSTALLED_PATH:
            die("grant runs only from %s" % INSTALLED_PATH, EX_REFUSED)
        why = fresh_auth_problem(argv[2])
        if why:
            try:
                log("GRANT-REFUSED(%s)" % why)
            except OSError:
                pass
            die("REFUSED: " + why, EX_REFUSED)
        uid = os.environ.get("SUDO_UID", "")
        try:
            log("GRANT(%s until %s)" % (argv[2], iso(int(now) + secs)))
            d = write_grant(secs, int(now), int(uid) if uid.isdigit() else 0)
        except OSError as e:
            die("cannot grant: %s" % e.strerror, EX_NOEXEC)
        print("expires_utc=" + d["expires_utc"])
        return 0
    if mode == "revoke":
        need_root()
        if len(argv) != 2:
            die("usage: revoke", EX_USAGE)
        since = last_granted_epoch()   # before the file goes
        try:
            log("REVOKE")
            os.unlink(GRANT_FILE)
        except FileNotFoundError:
            pass
        except OSError as e:
            die("cannot revoke: %s" % e.strerror, EX_NOEXEC)
        print_audit(since)   # after: ending the window never waits for the sweep. Revoke does not undo what was left behind
        return 0
    die("usage: exec -- CMD... | status [--check -- CMD...] | grant DURATION | revoke", EX_USAGE)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
