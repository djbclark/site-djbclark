def runner_problem(names, args):
    """Programs that run code or a program named in their own arguments (the denylist cannot see inside it): refused
    when called with the option that does it. (Programs that run code in any case are on ALWAYS_DENY.)"""
    def cluster(a, letters):   # short-option cluster such as -avze or -xIf
        return len(a) > 1 and a[0] == "-" and a[1] != "-" and any(c in a[1:] for c in letters)

    if names & {"tar", "bsdtar", "gtar"}:
        old = args[0] if args and not args[0].startswith("-") else ""   # `tar xIf ...`
        for a in ([old] if old else []) + [a for a in args if a.startswith("-")]:
            if (a.startswith("--") and a.startswith(TAR_BAD_LONG)) or (cluster(a, "IF") if a.startswith("-") else any(c in a for c in "IF")):
                return "tar option %s runs a program" % a
    if "rsync" in names:
        for a in args:
            if cluster(a, "e") or a.startswith(("--rsh", "--rsync-path", "--daemon", "--config", "--remote-option")) or a == "-M":
                return "rsync option %s runs a program" % a
    if names & {"scp", "sftp"}:
        for i, a in enumerate(args):
            if cluster(a, "SFD") and not a.startswith("--"):
                return "%s option %s runs a program" % ("/".join(sorted(names & {"scp", "sftp"})), a)
            if a == "-o" or (a.startswith("-o") and len(a) > 2):
                val = a[2:] if len(a) > 2 else (args[i + 1] if i + 1 < len(args) else "")
                if any(k in val.casefold() for k in ("command", "proxy")):
                    return "ssh option %s runs a program" % val
    if "git" in names:
        i = 0
        while i < len(args) and args[i].startswith("-"):
            a = args[i]
            if a.startswith(("-c", "-C")) or a.startswith(GIT_BAD_GLOBAL):
                return "git option %s can run a program or load other configuration" % a
            i += 1
        sub = args[i] if i < len(args) else ""
        if sub in GIT_BAD_SUBCOMMAND:
            return "git %s runs other programs" % sub
        if sub == "config" and (not set(args[i + 1:]) & GIT_CONFIG_READ or set(args[i + 1:]) & {"-e", "--edit"}):
            return "git config may write configuration (aliases, hooks and pagers run programs)"
        for a in args[i + 1:]:
            if a.startswith(GIT_BAD_ANYWHERE):
                return "git option %s runs a program" % a
    return None


