<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.{{ site_ns }}.hindsight-sync-{{ sync.name }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>{{ hindsight_sync_script }}</string>
        <string>--api</string>
        <string>http://{{ hindsight_bind }}:{{ hindsight_port }}</string>
        <string>--bank</string>
        <string>{{ sync.bank }}</string>
        <string>--dir</string>
        <string>{{ sync.dir }}</string>
{% for g in sync.globs %}
        <string>--glob</string>
        <string>{{ g }}</string>
{% endfor %}
        <string>--prefix</string>
        <string>{{ sync.name }}/</string>
{% for t in sync.tags | default([]) %}
        <string>--tag</string>
        <string>{{ t }}</string>
{% endfor %}
        <string>--state</string>
        <string>{{ hindsight_sync_state_dir }}/{{ sync.name }}.json</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>{{ sync.dir }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    {#- A git pull touches many files at once; wait for it to settle. #}
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>{{ hindsight_logs_dir }}/sync-{{ sync.name }}.log</string>
    <key>StandardErrorPath</key>
    <string>{{ hindsight_logs_dir }}/sync-{{ sync.name }}.log</string>
</dict>
</plist>
