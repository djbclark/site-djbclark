# Managed by site-djbclark roles/litellm. Local edits will be overwritten.
#
# This proxy serves ClinePass and nothing else (operator decision 2026-08-21).
#
# WHY ONLY ONE MODEL — the history is worth keeping, because the old multi-
# provider config was actively dangerous. LiteLLM's router silently falls back
# through router_settings.fallbacks whenever a model's own api_key env var is
# unset or empty, with NO error surfaced to the caller. Confirmed 2026-08-02:
# `claude-sonnet-5` on this proxy was actually served by
# google/gemini-3.5-flash-lite via OpenRouter, `gpt-4o` the same, and
# `gpt-5.5`/`gpt-4o-mini`/`gemini-flash` were all served by opencode-zen's
# deepseek-v4-flash-free. None ever reached its named vendor, and some of that
# misrouting spent real prepaid OpenRouter balance while returning responses
# that looked legitimate.
#
# A single model with NO fallbacks makes that class of bug impossible: there is
# nothing to silently substitute, so a ClinePass failure surfaces as an error.
# Do not add a fallback chain here without re-reading the paragraph above.
#
# 2026-08-22: additional ClinePass models were added for Hermes's MoA slots
# (retiring the pay-per-token DeepSeek account). The invariant above is one
# PROVIDER and no fallback chain, not literally one model — every entry below
# reaches the same ClinePass subscription through the same key, so there is
# still nothing to silently substitute.
#
# AMENDED 2026-09-25 (operator decision): fallbacks ARE now configured, because
# a single model with no fallback failed silently in a different way. From
# ~2026-09-21 ClinePass answered "model not found" for deepseek-v4-flash, and
# every Hindsight retain and reflect failed for four days with nobody noticing.
# The 08-21 hazard was fallbacks that were SILENT and that spent PREPAID money.
# This chain addresses both:
#   1. ClinePass models first (same subscription, same terms, no extra cost),
#      then the Gemini API FREE tier (sanctioned API, rate-capped, so it errors
#      rather than bills when exhausted). No pay-per-token backend is reachable.
#   2. Every fallback that actually serves a request is alerted. The Hermes
#      cron "LLM Backend Health" (~/.hermes/scripts/check-llm-backend-health.sh)
#      greps this proxy's log for LiteLLM's fallback lines and probes each route.
# Missing keys still cannot cause substitution: a route with an unset key just
# errors, and the chain only moves on to the next route after an error.
#
# AMENDED 2026-09-26 (operator decision): `grok-sub` — the SuperGrok
# subscription via xAI OAuth, the same grant Hermes already runs on — sits
# after the ClinePass models and before Gemini. It is reached through a
# loopback bridge (bin/xai_oauth_bridge.py) because the OAuth grant rotates and
# LiteLLM can only hold a static key. OPEN QUESTION, unverified: xAI's
# responses carry `cost_in_usd_ticks` even on OAuth calls; whether that draws
# on the subscription pool or on an API credit balance has not been confirmed.
#
# ClinePass is also the only monthly subscription whose terms permit this use.
# Verified 2026-08-21 against docs.cline.bot: "You can use ClinePass models from
# your own scripts, apps, or automation through the Cline API." Anthropic banned
# subscription OAuth for third-party tools in Feb 2026, z.ai's coding plan
# excludes general API use, and GitHub Models caps at 8K input. See
# site-private memory/reference_llm_gateway_subscription_compatibility.md.
#
# Keys are injected into the mode-0600 unit/plist by `just litellm-apply-secrets`
# and are never written into this file.

model_list:
  # Reached through the ClinePass provider in the LiteLLM git checkout
  # (~/src/litellm), which handles two Cline-specific quirks: the
  # {"data": {"choices": ...}} response envelope, and re-adding the
  # `modelType/` qualifier that LiteLLM strips from the model id.
  #
  # The `clinepass/` below is LiteLLM's PROVIDER ROUTING prefix and is stripped
  # before the request is built. The provider module then re-adds Cline's
  # CATALOG namespace, which is the hyphenated `cline-pass/`. Two different
  # strings; see roles/litellm/README.md. Getting the catalog namespace wrong
  # does not error — the API validates only the shape of a model id — it
  # silently resolves to a different model snapshot.
  #
  # max_tokens is pinned high on purpose. deepseek-v4-flash is a reasoning
  # model — measured 360 reasoning tokens out of 417 completion tokens — and at
  # max_tokens=600 the reasoning consumed the entire budget, so Cline returned
  # HTTP 500 "empty response content". Lowering this will look like a provider
  # outage rather than a config error.
  #
  # Raised 4000 -> {{ litellm_max_tokens }} on 2026-08-22. 4000 was not a safety
  # margin, it was a truncator: the same prompt returned completion_tokens=4000
  # (exactly the cap), and at 32000 stopped naturally at 3849 — for 25% LESS
  # money, because it was no longer burning 2015 reasoning tokens fighting the
  # ceiling. max_tokens is a ceiling, not a reservation; short answers cost the
  # same either way.
  #
  # Correction (2026-08-22, later the same day): the original note here also
  # claimed the API reported finish_reason "stop" on that truncated response.
  # Re-probing the live API — streaming and non-streaming, caps of 2000 and
  # 4000, both model namespaces — could NOT reproduce that; every capped
  # response correctly returned "length". The provider module still carries a
  # conservative correction as a safety net, but do not treat the misreport as
  # a currently-observable behaviour.
  - model_name: clinepass-deepseek
    litellm_params:
      model: clinepass/deepseek-v4-flash
      api_key: os.environ/CLINEPASS_API_KEY
      max_tokens: {{ litellm_max_tokens }}

  # Added 2026-08-22 for Hermes's non-streaming callers (MoA slots, auxiliary
  # tasks), which cannot talk to ClinePass directly — the data envelope kills
  # non-streaming calls — and so must come through this proxy. Model choice is
  # from the 2026-08-22 bake-off (site-private memory, handoff ed68):
  # minimax-m3 matched deepseek-v4-pro on all prompts at 2-5x the speed and a
  # quarter of the tokens; kimi-k3 is the strong-reasoning pick and modulates
  # reasoning_effort strongly (59 -> 169 reasoning tokens low -> high).
  - model_name: clinepass-minimax-m3
    litellm_params:
      model: clinepass/minimax-m3
      api_key: os.environ/CLINEPASS_API_KEY
      max_tokens: {{ litellm_max_tokens }}

  - model_name: clinepass-kimi-k3
    litellm_params:
      model: clinepass/kimi-k3
      api_key: os.environ/CLINEPASS_API_KEY
      max_tokens: {{ litellm_max_tokens }}

  # Last-resort fallbacks: Gemini API free tier (2026-09-25). Probed that day:
  # gemini-2.5-flash is retired for new users and several newer flash ids 503
  # under load; 3.7-flash and flash-lite-latest answered. Not for direct use:
  # the free tier's RPM/RPD caps cannot carry Hindsight's normal load.
{% if litellm_xai_bridge_enabled | bool %}
  # SuperGrok subscription through the loopback xAI OAuth bridge (2026-09-26).
  # The api_key is a placeholder: the bridge replaces the Authorization header
  # with a fresh OAuth token from Hermes's grant on every request.
  - model_name: grok-sub
    litellm_params:
      model: openai/{{ litellm_xai_fallback_model }}
      api_base: http://127.0.0.1:{{ litellm_xai_bridge_port }}/v1
      api_key: bridge-injects-oauth-token
      max_tokens: {{ litellm_max_tokens }}

{% endif %}
{% for g in litellm_gemini_fallback_models %}
  - model_name: {{ g.name }}
    litellm_params:
      model: {{ g.model }}
      api_key: os.environ/GEMINI_API_KEY
{% endfor %}

litellm_settings:
  cache: true
  cache_params:
    type: disk
    disk_cache_dir: "{{ litellm_cache_dir }}"
    ttl: 3600
  drop_params: true
  # Measured throughput is ~33 tokens/sec (8406 completion tokens took 256s), so
  # the timeout — not max_tokens — is what actually caps answer length. At the
  # old 120s a request could not exceed ~4000 tokens no matter what max_tokens
  # said, which is why the two must be raised together.
  request_timeout: {{ litellm_request_timeout }}

router_settings:
  # Dropped 2 -> {{ litellm_num_retries }} alongside the longer timeout: at
  # {{ litellm_request_timeout }}s per attempt, two retries put the worst case
  # near {{ (litellm_request_timeout | int) * 3 // 60 }} minutes on a single
  # call.
  num_retries: {{ litellm_num_retries }}
  timeout: {{ litellm_request_timeout }}
  # See the 2026-09-25 amendment in the header. Order matters: stay on the
  # ClinePass subscription as long as any of its models answers.
{% set gemini = (['grok-sub'] if litellm_xai_bridge_enabled | bool else []) + (litellm_gemini_fallback_models | map(attribute='name') | list) %}
  fallbacks:
    - clinepass-minimax-m3: {{ (['clinepass-kimi-k3', 'clinepass-deepseek'] + gemini) | to_json }}
    - clinepass-kimi-k3: {{ (['clinepass-minimax-m3', 'clinepass-deepseek'] + gemini) | to_json }}
    - clinepass-deepseek: {{ (['clinepass-minimax-m3', 'clinepass-kimi-k3'] + gemini) | to_json }}
{% if litellm_xai_bridge_enabled | bool %}
    # Hindsight reflect runs on grok-sub first (2026-09-26: minimax-m3 took
    # 70-120s per reflect and the plugin gives up at ~40s). If SuperGrok errors
    # or rate-limits, fall back to the ClinePass models, then Gemini free tier.
    - grok-sub: {{ (['clinepass-minimax-m3', 'clinepass-kimi-k3', 'clinepass-deepseek'] + (litellm_gemini_fallback_models | map(attribute='name') | list)) | to_json }}
{% endif %}

# No master_key while the proxy is loopback-only. Never widen litellm_bind
# (Tailscale or public) without a master key / auth story (E5 + REVIEW-1).
