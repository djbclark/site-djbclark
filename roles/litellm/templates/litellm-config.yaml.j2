# Managed by site-djbclark roles/litellm. Local edits will be overwritten.
#
# This proxy serves ClinePass and nothing else (operator decision 2026-08-21).
#
# WHY ONLY ONE MODEL — the history is worth keeping, because the old multi-
# provider config was actively dangerous. LiteLLM's router silently falls back
# through router_settings.fallbacks whenever a model's own api_key env var is
# unset or empty, with NO error surfaced to the caller. Confirmed 2026-08-02:
# `claude-sonnet-5` on this proxy was actually served by
# google/gemini-3.5-flash-lite via OpenRouter, `gpt-4o` the same, and
# `gpt-5.5`/`gpt-4o-mini`/`gemini-flash` were all served by opencode-zen's
# deepseek-v4-flash-free. None ever reached its named vendor, and some of that
# misrouting spent real prepaid OpenRouter balance while returning responses
# that looked legitimate.
#
# A single model with NO fallbacks makes that class of bug impossible: there is
# nothing to silently substitute, so a ClinePass failure surfaces as an error.
# Do not add a fallback chain here without re-reading the paragraph above.
#
# ClinePass is also the only monthly subscription whose terms permit this use.
# Verified 2026-08-21 against docs.cline.bot: "You can use ClinePass models from
# your own scripts, apps, or automation through the Cline API." Anthropic banned
# subscription OAuth for third-party tools in Feb 2026, z.ai's coding plan
# excludes general API use, and GitHub Models caps at 8K input. See
# site-private memory/reference_llm_gateway_subscription_compatibility.md.
#
# Keys are injected into the mode-0600 unit/plist by `just litellm-apply-secrets`
# and are never written into this file.

model_list:
  # Reached through the ClinePass provider in the LiteLLM git checkout
  # (~/src/litellm), which handles two Cline-specific quirks: the
  # {"data": {"choices": ...}} response envelope, and re-adding the
  # `modelType/` prefix that LiteLLM strips from the model id.
  #
  # max_tokens is pinned high on purpose. deepseek-v4-flash is a reasoning
  # model — measured 360 reasoning tokens out of 417 completion tokens — and at
  # max_tokens=600 the reasoning consumed the entire budget, so Cline returned
  # HTTP 500 "empty response content". Lowering this will look like a provider
  # outage rather than a config error.
  - model_name: clinepass-deepseek
    litellm_params:
      model: clinepass/deepseek-v4-flash
      api_key: os.environ/CLINEPASS_API_KEY
      max_tokens: 4000

litellm_settings:
  cache: true
  cache_params:
    type: disk
    disk_cache_dir: "{{ litellm_cache_dir }}"
    ttl: 3600
  drop_params: true
  request_timeout: 120

router_settings:
  num_retries: 2
  timeout: 120
  # No `fallbacks:` key, deliberately — see the header comment.

# No master_key while the proxy is loopback-only. Never widen litellm_bind
# (Tailscale or public) without a master key / auth story (E5 + REVIEW-1).
