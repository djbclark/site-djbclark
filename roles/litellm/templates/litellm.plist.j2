<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ litellm_label }}</string>
    {#- The log filter is the PARENT: it starts litellm, reads its merged output,
        forwards launchd's SIGTERM (SIGKILL after 20 s) and rotates the log. A
        `sh -c 'litellm | logpipe'` wrapper orphaned a wedged proxy on :4000
        when launchd signalled only the shell (2026-09-26). #}
    {#- NOT /usr/bin/python3 below: that is the Xcode CommandLineTools shim
        (/Applications/Xcode.app/Contents/Developer/usr/bin/python3), which dies with
        "unable to locate xcodebuild" whenever Xcode updates or its selected developer
        dir goes stale. It would take the log filter down with it, and so this whole
        service, which never starts without its filter. `env python3` resolves against
        the PATH declared below, which puts the user and homebrew bins ahead of
        /usr/bin, making the shim a last-resort fallback instead of a hard dependency.
        logpipe is stdlib-only; verified on 3.9.6 and 3.14.8 (2026-10-03). #}
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>{{ litellm_logpipe_script }}</string>
        <string>--out</string>
        <string>{{ litellm_logs_dir }}/litellm.log</string>
        <string>--max-bytes</string>
        <string>{{ litellm_log_max_bytes }}</string>
        <string>--backups</string>
        <string>{{ litellm_log_backups }}</string>
        <string>--</string>
        <string>{{ litellm_bin }}</string>
        <string>--config</string>
        <string>{{ litellm_config_path }}</string>
        <string>--host</string>
        <string>{{ litellm_bind }}</string>
        <string>--port</string>
        <string>{{ litellm_port }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>
    {#- Only the shell/pipe itself can write here (e.g. python3 missing). #}
    <key>StandardOutPath</key>
    <string>{{ litellm_logs_dir }}/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{ litellm_logs_dir }}/launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ litellm_home }}</string>
        <!-- Pydantic v2 scans every installed distribution for plugins on first
             schema build; in these uv envs that took 25+ min on litellm's first
             request (2026-09-27, py-spy). Neither service uses a Pydantic plugin. -->
        <key>PYDANTIC_DISABLE_PLUGINS</key>
        <string>1</string>
        <key>PATH</key>
        <string>{{ litellm_service_path }}</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>LITELLM_LOG</key>
        <string>INFO</string>
        <key>SERVER_ROOT_PATH</key>
        <string>{{ litellm_server_root_path }}</string>
{# Only keys for backends a model_list entry can reach are injected:
   ClinePass (primary) and, since 2026-09-25, the Gemini API free tier as the
   last fallback. Embedding any other provider key would put a live secret in
   this file for a backend nothing routes to. #}
{% if litellm_clinepass_api_key | length > 0 %}
        <key>CLINEPASS_API_KEY</key>
        <string>{{ litellm_clinepass_api_key | e }}</string>
{% endif %}
{% if litellm_gemini_api_key | length > 0 %}
        <key>GEMINI_API_KEY</key>
        <string>{{ litellm_gemini_api_key | e }}</string>
{% endif %}
{% if litellm_opencode_go_api_key | length > 0 %}
        <key>OPENCODE_GO_API_KEY</key>
        <string>{{ litellm_opencode_go_api_key | e }}</string>
{% endif %}
{% if litellm_db_enabled | bool %}
{# Virtual-key auth + spend DB. LITELLM_MASTER_KEY is a loopback-only anti-typo
   guard rather than a real secret (see defaults/main.yml); DATABASE_URL carries
   no password because the :5433 cluster trusts 127.0.0.1 only. #}
        <key>LITELLM_MASTER_KEY</key>
        <string>{{ litellm_master_key | e }}</string>
        <key>DATABASE_URL</key>
        <string>{{ litellm_database_url | trim | e }}</string>
{% endif %}
    </dict>
</dict>
</plist>
