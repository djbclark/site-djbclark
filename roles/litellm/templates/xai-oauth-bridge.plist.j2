<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ litellm_xai_bridge_label }}</string>
    {#- Same supervising log filter as litellm.plist.j2 (own process group,
        --kill-after below ExitTimeOut, reaper), smaller cap. #}
    {#- NOT /usr/bin/python3 below: that is the Xcode CommandLineTools shim
        (/Applications/Xcode.app/Contents/Developer/usr/bin/python3), which dies with
        "unable to locate xcodebuild" whenever Xcode updates or its selected developer
        dir goes stale. It would take the log filter down with it, and so this whole
        service, which never starts without its filter. `env python3` resolves against
        the PATH declared below, which puts the user and homebrew bins ahead of
        /usr/bin, making the shim a last-resort fallback instead of a hard dependency.
        logpipe is stdlib-only; verified on 3.9.6 and 3.14.8 (2026-10-03). #}
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>-I</string>
        <string>-S</string>
        <string>{{ litellm_logpipe_script }}</string>
        <string>--out</string>
        <string>{{ litellm_logs_dir }}/xai-oauth-bridge.log</string>
        <string>--max-bytes</string>
        <string>{{ litellm_xai_bridge_log_max_bytes }}</string>
        <string>--backups</string>
        <string>{{ litellm_xai_bridge_log_backups }}</string>
        <string>--kill-after</string>
        <string>{{ litellm_logpipe_kill_after }}</string>
        <string>--</string>
        <string>{{ litellm_xai_bridge_python }}</string>
        <string>{{ litellm_xai_bridge_script }}</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>{{ litellm_xai_bridge_port }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>{{ litellm_exit_timeout }}</integer>
    <key>AbandonProcessGroup</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>{{ litellm_throttle_interval }}</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>{{ litellm_logs_dir }}/xai-oauth-bridge.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>{{ litellm_logs_dir }}/xai-oauth-bridge.launchd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>HOME</key>
        <string>{{ litellm_home }}</string>
        <key>PATH</key>
        <string>{{ litellm_service_path }}</string>
    </dict>
</dict>
</plist>
