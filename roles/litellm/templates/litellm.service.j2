# Managed by site-djbclark roles/litellm (E5). Local edits will be overwritten.
# systemd --user unit. Mode 0600 — may embed provider API keys from apply-time env.
# Loopback-only bind; do not change litellm_bind without a master-key / auth plan.
# Boot without interactive login: loginctl enable-linger $USER (operator once).

[Unit]
Description=LiteLLM proxy (site {{ site_ns }})
Documentation=file://{{ litellm_config_path }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ litellm_bin }} --config {{ litellm_config_path }} --host {{ litellm_bind }} --port {{ litellm_port }}
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=append:{{ litellm_logs_dir }}/stdout.log
StandardError=append:{{ litellm_logs_dir }}/stderr.log
Environment=HOME={{ litellm_home }}
# Skip Pydantic's plugin scan (25+ min cold start, 2026-09-27); see litellm.plist.j2.
Environment=PYDANTIC_DISABLE_PLUGINS=1
Environment=PATH={{ litellm_service_path }}
Environment=LITELLM_LOG=INFO
Environment=SERVER_ROOT_PATH={{ litellm_server_root_path }}
{# Only keys for backends a model_list entry can reach are injected:
   ClinePass (primary) and, since 2026-09-25, the Gemini API free tier as the
   last fallback. #}
{% if litellm_clinepass_api_key | length > 0 %}
Environment=CLINEPASS_API_KEY={{ litellm_clinepass_api_key | replace('\\', '\\\\') | replace('"', '\\"') }}
{% endif %}
{% if litellm_gemini_api_key | length > 0 %}
Environment=GEMINI_API_KEY={{ litellm_gemini_api_key | replace('\\', '\\\\') | replace('"', '\\"') }}
{% endif %}
{# Not nested in the Gemini block: before 2026-10-09 it was, so a host with no
   Gemini key got no LITELLM_MASTER_KEY and master_key resolved to nothing,
   which turns proxy auth off. #}
{% if litellm_db_enabled | bool %}
Environment=LITELLM_MASTER_KEY={{ litellm_master_key | replace('\\', '\\\\') | replace('"', '\\"') }}
Environment=DATABASE_URL={{ litellm_database_url | trim }}
{% endif %}

[Install]
WantedBy=default.target
