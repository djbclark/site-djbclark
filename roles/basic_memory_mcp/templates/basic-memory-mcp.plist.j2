<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{ basic_memory_mcp_label }}</string>
  {#- bin/litellm_logpipe.py supervises the server (own process group; forwards
      launchd's SIGTERM to it, SIGKILL after --kill-after s, below ExitTimeOut;
      a reaper kills the group if the filter dies; filters repeats, size-caps
      the log). One shared server per machine; every agent session reaches it
      at {{ basic_memory_mcp_url }}. -I -S: logpipe is stdlib-only. #}
  {#- NOT /usr/bin/python3 below: that is the Xcode CommandLineTools shim
      (/Applications/Xcode.app/Contents/Developer/usr/bin/python3), which dies with
      "unable to locate xcodebuild" whenever Xcode updates or its selected developer
      dir goes stale. It would take the log filter down with it, and so this whole
      service, which never starts without its filter. `env python3` resolves against
      the PATH declared below, which puts the user and homebrew bins ahead of
      /usr/bin, making the shim a last-resort fallback instead of a hard dependency.
      logpipe is stdlib-only; verified on 3.9.6 and 3.14.8 (2026-10-03). #}
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>-I</string>
    <string>-S</string>
    <string>{{ basic_memory_mcp_logpipe_script }}</string>
    <string>--out</string><string>{{ basic_memory_mcp_logs_dir }}/basic-memory-mcp.log</string>
    <string>--max-bytes</string><string>{{ basic_memory_mcp_log_max_bytes | string }}</string>
    <string>--backups</string><string>{{ basic_memory_mcp_log_backups | string }}</string>
    <string>--kill-after</string><string>{{ basic_memory_mcp_logpipe_kill_after | string }}</string>
    <string>--</string>
    <string>{{ basic_memory_mcp_bin }}</string>
    <string>mcp</string>
    <string>--transport</string><string>streamable-http</string>
    <string>--host</string><string>{{ basic_memory_mcp_bind }}</string>
    <string>--port</string><string>{{ basic_memory_mcp_port | string }}</string>
    <string>--path</string><string>{{ basic_memory_mcp_path }}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>{{ basic_memory_mcp_exit_timeout }}</integer>
  <key>AbandonProcessGroup</key><false/>
  <!-- Standard, not Background: launchd defers and throttles Background jobs at login, so after the
       2026-10-05 reboot the server was not listening for ~5 min and every agent session resumed
       in that window came up without basic-memory (clients do not retry). -->
  <key>ProcessType</key><string>Standard</string>
  <key>WorkingDirectory</key><string>{{ basic_memory_mcp_home }}</string>
  <key>StandardOutPath</key><string>{{ basic_memory_mcp_logs_dir }}/launchd.log</string>
  <key>StandardErrorPath</key><string>{{ basic_memory_mcp_logs_dir }}/launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{ basic_memory_mcp_home }}</string>
    <key>PATH</key><string>{{ basic_memory_mcp_service_path }}</string>
  </dict>
</dict>
</plist>
