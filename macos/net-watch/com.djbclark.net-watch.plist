<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- net-watch (bin/net-watch, started through bin/net-watch-tick, which snapshots the ARP table for it): every 60 s a tick that returns at once unless a probe is due (every 5 min
     while healthy, every 1 min after a slow sample). Notices a download below 30 Mbps for 10+ minutes,
     pings once at the start and once at the end, collects a diagnostics snapshot, and tries one Deco reboot.
     Installed by `net-watch install`, removed by `net-watch uninstall`. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.net-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/djbclark/ops/site-public-djbclark/bin/net-watch-tick</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/djbclark/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/djbclark/.local/state/net-watch/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/djbclark/.local/state/net-watch/launchd.err</string>
</dict>
</plist>
