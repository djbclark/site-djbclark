<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.djbclark.otp-to-clipboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python</string>
        <string>/Users/djbclark/ops/site-djbclark/bin/otp-to-clipboard</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardErrorPath</key>
    <string>/Users/djbclark/Library/Logs/otp-to-clipboard.launchd.log</string>
    <key>StandardOutPath</key>
    <string>/Users/djbclark/Library/Logs/otp-to-clipboard.launchd.log</string>
</dict>
</plist>
