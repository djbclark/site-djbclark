<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.djbclark.athena-lockers</string>
  <!-- Stand-in for Athena's on-demand /mit: attach every locker named in
       ~/.config/athena/lockers (symlink in /mit + aklog for its cell) at login
       and hourly, which also keeps those cells' AFS tokens fresh. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"; [ -d /afs ] || exit 0; exec attach -q $(cat "$HOME/.config/athena/lockers")</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/djbclark/Library/Logs/athena-lockers.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/djbclark/Library/Logs/athena-lockers.log</string>
</dict>
</plist>
