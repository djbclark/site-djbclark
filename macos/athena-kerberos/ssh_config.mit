# Kerberos (GSSAPI) login to MIT hosts with the TGT forwarded, so the remote
# side has tickets (and, on Athena, AFS tokens) with no kinit there.
# Installed as ~/.ssh/config.d/mit, included near the top of ~/.ssh/config
# (ssh takes the first value it sees, so this must precede "Host *").
Host athena
    HostName athena.dialup.mit.edu

# The dialups also require Duo: share one master connection, opened on demand
# by athena-master (which answers Duo with a push). If it cannot be opened,
# ssh falls back to a direct connection and the Duo prompt.
Match originalhost athena,athena.dialup.mit.edu exec "~/ops/site-djbclark/macos/athena-kerberos/athena-master ensure"
    ControlPath ~/.ssh/cm/athena
    ControlMaster no

Host athena *.mit.edu
    User djbclark
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
    PreferredAuthentications gssapi-with-mic,keyboard-interactive,password
    IdentityAgent none
