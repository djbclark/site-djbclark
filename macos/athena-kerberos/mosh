#!/bin/bash
# mosh wrapper (~/.local/bin/mosh): for Athena dialup targets, take the server
# IP from $SSH_CONNECTION instead of mosh's default ProxyCommand probe, which
# passes `ssh -S none` and so bypasses the shared athena-master connection
# (and pays Duo again). Every other target runs mosh unchanged.
real=/opt/homebrew/bin/mosh
args=("$@")
for a in "$@"; do
  case "$a" in --experimental-remote-ip*) exec "$real" "${args[@]}" ;; esac
done
for a in "$@"; do
  case "${a#*@}" in
    athena|athena.dialup.mit.edu) exec "$real" --experimental-remote-ip=remote "${args[@]}" ;;
  esac
done
exec "$real" "${args[@]}"
