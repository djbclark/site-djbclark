{
  "basedpyright": {
    "command": "sh",
    "args": [
      "-c",
      "if command -v lsp-root-guard >/dev/null 2>&1; then exec lsp-root-guard -- \"$@\"; else exec \"$@\"; fi",
      "lsp-guard",
      "basedpyright-langserver",
      "--stdio"
    ],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  },
  "marksman": {
    "command": "sh",
    "args": [
      "-c",
      "if command -v lsp-root-guard >/dev/null 2>&1; then exec lsp-root-guard -- \"$@\"; else exec \"$@\"; fi",
      "lsp-guard",
      "marksman",
      "server"
    ],
    "extensionToLanguage": {
      ".md": "markdown"
    }
  },
  "taplo": {
    "command": "taplo",
    "args": [
      "lsp",
      "stdio"
    ],
    "extensionToLanguage": {
      ".toml": "toml"
    }
  },
  "gopls": {
    "command": "gopls",
    "extensionToLanguage": {
      ".go": "go"
    }
  },
  "typescript": {
    "command": "sh",
    "args": [
      "-c",
      "if command -v lsp-root-guard >/dev/null 2>&1; then exec lsp-root-guard -- \"$@\"; else exec \"$@\"; fi",
      "lsp-guard",
      "typescript-language-server",
      "--stdio"
    ],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    },
    "initializationOptions": {
      "tsserver": {
        "path": "/Users/djbclark/.local/share/tsserver-ts5/node_modules/typescript/lib"
      },
      "maxTsServerMemory": 3072
    }
  },
  "kotlin": {
    "command": "/Users/djbclark/ops/site-public-djbclark/bin/kotlin-lsp-lite",
    "args": [
      "--stdio"
    ],
    "extensionToLanguage": {
      ".kt": "kotlin",
      ".kts": "kotlin"
    },
    "startupTimeout": 120000
  }
}
