prefix_rule(pattern=["/opt/homebrew/bin/bash", "-lc", "before=$(adb -s RFCX219CHKA shell cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '\\r'); echo \"waiting_for_reboot before=$before\"; for _n in $(seq 1 12); do current=$(adb -s RFCX219CHKA shell cat /proc/sys/kernel/random/boot_id 2>/dev/null | tr -d '\\r'); completed=$(adb -s RFCX219CHKA shell getprop sys.boot_completed 2>/dev/null | tr -d '\\r'); if [ -n \"$current\" ] && [ \"$current\" != \"$before\" ]; then echo \"reboot_detected boot_id=$current boot_completed=$completed\"; exit 0; fi; sleep 5; done; echo \"reboot_not_detected_yet\""], decision="allow")
