# Delivery checks. Agents return provider failures as if they were answers
# (stop=end_turn, exit 0) or as bare ACP errors. Seen 2026-10-05: an ACP error
# "Internal error: Go usage limit exceeded" (opencode); the whole reply
# "Upgrade your plan to continue" (cursor); a 20-minute reply whose last line
# was "Error: RetriableError: [unavailable] PING timed out" (cursor).
# Keep these tables small: every entry is a chance of a false failure.
#
# FAILURE_CLASSES classifies text already known to be an error (an ACP error,
# the agent's stderr after it exited, a reply's TAIL_ERROR line, a REPLY_REFUSALS
# reply); first match wins.
FAILURE_CLASSES = [
    (
        "quota",
        [
            r"usage limit",
            r"quota",
            r"rate[ _-]?limit",
            r"resource[ _-]?exhausted",
            r"\b429\b",
            r"insufficient (credit|balance|funds)",
            r"out of credits",
        ],
    ),
    (
        "plan",
        [
            r"upgrade your plan",
            r"not (available|included) (on|in|with) your",
            r"requires? an? (paid|pro|higher|different) (plan|subscription)",
        ],
    ),
    (
        "auth",
        [
            r"auth(entication|orization)? required",
            r"please (log|sign) ?in",
            r"not (logged|signed) in",
            r"(log|sign) ?in (again|required)",
            r"invalid api[ _-]?key",
            r"unauthori[sz]ed",
            r"\b401\b",
        ],
    ),
    (
        "transient",
        [
            r"timed? ?out",
            r"unavailable",
            r"overloaded",
            r"econnreset",
            r"at capacity",
            r"socket hang up",
            r"retriable",
            r"connection (reset|closed|refused|error)",
            r"internal (server )?error",
            r"\b5\d\d\b",
        ],
    ),
]
FAILURE_TEXT = {
    "quota": "quota exhausted",
    "plan": "model not available on this plan",
    "auth": "not authenticated",
    "transient": "transient provider/transport error",
    "provider": "provider error",
}
# A whole reply of at most SHORT_REPLY characters that starts like this is a
# refusal, not an answer. Anchored at the start so a report that merely
# mentions quotas is not one.
SHORT_REPLY = 300
REPLY_REFUSALS = [
    r"upgrade your plan",
    r"selected model is at capacity",  # codex-acp, see openclaw/acpx#850
    r"you('ve| have) (hit|reached|exceeded) (your|the) \w+ (limit|quota)",
    r"(usage|rate) limit (exceeded|reached)",
    r"quota (exceeded|exhausted)",
    r"please (log|sign) ?in\b",
    r"(you are |you're )?not (logged|signed) in",
    r"auth(entication)? required",
]
# The last non-empty line of a reply that is an error report from the provider
# or transport (cursor: "Error: RetriableError: ...", claude: "API Error: 529").
TAIL_ERROR = r"^(api |provider )?error\b\s*[:(\d]|^selected model is at capacity"

# Tool kind from a permission request's title when the agent sends no kind.
# Ported from acpx (MIT, github.com/openclaw/acpx src/permissions.ts
# TOOL_KIND_TITLE_MATCHERS); "create", "str_replace", "apply_patch" added.
TITLE_KINDS = {
    "read": "read",
    "cat": "read",
    "search": "search",
    "find": "search",
    "grep": "search",
    "write": "edit",
    "edit": "edit",
    "patch": "edit",
    "create": "edit",
    "str_replace": "edit",
    "apply_patch": "edit",
    "delete": "delete",
    "remove": "delete",
    "move": "move",
    "rename": "move",
    "run": "execute",
    "execute": "execute",
    "bash": "execute",
    "fetch": "fetch",
    "http": "fetch",
    "url": "fetch",
    "think": "think",
}


def dump(o):
    if isinstance(o, (list, tuple)):
        return [dump(x) for x in o]
    if hasattr(o, "model_dump"):
        return o.model_dump(mode="json", by_alias=True, exclude_none=True)
    return o


def infer_kind(kind, title):
    """The tool kind a scoped policy should judge: the agent's own kind, else one
    inferred from the title's first word (acpx's approach), else None."""
    if kind and kind != "other":
        return kind
    head = re.split(r"[:\s(`]", (title or "").strip().lower(), maxsplit=1)[0]
    found = TITLE_KINDS.get(head) or TITLE_KINDS.get(re.split(r"[_\-.]", head)[0])
    if found:
        return found
    return kind  # "other" stays "other"; missing stays None


def classify(text):
    """Failure class for error text (FAILURE_CLASSES), or None."""
    for cls, alternatives in FAILURE_CLASSES:
        if re.search("|".join(alternatives), text or "", re.IGNORECASE):
            return cls
    return None


def reply_failure(text, tools):
    """(class, message) when a reply is a provider refusal or ends in a provider
    error line, else None."""
    s = (text or "").strip()
    if not s:
        return None
    lines = [ln.strip() for ln in s.splitlines() if ln.strip()]
    if len(s) <= SHORT_REPLY and any(
        re.match(rx, s, re.IGNORECASE) for rx in REPLY_REFUSALS
    ):
        cls = classify(s) or "provider"
        return cls, f"{FAILURE_TEXT[cls]}: reply was {s[:200]!r}"
    if re.match(TAIL_ERROR, lines[-1], re.IGNORECASE):
        cls = classify(lines[-1]) or "provider"
        msg = f"{FAILURE_TEXT[cls]}: {lines[-1][:200]}"
        if len(lines) > 1 or tools:
            msg = "reply truncated; edits may be present; " + msg
        return cls, msg
    return None


def select_exit(stop_reason, text, tools, allowed, denied, perm, failure):
    """(exit code, error message or None) for a turn that finished (no ACP
    error, no timeout)."""
    if failure:
        return 1, failure[1]
    if stop_reason != "end_turn":
        return 1, None
    if text.strip():
        return 0, None
    if denied and not allowed:
        return EXIT_ALL_DENIED, (
            f"empty reply and all {denied} permission request(s) were denied"
        )
    if denied:
        return 1, f"empty reply; {denied} of {allowed + denied} permission(s) denied"
    if tools == 0:
        return 1, "empty reply: end_turn with no text and no tool calls"
    if perm == "deny":
        return 1, "empty reply under --perm deny: nothing changed, nothing reported"
    return 0, None


def retryable_error(e):
    """A prompt error worth retrying: an ACP internal or parse error (acpx's
    isRetryablePromptError) that is not a quota, plan or auth failure."""
    if not isinstance(e, RequestError) or e.code not in (-32603, -32700):
        return False
    return classify(error_text(e)) not in ("quota", "plan", "auth")


def error_text(e):
    s = f"{type(e).__name__}: {e}"
    data = getattr(e, "data", None)
    if data:
        s += " " + json.dumps(data, default=str)[:300]
    return s


def load_per_core():
    return os.getloadavg()[0] / (os.cpu_count() or 1)


def load_guard(max_load, wait, poll=15.0):
    """None when the 1-minute load per core is at most max_load (waiting up to
    `wait` seconds for it to get there), else the reason for refusing."""
    deadline, said = time.monotonic() + wait, False
    while True:
        cur = load_per_core()
        if cur <= max_load:
            if said:
                print(f"acp-run: load {cur:.2f}/core, starting", file=sys.stderr)
            return None
        why = (
            f"1-minute load {os.getloadavg()[0]:.1f} over {os.cpu_count()} cores"
            f" = {cur:.2f}/core > --max-load {max_load}"
        )
        left = deadline - time.monotonic()
        if left <= 0:
            return why
        if not said:
            print(f"acp-run: {why}; waiting up to {wait:.0f}s", file=sys.stderr)
            said = True
        time.sleep(min(poll, left))


class RunClient(Client):
    def __init__(self, log, perm, root):
        self.log, self.perm, self.root = log, perm, root
        self.text, self.tools, self.allowed, self.denied = [], 0, 0, 0
        self.usage = None

    def rec(self, kind, data):
        row = {"t": round(time.time(), 3), "kind": kind, "data": data}
        self.log.write(json.dumps(row) + "\n")
        self.log.flush()

    def decide(self, tool_call):
        if self.perm == "all":
            return True
        if self.perm == "deny":
            return False
        kind = infer_kind(
            getattr(tool_call, "kind", None), getattr(tool_call, "title", None)
        )
        if kind in READ_KINDS:
            return True
        # edit/delete/move, or a kind that is missing and not inferable
        locs = getattr(tool_call, "locations", None) or []
        paths = [Path(loc.path) for loc in locs]
        if not paths:
            return False
        scopes = [
            (self.root / s).resolve()
            for s in self.perm.split(":", 1)[1].split(",")
            if s
        ]
        return all(any(p.resolve().is_relative_to(s) for s in scopes) for p in paths)

    async def request_permission(self, session_id, tool_call, options, **kw):
        # Pick only *_once options. An *_always option can outlive this run
        # (Hermes saves allow_always to a permanent on-disk allowlist), and
        # "cancelled" means the whole turn was cancelled, not one action denied.
        # With no fitting option, answer with a JSON-RPC error. Same rules as
        # multica-ai/multica#5351.
        ok = self.decide(tool_call)
        allow = next((o for o in options if o.kind == "allow_once"), None)
        reject = next((o for o in options if o.kind == "reject_once"), None)
        granted = ok and allow is not None
        pick = allow if granted else reject
        kind = infer_kind(
            getattr(tool_call, "kind", None), getattr(tool_call, "title", None)
        )
        self.rec(
            "permission",
            {
                "tool_call": dump(tool_call),
                "options": [dump(o) for o in options],
                "inferred_kind": kind,
                "decision": "allow" if granted else "deny",
                "option": pick.option_id if pick else None,
            },
        )
        if granted:
            self.allowed += 1
        else:
            self.denied += 1
        if pick is None:
            raise RequestError.invalid_params(
                {"reason": "acp-run answers only with allow_once/reject_once options"}
            )
        return RequestPermissionResponse(
            outcome=AllowedOutcome(outcome="selected", option_id=pick.option_id)
        )

    async def session_update(self, session_id, update, **kw):
        self.rec("update", dump(update))
        kind = getattr(update, "session_update", "")
        if isinstance(update, AgentMessageChunk) and isinstance(
            update.content, TextContentBlock
        ):
            self.text.append(update.content.text)
        elif kind == "tool_call":
            self.tools += 1
        elif kind == "usage_update":
            self.usage = dump(update)

    async def ext_method(self, method, params):
        raise RequestError.method_not_found(method)

    async def ext_notification(self, method, params):
        pass


def pick_config(options, want, category):
    """Find a select config option (e.g. category 'model') and the value matching want."""
    for opt in options or []:
        o = dump(opt)
        if o.get("id") != category and o.get("category") != category:
            continue
        values = []
        for v in o.get("options", []):
            values += v.get("options", [v]) if "options" in v else [v]
        for v in values:
            if want in (v.get("value"), v.get("name")):
                return o["id"], v["value"]
        raise SystemExit(
            f"acp-run: no {category} '{want}'; have: "
            + ", ".join(str(v.get("value")) for v in values)
        )
    raise SystemExit(
        f"acp-run: agent offers no '{category}' config option (try --info)"
    )


def ensure_agy_home() -> str:
    """Shadow ~/.gemini with symlinks to everything but hooks.json (see YOLO_SET note)."""
    src, dst = Path.home() / ".gemini", Path.home() / ".local/share/agy-acp-home"
    (dst / "config").mkdir(parents=True, exist_ok=True)
    hooks = dst / "config" / "hooks.json"
    if not hooks.exists():
        hooks.write_text("{}\n")
    for base, tgt in ((src, dst), (src / "config", dst / "config")):
        for f in base.iterdir():
            link = tgt / f.name
            if (f.name == "config" and base == src) or f.name.startswith("hooks.json"):
                continue
            if not link.is_symlink() and not link.exists():
                link.symlink_to(f)
    return str(dst)


async def _kill(proc):
    if proc is None or proc.returncode is not None:
        return
    proc.terminate()
    try:
        await asyncio.wait_for(proc.wait(), 5)
    except asyncio.TimeoutError:
        proc.kill()
        try:
            await asyncio.wait_for(proc.wait(), 5)
        except asyncio.TimeoutError:
            pass


def stderr_tail(path, n=2000):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - n))
            return f.read().decode(errors="replace")
    except OSError:
        return ""


def fallback_cli(a) -> int:
    """Headless CLI when ACP handshake hangs (claude-agent-acp session/new)."""
    if a.agent != "claude":
        return 1
    model = a.model or "sonnet"
    cmd = ["claude", "-p", a.prompt_text, "--model", model]
    if a.perm == "all":
        cmd.append("--dangerously-skip-permissions")
    print("acp-run: ACP handshake failed; fallback to claude CLI", file=sys.stderr)
    return subprocess.run(cmd, cwd=str(Path(a.dir).resolve()), check=False).returncode


async def run(a, log, err, log_path):
    cmd, auth = AGENTS[a.agent]
    auth = a.auth or auth
    if a.perm == "all" and not a.mode and a.agent in YOLO_CMD:
        cmd = YOLO_CMD[a.agent]
    root = Path(a.dir).resolve()
    env = dict(os.environ)
    if a.agent == "agy":
        env["GEMINI_HOME"] = ensure_agy_home()
    t0, out, code = time.time(), {"agent": a.agent, "log": str(log_path)}, 1
    handshake_timeout = a.handshake_timeout or HANDSHAKE_TIMEOUT.get(
        a.agent, HANDSHAKE_TIMEOUT_DEFAULT
    )
    tries = max(1, a.handshake_tries)
    proc = client = conn = init = sess = None
    # SIGINT/SIGTERM: cancel the turn cooperatively (session/cancel), stop the
    # agent and exit 128+signal, as acpx does for SIGINT. Without this, SIGTERM
    # left the agent process running.
    got = {}
    main_task = asyncio.current_task()

    def on_signal(signum):
        got.setdefault("sig", signum)
        main_task.cancel()

    loop = asyncio.get_running_loop()
    for s in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(s, on_signal, s)
    failure, prompt_task, finished = None, None, False
    try:
        for attempt in range(1, tries + 1):
            proc = await asyncio.create_subprocess_exec(
                *cmd,
                cwd=root,
                env=env,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=err,
                limit=64 * 1024 * 1024,
            )
            client = RunClient(log, a.perm, root)
            conn = connect_to_agent(client, proc.stdin, proc.stdout)
            try:
                init = await asyncio.wait_for(
                    conn.initialize(
                        protocol_version=PROTOCOL_VERSION,
                        client_capabilities=ClientCapabilities(),
                        client_info=Implementation(
                            name="acp-run", title="acp-run", version="1"
                        ),
                    ),
                    handshake_timeout,
                )
                client.rec("initialize", dump(init))
                if auth:
                    await asyncio.wait_for(conn.authenticate(method_id=auth), 300)
                sess = await asyncio.wait_for(
                    conn.new_session(mcp_servers=[], cwd=str(root)), handshake_timeout
                )
                client.rec("new_session", dump(sess))
                break
            except asyncio.TimeoutError:
                client.rec(
                    "handshake_timeout",
                    {"attempt": attempt, "tries": tries, "secs": handshake_timeout},
                )
                print(
                    f"acp-run: handshake timeout ({handshake_timeout:g}s)"
                    f" attempt {attempt}/{tries}",
                    file=sys.stderr,
                )
                await _kill(proc)
                proc = None
        else:
            out["error"] = (
                f"TimeoutError: handshake after {tries} tries of"
                f" {handshake_timeout:g}s (session/new hung)"
            )
            if not a.no_fallback and a.agent == "claude" and not a.info:
                return fallback_cli(a)
            code = 124
        if proc is None:
            pass
        elif a.info:
            info = {
                "agent": dump(init.agent_info),
                "auth_methods": dump(init.auth_methods),
                "modes": dump(sess.modes),
                "config_options": dump(sess.config_options),
            }
            print(json.dumps(info, indent=1))
            return 0
        else:
            if a.mode:
                await conn.set_session_mode(session_id=sess.session_id, mode_id=a.mode)
            sets = dict(DEFAULT_SET.get(a.agent, {}))
            if a.perm == "all" and not a.mode:
                sets.update(YOLO_SET.get(a.agent, {}))
            sets.update(kv.split("=", 1) for kv in a.set)
            for key, want in sets.items():  # provider before model: models depend on it
                cid, val = pick_config(sess.config_options, want, key)
                await conn.set_config_option(
                    config_id=cid, session_id=sess.session_id, value=val
                )
                client.rec("set_config", {"id": cid, "value": val})
            if a.model:
                cid, val = pick_config(sess.config_options, a.model, "model")
                await conn.set_config_option(
                    config_id=cid, session_id=sess.session_id, value=val
                )
            deadline = time.monotonic() + a.timeout
            prompt = [TextContentBlock(type="text", text=a.prompt_text)]
            for attempt in range(a.prompt_retries + 1):
                # Retry only before any side effect (acpx: no retry once the
                # turn touched anything), with acpx's 1 s * 2^n, max 10 s backoff.
                can_retry = (
                    attempt < a.prompt_retries
                    and client.tools == client.allowed == client.denied == 0
                )
                client.text = []
                prompt_task = asyncio.ensure_future(
                    conn.prompt(session_id=sess.session_id, prompt=prompt)
                )
                why = None
                try:
                    resp = await asyncio.wait_for(
                        asyncio.shield(prompt_task), max(1, deadline - time.monotonic())
                    )
                except asyncio.TimeoutError:
                    await conn.cancel(session_id=sess.session_id)
                    try:
                        resp = await asyncio.wait_for(prompt_task, 15)
                        out["stop_reason"] = resp.stop_reason
                    except (asyncio.TimeoutError, RequestError, ConnectionError):
                        out["stop_reason"] = "timeout"
                    code = 124
                    break
                except (RequestError, ConnectionError) as e:
                    if not (can_retry and retryable_error(e)):
                        raise
                    why = error_text(e)
                else:
                    out["stop_reason"] = resp.stop_reason
                    client.rec("prompt_response", dump(resp))
                    quota = (resp.field_meta or {}).get("quota")
                    if quota:  # e.g. codex-acp/Gemini _meta.quota: keep for --json
                        out["quota"] = quota
                    if resp.usage:
                        out["usage"] = dump(resp.usage)
                    failure = reply_failure("".join(client.text), client.tools)
                    if not (can_retry and failure and failure[0] == "transient"):
                        finished = True
                        break
                    why = failure[1]
                delay = min(2.0**attempt, 10.0)
                client.rec(
                    "retry", {"attempt": attempt + 1, "delay": delay, "why": why}
                )
                print(
                    f"acp-run: retry {attempt + 1}/{a.prompt_retries} in {delay:g}s: {why}",
                    file=sys.stderr,
                )
                await asyncio.sleep(delay)
    except asyncio.CancelledError:
        if "sig" not in got:
            raise
        main_task.uncancel()
        if conn is not None and sess is not None and not a.info:
            try:
                await asyncio.wait_for(conn.cancel(session_id=sess.session_id), 5)
                if prompt_task is not None:
                    await asyncio.wait_for(prompt_task, 5)
            except (
                asyncio.TimeoutError,
                asyncio.CancelledError,  # a second signal: stop waiting
                RequestError,
                ConnectionError,
            ):
                pass
        out["stop_reason"] = "interrupted"
        out["error"] = f"interrupted by {signal.Signals(got['sig']).name}"
        code = 128 + got["sig"]
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001 - any agent failure becomes a summary line + exit 1
        out["error"] = error_text(e)[:500]
        if isinstance(e, ConnectionError):  # the agent died: its stderr may say why
            await _kill(proc)
            rc = proc.returncode if proc else None
            out["error"] += f" (agent exited, code {rc})"
            cls = classify(stderr_tail(err.name))
        else:
            cls = classify(out["error"])
        if cls:
            failure = (cls, f"{FAILURE_TEXT[cls]}: {out['error']}")
    finally:
        logging.disable(logging.CRITICAL)  # a half-written line at shutdown is noise
        await _kill(proc)
        for s in (signal.SIGINT, signal.SIGTERM):
            loop.remove_signal_handler(s)
    out.update(seconds=round(time.time() - t0, 1))
    if client is None:
        out.update(tool_calls=0, permissions={"allowed": 0, "denied": 0})
        print(
            f"acp-run: agent={a.agent} stop=error secs={out['seconds']}"
            f" error={out.get('error')!r} log={log_path}",
            file=sys.stderr,
        )
        return code
    if client.usage:
        out["usage_update"] = client.usage
    out.update(
        tool_calls=client.tools,
        permissions={"allowed": client.allowed, "denied": client.denied},
    )
    text = "".join(client.text)
    if finished:
        code, msg = select_exit(
            out.get("stop_reason"),
            text,
            client.tools,
            client.allowed,
            client.denied,
            a.perm,
            failure,
        )
        if msg:
            out["error"] = msg
        if code == 0 and client.denied and not client.allowed:
            out["warning"] = f"all {client.denied} permission request(s) were denied"
    if failure:
        out["failure"] = failure[0]
    out["exit"] = code
    client.rec("result", out)
    if failure or (finished and code != 0 and "error" in out):
        label = out.get("failure") or (
            "permissions" if client.denied else "empty-reply"
        )
        print(f"acp-run: FAILED {label}: {out.get('error')}", file=sys.stderr)
    if a.json:
        print(json.dumps({**out, "text": text}, indent=1))
    else:
        sys.stdout.write(text + ("\n" if text and not text.endswith("\n") else ""))
        u = out.get("usage") or {}
        cost = (client.usage or {}).get("cost", {}).get("amount")
        bits = [
            f"agent={a.agent}",
            f"stop={out.get('stop_reason', 'error')}",
            f"secs={out['seconds']}",
            f"tools={client.tools}",
            f"perm={client.allowed}+/{client.denied}-",
        ]
        tok = u.get("totalTokens") or u.get("total_tokens")
        if tok:
            bits.append(f"tokens={tok}")
        if cost is not None:
            bits.append(f"cost=${cost:.4f}")
        if "failure" in out:
            bits.append(f"fail={out['failure']}")
        if "error" in out:
            bits.append(f"error={out['error']!r}")
        if "warning" in out:
            bits.append(f"warning={out['warning']!r}")
        print("acp-run: " + " ".join(bits) + f" log={log_path}", file=sys.stderr)
    return code


def env_float(name):
    v = os.environ.get(name)
    try:
        return float(v) if v else None
    except ValueError:
        raise SystemExit(f"acp-run: {name}={v!r} is not a number") from None


def main():
    ap = argparse.ArgumentParser(
        prog="acp-run",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("agent", nargs="?")
    ap.add_argument("-C", "--dir", default=".")
    ap.add_argument("-p", "--prompt")
    ap.add_argument("-f", "--prompt-file")
    ap.add_argument("--perm", default="all")
    ap.add_argument("--model")
    ap.add_argument("--mode")
    ap.add_argument(
        "--set",
        action="append",
        default=[],
        metavar="ID=VALUE",
        help="set an ACP session config option (see --info); repeatable",
    )
    ap.add_argument("--timeout", type=float, default=1800)
    ap.add_argument(
        "--auth",
        help="ACP auth method id to authenticate with (see --info), overriding"
        " the agent default; e.g. agy: oauth-personal",
    )
    ap.add_argument("--log")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--info", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument(
        "--handshake-tries",
        type=int,
        default=2,
        help="ACP initialize+session/new attempts before fallback (default 2)",
    )
    ap.add_argument(
        "--handshake-timeout",
        type=float,
        default=env_float("ACP_RUN_HANDSHAKE_TIMEOUT"),
        metavar="SECS",
        help="seconds for initialize and for session/new, each (default 40,"
        " claude 90; env ACP_RUN_HANDSHAKE_TIMEOUT)",
    )
    ap.add_argument(
        "--no-fallback",
        action="store_true",
        help="do not fall back to the agent's CLI if ACP handshake hangs",
    )
    ap.add_argument(
        "--prompt-retries",
        type=int,
        default=0,
        metavar="N",
        help="retry a prompt that failed transiently before any tool call (default 0)",
    )
    ap.add_argument(
        "--max-load",
        type=float,
        default=env_float("ACP_RUN_MAX_LOAD"),
        metavar="L",
        help="refuse to start (exit 75) while the 1-minute load average per CPU"
        " core is above L (env ACP_RUN_MAX_LOAD; default off)",
    )
    ap.add_argument(
        "--load-wait",
        type=float,
        default=env_float("ACP_RUN_LOAD_WAIT") or 0,
        metavar="SECS",
        help="with --max-load, wait up to SECS for the load to drop before"
        " refusing (env ACP_RUN_LOAD_WAIT; default 0)",
    )
    a = ap.parse_args()
    if a.list:
        for n, (c, auth) in AGENTS.items():
            ok = "ok " if shutil.which(c[0]) else "-- "
            print(f"{ok}{n:9} {' '.join(c)}" + (f"  (auth {auth})" if auth else ""))
        return 0
    if a.agent not in AGENTS:
        ap.error(f"agent must be one of: {', '.join(AGENTS)}")
    if not (a.perm in ("all", "deny") or a.perm.startswith("scoped:")):
        ap.error("--perm must be all, deny or scoped:PATH[,PATH...]")
    if a.prompt_retries < 0:
        ap.error("--prompt-retries must be 0 or more")
    if a.handshake_timeout is not None and a.handshake_timeout <= 0:
        ap.error("--handshake-timeout must be positive")
    if not a.info:
        if a.prompt_file:
            a.prompt_text = Path(a.prompt_file).read_text()
        elif a.prompt:
            a.prompt_text = a.prompt
        elif not sys.stdin.isatty():
            a.prompt_text = sys.stdin.read()
        else:
            ap.error("give a prompt with -p, -f or stdin")
    cmd = YOLO_CMD.get(a.agent, AGENTS[a.agent][0])
    if not shutil.which(cmd[0]):
        raise SystemExit(f"acp-run: {cmd[0]} not installed")
    if a.max_load is not None and not a.info:
        why = load_guard(a.max_load, a.load_wait)
        if why:
            print(f"acp-run: refusing to start: {why}", file=sys.stderr)
            return EXIT_LOAD
    state = Path.home() / ".local/state/acp-run"
    state.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    log_path = (
        Path(a.log) if a.log else state / f"{stamp}-{a.agent}-{os.getpid()}.jsonl"
    )
    with open(log_path, "w") as log, open(log_path.with_suffix(".stderr"), "w") as err:
        return asyncio.run(run(a, log, err, log_path))


if __name__ == "__main__":
    sys.exit(main())
